		Description = "Planeta que existe en dos dimensiones a la vez; sus anillos giran en sentidos imposibles.",
		Visual = { Texture = "quantum", Tint = rgb(190, 150, 255), Color = rgb(120, 80, 255), Material = "Glass",
			Atmosphere = rgb(120, 255, 255), Glow = rgb(150, 110, 255), Particles = "energy",
			Rings = { { Inner = 1.5, Outer = 1.58, Color = rgb(120, 255, 255), Tilt = 70, Alpha = 0.05, Line = true },
				{ Inner = 1.5, Outer = 1.58, Color = rgb(255, 110, 255), Tilt = -70, Alpha = 0.05, Line = true },
				{ Inner = 1.9, Outer = 1.98, Color = rgb(255, 255, 255), Tilt = 0, Alpha = 0.05, Line = true } } },
	},
	{
		Id = "infinitum", Name = "Infinitum", Rarity = "mythic", Elements = { "cosmic" }, TypeLabel = "Cósmico",
		System = "infinity", Base = 210, Scale = 1.35, RotationSpeed = 16, OrbitSpeed = 0.7,
		Description = "Una galaxia entera comprimida en un mundo: el premio de los coleccionistas pacientes.",
		Visual = { Texture = "singularity", Tint = rgb(170, 210, 255), Color = rgb(60, 90, 220), Material = "Neon",
			Atmosphere = rgb(160, 200, 255), Glow = rgb(140, 180, 255), Particles = "stardust",
			Rings = { { Inner = 1.4, Outer = 2.5, Color = rgb(170, 200, 255), Tilt = 12, Alpha = 0.35 } } },
	},
	{
		Id = "cryostar", Name = "Cryostar", Rarity = "secret", Elements = { "crystal", "ice" }, TypeLabel = "Cristal / hielo",
		System = "infinity", Base = 200, Scale = 1.1, RotationSpeed = 12, OrbitSpeed = 0.9,
		Description = "Planeta de cristal azul y blanco con fragmentos helados y brillo interno.",
		Visual = { Texture = "cryostar", Color = rgb(170, 225, 255), Material = "Ice", Atmosphere = rgb(200, 240, 255),
			Glow = rgb(170, 225, 255), Particles = "frost",
			Shards = { Count = 20, Color = rgb(205, 240, 255), Length = 0.7 },
			Rings = { { Inner = 1.7, Outer = 1.78, Color = rgb(210, 240, 255), Tilt = 16, Alpha = 0.1, Line = true } } },
		Secret = { Hint = "Tres mundos de hielo o cristal girando juntos en un mismo sistema despiertan algo frío...",
			Condition = { Type = "ElementsInSystem", Elements = { "ice", "crystal" }, Count = 3 } },
	},
	{
		Id = "volcanis", Name = "Volcanis", Rarity = "secret", Elements = { "fire" }, TypeLabel = "Volcánico",
		System = "infinity", Base = 220, Scale = 1.15, RotationSpeed = 14, OrbitSpeed = 1.0,
		Description = "Mundo volcánico avanzado con anillos ardientes y actividad extrema.",
		Visual = { Texture = "volcanis", Color = rgb(255, 90, 20), Material = "CrackedLava", Atmosphere = rgb(255, 110, 30),
			Glow = rgb(255, 100, 30), Particles = "embers",
			Rings = { { Inner = 1.45, Outer = 2.05, Color = rgb(255, 140, 50), Tilt = -16, Alpha = 0.3 } } },
		Secret = { Hint = "El fuego llama al fuego: reúne tres mundos de fuego en un mismo sistema, uno de ellos evolucionado.",
			Condition = { Type = "ElementsInSystem", Elements = { "fire" }, Count = 3, RequireEvolved = true } },
	},
	{
		Id = "zenith", Name = "Zenith", Rarity = "secret", Elements = { "energy" }, TypeLabel = "Energía",
		System = "infinity", Base = 250, Scale = 1.2, RotationSpeed = 20, OrbitSpeed = 0.85,
		Description = "Planeta cian de energía pura, atmósfera brillante y anillos delicados.",
		Visual = { Texture = "zenith", Color = rgb(60, 240, 220), Material = "Neon", Atmosphere = rgb(120, 255, 235),
			Glow = rgb(90, 255, 230), Particles = "energy", Emissive = true,
			Rings = { { Inner = 1.5, Outer = 1.57, Color = rgb(170, 255, 240), Tilt = 20, Alpha = 0.05, Line = true } } },
		Secret = { Hint = "Solo quien haya catalogado todos los mundos conocidos verá el cénit.",
			Condition = { Type = "DiscoverAllNonSecret" } },
	},
}

Planets.List = LIST
Planets.ById = {}
Planets.BySystem = {}
Planets.ByRarity = {}

for index, def in ipairs(LIST) do
	def.Order = index
	def.ModelKey = def.ModelKey or def.Id
	def.CollectionValue = def.CollectionValue or def.Base * 10
	def.VariantRules = def.VariantRules or ALL_VARIANTS
	Planets.ById[def.Id] = def
	if not Planets.BySystem[def.System] then Planets.BySystem[def.System] = {} end
	table.insert(Planets.BySystem[def.System], def)
	if not Planets.ByRarity[def.Rarity] then Planets.ByRarity[def.Rarity] = {} end
	table.insert(Planets.ByRarity[def.Rarity], def)
end

function Planets.get(id)
	return Planets.ById[id]
end

function Planets.hasElement(def, element)
	for _, e in ipairs(def.Elements) do
		if e == element then return true end
	end
	return false
end

-- Nombre visible de una instancia (evolucion y variante incluidas)
function Planets.displayName(def, evolved)
	if evolved then return def.Name .. " Prime" end
	return def.Name
end

-- Planetas no secretos de un sistema (los que cuentan para "completar la coleccion")
function Planets.collectionOf(systemId)
	local out = {}
	for _, def in ipairs(Planets.BySystem[systemId] or {}) do
		if def.Rarity ~= "secret" then table.insert(out, def) end
	end
	return out
end

Planets.ElementNames = {
	rocky = "Rocoso", desert = "Desértico", ice = "Hielo", gas = "Gaseoso", fire = "Fuego", crystal = "Cristal",
	celestial = "Celestial", cosmic = "Cósmico", dark = "Oscuro", quantum = "Cuántico", gravity = "Gravitacional",
	energy = "Energía", moon = "Luna",
}

return Planets
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX16">
          <Properties>
            <string name="Name">RarityDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- RarityDefinitions: rarezas de planetas. La rareza se comunica con color + texto + icono (accesibilidad).
local Rarities = {}

Rarities.Order = { "common", "uncommon", "rare", "epic", "legendary", "mythic", "secret" }

Rarities.ById = {
	common = { Id = "common", Name = "Común", Order = 1, Color = Color3.fromRGB(120, 200, 255), Icon = "⚪", SellMult = 1 },
	uncommon = { Id = "uncommon", Name = "Poco común", Order = 2, Color = Color3.fromRGB(110, 230, 120), Icon = "🟢", SellMult = 1.5 },
	rare = { Id = "rare", Name = "Raro", Order = 3, Color = Color3.fromRGB(70, 140, 255), Icon = "🔵", SellMult = 2.5 },
	epic = { Id = "epic", Name = "Épico", Order = 4, Color = Color3.fromRGB(190, 90, 255), Icon = "🟣", SellMult = 5 },
	legendary = { Id = "legendary", Name = "Legendario", Order = 5, Color = Color3.fromRGB(255, 190, 50), Icon = "⭐", SellMult = 12 },
	mythic = { Id = "mythic", Name = "Mítico", Order = 6, Color = Color3.fromRGB(255, 80, 200), Icon = "💎", SellMult = 30 },
	secret = { Id = "secret", Name = "Secreto", Order = 7, Color = Color3.fromRGB(255, 70, 70), Icon = "🔥", SellMult = 80 },
}

function Rarities.get(id)
	return Rarities.ById[id]
end

function Rarities.atLeast(id, minId)
	return Rarities.ById[id].Order >= Rarities.ById[minId].Order
end

return Rarities
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX17">
          <Properties>
            <string name="Name">SynergyDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- SynergyDefinitions: condiciones y bonificaciones declarativas.
-- Regla: las sinergias se evaluan POR SISTEMA sobre los planetas colocados en el; sus bonos se suman
-- entre si (aditivo) y multiplican la produccion de ese sistema. Sin acumulaciones ambiguas: cada
-- sinergia se aplica como maximo una vez por sistema.
local Synergies = {}

Synergies.List = {
	{ Id = "fire_duo", Name = "Dúo de Fuego", Bonus = 0.10, Description = "2 planetas de fuego en el mismo sistema.",
		Condition = { Type = "Element", Element = "fire", Count = 2 } },
	{ Id = "ice_trio", Name = "Trío Glacial", Bonus = 0.15, Description = "3 planetas de hielo o cristal en el mismo sistema.",
		Condition = { Type = "AnyElement", Elements = { "ice", "crystal" }, Count = 3 } },
	{ Id = "rocky_trio", Name = "Cinturón Rocoso", Bonus = 0.10, Description = "3 planetas rocosos o desérticos.",
		Condition = { Type = "AnyElement", Elements = { "rocky", "desert" }, Count = 3 } },
	{ Id = "gas_duo", Name = "Gigantes Gemelos", Bonus = 0.10, Description = "2 gigantes gaseosos.",
		Condition = { Type = "Element", Element = "gas", Count = 2 } },
	{ Id = "legend_moons", Name = "Corte Lunar", Bonus = 0.20, Description = "1 planeta Legendario (o superior) con 2 lunas.",
		Condition = { Type = "RarityWithElement", Rarity = "legendary", Element = "moon", Count = 2 } },
	{ Id = "dark_trio", Name = "Eclipse Total", Bonus = 0.18, Description = "3 mundos oscuros.",
		Condition = { Type = "Element", Element = "dark", Count = 3 } },
	{ Id = "celestial_trio", Name = "Coro Celestial", Bonus = 0.20, Description = "3 mundos celestiales.",
		Condition = { Type = "Element", Element = "celestial", Count = 3 } },
	{ Id = "quantum_link", Name = "Entrelazamiento", Bonus = 0.15, Description = "2 mundos cuánticos o cósmicos.",
		Condition = { Type = "AnyElement", Elements = { "quantum", "cosmic" }, Count = 2 } },
	{ Id = "diversity", Name = "Biodiversidad Cósmica", Bonus = 0.15, Description = "5 elementos distintos en el mismo sistema.",
		Condition = { Type = "DistinctElements", Count = 5 } },
	{ Id = "full_orbit", Name = "Órbitas Completas", Bonus = 0.25, Description = "Los 8 slots del sistema ocupados.",
		Condition = { Type = "FullOrbit" } },
	{ Id = "variant_trio", Name = "Constelación Brillante", Bonus = 0.15, Description = "3 planetas con variante (Shiny, Golden, Rainbow o Cosmic).",
		Condition = { Type = "Variants", Count = 3 } },
	{ Id = "prime_duo", Name = "Linaje Prime", Bonus = 0.20, Description = "2 planetas evolucionados (Prime).",
		Condition = { Type = "Evolved", Count = 2 } },
}

Synergies.ById = {}
for _, s in ipairs(Synergies.List) do
	Synergies.ById[s.Id] = s
end

return Synergies
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX18">
          <Properties>
            <string name="Name">UpgradeDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- UpgradeDefinitions: mejoras compradas con Energy (se reinician al ascender) y con Cosmic Cores (permanentes).
-- Cost(level) = coste de pasar del nivel `level` al siguiente. Effect(level) = efecto total con ese nivel.
local Upgrades = {}

local function geometric(base, growth)
	return function(level)
		return math.floor(base * growth ^ level)
	end
end

local function linear(base, step)
	return function(level)
		return base + step * level
	end
end

Upgrades.List = {
	---------------------------------------------------------------- Energy
	{ Id = "reactor", Name = "Reactor Estelar", Currency = "Energy", MaxLevel = 100, Icon = "⚡",
		Description = "+10% de producción total por nivel.",
		Cost = geometric(400, 1.32), Effect = function(level) return 1 + 0.10 * level end, EffectKind = "mult" },
	{ Id = "efficiency", Name = "Eficiencia de Cápsulas", Currency = "Energy", MaxLevel = 10, Icon = "💊",
		Description = "-3% al precio de todas las cápsulas por nivel.",
		Cost = geometric(2000, 2.2), Effect = function(level) return 1 - 0.03 * level end, EffectKind = "discount" },
	{ Id = "hangar", Name = "Hangar Orbital", Currency = "Energy", MaxLevel = 10, Icon = "🎒",
		Description = "+25 espacios de inventario por nivel.",
		Cost = geometric(5000, 2), Effect = function(level) return 25 * level end, EffectKind = "flat" },
	{ Id = "battery", Name = "Baterías Offline", Currency = "Energy", MaxLevel = 8, Icon = "🔋",
		Description = "+1 hora de ganancias sin conexión por nivel.",
		Cost = geometric(10000, 3), Effect = function(level) return level end, EffectKind = "hours" },
	{ Id = "resonance", Name = "Resonancia Orbital", Currency = "Energy", MaxLevel = 10, Icon = "🔗",
		Description = "+10% de potencia a todas las sinergias por nivel.",
		Cost = geometric(25000, 2.5), Effect = function(level) return 1 + 0.10 * level end, EffectKind = "mult" },
	---------------------------------------------------------------- Cosmic Cores (permanentes)
	{ Id = "core_power", Name = "Núcleo de Poder", Currency = "Cores", MaxLevel = 20, Icon = "💠",
		Description = "+25% de producción permanente por nivel.",
		Cost = linear(2, 1), Effect = function(level) return 1 + 0.25 * level end, EffectKind = "mult" },
	{ Id = "core_luck", Name = "Suerte Cósmica", Currency = "Cores", MaxLevel = 10, Icon = "🍀",
		Description = "+15% de probabilidad de variantes por nivel (las probabilidades mostradas se actualizan).",
		Cost = linear(3, 2), Effect = function(level) return 1 + 0.15 * level end, EffectKind = "mult" },
	{ Id = "core_offline", Name = "Colector Nocturno", Currency = "Cores", MaxLevel = 5, Icon = "🌙",
		Description = "+10% de eficiencia de ganancias sin conexión por nivel.",
		Cost = linear(2, 1), Effect = function(level) return 0.10 * level end, EffectKind = "add" },
	{ Id = "core_start", Name = "Legado Estelar", Currency = "Cores", MaxLevel = 5, Icon = "🌟",
		Description = "Multiplica x10 por nivel la Energy inicial tras cada ascensión.",
		Cost = linear(2, 2), Effect = function(level) return 10 ^ level end, EffectKind = "mult" },
	{ Id = "core_multi", Name = "Apertura Múltiple", Currency = "Cores", MaxLevel = 2, Icon = "🎰",
		Description = "Nivel 1: abre 3 cápsulas a la vez. Nivel 2: abre 10 a la vez.",
		Cost = linear(4, 6), Effect = function(level) return level end, EffectKind = "level" },
}

Upgrades.ById = {}
for index, u in ipairs(Upgrades.List) do
	u.Order = index
	Upgrades.ById[u.Id] = u
end

function Upgrades.get(id)
	return Upgrades.ById[id]
end

function Upgrades.level(profile, id)
	return (profile.Upgrades and profile.Upgrades[id]) or 0
end

function Upgrades.effect(profile, id)
	local def = Upgrades.ById[id]
	return def.Effect(Upgrades.level(profile, id))
end

return Upgrades
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX19">
          <Properties>
            <string name="Name">VariantDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- VariantDefinitions: variantes visuales. La variante es una dimension distinta de la rareza del planeta.
local Variants = {}

Variants.Order = { "none", "shiny", "golden", "rainbow", "cosmic" }

Variants.ById = {
	none = { Id = "none", Name = "Normal", Chance = 0, Multiplier = 1, Color = Color3.fromRGB(200, 215, 235), Icon = "" },
	shiny = { Id = "shiny", Name = "Shiny", Chance = 0.04, Multiplier = 1.5, Color = Color3.fromRGB(190, 240, 255), Icon = "✨",
		Description = "Brillo especial y reflejo marcado." },
	golden = { Id = "golden", Name = "Golden", Chance = 0.02, Multiplier = 2, Color = Color3.fromRGB(255, 205, 70), Icon = "🟡",
		Description = "Superficie dorada con partículas cálidas." },
	rainbow = { Id = "rainbow", Name = "Rainbow", Chance = 0.005, Multiplier = 3.5, Color = Color3.fromRGB(255, 120, 220), Icon = "🌈",
		Description = "Iridiscencia multicolor de transición suave." },
	cosmic = { Id = "cosmic", Name = "Cosmic", Chance = 0.001, Multiplier = 6, Color = Color3.fromRGB(150, 110, 255), Icon = "🌌",
		Description = "Textura galáctica con partículas cósmicas." },
}

function Variants.get(id)
	return Variants.ById[id or "none"] or Variants.ById.none
end

-- Probabilidades reales de variante dado un multiplicador de suerte (mejoras + evento).
-- Devuelve tabla { variantId = probabilidad }, incluyendo "none"; siempre suma 1.
function Variants.chances(luckMultiplier)
	luckMultiplier = luckMultiplier or 1
	local out = {}
	local total = 0
	for _, id in ipairs(Variants.Order) do
		if id ~= "none" then
			local c = math.min(Variants.ById[id].Chance * luckMultiplier, 0.25)
			out[id] = c
			total = total + c
		end
	end
	out.none = 1 - total
	return out
end

-- Elige una variante a partir de un numero aleatorio uniforme en [0, 1).
function Variants.roll(randomUnit, luckMultiplier)
	local chances = Variants.chances(luckMultiplier)
	local acc = 0
	-- se recorre de la mas rara a la mas comun
	for i = #Variants.Order, 2, -1 do
		local id = Variants.Order[i]
		acc = acc + chances[id]
		if randomUnit < acc then return id end
	end
	return "none"
end

return Variants
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX20">
        <Properties>
          <string name="Name">Defs</string>
          <ProtectedString name="Source"><![CDATA[-- Defs: punto unico de acceso a todas las definiciones compartidas.
local Definitions = script.Parent.Definitions

return {
	Config = require(script.Parent.Config),
	Rarities = require(Definitions.RarityDefinitions),
	Variants = require(Definitions.VariantDefinitions),
	Planets = require(Definitions.PlanetDefinitions),
	Capsules = require(Definitions.CapsuleDefinitions),
	Galaxy = require(Definitions.GalaxyDefinitions),
	Synergies = require(Definitions.SynergyDefinitions),
	Upgrades = require(Definitions.UpgradeDefinitions),
	Ascension = require(Definitions.AscensionDefinitions),
	Missions = require(Definitions.MissionDefinitions),
	Events = require(Definitions.EventDefinitions),
	Cosmetics = require(Definitions.CosmeticDefinitions),
}
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX21">
        <Properties>
          <string name="Name">PlanetVisual</string>
          <ProtectedString name="Source"><![CDATA[-- PlanetVisual: construye el modelo 3D de un planeta a partir de sus datos (PlanetDefinitions.Visual).
-- Un solo constructor para todo el catalogo: superficie texturizada (si hay assets), atmosfera,
-- anillos, cristales, particulas, variantes (Shiny/Golden/Rainbow/Cosmic) y forma evolucionada (Prime).
-- Se usa en el mundo (orbitas, Hub) y en ViewportFrames (inventario, capsulas, coleccion).
local Defs = require(script.Parent.Defs)
local Assets = require(script.Parent.Assets)
local Build = require(script.Parent.Util.Build)
local Config = Defs.Config

local PlanetVisual = {}

local VARIANT_TINT = {
	golden = Vector3.new(1, 0.8, 0.36),
	shiny = Vector3.new(1, 1, 1),
}

local function v3(color)
	return Vector3.new(color.R, color.G, color.B)
end

local function material(name)
	local ok, item = pcall(function()
		return Enum.Material[name]
	end)
	if ok and item then return item end
	return Enum.Material.SmoothPlastic
end

-- Radio en studs de una instancia
function PlanetVisual.radius(def, evolved, override)
	local r = override or (Config.World.PlanetBaseRadius * def.Scale)
	if evolved then r = r * Config.Evolution.ScaleMultiplier end
	return r
end

-- Factor de extension maxima (anillos incluidos) respecto al radio; sirve para encuadrar la camara
function PlanetVisual.extent(def, evolved)
	local e = 1.15
	local visual = def.Visual
	if visual.Rings then
		for _, ring in ipairs(visual.Rings) do
			if ring.Outer > e then e = ring.Outer end
		end
	end
	if visual.Shards then e = math.max(e, 1 + visual.Shards.Length * 1.1) end
	if evolved then e = e + 0.4 end
	return e
end

local function sphereMesh(part, radius, textureUrl, tint)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = Assets.url(Assets.SphereMesh)
	mesh.TextureId = textureUrl
	local s = radius / Assets.SphereMeshRadius
	mesh.Scale = Vector3.new(s, s, s)
	mesh.VertexColor = tint or Vector3.new(1, 1, 1)
	mesh.Parent = part
	return mesh
end

local function fibonacci(i, n)
	local y = 1 - (i - 0.5) / n * 2
	local r = math.sqrt(math.max(0, 1 - y * y))
	local a = i * 2.399963
	return Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
end

-- opts: Radius (studs), Lite (para ViewportFrame: sin luces/particulas), Static (sin particulas),
--       Distant (planeta de fondo), Hologram (tinte holografico), Welded (piezas soldadas al cuerpo
--       para moverlo con un solo CFrame)
function PlanetVisual.build(planetId, variant, evolved, opts)
	opts = opts or {}
	variant = variant or "none"
	local def = Defs.Planets.ById[planetId]
	local visual = def.Visual
	local radius = PlanetVisual.radius(def, evolved, opts.Radius)
	local lite = opts.Lite == true
	local effects = not lite and not opts.Static and not opts.Distant
	local rng = Random.new(def.Order * 977 + 13)

	local model = Instance.new("Model")
	model.Name = "Planet_" .. planetId
	model:SetAttribute("PlanetId", planetId)
	model:SetAttribute("Variant", variant)
	model:SetAttribute("Evolved", evolved == true)
	model:SetAttribute("Radius", radius)

	local baseColor = visual.Color
	local atmosphereColor = visual.Atmosphere
	local tint = visual.Tint and v3(visual.Tint) or Vector3.new(1, 1, 1)
	if variant == "golden" then
		baseColor = Color3.fromRGB(240, 190, 80)
		atmosphereColor = Color3.fromRGB(255, 215, 110)
		tint = VARIANT_TINT.golden
	elseif variant == "cosmic" then
		atmosphereColor = Color3.fromRGB(170, 110, 255)
	elseif variant == "shiny" then
		atmosphereColor = atmosphereColor or Color3.fromRGB(220, 240, 255)
	elseif variant == "rainbow" then
		atmosphereColor = atmosphereColor or Color3.fromRGB(255, 255, 255)
		model:SetAttribute("Rainbow", true)
	end
	if opts.Hologram then
		tint = Vector3.new(0.62, 0.9, 1)
		atmosphereColor = Color3.fromRGB(90, 220, 255)
	end

	local textureUrl = Assets.texture(visual.Texture)
	local useMesh = Assets.SphereMesh ~= 0 and textureUrl ~= ""

	-- cuerpo: esfera con material integrado (siempre visible aunque un asset no cargue)
	local body = Build.ball({ Position = Vector3.zero, Radius = useMesh and radius * 0.97 or radius }, {
		Name = "Body", Color = baseColor, Material = material(visual.Material), CanCollide = false, CanTouch = false, Parent = model,
	})
	if variant == "shiny" then body.Reflectance = 0.35 end
	if visual.Emissive then body.Material = Enum.Material.Neon end
	model.PrimaryPart = body

	local parts = {}
	local function add(part)
		table.insert(parts, part)
		part.Parent = model
		return part
	end

	if useMesh then
		local surface = Build.decor({ Name = "Surface", Size = Vector3.new(1, 1, 1), CFrame = CFrame.identity, Color = baseColor })
		-- los mundos emisivos dejan ver el nucleo de neon a traves de una superficie semitransparente
		if visual.Emissive then surface.Transparency = 0.3 end
		if variant == "shiny" then surface.Reflectance = 0.3 end
		if opts.Hologram then surface.Transparency = 0.12 end
		sphereMesh(surface, radius, textureUrl, tint)
		add(surface)
		if variant == "cosmic" and Assets.texture("cosmic") ~= "" then
			local overlay = Build.decor({ Name = "CosmicOverlay", Size = Vector3.new(1, 1, 1), CFrame = CFrame.identity, Transparency = 0.45 })
			sphereMesh(overlay, radius * 1.02, Assets.texture("cosmic"), Vector3.new(0.9, 0.7, 1))
			add(overlay)
		end
		if visual.Clouds and Assets.texture("clouds") ~= "" then
			local clouds = Build.decor({ Name = "Clouds", Size = Vector3.new(1, 1, 1), CFrame = CFrame.identity, Transparency = 0.25 })
			sphereMesh(clouds, radius * 1.025, Assets.texture("clouds"), Vector3.new(1, 1, 1))
			add(clouds)
		end
	end

	-- atmosfera
	if atmosphereColor and not opts.NoAtmosphere then
		local shell = Build.ball({ Position = Vector3.zero, Radius = radius * (opts.Distant and 1.04 or 1.09) }, {
			Name = "Atmosphere", Color = atmosphereColor, CanCollide = false, CanQuery = false, CanTouch = false,
		})
		if lite or opts.Distant then
			shell.Material = Enum.Material.Neon
			shell.Transparency = opts.Distant and 0.9 or 0.86
		else
			shell.Material = Enum.Material.ForceField
			shell.Transparency = (variant == "shiny" or opts.Hologram) and 0.05 or 0.3
		end
		add(shell)
	end

	-- relieve rocoso
	if visual.Bumps and not opts.Distant then
		for i = 1, visual.Bumps do
			local dir = fibonacci(i, visual.Bumps)
			local r = radius * rng:NextNumber(0.2, 0.34)
			add(Build.ball({ Position = dir * (radius * 0.84), Radius = r }, {
				Name = "Bump", Color = baseColor:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.25)), Material = material(visual.Material),
				CanCollide = false, CanQuery = false, CanTouch = false,
			}))
		end
	end

	-- cristales
	if visual.Shards and not opts.Distant then
		local shards = visual.Shards
		local shardColor = variant == "golden" and Color3.fromRGB(255, 215, 120) or shards.Color
		for i = 1, shards.Count do
			local dir = fibonacci(i, shards.Count)
			local length = radius * shards.Length * rng:NextNumber(0.7, 1.35)
			local width = length * rng:NextNumber(0.28, 0.4)
			local pos = dir * (radius * 0.8 + length * 0.42)
			local cf = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(math.rad(-90), rng:NextNumber(0, math.pi), 0)
			add(Build.decor({
				Name = "Shard", Size = Vector3.new(width, length, width), CFrame = cf, Color = shardColor,
				Material = (i % 3 == 0) and Enum.Material.Neon or Enum.Material.Glass, Transparency = (i % 3 == 0) and 0.1 or 0.2,
				Reflectance = 0.25,
			}))
		end
	end

	-- anillos
	local maxOuter = 1.15
	if visual.Rings then
		for index, ring in ipairs(visual.Rings) do
			if ring.Outer > maxOuter then maxOuter = ring.Outer end
			local ringColor = variant == "golden" and Color3.fromRGB(255, 220, 130) or ring.Color
			local cf = CFrame.Angles(math.rad(ring.Tilt or 0), 0, math.rad((ring.Tilt or 0) * 0.3))
			if ring.Line then
				local mid = (ring.Inner + ring.Outer) / 2 * radius
				local width = math.max(0.12, (ring.Outer - ring.Inner) * radius)
				for _, seg in ipairs(Build.ring({ CFrame = cf, Radius = mid, Width = width, Height = math.max(0.1, radius * 0.035),
					Segments = opts.Distant and 20 or 28 }, { Name = "RingLine" .. index, Color = ringColor, Material = Enum.Material.Neon,
					Transparency = ring.Alpha or 0.1 })) do
					add(seg)
				end
			else
				local hasImage = Assets.image("ring") ~= ""
				local t = math.min(0.9, (ring.Alpha or 0.3) + (hasImage and 0.5 or 0.3))
				local inner = ring.Inner + (ring.Outer - ring.Inner) * 0.55
				add(Build.cylinder({ CFrame = cf, Radius = inner * radius, Height = math.max(0.08, radius * 0.03) }, {
					Name = "RingBandInner", Color = ringColor, Material = Enum.Material.Neon, Transparency = t,
					CanCollide = false, CanQuery = false, CanTouch = false,
				}))
				add(Build.cylinder({ CFrame = cf, Radius = ring.Outer * radius, Height = math.max(0.06, radius * 0.02) }, {
					Name = "RingBandOuter", Color = ringColor, Material = Enum.Material.Neon, Transparency = math.min(0.92, t + 0.18),
					CanCollide = false, CanQuery = false, CanTouch = false,
				}))
				if hasImage and not lite then
					local plate = Build.decor({ Name = "RingPlate", Size = Vector3.new(ring.Outer * radius * 2, 0.05, ring.Outer * radius * 2),
						CFrame = cf, Transparency = 1 })
					for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Bottom }) do
						local decal = Instance.new("Decal")
						decal.Face = face
						decal.Texture = Assets.image("ring")
						decal.Color3 = ringColor
						decal.Transparency = 0.15
						decal.Parent = plate
					end
					add(plate)
				end
			end
		end
	end

	-- forma evolucionada: corona exterior
	if evolved then
		local crownRadius = (maxOuter + 0.32) * radius
		for _, seg in ipairs(Build.ring({ CFrame = CFrame.Angles(math.rad(38), 0, math.rad(-20)), Radius = crownRadius,
			Width = math.max(0.14, radius * 0.045), Height = math.max(0.14, radius * 0.045), Segments = 30 },
			{ Name = "PrimeCrown", Color = Color3.fromRGB(255, 240, 200), Material = Enum.Material.Neon, Transparency = 0.05 })) do
			add(seg)
		end
	end

	-- luces y particulas (solo en el mundo)
	if effects then
		local glow = visual.Glow or (variant ~= "none" and atmosphereColor) or nil
		if glow then
			Build.light(body, glow, math.min(60, radius * 5), 1.4)
		end
		local kind = visual.Particles
		local presets = {
			embers = { Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 70, 20), 9, 2.2 },
			frost = { Color3.fromRGB(220, 245, 255), Color3.fromRGB(140, 210, 255), 7, 1.2 },
			stardust = { Color3.fromRGB(170, 150, 255), Color3.fromRGB(110, 170, 255), 8, 1.4 },
			vortex = { Color3.fromRGB(210, 130, 255), Color3.fromRGB(120, 50, 230), 16, 3 },
			energy = { Color3.fromRGB(120, 255, 240), Color3.fromRGB(255, 110, 230), 10, 2.6 },
		}
		local function emit(c0, c1, rate, speed, name)
			local emitter = Build.particles(body, {
				Name = name, Color = ColorSequence.new(c0, c1), Rate = rate, Speed = NumberRange.new(speed * 0.4, speed),
				Lifetime = NumberRange.new(1.2, 2.4), Size = Build.sizeSeq(radius * 0.16), RotSpeed = NumberRange.new(-90, 90),
			})
			emitter.Shape = Enum.ParticleEmitterShape.Sphere
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
			return emitter
		end
		if kind and presets[kind] then
			local p = presets[kind]
			emit(p[1], p[2], p[3], p[4], "Aura")
		end
		if variant == "shiny" then
			emit(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 235, 255), 8, 1.5, "VariantFx")
		elseif variant == "golden" then
			emit(Color3.fromRGB(255, 225, 130), Color3.fromRGB(255, 180, 60), 8, 1.2, "VariantFx")
		elseif variant == "rainbow" then
			emit(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255), 9, 1.5, "VariantFx")
		elseif variant == "cosmic" then
			emit(Color3.fromRGB(190, 140, 255), Color3.fromRGB(90, 120, 255), 12, 1.8, "VariantFx")
		end
		if evolved then
			emit(Color3.fromRGB(255, 245, 210), Color3.fromRGB(255, 215, 120), 6, 2.4, "PrimeFx")
		end
	end

	if opts.Welded then
		for _, part in ipairs(parts) do
			part.Anchored = false
			part.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = body
			weld.Part1 = part
			weld.Parent = part
		end
	end
	return model
end

-- Monta un planeta dentro de un ViewportFrame con su camara. Devuelve el modelo y la camara.
function PlanetVisual.mount(viewport, planetId, variant, evolved)
	local def = Defs.Planets.ById[planetId]
	local model = PlanetVisual.build(planetId, variant, evolved, { Lite = true, Radius = 4 })
	model:PivotTo(CFrame.Angles(math.rad(18), math.rad(30), math.rad(-14)))
	model.Parent = viewport
	local camera = Instance.new("Camera")
	local extent = PlanetVisual.extent(def, evolved) * 4 * (evolved and Config.Evolution.ScaleMultiplier or 1)
	camera.FieldOfView = 30
	camera.CFrame = CFrame.lookAt(Vector3.new(0, extent * 0.9, extent * 3.6), Vector3.zero)
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	viewport.Ambient = Color3.fromRGB(150, 150, 170)
	viewport.LightColor = Color3.fromRGB(255, 250, 240)
	viewport.LightDirection = Vector3.new(-1, -0.8, -1)
	return model, camera
end

return PlanetVisual
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX22">
        <Properties>
          <string name="Name">Profile</string>
          <ProtectedString name="Source"><![CDATA[-- Profile: plantilla del perfil persistente del jugador y reconciliacion/migracion de datos.
-- Solo usa claves string (compatibles con DataStore y RemoteEvents).
local Defs = require(script.Parent.Defs)
local Config = Defs.Config

local Profile = {}

local function deepCopy(value)
	if type(value) ~= "table" then return value end
	local out = {}
	for k, v in pairs(value) do
		out[k] = deepCopy(v)
	end
	return out
end
Profile.deepCopy = deepCopy

function Profile.default(now)
	return {
		Version = Config.Data.Version,
		Energy = Config.Economy.StartingEnergy,
		Stardust = 0,
		Cores = 0,
		RunEnergy = 0,
		TotalEnergy = 0,
		Planets = {},
		NextUid = 1,
		Placed = { solar = {} },
		Slots = { solar = Defs.Galaxy.ById.solar.FreeSlots },
		Systems = { solar = true },
		ActiveSystem = "solar",
		Upgrades = {},
		Ascensions = 0,
		Discovered = {},
		CollectionsClaimed = {},
		SecretsFound = {},
		Missions = { DailyKey = 0, Daily = {}, WeeklyKey = 0, Weekly = {}, EventKey = 0, EventProgress = 0, EventClaimed = false },
		Stats = {
			CapsulesOpened = 0, PlanetsObtained = 0, RaresObtained = 0, Visits = 0, Evolutions = 0, Trades = 0,
			PlayTime = 0, MeteorsCollected = 0, PlanetsSold = 0, BestRate = 0, UpgradesBought = 0,
		},
		Settings = deepCopy(Config.DefaultSettings),
		Tutorial = 1,
		Cosmetics = {
			Owned = { orbit_system = true, aura_default = true },
			Equipped = deepCopy(Defs.Cosmetics.Defaults),
		},
		Created = now or 0,
		LastSave = 0,
	}
end

-- Rellena claves que falten (perfiles antiguos) sin tocar los valores existentes.
local function fill(target, template)
	for k, v in pairs(template) do
		if target[k] == nil then
			target[k] = deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" then
			-- solo se rellenan sub-tablas "de esquema"; las colecciones dinamicas se dejan como estan
			if k == "Stats" or k == "Settings" or k == "Missions" or k == "Cosmetics" or k == "Equipped" or k == "Owned" then
				fill(target[k], v)
			end
		end
	end
end

local function isFiniteNumber(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- Migraciones por version. migrations[n] convierte un perfil de la version n a la n+1.
local migrations = {}

-- Valida y repara un perfil cargado. Devuelve el perfil listo para usar.
function Profile.reconcile(data, now)
	if type(data) ~= "table" then
		return Profile.default(now)
	end
	local version = tonumber(data.Version) or 1
	while version < Config.Data.Version do
		local step = migrations[version]
		if step then step(data) end
		version = version + 1
	end
	data.Version = Config.Data.Version
	fill(data, Profile.default(now))

	-- monedas: numeros finitos, no negativos, con tope
	for _, key in ipairs({ "Energy", "Stardust", "Cores", "RunEnergy", "TotalEnergy" }) do
		local v = data[key]
		if not isFiniteNumber(v) or v < 0 then v = 0 end
		data[key] = math.min(v, Config.Economy.MaxCurrency)
	end
	if not isFiniteNumber(data.Ascensions) or data.Ascensions < 0 then data.Ascensions = 0 end
	data.Ascensions = math.floor(data.Ascensions)

	-- planetas: descartar instancias con definicion desconocida
	local maxUid = 0
	for uid, inst in pairs(data.Planets) do
		local def = type(inst) == "table" and Defs.Planets.ById[inst.Id]
		if not def then
			data.Planets[uid] = nil
		else
			if not Defs.Variants.ById[inst.V or "none"] then inst.V = "none" end
			inst.V = inst.V or "none"
			inst.E = inst.E == true
			inst.L = inst.L == true
			local n = tonumber(string.match(uid, "^p(%d+)$"))
			if n and n > maxUid then maxUid = n end
		end
	end
	if not isFiniteNumber(data.NextUid) or data.NextUid <= maxUid then data.NextUid = maxUid + 1 end

	-- sistemas y slots
	data.Systems.solar = true
	for _, sysId in ipairs(Defs.Galaxy.Order) do
		local def = Defs.Galaxy.ById[sysId]
		if data.Systems[sysId] then
			if type(data.Placed[sysId]) ~= "table" then data.Placed[sysId] = {} end
			local slots = tonumber(data.Slots[sysId]) or def.FreeSlots
			data.Slots[sysId] = math.max(def.FreeSlots, math.min(Config.Economy.SlotsPerSystem, math.floor(slots)))
		else
			data.Systems[sysId] = nil
			data.Placed[sysId] = nil
			data.Slots[sysId] = nil
		end
	end
	if not data.Systems[data.ActiveSystem] then data.ActiveSystem = "solar" end

	-- colocados: cada instancia existe, solo esta en un slot y el slot esta desbloqueado
	local seen = {}
	for sysId, slots in pairs(data.Placed) do
		for slotKey, uid in pairs(slots) do
			local index = tonumber(string.match(slotKey, "^s(%d+)$"))
			if not index or index < 1 or index > (data.Slots[sysId] or 0) or not data.Planets[uid] or seen[uid] then
				slots[slotKey] = nil
			else
				seen[uid] = true
			end
		end
	end

	-- mejoras: niveles validos
	for id, level in pairs(data.Upgrades) do
		local def = Defs.Upgrades.ById[id]
		if not def or not isFiniteNumber(level) then
			data.Upgrades[id] = nil
		else
			data.Upgrades[id] = math.max(0, math.min(def.MaxLevel, math.floor(level)))
		end
	end

	-- cosmeticos equipados validos
	for category, defaultId in pairs(Defs.Cosmetics.Defaults) do
		local id = data.Cosmetics.Equipped[category]
		if not id or not Defs.Cosmetics.ById[id] or not data.Cosmetics.Owned[id] then
			data.Cosmetics.Equipped[category] = defaultId
		end
	end

	if not isFiniteNumber(data.Tutorial) then data.Tutorial = 1 end
	return data
end

return Profile
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX23">
        <Properties>
          <string name="Name">Progression</string>
          <ProtectedString name="Source"><![CDATA[-- Progression: funciones puras sobre un perfil (produccion, sinergias, requisitos, costes).
-- Se usa en el servidor (autoridad) y en el cliente (solo para mostrar previsiones y progreso).
local Defs = require(script.Parent.Defs)
local Format = require(script.Parent.Util.Format)
local Config = Defs.Config
local Planets, Galaxy, Upgrades, Variants, Rarities = Defs.Planets, Defs.Galaxy, Defs.Upgrades, Defs.Variants, Defs.Rarities

local Progression = {}

---------------------------------------------------------------- inventario
function Progression.inventoryCount(profile)
	local n = 0
	for _ in pairs(profile.Planets) do
		n = n + 1
	end
	return n
end

function Progression.inventoryCapacity(profile)
	return Config.Economy.InventoryBaseCapacity + Upgrades.effect(profile, "hangar")
end

-- Devuelve systemId, slotKey si la instancia esta colocada
function Progression.findPlaced(profile, uid)
	for sysId, slots in pairs(profile.Placed) do
		for slotKey, placedUid in pairs(slots) do
			if placedUid == uid then return sysId, slotKey end
		end
	end
	return nil, nil
end

function Progression.placedCount(profile, systemId)
	local n = 0
	local slots = profile.Placed[systemId]
	if slots then
		for _ in pairs(slots) do
			n = n + 1
		end
	end
	return n
end

function Progression.countOwned(profile, predicate)
	local n = 0
	for _, inst in pairs(profile.Planets) do
		if predicate(inst, Planets.ById[inst.Id]) then n = n + 1 end
	end
	return n
end

---------------------------------------------------------------- descubrimientos
function Progression.discoveryKey(planetId, variant, evolved)
	if evolved then return planetId .. "#evo" end
	if variant and variant ~= "none" then return planetId .. "#" .. variant end
	return planetId
end

function Progression.discoveredInSystem(profile, systemId)
	local list = Planets.collectionOf(systemId)
	local n = 0
	for _, def in ipairs(list) do
		if profile.Discovered[def.Id] then n = n + 1 end
	end
	return n, #list
end

function Progression.collectionComplete(profile, systemId)
	local n, total = Progression.discoveredInSystem(profile, systemId)
	return n >= total
end

-- Planetas base descubiertos / total visible (los secretos solo cuentan cuando se descubren)
function Progression.discoveryTotals(profile)
	local found, total = 0, 0
	for _, def in ipairs(Planets.List) do
		if def.Rarity ~= "secret" then
			total = total + 1
			if profile.Discovered[def.Id] then found = found + 1 end
		elseif profile.Discovered[def.Id] then
			total = total + 1
			found = found + 1
		end
	end
	return found, total
end

function Progression.allNonSecretDiscovered(profile)
	for _, def in ipairs(Planets.List) do
		if def.Rarity ~= "secret" and not profile.Discovered[def.Id] then return false end
	end
	return true
end

---------------------------------------------------------------- produccion
function Progression.planetRate(inst)
	local def = Planets.ById[inst.Id]
	local rate = def.Base * Variants.get(inst.V).Multiplier
	if inst.E then rate = rate * Config.Evolution.ProductionMultiplier end
	return rate
end

-- Lista de { inst, def } colocados en un sistema
function Progression.placedIn(profile, systemId)
	local out = {}
	local slots = profile.Placed[systemId]
	if slots then
		for i = 1, Config.Economy.SlotsPerSystem do
			local uid = slots[Galaxy.slotKey(i)]
			local inst = uid and profile.Planets[uid]
			if inst then
				table.insert(out, { inst = inst, def = Planets.ById[inst.Id], uid = uid, slot = i })
			end
		end
	end
	return out
end

local function countWithElement(placed, elements)
	local n = 0
	for _, p in ipairs(placed) do
		for _, e in ipairs(elements) do
			if Planets.hasElement(p.def, e) then
				n = n + 1
				break
			end
		end
	end
	return n
end

local function synergyActive(cond, placed)
	local t = cond.Type
	if t == "Element" then
		return countWithElement(placed, { cond.Element }) >= cond.Count
	elseif t == "AnyElement" then
		return countWithElement(placed, cond.Elements) >= cond.Count
	elseif t == "RarityWithElement" then
		local hasRarity = false
		for _, p in ipairs(placed) do
			if Rarities.atLeast(p.def.Rarity, cond.Rarity) and not Planets.hasElement(p.def, cond.Element) then
				hasRarity = true
			end
		end
		return hasRarity and countWithElement(placed, { cond.Element }) >= cond.Count
	elseif t == "DistinctElements" then
		local seen, n = {}, 0
		for _, p in ipairs(placed) do
			for _, e in ipairs(p.def.Elements) do
				if not seen[e] then
					seen[e] = true
					n = n + 1
				end
			end
		end
		return n >= cond.Count
	elseif t == "FullOrbit" then
		return #placed >= Config.Economy.SlotsPerSystem
	elseif t == "Variants" then
		local n = 0
		for _, p in ipairs(placed) do
			if p.inst.V ~= "none" then n = n + 1 end
		end
		return n >= cond.Count
	elseif t == "Evolved" then
		local n = 0
		for _, p in ipairs(placed) do
			if p.inst.E then n = n + 1 end
		end
		return n >= cond.Count
	end
	return false
end

-- Sinergias activas para una lista de colocados. Devuelve lista de ids y bono total (sin amplificar)
function Progression.synergies(placed)
	local active, bonus = {}, 0
	for _, s in ipairs(Defs.Synergies.List) do
		if synergyActive(s.Condition, placed) then
			table.insert(active, s.Id)
			bonus = bonus + s.Bonus
		end
	end
	return active, bonus
end

function Progression.collectionBonus(profile)
	local bonus = 0
	for sysId in pairs(profile.CollectionsClaimed) do
		local def = Galaxy.ById[sysId]
		if def then bonus = bonus + def.Reward.ProductionBonus end
	end
	return 1 + bonus
end

-- Desglose completo de produccion. eventMultiplier viene del servidor (evento activo) o 1.
function Progression.production(profile, eventMultiplier)
	eventMultiplier = eventMultiplier or 1
	local resonance = Upgrades.effect(profile, "resonance")
	local systems = {}
	local subtotal = 0
	for _, sysId in ipairs(Galaxy.Order) do
		if profile.Systems[sysId] then
			local def = Galaxy.ById[sysId]
			local placed = Progression.placedIn(profile, sysId)
			local base = 0
			for _, p in ipairs(placed) do
				base = base + Progression.planetRate(p.inst)
			end
			local active, bonus = Progression.synergies(placed)
			local synergyMult = 1 + bonus * resonance
			local total = base * def.Multiplier * synergyMult
			systems[sysId] = { Base = base, Count = #placed, Multiplier = def.Multiplier, SynergyMult = synergyMult,
				Synergies = active, Total = total }
			subtotal = subtotal + total
		end
	end
	local mults = {
		Reactor = Upgrades.effect(profile, "reactor"),
		Cores = Upgrades.effect(profile, "core_power"),
		Ascension = Defs.Ascension.multiplier(profile.Ascensions),
		Collections = Progression.collectionBonus(profile),
		Event = eventMultiplier,
	}
	local total = subtotal * mults.Reactor * mults.Cores * mults.Ascension * mults.Collections * mults.Event
	return { Total = total, Subtotal = subtotal, Systems = systems, Mults = mults }
end

---------------------------------------------------------------- costes y limites
function Progression.capsulePrice(profile, capsuleDef, eventDiscount)
	local price = capsuleDef.Price * Upgrades.effect(profile, "efficiency") * (eventDiscount or 1)
	return math.max(1, math.floor(price + 0.5))
end

function Progression.variantLuck(profile, eventLuck)
	return Upgrades.effect(profile, "core_luck") * (eventLuck or 1)
end

function Progression.maxBatch(profile)
	local level = Upgrades.level(profile, "core_multi")
	return Config.Capsules.BatchSizes[level + 1] or 1
end

function Progression.offlineCapSeconds(profile)
	return (Config.Economy.OfflineBaseCapHours + Upgrades.effect(profile, "battery")) * 3600
end

function Progression.offlineRate(profile)
	return math.min(1, Config.Economy.OfflineBaseRate + Upgrades.effect(profile, "core_offline"))
end

function Progression.startingEnergy(profile)
	return Config.Economy.StartingEnergy * Upgrades.effect(profile, "core_start")
end

-- Coste del siguiente slot del sistema, o nil si ya estan todos
function Progression.nextSlotCost(profile, systemId)
	local owned = profile.Slots[systemId]
	if not owned or owned >= Config.Economy.SlotsPerSystem then return nil end
	return Galaxy.ById[systemId].SlotCosts[owned + 1]
end

-- Valor de venta base de cada planeta: una fraccion del precio de la capsula mas barata que lo
-- contiene, repartida de forma que el retorno esperado de abrir una capsula y vender todo sea
-- Config.Economy.SellReturn (15%) de su precio. Asi vender nunca es rentable frente a comprar.
local sellBase = nil
local function buildSellBase()
	sellBase = {}
	for _, capsule in ipairs(Defs.Capsules.List) do
		local rarities = 0
		for _ in pairs(capsule.Odds) do
			rarities = rarities + 1
		end
		for rarityId, pct in pairs(capsule.Odds) do
			local weight = math.min(8, (1 / rarities) / (pct / 100))
			for _, planetId in ipairs(capsule.Pools[rarityId]) do
				if sellBase[planetId] == nil then
					sellBase[planetId] = capsule.Price * Config.Economy.SellReturn * weight
				end
			end
		end
	end
end

function Progression.sellValue(inst)
	if not sellBase then buildSellBase() end
	local value = sellBase[inst.Id] or 1
	-- las variantes y la forma Prime valen algo mas, con tope para no crear bucles de dinero
	value = value * math.min(3, Variants.get(inst.V).Multiplier)
	if inst.E then value = value * 2 end
	return math.max(1, math.floor(value))
end

function Progression.evolutionCost(def)
	return {
		Energy = def.Base * Config.Evolution.EnergyCostPerBase * Galaxy.ById[def.System].Multiplier,
		Stardust = Config.Evolution.StardustPerRarityOrder * Rarities.ById[def.Rarity].Order,
		Copies = Config.Evolution.CopiesRequired,
	}
end

-- Copias que se pueden consumir para evolucionar `uid`: mismo planeta, sin variante, sin evolucionar,
-- sin bloquear y sin colocar. `busy` es un conjunto opcional de uids no disponibles (p. ej. en un trade).
function Progression.evolutionFodder(profile, uid, busy)
	local target = profile.Planets[uid]
	local out = {}
	if not target then return out end
	for otherUid, inst in pairs(profile.Planets) do
		if otherUid ~= uid and inst.Id == target.Id and inst.V == "none" and not inst.E and not inst.L
			and not (busy and busy[otherUid]) and not Progression.findPlaced(profile, otherUid) then
			table.insert(out, otherUid)
		end
	end
	table.sort(out)
	return out
end

-- Nivel de progreso usado para escalar misiones
function Progression.tier(profile)
	local systems = 0
	for _ in pairs(profile.Systems) do
		systems = systems + 1
	end
	return (systems - 1) + math.min(profile.Ascensions, 5)
end

---------------------------------------------------------------- requisitos
-- Evalua un requisito declarativo. Devuelve { Ok, Current, Goal, Text }.
-- `production` es opcional (se calcula si hace falta).
function Progression.checkRequirement(profile, req, production)
	local t = req.Type
	local current, goal, text = 0, 1, ""
	if t == "Energy" then
		current, goal = profile.Energy, req.Amount
		text = "Tener " .. Format.number(req.Amount) .. " de Energy (se gasta al desbloquear)"
	elseif t == "Collection" then
		current = Progression.discoveredInSystem(profile, req.System)
		goal = req.Count
		text = "Descubrir " .. req.Count .. " planetas de la colección " .. Galaxy.ById[req.System].Name
	elseif t == "CollectionComplete" then
		local n, total = Progression.discoveredInSystem(profile, req.System)
		current, goal = n, total
		text = "Completar la colección " .. Galaxy.ById[req.System].Name
	elseif t == "Placed" then
		current, goal = Progression.placedCount(profile, req.System), req.Count
		text = "Tener " .. req.Count .. " planetas en órbita en " .. Galaxy.ById[req.System].Name
	elseif t == "Production" then
		production = production or Progression.production(profile).Total
		current, goal = production, req.Amount
		text = "Producir " .. Format.rate(req.Amount)
	elseif t == "Ascensions" then
		current, goal = profile.Ascensions, req.Count
		text = "Alcanzar " .. req.Count .. " ascensiones"
	elseif t == "Discoveries" then
		current, goal = Progression.discoveryTotals(profile), req.Count
		text = "Descubrir " .. req.Count .. " planetas distintos"
	elseif t == "PlanetsOwned" then
		current, goal = Progression.inventoryCount(profile), req.Count
		text = "Tener " .. req.Count .. " planetas"
	elseif t == "RarityOwned" then
		current = Progression.countOwned(profile, function(_, def) return Rarities.atLeast(def.Rarity, req.Rarity) end)
		goal = req.Count
		text = "Tener " .. req.Count .. " planeta(s) " .. Rarities.ById[req.Rarity].Name .. " o superior"
	elseif t == "RunEnergy" then
		current, goal = profile.RunEnergy, req.Amount
		text = "Generar " .. Format.number(req.Amount) .. " de Energy en esta ascensión"
	end
	return { Ok = current >= goal, Current = math.min(current, goal), Goal = goal, Text = text }
end

-- Estado de un sistema: "unlocked", "ready" (cumple todo) o "locked". Devuelve estado y lista de requisitos.
function Progression.systemState(profile, systemId, production)
	local def = Galaxy.ById[systemId]
	if profile.Systems[systemId] then return "unlocked", {} end
	local checks = {}
	local allOk = true
	-- el sistema anterior debe estar desbloqueado
	local previous = Galaxy.Order[def.Order - 1]
	if previous and not profile.Systems[previous] then
		table.insert(checks, { Ok = false, Current = 0, Goal = 1, Text = "Desbloquear antes " .. Galaxy.ById[previous].Name })
		allOk = false
	end
	for _, req in ipairs(def.Unlock) do
		local check = Progression.checkRequirement(profile, req, production)
		if not check.Ok then allOk = false end
		table.insert(checks, check)
	end
	return allOk and "ready" or "locked", checks
end

-- Coste en Energy de desbloquear un sistema (0 si no tiene)
function Progression.systemEnergyCost(systemId)
	for _, req in ipairs(Galaxy.ById[systemId].Unlock) do
		if req.Type == "Energy" then return req.Amount end
	end
	return 0
end

-- Condicion de un descubrimiento secreto. Devuelve true si el perfil la cumple ahora mismo.
function Progression.secretConditionMet(profile, cond)
	if cond.Type == "ElementsInSystem" then
		for sysId in pairs(profile.Systems) do
			local placed = Progression.placedIn(profile, sysId)
			local n, evolved = 0, false
			for _, p in ipairs(placed) do
				for _, e in ipairs(cond.Elements) do
					if Planets.hasElement(p.def, e) then
						n = n + 1
						if p.inst.E then evolved = true end
						break
					end
				end
			end
			if n >= cond.Count and (not cond.RequireEvolved or evolved) then return true end
		end
		return false
	elseif cond.Type == "DiscoverAllNonSecret" then
		return Progression.allNonSecretDiscovered(profile)
	end
	return false
end

return Progression
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX24">
        <Properties>
          <string name="Name">UniverseLayout</string>
          <ProtectedString name="Source"><![CDATA[-- UniverseLayout: geometria compartida del universo personal (parcelas, orbitas, plataforma).
-- La usan el servidor (construye la estructura fija) y el cliente (dibuja estrella, orbitas y planetas).
-- La distancia orbital solo organiza la presentacion: nunca afecta a la produccion.
local Config = require(script.Parent.Config)
local World = Config.World

local Layout = {}

Layout.DeckOffset = Vector3.new(0, 30, 262)
Layout.DeckRadius = 38
Layout.OverviewOffset = Vector3.new(0, 210, 300)

function Layout.plotCenter(index)
	return World.PlotOrigin + Vector3.new((index - 1) * World.PlotSpacing, 0, 0)
end

function Layout.orbitRadius(slot)
	return World.OrbitBaseRadius + (slot - 1) * World.OrbitSpacing
end

function Layout.outerRadius()
	return Layout.orbitRadius(Config.Economy.SlotsPerSystem)
end

-- Centro de la plataforma de observacion (el jugador mira hacia la estrella, direccion -Z)
function Layout.deckPosition(center)
	return center + Layout.DeckOffset
end

function Layout.spawnCFrame(center, seed)
	local deck = Layout.deckPosition(center)
	local angle = ((seed or 0) % 8) / 8 * math.pi * 2
	local pos = deck + Vector3.new(math.cos(angle) * 5, 4, 8 + math.sin(angle) * 5)
	return CFrame.new(pos, Vector3.new(center.X, pos.Y, center.Z))
end

-- Angulo orbital sincronizado: depende solo del slot, de la velocidad del planeta y del reloj del servidor
function Layout.orbitAngle(slot, orbitSpeed, serverTime)
	local radius = Layout.orbitRadius(slot)
	local angular = 0.16 * (orbitSpeed or 1) * math.sqrt(World.OrbitBaseRadius / radius)
	return slot * 2.399963 + serverTime * angular
end

function Layout.orbitPosition(center, slot, angle)
	local radius = Layout.orbitRadius(slot)
	return center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

return Layout
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX25">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX26">
          <Properties>
            <string name="Name">Build</string>
            <ProtectedString name="Source"><![CDATA[-- Build: utilidades para construir geometria por codigo (piezas, anillos, carteles, luces, prompts).
-- Las usan el servidor (Cosmic Hub, parcelas) y el cliente (estrella, orbitas, efectos).
local Build = {}

Build.Colors = {
	Hull = Color3.fromRGB(22, 27, 44), -- metal oscuro / grafito azulado
	HullLight = Color3.fromRGB(40, 48, 74),
	Deck = Color3.fromRGB(28, 34, 56),
	Trim = Color3.fromRGB(58, 70, 108),
	Cyan = Color3.fromRGB(70, 215, 255),
	Blue = Color3.fromRGB(60, 120, 255),
	Violet = Color3.fromRGB(170, 95, 255),
	Magenta = Color3.fromRGB(255, 80, 210),
	Gold = Color3.fromRGB(255, 200, 90),
	White = Color3.fromRGB(235, 240, 255),
}

local function apply(inst, props)
	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		else
			inst[key] = value
		end
	end
	if parent then inst.Parent = parent end
	return inst
end
Build.apply = apply

function Build.new(className, props)
	return apply(Instance.new(className), props or {})
end

-- Pieza anclada generica. props admite cualquier propiedad de Part.
function Build.part(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = true
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Color = Build.Colors.Hull
	return apply(part, props)
end

-- Pieza decorativa sin colision ni consultas
function Build.decor(props)
	local part = Build.part(props)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	return part
end

function Build.neon(props)
	local part = Build.decor(props)
	part.Material = Enum.Material.Neon
	return part
end

-- Cilindro con el eje en Y (vertical) por defecto. opts: Position, Radius, Height, CFrame (opcional, eje Y local)
function Build.cylinder(opts, props)
	local cf = opts.CFrame or CFrame.new(opts.Position)
	local p = props or {}
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(opts.Height, opts.Radius * 2, opts.Radius * 2)
	p.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	return Build.part(p)
end

function Build.ball(opts, props)
	local p = props or {}
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(opts.Radius * 2, opts.Radius * 2, opts.Radius * 2)
	p.CFrame = opts.CFrame or CFrame.new(opts.Position)
	return Build.part(p)
end

-- Anillo de segmentos en el plano XZ local de `cf`.
-- opts: CFrame, Radius, Width (grosor radial), Height, Segments, Gap (0-1, fraccion vacia entre segmentos),
--       Arc (radianes, por defecto circulo completo), Start (angulo inicial)
function Build.ring(opts, props)
	local segments = opts.Segments or 32
	local arc = opts.Arc or (math.pi * 2)
	local start = opts.Start or 0
	local step = arc / segments
	local length = 2 * opts.Radius * math.tan(step / 2) * (1 - (opts.Gap or 0)) + (opts.Gap and 0 or 0.02)
	local parts = {}
	for i = 0, segments - 1 do
		local angle = start + (i + 0.5) * step
		local p = {}
		for k, v in pairs(props or {}) do
			p[k] = v
		end
		p.Size = Vector3.new(opts.Width, opts.Height, length)
		p.CFrame = opts.CFrame * CFrame.Angles(0, -angle, 0) * CFrame.new(opts.Radius, 0, 0)
		if opts.Collide then
			table.insert(parts, Build.part(p))
		else
			table.insert(parts, Build.decor(p))
		end
	end
	return parts
end

function Build.light(parent, color, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 24
	light.Brightness = brightness or 1.5
	light.Shadows = false
	light.Parent = parent
	return light
end

-- SurfaceGui con un marco raiz. Devuelve gui, frame.
function Build.surfaceGui(part, face, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Screen"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 30
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.ResetOnSpawn = false
	gui.Parent = part
	local frame = Instance.new("Frame")
	frame.Name = "Root"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Parent = gui
	return gui, frame
end

-- Etiqueta de texto con el estilo de la interfaz (blanco con borde luminoso)
function Build.label(parent, text, props)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = Build.Colors.White
	label.TextScaled = true
	label.TextWrapped = true
	apply(label, props or {})
	label.Parent = parent
	return label
end

function Build.stroke(parent, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness or 2
	stroke.Transparency = transparency or 0
	stroke.Parent = parent
	return stroke
end

-- Cartel luminoso: panel oscuro con borde neon y texto. `cf` mira hacia el espectador (cara Front).
-- opts: CFrame, Width, Height, Text, Color (acento), TextColor, Parent, Name, PixelsPerStud, Font
function Build.sign(opts)
	local accent = opts.Color or Build.Colors.Cyan
	local model = Instance.new("Model")
	model.Name = opts.Name or "Sign"
	local panel = Build.decor({
		Name = "Panel", Size = Vector3.new(opts.Width, opts.Height, 0.5), CFrame = opts.CFrame,
		Color = Color3.fromRGB(10, 14, 30), Material = Enum.Material.Glass, Transparency = 0.2, Parent = model,
	})
	local t = 0.35
	local w, h = opts.Width, opts.Height
	Build.neon({ Name = "Top", Size = Vector3.new(w + t, t, 0.7), CFrame = opts.CFrame * CFrame.new(0, h / 2, 0), Color = accent, Parent = model })
	Build.neon({ Name = "Bottom", Size = Vector3.new(w + t, t, 0.7), CFrame = opts.CFrame * CFrame.new(0, -h / 2, 0), Color = accent, Parent = model })
	Build.neon({ Name = "Left", Size = Vector3.new(t, h + t, 0.7), CFrame = opts.CFrame * CFrame.new(-w / 2, 0, 0), Color = accent, Parent = model })
	Build.neon({ Name = "Right", Size = Vector3.new(t, h + t, 0.7), CFrame = opts.CFrame * CFrame.new(w / 2, 0, 0), Color = accent, Parent = model })
	if opts.Text then
		local _, root = Build.surfaceGui(panel, Enum.NormalId.Front, opts.PixelsPerStud or 24)
		local label = Build.label(root, opts.Text, {
			Size = UDim2.fromScale(0.92, 0.78), Position = UDim2.fromScale(0.04, 0.11),
			Font = opts.Font or Enum.Font.Michroma, TextColor3 = opts.TextColor or accent,
		})
		Build.stroke(label, Color3.fromRGB(8, 12, 40), 2, 0.2)
	end
	model.PrimaryPart = panel
	model.Parent = opts.Parent
	return model, panel
end

-- ProximityPrompt con una accion que el cliente interpreta (atributo "Action")
function Build.prompt(part, actionText, objectText, action, distance)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText or ""
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = distance or 14
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("Action", action)
	prompt.Parent = part
	return prompt
end

-- Emisor de particulas con una textura integrada del cliente (no requiere assets subidos)
Build.ParticleTextures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
}

function Build.particles(parent, props)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = Build.ParticleTextures.Sparkle
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Rate = 6
	emitter.Lifetime = NumberRange.new(1.5, 3)
	emitter.Speed = NumberRange.new(0.5, 2)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 1), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(1, 1) })
	apply(emitter, props or {})
	emitter.Parent = parent
	return emitter
end

-- Secuencia de tamaño simple: aparece, se mantiene y desaparece
function Build.sizeSeq(size)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.25, size), NumberSequenceKeypoint.new(1, 0) })
end

function Build.fadeSeq(minTransparency)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, minTransparency),
		NumberSequenceKeypoint.new(1, 1) })
end

return Build
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX27">
          <Properties>
            <string name="Name">Format</string>
            <ProtectedString name="Source"><![CDATA[-- Format: utilidades de formato de numeros y tiempo para la interfaz.
local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc" }

-- 1234567 -> "1.23M"
function Format.number(n)
	if type(n) ~= "number" or n ~= n then return "0" end
	local neg = n < 0
	if neg then n = -n end
	local out
	if n < 1000 then
		if n >= 100 or n == math.floor(n) then
			out = string.format("%d", math.floor(n + 0.0001))
		else
			out = string.format("%.1f", n)
		end
	else
		local idx = 1
		while n >= 1000 and idx < #SUFFIXES do
			n = n / 1000
			idx = idx + 1
		end
		if n >= 100 then
			out = string.format("%d", math.floor(n)) .. SUFFIXES[idx]
		elseif n >= 10 then
			out = string.format("%.1f", math.floor(n * 10) / 10) .. SUFFIXES[idx]
		else
			out = string.format("%.2f", math.floor(n * 100) / 100) .. SUFFIXES[idx]
		end
	end
	if neg then out = "-" .. out end
	return out
end

function Format.rate(n)
	return Format.number(n) .. "/s"
end

-- 1234567 -> "1,234,567"
function Format.commas(n)
	local s = string.format("%d", math.floor(n))
	local out = s
	while true do
		local replaced
		out, replaced = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		if replaced == 0 then break end
	end
	return out
end

-- 3725 -> "1h 02m"
function Format.duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

-- 754 -> "12:34"
function Format.clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- 0.125 -> "12.5%"
function Format.percent(fraction, decimals)
	local pct = fraction * 100
	if decimals == nil then
		if pct >= 10 or pct == math.floor(pct) then decimals = pct == math.floor(pct) and 0 or 1
		elseif pct >= 1 then decimals = 1
		elseif pct >= 0.1 then decimals = 2
		else decimals = 3 end
	end
	return string.format("%." .. decimals .. "f%%", pct)
end

-- 1.5 -> "x1.5"
function Format.mult(m)
	if m == math.floor(m) then return "x" .. string.format("%d", m) end
	return "x" .. string.format("%.2f", m):gsub("0+$", "")
end

return Format
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX28">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX29">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="RBX30">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[-- Main: punto de entrada del servidor de PLANET COLLECTOR.
-- 1) construye el mundo (entorno, Cosmic Hub, contenedores), 2) inicializa los servicios en orden,
-- 3) los arranca. El servidor es la autoridad de economia, inventario, colocacion, progreso y guardado.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

ReplicatedStorage:WaitForChild("Shared")

local Server = script.Parent
local Net = require(Server.Net)

local startClock = os.clock()

---------------------------------------------------------------- mundo
local zones = Instance.new("Folder")
zones.Name = "PlayerUniverseZones"
zones.Parent = Workspace

local eventEnvironment = Instance.new("Folder")
eventEnvironment.Name = "EventEnvironment"
eventEnvironment.Parent = Workspace

require(Server.World.Environment).apply()
require(Server.World.HubBuilder).build()

---------------------------------------------------------------- servicios
-- El orden importa: define el orden de los callbacks de carga de jugador.
local ORDER = {
	"DataService", "PlayerService", "UniverseService", "DiscoveryService", "InventoryService", "MissionService",
	"EventService", "ProductionService", "EconomyService", "CapsuleService", "PlanetPlacementService",
	"UpgradeService", "GalaxyService", "RebirthService", "TradingService", "LeaderboardService", "CosmeticService",
}

local services = {}
for _, name in ipairs(ORDER) do
	services[name] = require(Server.Services[name])
end

Net.init(function(player)
	return services.PlayerService.isLoaded(player)
end)

for _, name in ipairs(ORDER) do
	services[name].Init(services)
end
for _, name in ipairs(ORDER) do
	services[name].Start()
end

game:BindToClose(function()
	services.DataService.saveAll()
end)

-- señal para los clientes de que los Remotes ya existen
local ready = Instance.new("BoolValue")
ready.Name = "ServerReady"
ready.Value = true
ready.Parent = ReplicatedStorage

print(string.format("[PlanetCollector] servidor listo en %.2fs (v%s)", os.clock() - startClock,
	require(ReplicatedStorage.Shared.Config).Version))
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX31">
        <Properties>
          <string name="Name">Net</string>
          <ProtectedString name="Source"><![CDATA[-- Net: registro central de Remotes con validacion de argumentos, limites de frecuencia y respuesta controlada.
-- Toda peticion cliente->servidor pasa por Net.handle: el servidor nunca confia en los datos del cliente.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Net = {}

local folder = nil
local lastCall = {} -- [player] = { [remoteName] = tiempo }
local burst = {} -- [player] = { windowStart, count }
local profileCheck = nil -- funcion(player) -> boolean (perfil cargado)

local BURST_WINDOW = 1
local BURST_LIMIT = 40

function Net.init(isProfileLoaded)
	profileCheck = isProfileLoaded
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
		burst[player] = nil
	end)
end

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Valida un argumento contra su especificacion. Devuelve true o false, motivo.
local function validate(value, spec)
	local kind = spec[1]
	if value == nil then
		if spec.Optional then return true end
		return false, "falta argumento"
	end
	if kind == "string" then
		if type(value) ~= "string" then return false, "se esperaba texto" end
		if #value == 0 or #value > (spec.Max or 64) then return false, "longitud invalida" end
	elseif kind == "integer" then
		if not isFinite(value) or math.floor(value) ~= value then return false, "se esperaba entero" end
		if value < (spec.Min or 0) or value > (spec.Max or 1e9) then return false, "fuera de rango" end
	elseif kind == "number" then
		if not isFinite(value) then return false, "se esperaba numero" end
		if value < (spec.Min or -1e15) or value > (spec.Max or 1e15) then return false, "fuera de rango" end
	elseif kind == "boolean" then
		if type(value) ~= "boolean" then return false, "se esperaba booleano" end
	elseif kind == "stringList" then
		if type(value) ~= "table" then return false, "se esperaba lista" end
		local n = 0
		for k, v in pairs(value) do
			n = n + 1
			if type(k) ~= "number" or type(v) ~= "string" or #v == 0 or #v > (spec.MaxLength or 64) then
				return false, "lista invalida"
			end
			if n > (spec.Max or 100) then return false, "lista demasiado larga" end
		end
		if n ~= #value then return false, "lista invalida" end
	else
		return false, "especificacion desconocida"
	end
	return true
end
Net.validate = validate

local function allowed(player, name, cooldown)
	local now = os.clock()
	local b = burst[player]
	if not b or now - b.Start > BURST_WINDOW then
		b = { Start = now, Count = 0 }
		burst[player] = b
	end
	b.Count = b.Count + 1
	if b.Count > BURST_LIMIT then return false end
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	local last = calls[name]
	if last and now - last < cooldown then return false end
	calls[name] = now
	return true
end

-- Registra una peticion. opts = { Args = { spec... }, Cooldown = segundos, NoProfile = true si no requiere perfil }
-- handler(player, ...) -> ok(boolean), dataOrMessage
function Net.handle(name, opts, handler)
	local remote = Instance.new("RemoteFunction")
	remote.Name = name
	remote.Parent = folder
	local argSpecs = opts.Args or {}
	local cooldown = opts.Cooldown or 0.15
	remote.OnServerInvoke = function(player, ...)
		if not allowed(player, name, cooldown) then
			return { Ok = false, Error = "Demasiado rápido, espera un momento.", Code = "rate" }
		end
		if not opts.NoProfile and not profileCheck(player) then
			return { Ok = false, Error = "Tus datos aún se están cargando.", Code = "loading" }
		end
		local args = table.pack(...)
		if args.n > #argSpecs then
			return { Ok = false, Error = "Petición inválida.", Code = "args" }
		end
		for i, spec in ipairs(argSpecs) do
			local ok = validate(args[i], spec)
			if not ok then
				return { Ok = false, Error = "Petición inválida.", Code = "args" }
			end
		end
		local success, ok, data = pcall(handler, player, table.unpack(args, 1, #argSpecs))
		if not success then
			warn("[Net] error en " .. name .. ": " .. tostring(ok))
			return { Ok = false, Error = "Error interno. Inténtalo de nuevo.", Code = "internal" }
		end
		if ok then
			return { Ok = true, Data = data }
		end
		return { Ok = false, Error = data or "No se pudo completar la acción." }
	end
	return remote
end

local events = {}
function Net.event(name)
	local e = events[name]
	if not e then
		e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
		events[name] = e
	end
	return e
end

function Net.fire(name, player, ...)
	if player.Parent == Players then
		Net.event(name):FireClient(player, ...)
	end
end

function Net.fireAll(name, ...)
	Net.event(name):FireAllClients(...)
end

return Net
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX32">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX33">
          <Properties>
            <string name="Name">CapsuleService</string>
            <ProtectedString name="Source"><![CDATA[-- CapsuleService: compra y apertura de capsulas. La tirada aleatoria ocurre SOLO en el servidor.
-- El cliente pide abrir una capsula por id; el servidor valida precio, saldo, desbloqueo, cooldown e
-- inventario, descuenta Energy, genera el resultado y entrega el planeta. El cliente solo anima.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Net = require(script.Parent.Parent.Net)
local Config = Defs.Config

local CapsuleService = {}
local S = nil
local rng = Random.new()

local function batchAllowed(profile, count)
	if count > Progression.maxBatch(profile) then return false end
	for _, size in ipairs(Config.Capsules.BatchSizes) do
		if size == count then return true end
	end
	return false
end

local function open(player, capsuleId, count)
	local session = S.PlayerService.get(player)
	local profile = session.Profile
	local def = Defs.Capsules.ById[capsuleId]
	if not def then return false, "Cápsula desconocida." end
	if not profile.Systems[def.RequiresSystem] then
		return false, "Desbloquea " .. Defs.Galaxy.ById[def.RequiresSystem].Name .. " para usar esta cápsula."
	end
	if not batchAllowed(profile, count) then return false, "Cantidad no permitida." end
	local now = os.clock()
	if now - session.LastCapsule < Config.Capsules.CooldownSeconds then
		return false, "La máquina se está recargando."
	end
	if not S.InventoryService.hasSpace(player, count) then
		return false, "Inventario lleno. Vende planetas o mejora el Hangar Orbital."
	end
	local price = Progression.capsulePrice(profile, def, S.EventService.capsuleDiscount()) * count
	if not S.EconomyService.spend(player, "Energy", price, "capsule:" .. capsuleId) then
		return false, "No tienes suficiente Energy."
	end
	session.LastCapsule = now

	local luck = Progression.variantLuck(profile, S.EventService.variantLuck())
	local results = {}
	local rares, epics = 0, 0
	for _ = 1, count do
		local planetId, rarity = Defs.Capsules.roll(def, Defs.Rarities.Order, rng:NextNumber(), rng:NextNumber())
		local variant = Defs.Variants.roll(rng:NextNumber(), luck)
		local uid, discovery = S.InventoryService.add(player, planetId, variant, "capsule:" .. capsuleId)
		table.insert(results, { Uid = uid, Id = planetId, V = variant, Rarity = rarity,
			New = discovery.NewPlanet, NewVariant = discovery.NewVariant })
		if Defs.Rarities.atLeast(rarity, "rare") then rares = rares + 1 end
		if Defs.Rarities.atLeast(rarity, "epic") then epics = epics + 1 end
	end
	profile.Stats.CapsulesOpened = profile.Stats.CapsulesOpened + count
	S.PlayerService.sync(player, "Stats", "CapsulesOpened")
	S.MissionService.progress(player, "OpenCapsules", count)
	if rares > 0 then S.MissionService.progress(player, "ObtainRare", rares) end
	if epics > 0 then S.MissionService.progress(player, "ObtainEpic", epics) end
	S.PlayerService.tutorialEvent(player, "open_capsule")
	S.DiscoveryService.checkSecrets(player)
	return true, { Results = results, Spent = price, Capsule = capsuleId }
end

function CapsuleService.Init(services)
	S = services
	Net.handle("OpenCapsule", { Args = { { "string", Max = 24 }, { "integer", Min = 1, Max = 10 } }, Cooldown = 0.25 }, open)
end

function CapsuleService.Start() end

return CapsuleService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX34">
          <Properties>
            <string name="Name">CosmeticService</string>
            <ProtectedString name="Source"><![CDATA[-- CosmeticService: compra (con Stardust) y equipamiento de cosmeticos del universo. Sin efecto economico.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Net = require(script.Parent.Parent.Net)

local CosmeticService = {}
local S = nil

local function buy(player, cosmeticId)
	local profile = S.PlayerService.profile(player)
	local def = Defs.Cosmetics.ById[cosmeticId]
	if not def then return false, "Cosmético desconocido." end
	if profile.Cosmetics.Owned[cosmeticId] then return false, "Ya tienes ese cosmético." end
	if def.Price > 0 and not S.EconomyService.spend(player, "Stardust", def.Price, "cosmetic:" .. cosmeticId) then
		return false, "No tienes suficiente Stardust."
	end
	profile.Cosmetics.Owned[cosmeticId] = true
	S.PlayerService.sync(player, "Cosmetics", "Owned", cosmeticId)
	return true, { Id = cosmeticId }
end

local function equip(player, cosmeticId)
	local profile = S.PlayerService.profile(player)
	local def = Defs.Cosmetics.ById[cosmeticId]
	if not def then return false, "Cosmético desconocido." end
	if not profile.Cosmetics.Owned[cosmeticId] then return false, "Aún no tienes ese cosmético." end
	profile.Cosmetics.Equipped[def.Category] = cosmeticId
	S.PlayerService.sync(player, "Cosmetics", "Equipped", def.Category)
	S.UniverseService.publish(player)
	return true, { Id = cosmeticId }
end

function CosmeticService.Init(services)
	S = services
	Net.handle("BuyCosmetic", { Args = { { "string", Max = 32 } }, Cooldown = 0.3 }, buy)
	Net.handle("EquipCosmetic", { Args = { { "string", Max = 32 } }, Cooldown = 0.2 }, equip)
end

function CosmeticService.Start() end

return CosmeticService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX35">
          <Properties>
            <string name="Name">DataService</string>
            <ProtectedString name="Source"><![CDATA[-- DataService: carga/guardado de perfiles con candado de sesion, reintentos con backoff, versionado y
-- autosave. Si la carga falla NUNCA se inicia con datos por defecto sobre datos validos: el jugador
-- es expulsado con un mensaje (o, en Studio sin acceso a API, juega en modo "solo sesion").
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Profile = require(Shared.Profile)
local Config = Defs.Config

local DataService = {}

local store = nil
local storeError = nil
local memory = {} -- [userId] = perfil (modo solo sesion en Studio)
local records = {} -- [player] = { Profile, SessionOnly, Saving, Released, LastSave }
local savedCallbacks = {}

DataService.SessionOnlyMode = false

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
		warn("[DataService] DataStore no disponible: " .. storeError)
	end
end

local function key(userId)
	return "u_" .. tostring(userId)
end

local function retry(times, fn)
	local lastErr = nil
	for attempt = 1, times do
		local ok, a, b = pcall(fn)
		if ok then return true, a, b end
		lastErr = a
		if attempt < times then
			task.wait(math.min(8, 0.75 * 2 ^ (attempt - 1)))
		end
	end
	return false, lastErr
end

-- Carga el perfil. Devuelve perfil, info  |  nil, motivo
function DataService.load(player)
	local userId = player.UserId
	local now = os.time()
	if store == nil then
		if RunService:IsStudio() then
			DataService.SessionOnlyMode = true
			local data = Profile.reconcile(memory[userId], now)
			records[player] = { Profile = data, SessionOnly = true }
			return data, { SessionOnly = true, IsNew = memory[userId] == nil }
		end
		return nil, "El servicio de datos no está disponible."
	end

	local locked = false
	local loaded = nil
	local isNew = false
	local attempts = RunService:IsStudio() and 2 or Config.Data.LoadRetries
	local ok, err = retry(attempts, function()
		locked = false
		store:UpdateAsync(key(userId), function(old)
			if old ~= nil and type(old) ~= "table" then
				error("formato de datos inesperado")
			end
			if old and old.Lock and old.Lock.JobId ~= game.JobId and now - (old.Lock.Time or 0) < Config.Data.LockTimeout then
				locked = true
				return nil
			end
			local record = old or {}
			isNew = record.Data == nil
			record.Lock = { JobId = game.JobId, Time = os.time() }
			loaded = record.Data
			return record
		end)
		if locked then
			error("perfil bloqueado por otra sesion")
		end
	end)

	if not ok then
		if RunService:IsStudio() and not locked then
			-- Studio sin "Enable Studio Access to API Services": se juega sin guardar
			warn("[DataService] No se pudo cargar (" .. tostring(err) .. "). Modo solo sesion: NO se guardara el progreso.")
			DataService.SessionOnlyMode = true
			local data = Profile.reconcile(memory[userId], now)
			records[player] = { Profile = data, SessionOnly = true }
			return data, { SessionOnly = true, IsNew = memory[userId] == nil }
		end
		if locked then
			return nil, "Tus datos siguen abiertos en otro servidor. Espera un minuto y vuelve a entrar."
		end
		return nil, "No se pudieron cargar tus datos. Para protegerlos no se inició una partida nueva. Vuelve a intentarlo."
	end

	if player.Parent ~= Players then
		-- se fue mientras cargaba: liberar el candado
		DataService._release(userId)
		return nil, "desconectado"
	end
	local data = Profile.reconcile(loaded, now)
	records[player] = { Profile = data, SessionOnly = false, LastSave = os.clock() }
	return data, { SessionOnly = false, IsNew = isNew }
end

function DataService._release(userId)
	if store == nil then return end
	pcall(function()
		store:UpdateAsync(key(userId), function(old)
			if old and old.Lock and old.Lock.JobId == game.JobId then
				old.Lock = nil
				return old
			end
			return nil
		end)
	end)
end

function DataService.get(player)
	local rec = records[player]
	return rec and rec.Profile or nil
end

function DataService.isSessionOnly(player)
	local rec = records[player]
	return rec ~= nil and rec.SessionOnly == true
end

-- Olvida el registro en memoria (tras el guardado final, haya ido bien o no)
function DataService.forget(player)
	records[player] = nil
end

function DataService.onSaved(fn)
	table.insert(savedCallbacks, fn)
end

-- Guarda el perfil. release = true libera el candado (al salir). Devuelve true si se guardo.
function DataService.save(player, release)
	local rec = records[player]
	if not rec or rec.Lost then return false end
	local data = rec.Profile
	data.LastSave = os.time()
	if rec.SessionOnly then
		memory[player.UserId] = Profile.deepCopy(data)
		if release then records[player] = nil end
		return true
	end
	if rec.Saving then
		-- ya hay un guardado en curso: esperar a que termine para no pisarlo
		local waited = 0
		while rec.Saving and waited < 15 do
			waited = waited + task.wait(0.1)
		end
	end
	rec.Saving = true
	local snapshot = Profile.deepCopy(data)
	local stolen = false
	local ok, err = retry(Config.Data.SaveRetries, function()
		stolen = false
		store:UpdateAsync(key(player.UserId), function(old)
			if old and old.Lock and old.Lock.JobId ~= game.JobId then
				stolen = true
				return nil
			end
			local record = old or {}
			record.Data = snapshot
			record.Saved = os.time()
			if release then
				record.Lock = nil
			else
				record.Lock = { JobId = game.JobId, Time = os.time() }
			end
			return record
		end)
	end)
	rec.Saving = false
	if stolen then
		rec.Lost = true
		warn("[DataService] el candado de " .. player.Name .. " pertenece a otro servidor; se detiene el guardado")
		if player.Parent == Players then
			player:Kick("Tu sesión se abrió en otro servidor. Tus datos están a salvo.")
		end
		return false
	end
	if not ok then
		warn("[DataService] fallo al guardar " .. player.Name .. ": " .. tostring(err))
		return false
	end
	rec.LastSave = os.clock()
	for _, fn in ipairs(savedCallbacks) do
		task.spawn(fn, player, snapshot)
	end
	if release then records[player] = nil end
	return true
end

function DataService.Start()
	-- autosave escalonado
	task.spawn(function()
		while true do
			task.wait(10)
			for player, rec in pairs(records) do
				if not rec.SessionOnly and not rec.Saving and not rec.Lost and player.Parent == Players
					and os.clock() - (rec.LastSave or 0) >= Config.Data.AutosaveInterval then
					task.spawn(DataService.save, player, false)
				end
			end
		end
	end)
end

-- Guardado final de todos los jugadores (BindToClose)
function DataService.saveAll()
	local pending = 0
	for player in pairs(records) do
		pending = pending + 1
		task.spawn(function()
			DataService.save(player, true)
			pending = pending - 1
		end)
	end
	local waited = 0
	while pending > 0 and waited < 25 do
		waited = waited + task.wait(0.2)
	end
end

return DataService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX36">
          <Properties>
            <string name="Name">DiscoveryService</string>
            <ProtectedString name="Source"><![CDATA[-- DiscoveryService: Collection Index, recompensas por completar colecciones y descubrimientos secretos.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)

local DiscoveryService = {}
local S = nil

-- Registra un planeta obtenido. Devuelve { NewPlanet, NewVariant }.
function DiscoveryService.register(player, planetId, variant, evolved)
	local profile = S.PlayerService.profile(player)
	local result = { NewPlanet = false, NewVariant = false }
	if not profile then return result end
	if not profile.Discovered[planetId] then
		profile.Discovered[planetId] = true
		result.NewPlanet = true
		S.PlayerService.sync(player, "Discovered", planetId)
	end
	local key = Progression.discoveryKey(planetId, variant, evolved)
	if key ~= planetId and not profile.Discovered[key] then
		profile.Discovered[key] = true
		result.NewVariant = true
		S.PlayerService.sync(player, "Discovered", key)
	end
	if result.NewPlanet then
		DiscoveryService.checkCollections(player)
	end
	return result
end

-- Entrega la recompensa de cada coleccion de sistema completada (una sola vez).
function DiscoveryService.checkCollections(player)
	local profile = S.PlayerService.profile(player)
	local changed = false
	for _, sysId in ipairs(Defs.Galaxy.Order) do
		if not profile.CollectionsClaimed[sysId] and Progression.collectionComplete(profile, sysId) then
			local def = Defs.Galaxy.ById[sysId]
			profile.CollectionsClaimed[sysId] = true
			S.PlayerService.sync(player, "CollectionsClaimed", sysId)
			S.EconomyService.add(player, "Stardust", def.Reward.Stardust, "collection:" .. sysId)
			S.PlayerService.notify(player, "collection", "¡Colección " .. def.Name .. " completada! +" .. def.Reward.Stardust
				.. " Stardust y +" .. math.floor(def.Reward.ProductionBonus * 100) .. "% de producción permanente")
			changed = true
		end
	end
	if changed then
		S.ProductionService.recalc(player)
	end
end

-- Comprueba las condiciones de los secretos y entrega el planeta la primera vez que se cumplen.
function DiscoveryService.checkSecrets(player)
	local profile = S.PlayerService.profile(player)
	if not profile then return end
	for _, def in ipairs(Defs.Planets.List) do
		if def.Secret and not profile.SecretsFound[def.Id] and Progression.secretConditionMet(profile, def.Secret.Condition) then
			profile.SecretsFound[def.Id] = true
			S.PlayerService.sync(player, "SecretsFound", def.Id)
			local uid = S.InventoryService.add(player, def.Id, "none", "secret", true)
			if uid then
				S.PlayerService.notify(player, "secret", "¡DESCUBRIMIENTO SECRETO! Has encontrado " .. def.Name,
					{ PlanetId = def.Id, Uid = uid })
			end
		end
	end
end

function DiscoveryService.Init(services)
	S = services
end

function DiscoveryService.Start() end

return DiscoveryService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX37">
          <Properties>
            <string name="Name">EconomyService</string>
            <ProtectedString name="Source"><![CDATA[-- EconomyService: unica puerta de entrada para modificar monedas (Energy, Stardust, Cores).
-- Valida cantidades, evita negativos/overflow, registra transacciones criticas y aplica el tick de
-- produccion agregado (un calculo por jugador y tick, nunca por planeta y frame).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Config = Defs.Config

local EconomyService = {}
local S = nil

local CURRENCIES = { Energy = true, Stardust = true, Cores = true }
local log = {}
local LOG_MAX = 300

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function record(player, currency, delta, reason)
	table.insert(log, { Time = os.time(), UserId = player.UserId, Currency = currency, Delta = delta, Reason = reason })
	if #log > LOG_MAX then table.remove(log, 1) end
end

function EconomyService.getLog()
	return log
end

-- Suma moneda. earned = true cuenta como Energy generada (estadisticas y misiones).
function EconomyService.add(player, currency, amount, reason, earned)
	local profile = S.PlayerService.profile(player)
	if not profile or not CURRENCIES[currency] or not isFinite(amount) or amount <= 0 then return false end
	if currency ~= "Energy" then amount = math.floor(amount) end
	if amount <= 0 then return false end
	profile[currency] = math.min(Config.Economy.MaxCurrency, profile[currency] + amount)
	if currency == "Energy" and earned then
		profile.RunEnergy = math.min(Config.Economy.MaxCurrency, profile.RunEnergy + amount)
		profile.TotalEnergy = math.min(Config.Economy.MaxCurrency, profile.TotalEnergy + amount)
		S.MissionService.progress(player, "EarnEnergy", amount)
	end
	if reason ~= "production" then record(player, currency, amount, reason) end
	S.PlayerService.sync(player, currency)
	return true
end

function EconomyService.canAfford(player, currency, amount)
	local profile = S.PlayerService.profile(player)
	return profile ~= nil and CURRENCIES[currency] == true and isFinite(amount) and amount >= 0 and profile[currency] >= amount
end

-- Gasta moneda de forma atomica. Devuelve false si no alcanza (nunca deja saldo negativo).
function EconomyService.spend(player, currency, amount, reason)
	if not EconomyService.canAfford(player, currency, amount) then return false end
	local profile = S.PlayerService.profile(player)
	profile[currency] = math.max(0, profile[currency] - amount)
	record(player, currency, -amount, reason)
	S.PlayerService.sync(player, currency)
	return true
end

-- Ganancias sin conexion: tiempo desde el ultimo guardado, validado y con tope.
local function grantOffline(player, session, info)
	local profile = session.Profile
	if info.SessionOnly or info.IsNew or profile.LastSave <= 0 then return end
	local elapsed = os.time() - profile.LastSave
	if elapsed < Config.Economy.OfflineMinSeconds then return end -- incluye relojes inconsistentes (negativo)
	local capped = math.min(elapsed, Progression.offlineCapSeconds(profile))
	local rate = Progression.production(profile, 1).Total
	local amount = math.floor(rate * capped * Progression.offlineRate(profile))
	if amount <= 0 then return end
	EconomyService.add(player, "Energy", amount, "offline", true)
	session.Derived._Session.Offline = { Seconds = capped, Away = elapsed, Energy = amount }
end

function EconomyService.Init(services)
	S = services
	S.PlayerService.onLoaded(grantOffline)
end

function EconomyService.Start()
	task.spawn(function()
		local last = os.clock()
		local counter = 0
		while true do
			task.wait(Config.Economy.TickSeconds)
			local now = os.clock()
			local dt = math.min(now - last, 5)
			last = now
			counter = counter + 1
			for player, session in pairs(S.PlayerService.all()) do
				local production = session.Derived._Production
				local rate = production and production.Total or 0
				if rate > 0 then
					EconomyService.add(player, "Energy", rate * dt, "production", true)
					if rate > session.Profile.Stats.BestRate then
						session.Profile.Stats.BestRate = rate
					end
				end
				if counter % 5 == 0 then
					S.PlayerService.sync(player, "RunEnergy")
					S.PlayerService.sync(player, "TotalEnergy")
					S.PlayerService.updateLeaderstats(player)
				end
			end
		end
	end)
end

return EconomyService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX38">
          <Properties>
            <string name="Name">EventService</string>
            <ProtectedString name="Source"><![CDATA[-- EventService: eventos cosmicos globales calculados con el tiempo del servidor (sin temporizadores
-- falsos). Expone los modificadores activos y gestiona los meteoritos de Meteor Shower.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Net = require(script.Parent.Parent.Net)
local Events = Defs.Events

local EventService = {}
local S = nil

local current = nil -- definicion del evento activo o nil
local schedule = Events.schedule(os.time())
local rng = Random.new()
local meteorCounter = 0

local METEOR_INTERVAL = 4
local METEOR_LIFETIME = 14
local METEOR_MAX_ACTIVE = 5

function EventService.active()
	return current
end

function EventService.cycleIndex()
	return schedule.CycleIndex
end

function EventService.productionMultiplier()
	return (current and current.Effects.Production) or 1
end

function EventService.variantLuck()
	return (current and current.Effects.VariantLuck) or 1
end

function EventService.capsuleDiscount()
	return (current and current.Effects.CapsuleDiscount) or 1
end

function EventService.view()
	return {
		Id = current and current.Id or nil,
		EndsAt = schedule.EndsAt,
		NextId = schedule.Next.Id,
		NextStartsAt = schedule.NextStartsAt,
		Cycle = schedule.CycleIndex,
	}
end

local function broadcast()
	for player in pairs(S.PlayerService.all()) do
		S.PlayerService.setDerived(player, "_Event", EventService.view())
	end
end

local function update()
	local newSchedule = Events.schedule(os.time())
	local newActive = newSchedule.Active
	local changed = newActive ~= current or newSchedule.CycleIndex ~= schedule.CycleIndex
	schedule = newSchedule
	if changed then
		local previous = current
		current = newActive
		for player in pairs(S.PlayerService.all()) do
			S.MissionService.refresh(player)
		end
		broadcast()
		if (previous and previous.Effects.Production) or (current and current.Effects.Production) then
			S.ProductionService.recalcAll()
		end
		if current then
			Net.fireAll("Notify", { Kind = "event", Text = current.Icon .. " ¡Evento " .. current.Name .. "! " .. current.Description })
		end
	end
end

local function spawnMeteors()
	if not current or not current.Effects.Meteors then return end
	local now = os.clock()
	for player, session in pairs(S.PlayerService.all()) do
		local meteors = session.Meteors
		if not meteors then
			meteors = {}
			session.Meteors = meteors
		end
		local count = 0
		for id, expires in pairs(meteors) do
			if expires < now then meteors[id] = nil else count = count + 1 end
		end
		if count < METEOR_MAX_ACTIVE then
			meteorCounter = meteorCounter + 1
			local id = "m" .. tostring(meteorCounter)
			meteors[id] = now + METEOR_LIFETIME
			Net.fire("Meteor", player, { Id = id, Seed = rng:NextInteger(1, 1000000), Lifetime = METEOR_LIFETIME })
		end
	end
end

local function collectMeteor(player, id)
	local session = S.PlayerService.get(player)
	local meteors = session.Meteors
	if not meteors or not meteors[id] then return false, "Ese meteorito ya no está." end
	if meteors[id] < os.clock() then
		meteors[id] = nil
		return false, "Ese meteorito se desintegró."
	end
	meteors[id] = nil
	local reward = rng:NextInteger(1, 3)
	S.EconomyService.add(player, "Stardust", reward, "meteor")
	session.Profile.Stats.MeteorsCollected = session.Profile.Stats.MeteorsCollected + 1
	S.MissionService.progress(player, "CollectMeteors", 1)
	return true, { Stardust = reward }
end

function EventService.Init(services)
	S = services
	current = schedule.Active
	Net.event("Meteor")
	S.PlayerService.onLoaded(function(player, session)
		session.Derived._Event = EventService.view()
	end)
	Net.handle("CollectMeteor", { Args = { { "string", Max = 16 } }, Cooldown = 0.1 }, collectMeteor)
end

function EventService.Start()
	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(1)
			elapsed = elapsed + 1
			update()
			if elapsed % METEOR_INTERVAL == 0 then
				spawnMeteors()
			end
		end
	end)
end

return EventService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX39">
          <Properties>
            <string name="Name">GalaxyService</string>
            <ProtectedString name="Source"><![CDATA[-- GalaxyService: desbloqueo de sistemas y cambio de sistema activo (validados en servidor).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Net = require(script.Parent.Parent.Net)
local Galaxy = Defs.Galaxy

local GalaxyService = {}
local S = nil

local function unlockSystem(player, systemId)
	local profile = S.PlayerService.profile(player)
	local def = Galaxy.ById[systemId]
	if not def then return false, "Sistema desconocido." end
	if profile.Systems[systemId] then return false, "Ya tienes ese sistema." end
	local state = Progression.systemState(profile, systemId, S.ProductionService.rate(player))
	if state ~= "ready" then return false, "Aún no cumples los requisitos." end
	local cost = Progression.systemEnergyCost(systemId)
	if cost > 0 and not S.EconomyService.spend(player, "Energy", cost, "system:" .. systemId) then
		return false, "No tienes suficiente Energy."
	end
	profile.Systems[systemId] = true
	profile.Placed[systemId] = {}
	profile.Slots[systemId] = def.FreeSlots
	S.PlayerService.sync(player, "Systems", systemId)
	S.PlayerService.sync(player, "Placed", systemId)
	S.PlayerService.sync(player, "Slots", systemId)
	S.MissionService.refresh(player)
	S.ProductionService.recalc(player)
	S.PlayerService.notify(player, "system", "¡" .. def.Name .. " desbloqueado! " .. def.Introduces)
	return true, { System = systemId }
end

local function setActiveSystem(player, systemId)
	local profile = S.PlayerService.profile(player)
	if not Galaxy.ById[systemId] or not profile.Systems[systemId] then
		return false, "Ese sistema no está desbloqueado."
	end
	if profile.ActiveSystem ~= systemId then
		profile.ActiveSystem = systemId
		S.PlayerService.sync(player, "ActiveSystem")
		S.UniverseService.publish(player)
	end
	return true, { System = systemId }
end

function GalaxyService.Init(services)
	S = services
	Net.handle("UnlockSystem", { Args = { { "string", Max = 16 } }, Cooldown = 0.5 }, unlockSystem)
	Net.handle("SetActiveSystem", { Args = { { "string", Max = 16 } }, Cooldown = 0.3 }, setActiveSystem)
end

function GalaxyService.Start() end

return GalaxyService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX40">
          <Properties>
            <string name="Name">InventoryService</string>
            <ProtectedString name="Source"><![CDATA[-- InventoryService: propiedad de instancias de planetas, limites, venta, bloqueo, evolucion y transferencias.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Net = require(script.Parent.Parent.Net)
local Config = Defs.Config

local InventoryService = {}
local S = nil

function InventoryService.hasSpace(player, count)
	local profile = S.PlayerService.profile(player)
	return Progression.inventoryCount(profile) + (count or 1) <= Progression.inventoryCapacity(profile)
end

-- Crea una instancia nueva. ignoreCapacity se usa solo para recompensas garantizadas (secretos).
-- Devuelve uid, discovery  |  nil
function InventoryService.add(player, planetId, variant, source, ignoreCapacity, evolved)
	local profile = S.PlayerService.profile(player)
	local def = Defs.Planets.ById[planetId]
	if not profile or not def then return nil end
	variant = variant or "none"
	if not Defs.Variants.ById[variant] then variant = "none" end
	if not ignoreCapacity and not InventoryService.hasSpace(player, 1) then return nil end
	local uid = "p" .. tostring(profile.NextUid)
	profile.NextUid = profile.NextUid + 1
	profile.Planets[uid] = { Id = planetId, V = variant, E = evolved == true, L = false }
	S.PlayerService.sync(player, "Planets", uid)
	profile.Stats.PlanetsObtained = profile.Stats.PlanetsObtained + 1
	if Defs.Rarities.atLeast(def.Rarity, "rare") then
		profile.Stats.RaresObtained = profile.Stats.RaresObtained + 1
	end
	local discovery = S.DiscoveryService.register(player, planetId, variant, evolved == true)
	return uid, discovery
end

-- true si la instancia no se puede vender/mover/consumir ahora mismo
function InventoryService.isBusy(player, uid)
	local session = S.PlayerService.get(player)
	return session ~= nil and session.Busy[uid] == true
end

function InventoryService.remove(player, uid)
	local profile = S.PlayerService.profile(player)
	if not profile or not profile.Planets[uid] then return false end
	profile.Planets[uid] = nil
	S.PlayerService.sync(player, "Planets", uid)
	return true
end

local function sell(player, uids)
	local profile = S.PlayerService.profile(player)
	local seen = {}
	local total, count = 0, 0
	-- validar todo antes de modificar nada
	for _, uid in ipairs(uids) do
		local inst = profile.Planets[uid]
		if not inst then return false, "Uno de los planetas ya no existe." end
		if seen[uid] then return false, "Selección duplicada." end
		seen[uid] = true
		if inst.L then return false, "No puedes vender planetas bloqueados." end
		if InventoryService.isBusy(player, uid) then return false, "Ese planeta está en un intercambio." end
		if Progression.findPlaced(profile, uid) then return false, "Retira el planeta de su órbita antes de venderlo." end
		total = total + Progression.sellValue(inst)
		count = count + 1
	end
	if count == 0 then return false, "No hay nada que vender." end
	for uid in pairs(seen) do
		InventoryService.remove(player, uid)
	end
	S.EconomyService.add(player, "Energy", total, "sell", true)
	profile.Stats.PlanetsSold = profile.Stats.PlanetsSold + count
	S.MissionService.progress(player, "SellPlanets", count)
	return true, { Energy = total, Count = count }
end

local function lock(player, uid, value)
	local profile = S.PlayerService.profile(player)
	local inst = profile.Planets[uid]
	if not inst then return false, "Ese planeta no existe." end
	if InventoryService.isBusy(player, uid) then return false, "Ese planeta está en un intercambio." end
	inst.L = value
	S.PlayerService.sync(player, "Planets", uid)
	return true
end

local function evolve(player, uid)
	local session = S.PlayerService.get(player)
	local profile = session.Profile
	local inst = profile.Planets[uid]
	if not inst then return false, "Ese planeta no existe." end
	if inst.E then return false, "Ese planeta ya está evolucionado." end
	if InventoryService.isBusy(player, uid) then return false, "Ese planeta está en un intercambio." end
	local def = Defs.Planets.ById[inst.Id]
	local cost = Progression.evolutionCost(def)
	local fodder = Progression.evolutionFodder(profile, uid, session.Busy)
	if #fodder < cost.Copies then
		return false, "Necesitas " .. cost.Copies .. " copias normales de " .. def.Name .. " (sin variante, sin colocar y sin bloquear)."
	end
	if not S.EconomyService.canAfford(player, "Energy", cost.Energy) then return false, "No tienes suficiente Energy." end
	if not S.EconomyService.canAfford(player, "Stardust", cost.Stardust) then return false, "No tienes suficiente Stardust." end
	S.EconomyService.spend(player, "Energy", cost.Energy, "evolve")
	S.EconomyService.spend(player, "Stardust", cost.Stardust, "evolve")
	for i = 1, cost.Copies do
		InventoryService.remove(player, fodder[i])
	end
	inst.E = true
	S.PlayerService.sync(player, "Planets", uid)
	profile.Stats.Evolutions = profile.Stats.Evolutions + 1
	local discovery = S.DiscoveryService.register(player, inst.Id, inst.V, true)
	S.MissionService.progress(player, "EvolvePlanet", 1)
	if Progression.findPlaced(profile, uid) then
		S.ProductionService.recalc(player)
		S.UniverseService.publish(player)
	end
	S.DiscoveryService.checkSecrets(player)
	return true, { Uid = uid, New = discovery.NewVariant }
end

-- Transfiere instancias entre dos jugadores (usado por TradingService tras revalidar).
-- Devuelve la lista de uids nuevos en el receptor.
function InventoryService.transfer(fromPlayer, toPlayer, uids)
	local fromProfile = S.PlayerService.profile(fromPlayer)
	local created = {}
	for _, uid in ipairs(uids) do
		local inst = fromProfile.Planets[uid]
		InventoryService.remove(fromPlayer, uid)
		local newUid = InventoryService.add(toPlayer, inst.Id, inst.V, "trade", true, inst.E)
		table.insert(created, newUid)
	end
	return created
end

function InventoryService.Init(services)
	S = services
	Net.handle("SellPlanets", { Args = { { "stringList", Max = 200, MaxLength = 16 } }, Cooldown = 0.3 }, sell)
	Net.handle("LockPlanet", { Args = { { "string", Max = 16 }, { "boolean" } }, Cooldown = 0.1 }, lock)
	Net.handle("EvolvePlanet", { Args = { { "string", Max = 16 } }, Cooldown = 0.5 }, evolve)
end

function InventoryService.Start() end

return InventoryService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX41">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <ProtectedString name="Source"><![CDATA[-- LeaderboardService: cinco clasificaciones persistentes (OrderedDataStore) refrescadas con una
-- frecuencia controlada. Nunca consulta el OrderedDataStore por frame; si no hay DataStore
-- (Studio), usa los valores en vivo de los jugadores conectados.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Net = require(script.Parent.Parent.Net)
local Config = Defs.Config

local LeaderboardService = {}
local S = nil

LeaderboardService.Categories = {
	{ Id = "Rate", Name = "Producción (Energy/s)" },
	{ Id = "Value", Name = "Valor del universo" },
	{ Id = "Ascensions", Name = "Ascensiones" },
	{ Id = "Discoveries", Name = "Planetas descubiertos" },
	{ Id = "Rares", Name = "Planetas raros" },
}

local stores = {}
local boards = {}
local nameCache = {}
local MAX_STORED = 9e15

local function valuesFor(profile)
	local value, rares = 0, 0
	for _, inst in pairs(profile.Planets) do
		local def = Defs.Planets.ById[inst.Id]
		if def then
			local v = def.CollectionValue * Defs.Variants.get(inst.V).Multiplier
			if inst.E then v = v * Config.Evolution.ProductionMultiplier end
			value = value + v
			if Defs.Rarities.atLeast(def.Rarity, "epic") then rares = rares + 1 end
		end
	end
	local discoveries = Progression.discoveryTotals(profile)
	return {
		Rate = Progression.production(profile, 1).Total,
		Value = value,
		Ascensions = profile.Ascensions,
		Discoveries = discoveries,
		Rares = rares,
	}
end

local function nameOf(userId)
	local player = Players:GetPlayerByUserId(userId)
	if player then return player.DisplayName end
	if nameCache[userId] then return nameCache[userId] end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Jugador " .. tostring(userId))
	return nameCache[userId]
end

local function refresh()
	local live = {}
	for player, session in pairs(S.PlayerService.all()) do
		live[player.UserId] = valuesFor(session.Profile)
	end
	for _, category in ipairs(LeaderboardService.Categories) do
		local entries = {}
		local store = stores[category.Id]
		if store then
			local ok, page = pcall(function()
				return store:GetSortedAsync(false, Config.Leaderboard.Size):GetCurrentPage()
			end)
			if ok and page then
				for _, item in ipairs(page) do
					local userId = tonumber(string.match(item.key, "^u_(%d+)$"))
					if userId then
						entries[userId] = item.value
					end
				end
			end
		end
		-- los jugadores conectados siempre muestran su valor en vivo
		for userId, values in pairs(live) do
			entries[userId] = values[category.Id]
		end
		local list = {}
		for userId, value in pairs(entries) do
			if value > 0 then
				table.insert(list, { UserId = userId, Value = value })
			end
		end
		table.sort(list, function(a, b)
			if a.Value == b.Value then return a.UserId < b.UserId end
			return a.Value > b.Value
		end)
		local top = {}
		for i = 1, math.min(Config.Leaderboard.Size, #list) do
			top[i] = { UserId = list[i].UserId, Name = nameOf(list[i].UserId), Value = list[i].Value }
		end
		boards[category.Id] = top
	end
	Net.fireAll("LeaderboardUpdate", boards)
end
LeaderboardService.refresh = refresh

function LeaderboardService.Init(services)
	S = services
	Net.event("LeaderboardUpdate")
	for _, category in ipairs(LeaderboardService.Categories) do
		boards[category.Id] = {}
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.Leaderboard.StorePrefix .. category.Id)
		end)
		if ok then stores[category.Id] = store end
	end
	S.DataService.onSaved(function(player, snapshot)
		local values = valuesFor(snapshot)
		for _, category in ipairs(LeaderboardService.Categories) do
			local store = stores[category.Id]
			if store then
				pcall(function()
					store:SetAsync("u_" .. tostring(player.UserId), math.floor(math.min(values[category.Id], MAX_STORED)))
				end)
			end
		end
	end)
	Net.handle("GetLeaderboard", { NoProfile = true, Cooldown = 1 }, function()
		return true, boards
	end)
end

function LeaderboardService.Start()
	task.spawn(function()
		task.wait(5)
		while true do
			local ok, err = pcall(refresh)
			if not ok then warn("[Leaderboard] " .. tostring(err)) end
			task.wait(Config.Leaderboard.RefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX42">
          <Properties>
            <string name="Name">MissionService</string>
            <ProtectedString name="Source"><![CDATA[-- MissionService: misiones diarias/semanales y objetivo del evento activo. Progreso y reclamacion
-- validados en servidor. Sin castigos por perder dias: simplemente se generan misiones nuevas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Net = require(script.Parent.Parent.Net)
local Missions = Defs.Missions

local MissionService = {}
local S = nil
local dirty = {}

local function dayKey(now)
	return math.floor(now / 86400)
end

local function weekKey(now)
	-- el dia 0 de la epoca unix fue jueves; +3 hace que la semana empiece en lunes
	return math.floor((dayKey(now) + 3) / 7)
end

local function generate(player, profile, scope, key, count)
	local pool = Missions.ByScope[scope]
	local rng = Random.new(player.UserId * 31 + key * 7919 + (scope == "weekly" and 17 or 0))
	local order = {}
	for i = 1, #pool do
		order[i] = i
	end
	rng:Shuffle(order)
	local tier = Progression.tier(profile)
	local production = Progression.production(profile, 1).Total
	local list = {}
	for i = 1, math.min(count, #order) do
		local template = pool[order[i]]
		list[i] = {
			Id = template.Id,
			Goal = template.Goal(tier, production),
			Progress = 0,
			Claimed = false,
			Stardust = template.Stardust(tier),
			Energy = math.floor(math.max(250, production * Missions.EnergyRewardSeconds[scope])),
		}
	end
	return list
end

-- Genera misiones si cambio el dia/semana. Devuelve true si hubo cambios.
function MissionService.refresh(player)
	local profile = S.PlayerService.profile(player)
	if not profile then return false end
	local now = os.time()
	local m = profile.Missions
	local changed = false
	if m.DailyKey ~= dayKey(now) or #m.Daily == 0 then
		m.DailyKey = dayKey(now)
		m.Daily = generate(player, profile, "daily", m.DailyKey, Missions.DailyCount)
		changed = true
	end
	if m.WeeklyKey ~= weekKey(now) or #m.Weekly == 0 then
		m.WeeklyKey = weekKey(now)
		m.Weekly = generate(player, profile, "weekly", m.WeeklyKey, Missions.WeeklyCount)
		changed = true
	end
	local schedule = Defs.Events.schedule(now)
	if m.EventKey ~= schedule.CycleIndex then
		m.EventKey = schedule.CycleIndex
		m.EventProgress = 0
		m.EventClaimed = false
		changed = true
	end
	if changed then S.PlayerService.sync(player, "Missions") end
	return changed
end

function MissionService.progress(player, missionType, amount)
	local profile = S.PlayerService.profile(player)
	if not profile or amount <= 0 then return end
	local m = profile.Missions
	local changed = false
	for _, list in ipairs({ m.Daily, m.Weekly }) do
		for _, mission in ipairs(list) do
			local template = Missions.ById[mission.Id]
			if template and template.Type == missionType and mission.Progress < mission.Goal then
				mission.Progress = math.min(mission.Goal, mission.Progress + amount)
				changed = true
			end
		end
	end
	local active = S.EventService.active()
	if active and active.Objective.Type == missionType and m.EventKey == S.EventService.cycleIndex()
		and m.EventProgress < active.Objective.Goal then
		m.EventProgress = math.min(active.Objective.Goal, m.EventProgress + amount)
		changed = true
	end
	if changed then dirty[player] = true end
end

local function claim(player, scope, index)
	local profile = S.PlayerService.profile(player)
	local m = profile.Missions
	if scope == "event" then
		local active = S.EventService.active()
		if not active or m.EventKey ~= S.EventService.cycleIndex() then return false, "No hay evento activo." end
		if m.EventClaimed then return false, "Ya reclamaste esta recompensa." end
		if m.EventProgress < active.Objective.Goal then return false, "Objetivo sin completar." end
		m.EventClaimed = true
		S.PlayerService.sync(player, "Missions")
		S.EconomyService.add(player, "Stardust", active.RewardStardust, "event:" .. active.Id)
		MissionService.progress(player, "EventParticipation", 1)
		return true, { Stardust = active.RewardStardust }
	end
	local list = (scope == "daily" and m.Daily) or (scope == "weekly" and m.Weekly) or nil
	if not list then return false, "Misión inválida." end
	local mission = list[index]
	if not mission then return false, "Misión inválida." end
	if mission.Claimed then return false, "Ya reclamaste esta misión." end
	if mission.Progress < mission.Goal then return false, "Misión sin completar." end
	mission.Claimed = true
	S.PlayerService.sync(player, "Missions")
	S.EconomyService.add(player, "Stardust", mission.Stardust, "mission:" .. mission.Id)
	S.EconomyService.add(player, "Energy", mission.Energy, "mission:" .. mission.Id, false)
	return true, { Stardust = mission.Stardust, Energy = mission.Energy }
end

function MissionService.Init(services)
	S = services
	S.PlayerService.onLoaded(function(player)
		MissionService.refresh(player)
	end)
	S.PlayerService.onLeaving(function(player)
		dirty[player] = nil
	end)
	Net.handle("ClaimMission", { Args = { { "string", Max = 12 }, { "integer", Min = 1, Max = 10 } }, Cooldown = 0.2 }, claim)
end

function MissionService.Start()
	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(2)
			ticks = ticks + 1
			for player in pairs(dirty) do
				S.PlayerService.sync(player, "Missions")
			end
			dirty = {}
			if ticks % 15 == 0 then
				for player in pairs(S.PlayerService.all()) do
					MissionService.refresh(player)
				end
			end
		end
	end)
end

return MissionService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX43">
          <Properties>
            <string name="Name">PlanetPlacementService</string>
            <ProtectedString name="Source"><![CDATA[-- PlanetPlacementService: valida slots y colocacion orbital. El cliente solo solicita; el servidor
-- comprueba propiedad, sistema activo, slot desbloqueado y estado, y replica la colocacion autorizada.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Net = require(script.Parent.Parent.Net)
local Config = Defs.Config
local Galaxy = Defs.Galaxy

local PlanetPlacementService = {}
local S = nil

local function afterChange(player, systemId)
	S.PlayerService.sync(player, "Placed", systemId)
	S.ProductionService.recalc(player)
	S.UniverseService.publish(player)
	S.DiscoveryService.checkSecrets(player)
end

local function equip(player, uid, systemId, slotIndex)
	local profile = S.PlayerService.profile(player)
	if not Galaxy.ById[systemId] or not profile.Systems[systemId] then return false, "Ese sistema no está desbloqueado." end
	if systemId ~= profile.ActiveSystem then return false, "Viaja a ese sistema antes de colocar planetas en él." end
	if slotIndex > (profile.Slots[systemId] or 0) then return false, "Ese slot orbital está bloqueado." end
	local inst = profile.Planets[uid]
	if not inst then return false, "Ese planeta no es tuyo." end
	if S.InventoryService.isBusy(player, uid) then return false, "Ese planeta está en un intercambio." end
	local slotKey = Galaxy.slotKey(slotIndex)
	local slots = profile.Placed[systemId]
	if slots[slotKey] == uid then return true, { Slot = slotIndex } end
	-- si ya estaba colocado en otro sitio, se mueve (una instancia nunca ocupa dos slots)
	local oldSystem, oldSlot = Progression.findPlaced(profile, uid)
	if oldSystem then
		profile.Placed[oldSystem][oldSlot] = nil
		if oldSystem ~= systemId then S.PlayerService.sync(player, "Placed", oldSystem) end
	end
	local replaced = slots[slotKey]
	slots[slotKey] = uid
	S.MissionService.progress(player, "PlacePlanets", 1)
	S.PlayerService.tutorialEvent(player, "place_planet")
	afterChange(player, systemId)
	return true, { Slot = slotIndex, Replaced = replaced }
end

local function unequip(player, systemId, slotIndex)
	local profile = S.PlayerService.profile(player)
	if not Galaxy.ById[systemId] or not profile.Systems[systemId] then return false, "Ese sistema no está desbloqueado." end
	local slotKey = Galaxy.slotKey(slotIndex)
	local slots = profile.Placed[systemId]
	if not slots[slotKey] then return false, "Ese slot ya está vacío." end
	slots[slotKey] = nil
	afterChange(player, systemId)
	return true
end

local function unlockSlot(player, systemId)
	local profile = S.PlayerService.profile(player)
	if not Galaxy.ById[systemId] or not profile.Systems[systemId] then return false, "Ese sistema no está desbloqueado." end
	local cost = Progression.nextSlotCost(profile, systemId)
	if not cost then return false, "Ya tienes los " .. Config.Economy.SlotsPerSystem .. " slots de este sistema." end
	if not S.EconomyService.spend(player, "Energy", cost, "slot:" .. systemId) then
		return false, "No tienes suficiente Energy."
	end
	profile.Slots[systemId] = profile.Slots[systemId] + 1
	S.PlayerService.sync(player, "Slots", systemId)
	S.UniverseService.publish(player)
	return true, { Slots = profile.Slots[systemId] }
end

-- Retira todos los planetas (usado por la ascension)
function PlanetPlacementService.clearAll(player)
	local profile = S.PlayerService.profile(player)
	for sysId in pairs(profile.Placed) do
		profile.Placed[sysId] = {}
	end
end

function PlanetPlacementService.Init(services)
	S = services
	local slotArg = { "integer", Min = 1, Max = Config.Economy.SlotsPerSystem }
	Net.handle("EquipPlanet", { Args = { { "string", Max = 16 }, { "string", Max = 16 }, slotArg }, Cooldown = 0.1 }, equip)
	Net.handle("UnequipPlanet", { Args = { { "string", Max = 16 }, slotArg }, Cooldown = 0.1 }, unequip)
	Net.handle("UnlockSlot", { Args = { { "string", Max = 16 } }, Cooldown = 0.2 }, unlockSlot)
end

function PlanetPlacementService.Start() end

return PlanetPlacementService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX44">
          <Properties>
            <string name="Name">PlayerService</string>
            <ProtectedString name="Source"><![CDATA[-- PlayerService: ciclo de vida del jugador, sesion en memoria, replicacion de estado al cliente,
-- aparicion del personaje, tutorial y ajustes.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Format = require(Shared.Util.Format)
local Net = require(script.Parent.Parent.Net)
local Config = Defs.Config

local PlayerService = {}
local S = nil

local sessions = {}
local loadedCallbacks = {}
local leavingCallbacks = {}

function PlayerService.get(player)
	return sessions[player]
end

function PlayerService.profile(player)
	local s = sessions[player]
	return s and s.Profile or nil
end

function PlayerService.isLoaded(player)
	return sessions[player] ~= nil
end

function PlayerService.all()
	return sessions
end

function PlayerService.onLoaded(fn)
	table.insert(loadedCallbacks, fn)
end

function PlayerService.onLeaving(fn)
	table.insert(leavingCallbacks, fn)
end

---------------------------------------------------------------- replicacion de estado
local function resolve(session, path)
	local node = session.Profile
	if string.sub(path[1], 1, 1) == "_" then node = session.Derived end
	for _, k in ipairs(path) do
		if type(node) ~= "table" then return nil end
		node = node[k]
	end
	return node
end

local function flush(player)
	local session = sessions[player]
	if not session then return end
	session.FlushScheduled = false
	local patches = {}
	for _, path in pairs(session.Pending) do
		table.insert(patches, { p = path, v = resolve(session, path) })
	end
	session.Pending = {}
	if #patches > 0 then
		Net.fire("StateUpdate", player, patches)
	end
end

-- Marca una ruta del perfil (o de Derived si empieza por "_") para enviarla al cliente en este frame.
function PlayerService.sync(player, ...)
	local session = sessions[player]
	if not session then return end
	local path = { ... }
	session.Pending[table.concat(path, "/")] = path
	if not session.FlushScheduled then
		session.FlushScheduled = true
		task.defer(flush, player)
	end
end

function PlayerService.setDerived(player, key, value)
	local session = sessions[player]
	if not session then return end
	session.Derived[key] = value
	PlayerService.sync(player, key)
end

function PlayerService.notify(player, kind, text, extra)
	Net.fire("Notify", player, { Kind = kind, Text = text, Extra = extra })
end

---------------------------------------------------------------- personaje
local function spawnCFrame(player)
	local session = sessions[player]
	if session and session.Location ~= "hub" and S.UniverseService then
		local cf = S.UniverseService.spawnCFrameFor(session.Location)
		if cf then return cf end
	end
	local angle = (player.UserId % 12) / 12 * math.pi * 2
	local offset = Vector3.new(math.cos(angle) * 6, 0, math.sin(angle) * 6)
	local pos = Config.World.HubSpawn + offset
	return CFrame.new(pos, Vector3.new(0, pos.Y, 0))
end

function PlayerService.placeCharacter(player, cf)
	local character = player.Character
	if not character then return false end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	root.AssemblyLinearVelocity = Vector3.zero
	character:PivotTo(cf)
	return true
end

local function onCharacterAdded(player, character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not root or not humanoid then return end
	task.wait()
	PlayerService.placeCharacter(player, spawnCFrame(player))
	humanoid.Died:Connect(function()
		task.wait(3)
		if player.Parent == Players and sessions[player] then
			player:LoadCharacter()
		end
	end)
end

---------------------------------------------------------------- tutorial
function PlayerService.tutorialEvent(player, stepName)
	local profile = PlayerService.profile(player)
	if not profile then return end
	local steps = Config.TutorialSteps
	local index = table.find(steps, stepName)
	-- completar un paso posterior tambien da por hechos los anteriores (el jugador se adelanto)
	if not index or profile.Tutorial > index then return end
	local wasDone = steps[profile.Tutorial] == "done"
	profile.Tutorial = index + 1
	PlayerService.sync(player, "Tutorial")
	if not wasDone and steps[profile.Tutorial] == "done" then
		S.EconomyService.add(player, "Stardust", 25, "tutorial")
		PlayerService.notify(player, "reward", "¡Tutorial completado! +25 Stardust")
	end
end

---------------------------------------------------------------- leaderstats
local function createLeaderstats(player, profile)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local energy = Instance.new("StringValue")
	energy.Name = "Energy"
	energy.Value = Format.number(profile.Energy)
	energy.Parent = folder
	local asc = Instance.new("IntValue")
	asc.Name = "Ascensiones"
	asc.Value = profile.Ascensions
	asc.Parent = folder
	folder.Parent = player
end

function PlayerService.updateLeaderstats(player)
	local profile = PlayerService.profile(player)
	local folder = player:FindFirstChild("leaderstats")
	if not profile or not folder then return end
	local energy = folder:FindFirstChild("Energy")
	if energy then energy.Value = Format.number(profile.Energy) end
	local asc = folder:FindFirstChild("Ascensiones")
	if asc then asc.Value = profile.Ascensions end
end

---------------------------------------------------------------- ciclo de vida
local function onPlayerAdded(player)
	local profile, info = S.DataService.load(player)
	if not profile then
		if info ~= "desconectado" and player.Parent == Players then
			player:Kick(info)
		end
		return
	end
	local session = {
		Player = player,
		Profile = profile,
		Derived = { _Session = { SessionOnly = info.SessionOnly, Location = "hub", IsNew = info.IsNew } },
		Busy = {},
		Pending = {},
		Location = "hub",
		JoinClock = os.clock(),
		LastCapsule = 0,
	}
	sessions[player] = session
	for _, fn in ipairs(loadedCallbacks) do
		local ok, err = pcall(fn, player, session, info)
		if not ok then warn("[PlayerService] error en onLoaded: " .. tostring(err)) end
	end
	createLeaderstats(player, profile)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Parent == Players then
		player:LoadCharacter()
	end
end

local function onPlayerRemoving(player)
	local session = sessions[player]
	if not session then return end
	for _, fn in ipairs(leavingCallbacks) do
		local ok, err = pcall(fn, player, session)
		if not ok then warn("[PlayerService] error en onLeaving: " .. tostring(err)) end
	end
	session.Profile.Stats.PlayTime = session.Profile.Stats.PlayTime + (os.clock() - session.JoinClock)
	sessions[player] = nil
	S.DataService.save(player, true)
	S.DataService.forget(player)
end

function PlayerService.Init(services)
	S = services
	Net.event("StateUpdate")
	Net.event("Notify")

	Net.handle("GetState", { NoProfile = true, Cooldown = 0.2 }, function(player)
		local session = sessions[player]
		if not session then return false, "loading" end
		return true, { Profile = session.Profile, Derived = session.Derived, ServerTime = os.time() }
	end)

	Net.handle("TutorialAck", { Args = { { "string", Max = 32 } }, Cooldown = 0.3 }, function(player, stepName)
		if stepName ~= "welcome" and stepName ~= "watch_production" then return false, "Paso inválido." end
		PlayerService.tutorialEvent(player, stepName)
		return true
	end)

	Net.handle("SkipTutorial", { Cooldown = 1 }, function(player)
		local profile = PlayerService.profile(player)
		if profile.Tutorial < #Config.TutorialSteps then
			profile.Tutorial = #Config.TutorialSteps
			PlayerService.sync(player, "Tutorial")
		end
		return true
	end)

	Net.handle("UpdateSetting", { Args = { { "string", Max = 32 }, { "boolean" } }, Cooldown = 0.1 }, function(player, key, value)
		if Config.DefaultSettings[key] == nil then return false, "Ajuste desconocido." end
		local profile = PlayerService.profile(player)
		profile.Settings[key] = value
		PlayerService.sync(player, "Settings", key)
		return true
	end)
end

function PlayerService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
end

return PlayerService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX45">
          <Properties>
            <string name="Name">ProductionService</string>
            <ProtectedString name="Source"><![CDATA[-- ProductionService: calcula y cachea la produccion agregada de cada jugador (con desglose).
-- Solo se recalcula cuando cambia algo relevante (colocacion, mejoras, ascension, evento...).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Progression = require(Shared.Progression)

local ProductionService = {}
local S = nil

function ProductionService.recalc(player)
	local session = S.PlayerService.get(player)
	if not session then return nil end
	local production = Progression.production(session.Profile, S.EventService.productionMultiplier())
	S.PlayerService.setDerived(player, "_Production", production)
	return production
end

function ProductionService.rate(player)
	local session = S.PlayerService.get(player)
	local production = session and session.Derived._Production
	return production and production.Total or 0
end

function ProductionService.recalcAll()
	for player in pairs(S.PlayerService.all()) do
		ProductionService.recalc(player)
	end
end

function ProductionService.Init(services)
	S = services
	S.PlayerService.onLoaded(function(player)
		ProductionService.recalc(player)
	end)
end

function ProductionService.Start() end

return ProductionService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX46">
          <Properties>
            <string name="Name">RebirthService</string>
            <ProtectedString name="Source"><![CDATA[-- RebirthService: Galactic Ascension. Valida el requisito del siguiente hito, reinicia la progresion
-- seleccionada y entrega multiplicador permanente + Cosmic Cores. El reinicio se hace en memoria sin
-- esperas intermedias (atomico) y se guarda inmediatamente despues.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Net = require(script.Parent.Parent.Net)

local RebirthService = {}
local S = nil

local function rebirth(player, confirmed)
	if not confirmed then return false, "La ascensión requiere confirmación." end
	local session = S.PlayerService.get(player)
	local profile = session.Profile
	if S.TradingService.isTrading(player) then return false, "Termina tu intercambio antes de ascender." end
	local milestone = Defs.Ascension.next(profile.Ascensions)
	for _, requirement in ipairs(milestone.Requirements) do
		local check = Progression.checkRequirement(profile, requirement, S.ProductionService.rate(player))
		if not check.Ok then return false, "Aún no cumples el requisito: " .. check.Text end
	end

	-- reinicio atomico (sin yields)
	profile.Ascensions = milestone.Index
	profile.Cores = profile.Cores + milestone.Cores
	profile.RunEnergy = 0
	for id, _ in pairs(profile.Upgrades) do
		if Defs.Upgrades.ById[id].Currency == "Energy" then
			profile.Upgrades[id] = nil
		end
	end
	profile.Energy = Progression.startingEnergy(profile)
	profile.Systems = { solar = true }
	profile.Placed = { solar = {} }
	profile.Slots = { solar = Defs.Galaxy.ById.solar.FreeSlots }
	profile.ActiveSystem = "solar"

	for _, key in ipairs({ "Ascensions", "Cores", "RunEnergy", "Upgrades", "Energy", "Systems", "Placed", "Slots", "ActiveSystem" }) do
		S.PlayerService.sync(player, key)
	end
	S.MissionService.refresh(player)
	S.ProductionService.recalc(player)
	S.UniverseService.publish(player)
	S.PlayerService.updateLeaderstats(player)
	task.spawn(S.DataService.save, player, false)
	return true, { Ascensions = milestone.Index, Multiplier = milestone.Multiplier, Cores = milestone.Cores }
end

function RebirthService.Init(services)
	S = services
	Net.handle("Rebirth", { Args = { { "boolean" } }, Cooldown = 2 }, rebirth)
end

function RebirthService.Start() end

return RebirthService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX47">
          <Properties>
            <string name="Name">TradingService</string>
            <ProtectedString name="Source"><![CDATA[-- TradingService: Galactic Trading seguro. Invitacion -> ofertas -> ambos "Listo" -> periodo de
-- revision -> confirmacion final de ambos -> el servidor revalida propiedad/estado y transfiere.
-- Cualquier cambio de oferta reinicia las confirmaciones. Se cancela si un jugador se va.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Net = require(script.Parent.Parent.Net)
local Config = Defs.Config

local TradingService = {}
local S = nil

local trades = {} -- [player] = trade
local requests = {} -- [target] = { [fromUserId] = expira (os.clock) }

function TradingService.isTrading(player)
	return trades[player] ~= nil
end

local function sides(trade, player)
	if trade.A.Player == player then return trade.A, trade.B end
	return trade.B, trade.A
end

local function items(side)
	local profile = S.PlayerService.profile(side.Player)
	local out = {}
	for _, uid in ipairs(side.Offer) do
		local inst = profile and profile.Planets[uid]
		if inst then
			table.insert(out, { Uid = uid, Id = inst.Id, V = inst.V, E = inst.E })
		end
	end
	return out
end

local function push(trade)
	for _, side in ipairs({ trade.A, trade.B }) do
		local mine, theirs = sides(trade, side.Player)
		Net.fire("TradeUpdate", side.Player, {
			Stage = trade.Stage,
			ReviewEndsAt = trade.ReviewEndsAt,
			You = { Offer = items(mine), Ready = mine.Ready, Confirmed = mine.Confirmed },
			Them = { UserId = theirs.Player.UserId, Name = theirs.Player.DisplayName, Offer = items(theirs),
				Ready = theirs.Ready, Confirmed = theirs.Confirmed },
		})
	end
end

local function releaseBusy(side)
	local session = S.PlayerService.get(side.Player)
	if session then
		for _, uid in ipairs(side.Offer) do
			session.Busy[uid] = nil
		end
	end
end

local function endTrade(trade, reason, completed)
	releaseBusy(trade.A)
	releaseBusy(trade.B)
	trades[trade.A.Player] = nil
	trades[trade.B.Player] = nil
	for _, side in ipairs({ trade.A, trade.B }) do
		Net.fire("TradeUpdate", side.Player, { Stage = "closed", Reason = reason, Completed = completed == true })
	end
end

local function resetConfirmations(trade)
	trade.Stage = "offer"
	trade.ReviewEndsAt = nil
	trade.A.Ready, trade.B.Ready = false, false
	trade.A.Confirmed, trade.B.Confirmed = false, false
end

local function request(player, targetUserId)
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then return false, "Jugador no disponible." end
	if not S.PlayerService.isLoaded(target) then return false, "Ese jugador aún está cargando." end
	if trades[player] then return false, "Ya estás en un intercambio." end
	if trades[target] then return false, "Ese jugador ya está en un intercambio." end
	local list = requests[target]
	if not list then
		list = {}
		requests[target] = list
	end
	list[player.UserId] = os.clock() + Config.Trade.RequestTimeout
	Net.fire("TradeUpdate", target, { Stage = "request", From = player.UserId, Name = player.DisplayName,
		Timeout = Config.Trade.RequestTimeout })
	return true
end

local function respond(player, fromUserId, accept)
	local list = requests[player]
	local expires = list and list[fromUserId]
	if not expires then return false, "Esa invitación ya no existe." end
	list[fromUserId] = nil
	local from = Players:GetPlayerByUserId(fromUserId)
	if not accept then
		if from then S.PlayerService.notify(from, "info", player.DisplayName .. " rechazó tu invitación de intercambio.") end
		return true
	end
	if expires < os.clock() then return false, "La invitación caducó." end
	if not from or not S.PlayerService.isLoaded(from) then return false, "Ese jugador ya no está." end
	if trades[player] or trades[from] then return false, "Uno de los dos ya está en un intercambio." end
	local trade = {
		A = { Player = from, Offer = {}, Ready = false, Confirmed = false },
		B = { Player = player, Offer = {}, Ready = false, Confirmed = false },
		Stage = "offer",
	}
	trades[from] = trade
	trades[player] = trade
	push(trade)
	return true
end

local function validOffer(player, uid)
	local profile = S.PlayerService.profile(player)
	local inst = profile and profile.Planets[uid]
	if not inst then return false, "Ese planeta no es tuyo." end
	if inst.L then return false, "Desbloquea el planeta antes de ofrecerlo." end
	if Progression.findPlaced(profile, uid) then return false, "Retira el planeta de su órbita antes de ofrecerlo." end
	return true
end

local function execute(trade)
	local a, b = trade.A, trade.B
	local profileA = S.PlayerService.profile(a.Player)
	local profileB = S.PlayerService.profile(b.Player)
	if not profileA or not profileB then
		endTrade(trade, "Un jugador se desconectó.")
		return false
	end
	-- revalidar propiedad y estado justo antes de transferir
	for _, side in ipairs({ a, b }) do
		local seen = {}
		for _, uid in ipairs(side.Offer) do
			if seen[uid] or not validOffer(side.Player, uid) then
				endTrade(trade, "La oferta dejó de ser válida.")
				return false
			end
			seen[uid] = true
		end
	end
	local afterA = Progression.inventoryCount(profileA) - #a.Offer + #b.Offer
	local afterB = Progression.inventoryCount(profileB) - #b.Offer + #a.Offer
	if afterA > Progression.inventoryCapacity(profileA) or afterB > Progression.inventoryCapacity(profileB) then
		endTrade(trade, "Uno de los inventarios no tiene espacio.")
		return false
	end
	-- transferencia (sin yields entre la validacion y el final)
	local offerA, offerB = a.Offer, b.Offer
	releaseBusy(a)
	releaseBusy(b)
	a.Offer, b.Offer = {}, {}
	S.InventoryService.transfer(a.Player, b.Player, offerA)
	S.InventoryService.transfer(b.Player, a.Player, offerB)
	for _, side in ipairs({ a, b }) do
		local profile = S.PlayerService.profile(side.Player)
		profile.Stats.Trades = profile.Stats.Trades + 1
		S.MissionService.progress(side.Player, "CompleteTrade", 1)
	end
	endTrade(trade, "Intercambio completado.", true)
	task.spawn(S.DataService.save, a.Player, false)
	task.spawn(S.DataService.save, b.Player, false)
	return true
end

local function action(player, name, uid)
	local trade = trades[player]
	if not trade then return false, "No estás en un intercambio." end
	local mine = sides(trade, player)
	if name == "cancel" then
		endTrade(trade, player.DisplayName .. " canceló el intercambio.")
		return true
	elseif name == "add" then
		if not uid then return false, "Falta el planeta." end
		if #mine.Offer >= Config.Trade.MaxItemsPerSide then return false, "Máximo " .. Config.Trade.MaxItemsPerSide .. " planetas por oferta." end
		for _, offered in ipairs(mine.Offer) do
			if offered == uid then return false, "Ya ofreciste ese planeta." end
		end
		local ok, reason = validOffer(player, uid)
		if not ok then return false, reason end
		table.insert(mine.Offer, uid)
		S.PlayerService.get(player).Busy[uid] = true
		resetConfirmations(trade)
	elseif name == "remove" then
		local index = uid and table.find(mine.Offer, uid)
		if not index then return false, "Ese planeta no está en tu oferta." end
		table.remove(mine.Offer, index)
		S.PlayerService.get(player).Busy[uid] = nil
		resetConfirmations(trade)
	elseif name == "ready" then
		if trade.Stage ~= "offer" then return false, "La oferta ya está en revisión." end
		mine.Ready = true
		if trade.A.Ready and trade.B.Ready then
			trade.Stage = "review"
			trade.ReviewEndsAt = os.time() + Config.Trade.ReviewSeconds
		end
	elseif name == "unready" then
		resetConfirmations(trade)
	else
		return false, "Acción desconocida."
	end
	push(trade)
	return true
end

local function confirm(player)
	local trade = trades[player]
	if not trade then return false, "No estás en un intercambio." end
	if trade.Stage ~= "review" then return false, "Ambos jugadores deben marcar Listo primero." end
	if os.time() < trade.ReviewEndsAt then return false, "Revisa la oferta unos segundos antes de confirmar." end
	local mine = sides(trade, player)
	mine.Confirmed = true
	if trade.A.Confirmed and trade.B.Confirmed then
		execute(trade)
	else
		push(trade)
	end
	return true
end

function TradingService.Init(services)
	S = services
	Net.event("TradeUpdate")
	Net.handle("RequestTrade", { Args = { { "integer", Min = 1, Max = 1e15 } }, Cooldown = 2 }, request)
	Net.handle("RespondTrade", { Args = { { "integer", Min = 1, Max = 1e15 }, { "boolean" } }, Cooldown = 0.3 }, respond)
	Net.handle("TradeAction", { Args = { { "string", Max = 12 }, { "string", Max = 16, Optional = true } }, Cooldown = 0.1 }, action)
	Net.handle("ConfirmTrade", { Cooldown = 0.3 }, confirm)
	S.PlayerService.onLeaving(function(player)
		local trade = trades[player]
		if trade then endTrade(trade, player.DisplayName .. " se desconectó.") end
		requests[player] = nil
	end)
end

function TradingService.Start() end

return TradingService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX48">
          <Properties>
            <string name="Name">UniverseService</string>
            <ProtectedString name="Source"><![CDATA[-- UniverseService: asigna una parcela (universo personal) a cada jugador, gestiona los viajes
-- Hub <-> universo y las visitas de solo lectura, y publica la vista publica de cada universo.
-- Solo se construye la estructura fija de la parcela; los cinco sistemas se activan dentro de ella.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Progression = require(Shared.Progression)
local Layout = require(Shared.UniverseLayout)
local Net = require(script.Parent.Parent.Net)
local UniverseBuilder = require(script.Parent.Parent.World.UniverseBuilder)
local Config = Defs.Config

local UniverseService = {}
local S = nil

local plots = {} -- [indice] = player
local plotOf = {} -- [player] = indice
local models = {} -- [player] = Model
local pending = {} -- publicaciones pendientes en este frame
local visited = {} -- [player] = { [userId] = true }

local function locationOf(userId)
	return "u:" .. tostring(userId)
end

local function ownerFromLocation(location)
	local userId = tonumber(string.match(location, "^u:(%d+)$"))
	return userId and Players:GetPlayerByUserId(userId) or nil
end

-- Vista publica (solo lectura) del universo de un jugador
function UniverseService.view(player)
	local session = S.PlayerService.get(player)
	local index = plotOf[player]
	if not session or not index then return nil end
	local profile = session.Profile
	local systemId = profile.ActiveSystem
	local planets = {}
	for slotKey, uid in pairs(profile.Placed[systemId] or {}) do
		local inst = profile.Planets[uid]
		if inst then
			planets[slotKey] = { Id = inst.Id, V = inst.V, E = inst.E, Uid = uid }
		end
	end
	local systems = {}
	for _, sysId in ipairs(Defs.Galaxy.Order) do
		if profile.Systems[sysId] then table.insert(systems, sysId) end
	end
	local found, total = Progression.discoveryTotals(profile)
	return {
		Owner = player.UserId,
		Name = player.DisplayName,
		Plot = index,
		Center = Layout.plotCenter(index),
		System = systemId,
		Slots = profile.Slots[systemId] or 0,
		Planets = planets,
		Cosmetics = { OrbitColor = profile.Cosmetics.Equipped.OrbitColor, StarAura = profile.Cosmetics.Equipped.StarAura },
		Stats = { Rate = S.ProductionService.rate(player), Ascensions = profile.Ascensions, Discovered = found,
			DiscoveredTotal = total, Systems = systems },
	}
end

-- Publica la vista a todos los clientes (agrupando varias llamadas del mismo frame)
function UniverseService.publish(player)
	if pending[player] then return end
	pending[player] = true
	task.defer(function()
		pending[player] = nil
		local view = UniverseService.view(player)
		if view then Net.fireAll("UniverseUpdate", view) end
	end)
end

function UniverseService.spawnCFrameFor(location)
	local owner = ownerFromLocation(location)
	local index = owner and plotOf[owner]
	if not index then return nil end
	return Layout.spawnCFrame(Layout.plotCenter(index), os.clock() * 7)
end

local function setLocation(player, location)
	local session = S.PlayerService.get(player)
	session.Location = location
	session.Derived._Session.Location = location
	S.PlayerService.sync(player, "_Session", "Location")
end

local function goHub(player)
	setLocation(player, "hub")
	local angle = (os.clock() * 3) % (math.pi * 2)
	local pos = Config.World.HubSpawn + Vector3.new(math.cos(angle) * 5, 0, math.sin(angle) * 5)
	S.PlayerService.placeCharacter(player, CFrame.new(pos, Vector3.new(0, pos.Y, 0)))
end

local function goUniverse(player, owner)
	local location = locationOf(owner.UserId)
	local cf = UniverseService.spawnCFrameFor(location)
	if not cf then return false end
	setLocation(player, location)
	S.PlayerService.placeCharacter(player, cf)
	return true
end

local function teleport(player, destination)
	if destination == "hub" then
		goHub(player)
		return true, { Location = "hub" }
	elseif destination == "universe" then
		if not goUniverse(player, player) then return false, "Tu universo aún no está listo." end
		S.PlayerService.tutorialEvent(player, "go_universe")
		return true, { Location = locationOf(player.UserId) }
	end
	return false, "Destino desconocido."
end

local function visit(player, targetUserId)
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or not S.PlayerService.isLoaded(target) or not plotOf[target] then
		return false, "Ese universo no está disponible."
	end
	if target == player then return teleport(player, "universe") end
	if not goUniverse(player, target) then return false, "Ese universo no está disponible." end
	local seen = visited[player]
	if not seen[targetUserId] then
		seen[targetUserId] = true
		local profile = S.PlayerService.profile(player)
		profile.Stats.Visits = profile.Stats.Visits + 1
		S.MissionService.progress(player, "VisitUniverse", 1)
		S.PlayerService.notify(target, "info", player.DisplayName .. " está visitando tu universo.")
	end
	return true, { Location = locationOf(targetUserId) }
end

function UniverseService.Init(services)
	S = services
	Net.event("UniverseUpdate")
	Net.event("UniverseRemoved")

	S.PlayerService.onLoaded(function(player)
		local index = nil
		for i = 1, Config.World.PlotCount do
			if not plots[i] then
				index = i
				break
			end
		end
		if not index then
			-- no deberia ocurrir (PlotCount >= jugadores maximos): se comparte la ultima parcela
			index = Config.World.PlotCount
		end
		plots[index] = player
		plotOf[player] = index
		visited[player] = {}
		models[player] = UniverseBuilder.build(index, Layout.plotCenter(index), player.DisplayName)
		UniverseService.publish(player)
	end)

	S.PlayerService.onLeaving(function(player)
		local index = plotOf[player]
		local location = locationOf(player.UserId)
		for other, session in pairs(S.PlayerService.all()) do
			if other ~= player and session.Location == location then
				goHub(other)
				S.PlayerService.notify(other, "info", player.DisplayName .. " se fue: has vuelto al Cosmic Hub.")
			end
		end
		if index and plots[index] == player then plots[index] = nil end
		plotOf[player] = nil
		visited[player] = nil
		pending[player] = nil
		if models[player] then
			models[player]:Destroy()
			models[player] = nil
		end
		Net.fireAll("UniverseRemoved", player.UserId)
	end)

	Net.handle("Teleport", { Args = { { "string", Max = 16 } }, Cooldown = 0.8 }, teleport)
	Net.handle("VisitUniverse", { Args = { { "integer", Min = 1, Max = 1e15 } }, Cooldown = 0.8 }, visit)
	Net.handle("GetUniverses", { NoProfile = true, Cooldown = 0.5 }, function()
		local list = {}
		for player in pairs(plotOf) do
			local view = UniverseService.view(player)
			if view then table.insert(list, view) end
		end
		return true, list
	end)
end

function UniverseService.Start()
	-- refresco periodico de estadisticas publicas (produccion mostrada a visitantes)
	task.spawn(function()
		while true do
			task.wait(15)
			for player in pairs(plotOf) do
				UniverseService.publish(player)
			end
		end
	end)
end

return UniverseService
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX49">
          <Properties>
            <string name="Name">UpgradeService</string>
            <ProtectedString name="Source"><![CDATA[-- UpgradeService: costes, niveles y efectos de mejoras. El precio siempre se calcula en el servidor.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Net = require(script.Parent.Parent.Net)

local UpgradeService = {}
local S = nil

local function purchase(player, upgradeId)
	local profile = S.PlayerService.profile(player)
	local def = Defs.Upgrades.ById[upgradeId]
	if not def then return false, "Mejora desconocida." end
	local level = Defs.Upgrades.level(profile, upgradeId)
	if level >= def.MaxLevel then return false, "Esa mejora ya está al máximo." end
	local cost = def.Cost(level)
	if not S.EconomyService.spend(player, def.Currency, cost, "upgrade:" .. upgradeId) then
		if def.Currency == "Cores" then return false, "No tienes suficientes Cosmic Cores." end
		return false, "No tienes suficiente Energy."
	end
	profile.Upgrades[upgradeId] = level + 1
	S.PlayerService.sync(player, "Upgrades", upgradeId)
	profile.Stats.UpgradesBought = profile.Stats.UpgradesBought + 1
	S.MissionService.progress(player, "BuyUpgrades", 1)
	S.PlayerService.tutorialEvent(player, "buy_upgrade")
	S.ProductionService.recalc(player)
	return true, { Level = level + 1, Spent = cost }
end

function UpgradeService.Init(services)
	S = services
	Net.handle("PurchaseUpgrade", { Args = { { "string", Max = 24 } }, Cooldown = 0.08 }, purchase)
end

function UpgradeService.Start() end

return UpgradeService
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX50">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX51">
          <Properties>
            <string name="Name">Environment</string>
            <ProtectedString name="Source"><![CDATA[-- Environment: iluminacion, cielo y posprocesado del espacio profundo (azul noche, cian y violeta).
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Assets = require(ReplicatedStorage:WaitForChild("Shared").Assets)

local Environment = {}

function Environment.apply()
	Lighting.ClockTime = 0
	Lighting.GeographicLatitude = 35
	Lighting.Brightness = 1.6
	Lighting.Ambient = Color3.fromRGB(108, 114, 150)
	Lighting.OutdoorAmbient = Color3.fromRGB(112, 116, 162)
	Lighting.ColorShift_Top = Color3.fromRGB(120, 140, 255)
	Lighting.ColorShift_Bottom = Color3.fromRGB(90, 60, 160)
	Lighting.EnvironmentDiffuseScale = 0.45
	Lighting.EnvironmentSpecularScale = 0.9
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 100000
	Lighting.ExposureCompensation = 0.25

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") or child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.Name = "DeepSpace"
	sky.CelestialBodiesShown = false
	sky.StarCount = 3000
	local box = Assets.Skybox
	if box then
		sky.SkyboxBk = Assets.url(box.Bk)
		sky.SkyboxDn = Assets.url(box.Dn)
		sky.SkyboxFt = Assets.url(box.Ft)
		sky.SkyboxLf = Assets.url(box.Lf)
		sky.SkyboxRt = Assets.url(box.Rt)
		sky.SkyboxUp = Assets.url(box.Up)
	end
	sky.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "Bloom"
	bloom.Intensity = 0.85
	bloom.Size = 30
	bloom.Threshold = 1.1
	bloom.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "Grade"
	color.Contrast = 0.12
	color.Saturation = 0.18
	color.Brightness = 0.02
	color.TintColor = Color3.fromRGB(235, 238, 255)
	color.Parent = Lighting

	-- camara: permitir alejarse para contemplar el universo
	StarterPlayer.CameraMaxZoomDistance = 90
	StarterPlayer.CameraMinZoomDistance = 0.5
end

return Environment
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX52">
          <Properties>
            <string name="Name">HubBuilder</string>
            <ProtectedString name="Source"><![CDATA[-- HubBuilder: construye el COSMIC HUB (estacion orbital compartida) por codigo.
-- Compacto y sin laberintos: desde el spawn se ven el nucleo central y las cinco instalaciones
-- (Capsule Station, Galactic Market, Leaderboard, Portal Room y Event Terminal).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Build = require(Shared.Util.Build)
local Format = require(Shared.Util.Format)
local PlanetVisual = require(Shared.PlanetVisual)
local C = Build.Colors

local HubBuilder = {}

local FLOOR_RADIUS = 120
local CENTER = Vector3.new(0, 0, 0)

local function facing(pos, target)
	return CFrame.lookAt(pos, Vector3.new(target.X, pos.Y, target.Z))
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

---------------------------------------------------------------- suelo y borde
local function buildFloor(parent)
	Build.cylinder({ Position = Vector3.new(0, -2, 0), Radius = FLOOR_RADIUS, Height = 4 },
		{ Name = "Floor", Color = C.Deck, Material = Enum.Material.SmoothPlastic, Reflectance = 0.14, Parent = parent })
	Build.cylinder({ Position = Vector3.new(0, -5, 0), Radius = FLOOR_RADIUS - 6, Height = 2 },
		{ Name = "Underglow", Color = C.Blue, Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false, Parent = parent })
	Build.cylinder({ Position = Vector3.new(0, -10, 0), Radius = FLOOR_RADIUS - 20, Height = 8 },
		{ Name = "Keel", Color = C.Hull, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })

	local inlays = folder("Inlays", parent)
	local rings = { { 31, C.Cyan, 0.7 }, { 66, C.Violet, 0.6 }, { 101, C.Cyan, 0.7 } }
	for _, r in ipairs(rings) do
		Build.ring({ CFrame = CFrame.new(0, 0.1, 0), Radius = r[1], Width = r[3], Height = 0.24, Segments = 56 },
			{ Color = r[2], Material = Enum.Material.Neon, Parent = inlays })
	end
	for i = 0, 11 do
		local angle = i / 12 * math.pi * 2 + math.rad(15)
		local color = (i % 2 == 0) and C.Cyan or C.Violet
		Build.neon({ Name = "Ray", Size = Vector3.new(34, 0.2, 0.35), Color = color, Transparency = 0.25,
			CFrame = CFrame.new(0, 0.09, 0) * CFrame.Angles(0, -angle, 0) * CFrame.new(83.5, 0, 0), Parent = inlays })
		Build.neon({ Name = "Ray", Size = Vector3.new(34, 0.2, 0.35), Color = color, Transparency = 0.25,
			CFrame = CFrame.new(0, 0.09, 0) * CFrame.Angles(0, -angle, 0) * CFrame.new(48.5, 0, 0), Parent = inlays })
	end
	-- paneles oscuros alternos para dar ritmo al suelo
	for i = 0, 23 do
		local angle = i / 24 * math.pi * 2
		Build.decor({ Name = "Tile", Size = Vector3.new(26, 0.16, 9), Color = C.Hull, Material = Enum.Material.Metal,
			CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, -angle, 0) * CFrame.new(84, 0, 0), Parent = inlays })
	end

	local rim = folder("Rim", parent)
	Build.ring({ CFrame = CFrame.new(0, 1.6, 0), Radius = FLOOR_RADIUS - 1.2, Width = 2.4, Height = 3.2, Segments = 48, Collide = true },
		{ Color = C.Hull, Material = Enum.Material.Metal, Parent = rim })
	Build.ring({ CFrame = CFrame.new(0, 3.35, 0), Radius = FLOOR_RADIUS - 1.2, Width = 0.7, Height = 0.3, Segments = 48 },
		{ Color = C.Cyan, Material = Enum.Material.Neon, Parent = rim })
	Build.ring({ CFrame = CFrame.new(0, 24, 0), Radius = FLOOR_RADIUS - 0.5, Width = 1, Height = 48, Segments = 32, Collide = true },
		{ Name = "Barrier", Transparency = 1, Parent = rim })

	-- punto de aparicion
	local spawnPos = Defs.Config.World.HubSpawn
	Build.cylinder({ Position = Vector3.new(spawnPos.X, 0.08, spawnPos.Z), Radius = 9, Height = 0.16 },
		{ Name = "SpawnPad", Color = C.HullLight, Material = Enum.Material.Metal, CanCollide = false, Parent = parent })
	Build.ring({ CFrame = CFrame.new(spawnPos.X, 0.2, spawnPos.Z), Radius = 9, Width = 0.5, Height = 0.12, Segments = 28 },
		{ Color = C.Cyan, Material = Enum.Material.Neon, Parent = inlays })
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Anchored = true
	spawn.CanCollide = false
	spawn.CanQuery = false
	spawn.Transparency = 1
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = facing(Vector3.new(spawnPos.X, 0.5, spawnPos.Z), CENTER)
	spawn.Parent = parent
end

---------------------------------------------------------------- nucleo central
local function buildCore(parent)
	local core = folder("Core", parent)
	local tiers = { { 28, 0.6 }, { 21, 1.8 }, { 14, 3.0 } }
	for i, t in ipairs(tiers) do
		Build.cylinder({ Position = Vector3.new(0, t[2], 0), Radius = t[1], Height = 1.2 },
			{ Name = "Tier" .. i, Color = (i % 2 == 1) and C.HullLight or C.Hull, Material = Enum.Material.Metal, Parent = core })
		Build.ring({ CFrame = CFrame.new(0, t[2] + 0.62, 0), Radius = t[1] - 0.4, Width = 0.45, Height = 0.14, Segments = 40 },
			{ Color = (i == 2) and C.Violet or C.Cyan, Material = Enum.Material.Neon, Parent = core })
	end
	Build.cylinder({ Position = Vector3.new(0, 4.0, 0), Radius = 7, Height = 0.8 },
		{ Name = "Projector", Color = C.Cyan, Material = Enum.Material.Neon, Transparency = 0.15, CanCollide = false, Parent = core })
	Build.cylinder({ Position = Vector3.new(0, 14, 0), Radius = 6, Height = 20 },
		{ Name = "Beam", Color = C.Cyan, Material = Enum.Material.Neon, Transparency = 0.92, CanCollide = false,
			CanQuery = false, Parent = core })
	Build.cylinder({ Position = Vector3.new(0, 46, 0), Radius = 0.5, Height = 26 },
		{ Name = "BeamCore", Color = C.White, Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false,
			CanQuery = false, Parent = core })

	-- holograma de planeta (el cliente lo hace girar)
	local globe = PlanetVisual.build("terra", "none", false, { Radius = 12, Static = true, Hologram = true })
	globe.Name = "HubGlobe"
	globe:PivotTo(CFrame.new(0, 26, 0))
	globe.Parent = core
	local ringColors = { C.Cyan, C.Violet, C.Blue }
	local tilts = { { 12, 0 }, { -24, 40 }, { 30, -30 } }
	for i = 1, 3 do
		local ringModel = Instance.new("Model")
		ringModel.Name = "HoloRing" .. i
		Build.ring({ CFrame = CFrame.new(0, 26, 0) * CFrame.Angles(math.rad(tilts[i][1]), 0, math.rad(tilts[i][2])),
			Radius = 16 + i * 2.6, Width = 0.35, Height = 0.35, Segments = 40 },
			{ Color = ringColors[i], Material = Enum.Material.Neon, Transparency = 0.15, Parent = ringModel })
		ringModel.Parent = core
	end
	local lamp = Build.decor({ Name = "CoreLight", Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(0, 12, 0), Parent = core })
	Build.light(lamp, C.Cyan, 60, 2.2)
	Build.particles(lamp, { Color = ColorSequence.new(C.Cyan, C.Violet), Rate = 14, Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(2, 4), Size = Build.sizeSeq(0.9), SpreadAngle = Vector2.new(25, 25) })

	-- titulo
	local anchor = Build.decor({ Name = "TitleAnchor", Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(0, 60, 0), Parent = core })
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Title"
	billboard.Size = UDim2.fromScale(74, 24)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 900
	billboard.Brightness = 1.6
	billboard.Parent = anchor
	local title = Build.label(billboard, "PLANET\nCOLLECTOR", { Font = Enum.Font.Michroma, TextColor3 = C.White, LineHeight = 0.95 })
	Build.stroke(title, C.Blue, 3, 0)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(170, 215, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 110, 255)) })
	gradient.Rotation = 90
	gradient.Parent = title
end

---------------------------------------------------------------- Capsule Station
local function buildCapsuleMachine(parent, def, cf)
	local model = Instance.new("Model")
	model.Name = "Capsule_" .. def.Id
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	local base = Build.cylinder({ CFrame = at(0, 0.5, 0), Radius = 4.6, Height = 1 },
		{ Name = "Base", Color = C.HullLight, Material = Enum.Material.Metal, Parent = model })
	Build.ring({ CFrame = at(0, 1.06, 0), Radius = 4.3, Width = 0.4, Height = 0.14, Segments = 24 },
		{ Color = def.Color, Material = Enum.Material.Neon, Parent = model })
	Build.cylinder({ CFrame = at(0, 1.5, 0), Radius = 3.3, Height = 1 },
		{ Name = "Pedestal", Color = C.Hull, Material = Enum.Material.Metal, Parent = model })
	Build.cylinder({ CFrame = at(0, 6, 0), Radius = 2.9, Height = 8 },
		{ Name = "Glass", Color = def.Color, Material = Enum.Material.Glass, Transparency = 0.6, CanCollide = false, Parent = model })
	Build.cylinder({ CFrame = at(0, 10.6, 0), Radius = 3.4, Height = 1.2 },
		{ Name = "Cap", Color = C.HullLight, Material = Enum.Material.Metal, CanCollide = false, Parent = model })
	Build.ring({ CFrame = at(0, 11.25, 0), Radius = 3.1, Width = 0.35, Height = 0.14, Segments = 20 },
		{ Color = def.Color, Material = Enum.Material.Neon, Parent = model })
	Build.cylinder({ CFrame = at(0, 12.4, 0), Radius = 0.25, Height = 2.6 },
		{ Name = "Antenna", Color = C.Trim, Material = Enum.Material.Metal, CanCollide = false, Parent = model })
	Build.ball({ CFrame = at(0, 13.9, 0), Radius = 0.5 },
		{ Name = "Beacon", Color = def.CoreColor, Material = Enum.Material.Neon, CanCollide = false, Parent = model })

	-- capsula flotante (el cliente la hace levitar y girar)
	local capsule = Instance.new("Model")
	capsule.Name = "Capsule"
	local corePart = Build.cylinder({ CFrame = at(0, 6, 0), Radius = 1.25, Height = 2.4 },
		{ Name = "Core", Color = def.CoreColor, Material = Enum.Material.Neon, Transparency = 0.05, CanCollide = false, Parent = capsule })
	Build.ball({ CFrame = at(0, 7.2, 0), Radius = 1.25 },
		{ Name = "Top", Color = C.White, Material = Enum.Material.SmoothPlastic, Reflectance = 0.3, CanCollide = false, Parent = capsule })
	Build.ball({ CFrame = at(0, 4.8, 0), Radius = 1.25 },
		{ Name = "Bottom", Color = def.Color, Material = Enum.Material.SmoothPlastic, Reflectance = 0.2, CanCollide = false, Parent = capsule })
	capsule.PrimaryPart = corePart
	capsule.Parent = model
	Build.light(corePart, def.Color, 20, 2)
	Build.particles(corePart, { Color = ColorSequence.new(def.CoreColor, def.Color), Rate = 8, Speed = NumberRange.new(0.4, 1.2),
		Size = Build.sizeSeq(0.5), Lifetime = NumberRange.new(1, 2) })

	for _, y in ipairs({ 3.4, 8.6 }) do
		Build.ring({ CFrame = at(0, y, 0), Radius = 3.25, Width = 0.25, Height = 0.25, Segments = 20 },
			{ Color = def.CoreColor, Material = Enum.Material.Neon, Transparency = 0.1, Parent = model })
	end
	for _, side in ipairs({ -1, 1 }) do
		Build.cylinder({ CFrame = at(side * 4.1, 4.5, 0.6), Radius = 0.65, Height = 7 },
			{ Name = "Coil", Color = C.Hull, Material = Enum.Material.Metal, CanCollide = false, Parent = model })
		for band = 0, 2 do
			Build.cylinder({ CFrame = at(side * 4.1, 2.6 + band * 1.9, 0.6), Radius = 0.78, Height = 0.3 },
				{ Name = "CoilBand", Color = def.Color, Material = Enum.Material.Neon, CanCollide = false, Parent = model })
		end
	end
	-- las maquinas superiores ganan aros exteriores
	if def.Order >= 4 then
		Build.ring({ CFrame = at(0, 6, 0) * CFrame.Angles(math.rad(70), 0, 0), Radius = 5.6, Width = 0.3, Height = 0.3, Segments = 28 },
			{ Color = def.Color, Material = Enum.Material.Neon, Parent = model })
	end
	if def.Order >= 5 then
		Build.ring({ CFrame = at(0, 6, 0) * CFrame.Angles(math.rad(70), math.rad(90), 0), Radius = 6.2, Width = 0.3, Height = 0.3, Segments = 28 },
			{ Color = def.CoreColor, Material = Enum.Material.Neon, Parent = model })
	end
	if def.Order >= 6 then
		Build.ring({ CFrame = at(0, 6, 0), Radius = 6.8, Width = 0.3, Height = 0.3, Segments = 32 },
			{ Color = C.White, Material = Enum.Material.Neon, Parent = model })
	end

	local screenCf = at(0, 2.6, -5.4) * CFrame.Angles(math.rad(-18), 0, 0)
	Build.sign({ Name = "PriceScreen", CFrame = screenCf, Width = 6.4, Height = 3, Color = def.Color, Parent = model,
		Text = def.Name .. "\n⚡ " .. Format.number(def.Price), Font = Enum.Font.GothamBold, TextColor = C.White, PixelsPerStud = 40 })
	Build.prompt(base, "Abrir cápsulas", def.Name, "Capsule:" .. def.Id, 16)
	model.PrimaryPart = base
	model.Parent = parent
	return model
end

local function buildCapsuleStation(parent)
	local station = folder("CapsuleStation", parent)
	Build.part({ Name = "Deck", Size = Vector3.new(46, 0.5, 92), CFrame = CFrame.new(-80, 0.25, 0), Color = C.HullLight,
		Material = Enum.Material.Metal, Parent = station })
	Build.neon({ Name = "DeckEdge", Size = Vector3.new(0.4, 0.2, 92), CFrame = CFrame.new(-57, 0.52, 0), Color = C.Cyan, Parent = station })
	Build.part({ Name = "UpperDeck", Size = Vector3.new(16, 3.5, 92), CFrame = CFrame.new(-95, 1.75, 0), Color = C.Hull,
		Material = Enum.Material.Metal, Parent = station })
	Build.neon({ Name = "UpperEdge", Size = Vector3.new(0.4, 0.25, 92), CFrame = CFrame.new(-87, 3.55, 0), Color = C.Violet, Parent = station })
	-- pared trasera con franjas de luz
	Build.part({ Name = "BackWall", Size = Vector3.new(3, 40, 96), CFrame = CFrame.new(-105, 20, 0), Color = C.Hull,
		Material = Enum.Material.Metal, Parent = station })
	for i = -4, 4 do
		Build.neon({ Name = "WallStrip", Size = Vector3.new(0.3, 30, 0.6), CFrame = CFrame.new(-103.4, 20, i * 10.5),
			Color = (i % 2 == 0) and C.Cyan or C.Violet, Transparency = 0.2, Parent = station })
	end
	Build.sign({ Name = "StationSign", CFrame = CFrame.lookAt(Vector3.new(-102.6, 31, 0), Vector3.new(0, 31, 0)), Width = 62, Height = 9,
		Text = "CAPSULE STATION", Color = C.Cyan, Parent = station })

	local positions = {
		{ Vector3.new(-66, 0.5, -27), false }, { Vector3.new(-70, 0.5, 0), false }, { Vector3.new(-66, 0.5, 27), false },
		{ Vector3.new(-94, 3.5, -30), true }, { Vector3.new(-96, 3.5, 0), true }, { Vector3.new(-94, 3.5, 30), true },
	}
	for index, def in ipairs(Defs.Capsules.List) do
		local slot = positions[index]
		local pos = slot[1]
		buildCapsuleMachine(station, def, facing(pos, CENTER))
	end
end

---------------------------------------------------------------- tableros (el cliente los rellena)
local function buildBoard(parent, name, pos, lookTarget, width, height, color, floorY)
	local cf = CFrame.lookAt(pos, lookTarget)
	local model, panel = Build.sign({ Name = name, CFrame = cf, Width = width, Height = height, Color = color, Parent = parent })
	panel.Name = "Panel"
	panel.CanQuery = true
	-- soportes hasta el suelo
	for _, side in ipairs({ -1, 1 }) do
		local top = cf * CFrame.new(side * (width / 2 - 2), -height / 2, 0.4)
		local length = top.Position.Y - (floorY or 0)
		if length > 1 then
			Build.decor({ Name = "Pylon", Size = Vector3.new(1.2, length, 1.2), CFrame = CFrame.new(top.Position.X, (floorY or 0) + length / 2, top.Position.Z),
				Color = C.Hull, Material = Enum.Material.Metal, Parent = model })
		end
	end
	return model
end

---------------------------------------------------------------- Portal Room
local function buildPortal(parent, cf, signText, action, promptText, scale, color)
	local portal = Instance.new("Model")
	portal.Name = "Portal"
	local s = scale or 1
	local centerCf = cf * CFrame.new(0, 13 * s, 0)
	local vertical = centerCf * CFrame.Angles(math.rad(90), 0, 0)
	Build.cylinder({ CFrame = cf * CFrame.new(0, 0.25, 0), Radius = 15 * s, Height = 0.5 },
		{ Name = "Platform", Color = C.HullLight, Material = Enum.Material.Metal, Parent = portal })
	Build.ring({ CFrame = cf * CFrame.new(0, 0.56, 0), Radius = 14.4 * s, Width = 0.5, Height = 0.14, Segments = 32 },
		{ Color = color, Material = Enum.Material.Neon, Parent = portal })
	Build.ring({ CFrame = vertical * CFrame.Angles(0, math.rad(22.5), 0), Radius = 11.6 * s, Width = 2.6 * s, Height = 3 * s, Segments = 8, Collide = true },
		{ Name = "Frame", Color = C.Hull, Material = Enum.Material.Metal, Parent = portal })
	Build.ring({ CFrame = vertical * CFrame.Angles(0, math.rad(22.5), 0), Radius = 10.1 * s, Width = 0.5, Height = 3.3 * s, Segments = 8 },
		{ Name = "FrameGlow", Color = color, Material = Enum.Material.Neon, Parent = portal })
	local core = Build.cylinder({ CFrame = vertical, Radius = 9.6 * s, Height = 0.5 },
		{ Name = "PortalCore", Color = color, Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false, Parent = portal })
	Build.cylinder({ CFrame = vertical * CFrame.new(0, -0.2, 0), Radius = 6 * s, Height = 0.5 },
		{ Name = "PortalEye", Color = Color3.fromRGB(240, 220, 255), Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false, Parent = portal })
	Build.light(core, color, 40, 2.5)
	Build.particles(core, { Color = ColorSequence.new(color, Color3.fromRGB(255, 255, 255)), Rate = 30, Speed = NumberRange.new(1, 4),
		Lifetime = NumberRange.new(1, 2.2), Size = Build.sizeSeq(1.1), RotSpeed = NumberRange.new(-120, 120) })
	if signText then
		Build.sign({ Name = "PortalSign", CFrame = cf * CFrame.new(0, 28.5 * s, 0), Width = 30 * s, Height = 5.5 * s, Text = signText,
			Color = color, Parent = portal })
	end
	Build.prompt(core, promptText, signText or "Portal", action, 18)
	portal.PrimaryPart = core
	portal.Parent = parent
	return portal
end
HubBuilder.buildPortal = buildPortal

---------------------------------------------------------------- Galactic Market
local function buildMarket(parent)
	local market = folder("GalacticMarket", parent)
	local pos = Vector3.new(78, -0.5, -34)
	local cf = facing(pos, CENTER)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	Build.part({ Name = "Deck", Size = Vector3.new(40, 0.5, 26), CFrame = at(0, 0.75, 2), Color = C.HullLight, Material = Enum.Material.Metal, Parent = market })
	Build.neon({ Name = "DeckEdge", Size = Vector3.new(40, 0.2, 0.4), CFrame = at(0, 1.02, -11), Color = C.Violet, Parent = market })
	local counter = Build.part({ Name = "Counter", Size = Vector3.new(26, 3.4, 4), CFrame = at(0, 2.7, -4), Color = C.Hull, Material = Enum.Material.Metal, Parent = market })
	Build.neon({ Name = "CounterGlow", Size = Vector3.new(26.2, 0.3, 4.2), CFrame = at(0, 4.5, -4), Color = C.Cyan, Parent = market })
	Build.neon({ Name = "CounterStrip", Size = Vector3.new(26.2, 0.4, 0.2), CFrame = at(0, 2.2, -6.1), Color = C.Violet, Parent = market })
	for _, x in ipairs({ -17, 17 }) do
		Build.part({ Name = "Pillar", Size = Vector3.new(2, 18, 2), CFrame = at(x, 10, 6), Color = C.Hull, Material = Enum.Material.Metal, Parent = market })
		Build.neon({ Name = "PillarGlow", Size = Vector3.new(0.3, 16, 0.3), CFrame = at(x, 10, 4.9), Color = C.Cyan, Parent = market })
	end
	Build.part({ Name = "Roof", Size = Vector3.new(40, 1.2, 14), CFrame = at(0, 19.6, 4), Color = C.Hull, Material = Enum.Material.Metal, CanCollide = false, Parent = market })
	Build.part({ Name = "Back", Size = Vector3.new(36, 18, 1.4), CFrame = at(0, 10, 10.4), Color = C.Hull, Material = Enum.Material.Metal, Parent = market })
	local screens = { { -11, "🔁 OFERTAS" }, { 0, "🪐 INTERCAMBIO SEGURO" }, { 11, "✅ DOBLE CONFIRMACIÓN" } }
	for _, sdef in ipairs(screens) do
		Build.sign({ Name = "MarketScreen", CFrame = at(sdef[1], 11.5, 9.4), Width = 9.6, Height = 6, Text = sdef[2], Color = C.Cyan,
			TextColor = C.White, Font = Enum.Font.GothamBold, Parent = market })
	end
	Build.sign({ Name = "MarketSign", CFrame = at(0, 23.6, -1), Width = 36, Height = 6, Text = "GALACTIC MARKET", Color = C.Cyan, Parent = market })
	Build.light(counter, C.Cyan, 28, 1.6)
	Build.prompt(counter, "Comerciar", "Galactic Market", "Market", 16)
end

---------------------------------------------------------------- Event Terminal y Leaderboard
local function buildTerminal(parent, name, cf, title, action, promptText, color)
	local terminal = Instance.new("Model")
	terminal.Name = name
	local base = Build.part({ Name = "Console", Size = Vector3.new(9, 3.6, 3.4), CFrame = cf * CFrame.new(0, 1.8, 0), Color = C.Hull,
		Material = Enum.Material.Metal, Parent = terminal })
	Build.neon({ Name = "ConsoleGlow", Size = Vector3.new(9.2, 0.25, 3.6), CFrame = cf * CFrame.new(0, 3.7, 0), Color = color, Parent = terminal })
	Build.sign({ Name = "ConsoleScreen", CFrame = cf * CFrame.new(0, 5.6, 0.6) * CFrame.Angles(math.rad(-12), 0, 0), Width = 8.4, Height = 3.2,
		Text = title, Color = color, TextColor = C.White, Font = Enum.Font.GothamBold, Parent = terminal })
	Build.light(base, color, 18, 1.4)
	Build.prompt(base, promptText, title, action, 14)
	terminal.PrimaryPart = base
	terminal.Parent = parent
	return terminal
end
HubBuilder.buildTerminal = buildTerminal
HubBuilder.buildBoard = buildBoard

---------------------------------------------------------------- decoracion
local function buildTree(parent, pos)
	local tree = Instance.new("Model")
	tree.Name = "Tree"
	Build.cylinder({ Position = pos + Vector3.new(0, 0.9, 0), Radius = 3.4, Height = 1.8 },
		{ Name = "Planter", Color = C.HullLight, Material = Enum.Material.Metal, Parent = tree })
	Build.ring({ CFrame = CFrame.new(pos + Vector3.new(0, 1.84, 0)), Radius = 3.2, Width = 0.35, Height = 0.12, Segments = 18 },
		{ Color = C.Cyan, Material = Enum.Material.Neon, Parent = tree })
	Build.cylinder({ Position = pos + Vector3.new(0, 1.7, 0), Radius = 2.8, Height = 0.3 },
		{ Name = "Soil", Color = Color3.fromRGB(46, 36, 30), Material = Enum.Material.Ground, CanCollide = false, Parent = tree })
	Build.cylinder({ Position = pos + Vector3.new(0, 5, 0), Radius = 0.55, Height = 6.5 },
		{ Name = "Trunk", Color = Color3.fromRGB(92, 66, 48), Material = Enum.Material.Wood, CanCollide = false, Parent = tree })
	local leaves = { { 0, 9.2, 0, 3.3 }, { 1.9, 8.2, 0.6, 2.4 }, { -1.7, 8.4, -0.8, 2.5 }, { 0.3, 8, 1.9, 2.2 }, { -0.4, 10.6, -0.3, 2.3 } }
	for _, l in ipairs(leaves) do
		Build.ball({ Position = pos + Vector3.new(l[1], l[2], l[3]), Radius = l[4] },
			{ Name = "Leaves", Color = Color3.fromRGB(58, 150, 84), Material = Enum.Material.Grass, CanCollide = false, Parent = tree })
	end
	tree.Parent = parent
end

local function buildSkyline(parent)
	local skyline = folder("Skyline", parent)
	local rng = Random.new(20261)
	for i = 0, 23 do
		local angle = i / 24 * math.pi * 2 + rng:NextNumber(-0.06, 0.06)
		local dist = rng:NextNumber(165, 235)
		local height = rng:NextNumber(110, 280)
		local width = rng:NextNumber(16, 30)
		local pos = Vector3.new(math.cos(angle) * dist, height / 2 - 70, math.sin(angle) * dist)
		local cf = facing(pos, CENTER)
		local tower = Instance.new("Model")
		tower.Name = "Tower"
		Build.decor({ Name = "Body", Size = Vector3.new(width, height, width), CFrame = cf, Color = C.Hull, Material = Enum.Material.Metal, Parent = tower })
		Build.decor({ Name = "Crown", Size = Vector3.new(width * 0.6, height * 0.22, width * 0.6), CFrame = cf * CFrame.new(0, height * 0.61, 0),
			Color = C.HullLight, Material = Enum.Material.Metal, Parent = tower })
		Build.decor({ Name = "Spire", Size = Vector3.new(1.4, height * 0.3, 1.4), CFrame = cf * CFrame.new(0, height * 0.87, 0),
			Color = C.Trim, Material = Enum.Material.Metal, Parent = tower })
		local color = (i % 3 == 0) and C.Violet or C.Cyan
		Build.neon({ Name = "Beacon", Size = Vector3.new(2.4, 2.4, 2.4), Shape = Enum.PartType.Ball, CFrame = cf * CFrame.new(0, height * 1.03, 0),
			Color = color, Parent = tower })
		-- franjas de ventanas en la cara que mira al Hub
		local strips = math.floor(width / 7)
		for sIndex = 1, strips do
			local x = (sIndex - (strips + 1) / 2) * 6
			Build.neon({ Name = "Windows", Size = Vector3.new(1, height * rng:NextNumber(0.45, 0.85), 0.4),
				CFrame = cf * CFrame.new(x, rng:NextNumber(-10, 10), -width / 2 - 0.1), Color = color, Transparency = 0.25, Parent = tower })
		end
		Build.neon({ Name = "Band", Size = Vector3.new(width + 0.6, 1, width + 0.6), CFrame = cf * CFrame.new(0, height * 0.5 - 2, 0),
			Color = color, Transparency = 0.1, Parent = tower })
		tower.Parent = skyline
	end
	-- anillos orbitales gigantes sobre la estacion
	local arcs = { { 150, 68, 20, C.Cyan }, { 172, -62, -28, C.Violet } }
	for _, a in ipairs(arcs) do
		local cf = CFrame.new(0, 40, 0) * CFrame.Angles(math.rad(a[2]), 0, math.rad(a[3]))
		Build.ring({ CFrame = cf, Radius = a[1], Width = 4, Height = 3, Segments = 56 },
			{ Name = "OrbitalRing", Color = C.Hull, Material = Enum.Material.Metal, Parent = skyline })
		Build.ring({ CFrame = cf, Radius = a[1] - 2.4, Width = 0.6, Height = 0.6, Segments = 56 },
			{ Name = "OrbitalRingGlow", Color = a[4], Material = Enum.Material.Neon, Parent = skyline })
	end
	-- planetas lejanos
	local far = {
		{ "jovian", 250, Vector3.new(-1150, 340, -1500) },
		{ "aureon", 170, Vector3.new(1250, 420, -1150) },
		{ "lunaris", 70, Vector3.new(-520, 520, -820) },
		{ "nebulon", 120, Vector3.new(700, 150, 1500) },
	}
	for _, f in ipairs(far) do
		local planet = PlanetVisual.build(f[1], "none", false, { Radius = f[2], Static = true, Distant = true })
		planet.Name = "Far_" .. f[1]
		planet:PivotTo(CFrame.new(f[3]) * CFrame.Angles(math.rad(18), 0, math.rad(-12)))
		planet.Parent = skyline
	end
end

---------------------------------------------------------------- build
function HubBuilder.build()
	local hub = Instance.new("Model")
	hub.Name = "CosmicHub"

	buildFloor(hub)
	buildCore(hub)
	buildCapsuleStation(hub)

	local boards = folder("Boards", hub)
	buildBoard(boards, "Board_Odds", Vector3.new(-44, 34, -84), Vector3.new(0, 18, 40), 46, 26, C.Cyan)
	buildBoard(boards, "Board_Leaderboard", Vector3.new(48, 34, -84), Vector3.new(0, 18, 40), 42, 26, C.Violet)

	local portalRoom = folder("PortalRoom", hub)
	buildPortal(portalRoom, facing(Vector3.new(88, 0, 34), CENTER), "PORTAL ROOM", "Portal", "Viajar", 1, C.Violet)

	buildMarket(hub)

	local eventFolder = folder("EventTerminal", hub)
	buildTerminal(eventFolder, "EventConsole", facing(Vector3.new(0, 0, -86), CENTER), "EVENT TERMINAL", "Event", "Ver evento", C.Gold)
	buildBoard(eventFolder, "Board_Event", Vector3.new(0, 16, -98), Vector3.new(0, 12, 0), 30, 15, C.Gold)

	local lbFolder = folder("LeaderboardKiosk", hub)
	buildTerminal(lbFolder, "LeaderboardConsole", facing(Vector3.new(40, 0, -76), CENTER), "LEADERBOARD", "Leaderboard", "Ver clasificación", C.Violet)

	local decor = folder("Decor", hub)
	for _, angle in ipairs({ 40, 140, 220, 320, 95, 265 }) do
		local a = math.rad(angle)
		buildTree(decor, Vector3.new(math.cos(a) * 46, 0, math.sin(a) * 46))
	end
	-- farolas
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + math.rad(22.5)
		local pos = Vector3.new(math.cos(a) * 60, 0, math.sin(a) * 60)
		Build.cylinder({ Position = pos + Vector3.new(0, 5, 0), Radius = 0.35, Height = 10 },
			{ Name = "LampPost", Color = C.Trim, Material = Enum.Material.Metal, CanCollide = false, Parent = decor })
		local lamp = Build.neon({ Name = "Lamp", Size = Vector3.new(1.6, 1.6, 1.6), Shape = Enum.PartType.Ball,
			CFrame = CFrame.new(pos + Vector3.new(0, 10.4, 0)), Color = (i % 2 == 0) and C.Cyan or C.Violet, Parent = decor })
		Build.light(lamp, lamp.Color, 34, 1.3)
	end

	buildSkyline(hub)
	hub.Parent = Workspace
	return hub
end

return HubBuilder
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX53">
          <Properties>
            <string name="Name">UniverseBuilder</string>
            <ProtectedString name="Source"><![CDATA[-- UniverseBuilder: estructura fija de una parcela de universo personal (plataforma de observacion,
-- terminales, portal de regreso y tableros). La estrella, las orbitas y los planetas los dibuja cada
-- cliente a partir del estado autorizado por el servidor (UniverseController).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Build = require(Shared.Util.Build)
local Layout = require(Shared.UniverseLayout)
local HubBuilder = require(script.Parent.HubBuilder)
local C = Build.Colors

local UniverseBuilder = {}

function UniverseBuilder.build(index, center, ownerName)
	local model = Instance.new("Model")
	model.Name = "Universe_" .. tostring(index)
	model:SetAttribute("PlotIndex", index)
	model:SetAttribute("OwnerName", ownerName)

	local deckPos = Layout.deckPosition(center)
	local radius = Layout.DeckRadius
	-- marco local de la plataforma: -Z mira hacia la estrella
	local origin = CFrame.new(deckPos)
	local function at(x, y, z)
		return origin * CFrame.new(x, y, z)
	end
	local function facingCenter(x, y, z)
		local pos = (origin * CFrame.new(x, y, z)).Position
		return CFrame.lookAt(pos, Vector3.new(deckPos.X, pos.Y, deckPos.Z))
	end

	-- plataforma
	Build.cylinder({ CFrame = at(0, -1, 0), Radius = radius, Height = 2 },
		{ Name = "Deck", Color = C.Deck, Material = Enum.Material.SmoothPlastic, Reflectance = 0.14, Parent = model })
	Build.cylinder({ CFrame = at(0, -4, 0), Radius = radius - 8, Height = 4 },
		{ Name = "Keel1", Color = C.Hull, Material = Enum.Material.Metal, CanCollide = false, Parent = model })
	Build.cylinder({ CFrame = at(0, -10, 0), Radius = radius - 20, Height = 8 },
		{ Name = "Keel2", Color = C.HullLight, Material = Enum.Material.Metal, CanCollide = false, Parent = model })
	Build.cylinder({ CFrame = at(0, -22, 0), Radius = 1.2, Height = 16 },
		{ Name = "Antenna", Color = C.Trim, Material = Enum.Material.Metal, CanCollide = false, Parent = model })
	Build.cylinder({ CFrame = at(0, -2.2, 0), Radius = radius - 2, Height = 0.5 },
		{ Name = "Underglow", Color = C.Cyan, Material = Enum.Material.Neon, Transparency = 0.3, CanCollide = false, Parent = model })
	for _, r in ipairs({ { radius - 1.5, C.Cyan }, { 22, C.Violet }, { 9, C.Cyan } }) do
		Build.ring({ CFrame = at(0, 0.05, 0), Radius = r[1], Width = 0.5, Height = 0.12, Segments = 40 },
			{ Color = r[2], Material = Enum.Material.Neon, Parent = model })
	end
	for i = 0, 7 do
		local angle = i / 8 * math.pi * 2
		Build.neon({ Name = "Ray", Size = Vector3.new(12, 0.1, 0.3), Color = C.Cyan, Transparency = 0.3,
			CFrame = at(0, 0.05, 0) * CFrame.Angles(0, -angle, 0) * CFrame.new(15.5, 0, 0), Parent = model })
	end

	-- barandilla de cristal al frente (hacia la estrella) y muro bajo detras
	Build.ring({ CFrame = at(0, 1.7, 0), Radius = radius - 0.6, Width = 0.3, Height = 3.4, Segments = 18,
		Start = math.rad(200), Arc = math.rad(140), Collide = true },
		{ Name = "GlassRail", Color = C.Cyan, Material = Enum.Material.Glass, Transparency = 0.7, Parent = model })
	Build.ring({ CFrame = at(0, 3.5, 0), Radius = radius - 0.6, Width = 0.45, Height = 0.25, Segments = 18,
		Start = math.rad(200), Arc = math.rad(140) },
		{ Name = "RailGlow", Color = C.Cyan, Material = Enum.Material.Neon, Parent = model })
	Build.ring({ CFrame = at(0, 2.5, 0), Radius = radius - 0.9, Width = 1.8, Height = 5, Segments = 26,
		Start = math.rad(-20), Arc = math.rad(220), Collide = true },
		{ Name = "BackWall", Color = C.Hull, Material = Enum.Material.Metal, Parent = model })
	Build.ring({ CFrame = at(0, 5.1, 0), Radius = radius - 0.9, Width = 0.6, Height = 0.25, Segments = 26,
		Start = math.rad(-20), Arc = math.rad(220) },
		{ Name = "BackWallGlow", Color = C.Violet, Material = Enum.Material.Neon, Parent = model })
	Build.ring({ CFrame = at(0, 30, 0), Radius = radius - 0.4, Width = 1, Height = 60, Segments = 24, Collide = true },
		{ Name = "Barrier", Transparency = 1, Parent = model })

	-- portal de regreso al Hub
	HubBuilder.buildPortal(model, facingCenter(0, 0, 27), "COSMIC HUB", "Hub", "Volver al Hub", 0.5, C.Cyan)

	-- terminales (todas miran al centro de la plataforma)
	HubBuilder.buildTerminal(model, "UpgradeTerminal", facingCenter(-19, 0, 19), "MEJORAS", "Upgrades", "Abrir mejoras", C.Cyan)
	HubBuilder.buildTerminal(model, "CapsuleTerminal", facingCenter(19, 0, 19), "CÁPSULAS", "Capsules", "Abrir cápsulas", C.Violet)
	HubBuilder.buildTerminal(model, "GalaxyTerminal", facingCenter(-29, 0, 2), "SISTEMAS", "Galaxy", "Ver sistemas", C.Blue)
	HubBuilder.buildTerminal(model, "CollectionTerminal", facingCenter(29, 0, 2), "COLECCIÓN", "Collection", "Ver colección", C.Gold)

	-- tableros que rellena el cliente: produccion (izquierda) y estadisticas del universo (derecha)
	local lookAt = (origin * CFrame.new(0, 6, 6)).Position
	HubBuilder.buildBoard(model, "Board_Production", (origin * CFrame.new(-30, 15, -22)).Position, lookAt, 22, 13, C.Cyan, deckPos.Y)
	HubBuilder.buildBoard(model, "Board_Universe", (origin * CFrame.new(30, 15, -22)).Position, lookAt, 22, 13, C.Violet, deckPos.Y)

	-- cartel del propietario
	local anchor = Build.decor({ Name = "OwnerAnchor", Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = at(0, 26, 30), Parent = model })
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "OwnerSign"
	billboard.Size = UDim2.fromScale(40, 6)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 600
	billboard.Parent = anchor
	local label = Build.label(billboard, "UNIVERSO DE " .. string.upper(ownerName), { Font = Enum.Font.Michroma })
	Build.stroke(label, C.Blue, 2, 0)

	-- luces de cubierta
	for _, p in ipairs({ { -16, -14 }, { 16, -14 }, { -16, 14 }, { 16, 14 } }) do
		local lamp = Build.decor({ Name = "DeckLight", Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = at(p[1], 8, p[2]), Parent = model })
		Build.light(lamp, C.Cyan, 36, 1.2)
	end

	model.Parent = Workspace:FindFirstChild("PlayerUniverseZones")
	return model
end

return UniverseBuilder
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
