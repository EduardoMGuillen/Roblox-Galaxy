			Atmosphere = rgb(255, 255, 255), Glow = rgb(235, 235, 255),
			Rings = { { Inner = 1.2, Outer = 1.28, Color = rgb(255, 255, 255), Tilt = 90, Alpha = 0.05, Line = true } } },
