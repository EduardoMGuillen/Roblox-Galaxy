      <Item class="ModuleScript" referent="RBX6">
        <Properties>
          <string name="Name">Assets</string>
          <ProtectedString name="Source"><![CDATA[-- Assets: ids de assets GRATUITOS del Creator Store de Roblox usados por el juego (ver assets/manifest.json
-- para autor y alternativas de cada uno, y assets/preview/ para verlos).
-- Un id en 0 significa "sin asset": el juego usa entonces su alternativa construida con piezas y
-- materiales integrados. Ademas, el cliente comprueba al arrancar que cada textura carga
-- (AssetCheck) y, si alguna falla, la desactiva: nunca quedan planetas invisibles ni referencias rotas.
local Assets = {}

-- Esfera con UV equirectangular ("RenderMesh", pack oficial de Roblox "Beyond the Dark")
Assets.SphereMesh = 6441034336
Assets.SphereMeshRadius = 8.00446 -- radio de la malla en unidades de malla

-- Mapas de superficie (equirectangulares 2:1) por clave de textura (PlanetDefinitions.Visual.Texture)
Assets.Textures = {
	terra = 14113088653,
	rocanox = 5184963957,
	dunaris = 8637912772,
	glaciera = 109017797659108,
	jovian = 78908883189888,
	inferno = 17886692408,
	amethyst = 9848378750,
	aureon = 106225721938856,
	nebulon = 110852519379669,
	shadowra = 137143678008653,
	quantum = 103941792770202,
	singularity = 9856964100,
	cryostar = 123306104411190,
	volcanis = 91528305407533,
	zenith = 10685296286,
	moon = 8159103611,
	sun = 133964586422832,
	cosmic = 14113890780, -- capa de la variante Cosmic
	clouds = 11025160997, -- capa de nubes con transparencia
}

-- Imagenes con transparencia
Assets.Images = {
	ring = 127544228287826, -- anillos blancos vistos desde arriba (se tiñen)
	ring_saturn = 5450454604,
	glow = 290434402, -- degradado radial blanco
	flare = 15049808173, -- destello de 4 puntas
	smoke = 6835347835, -- nube suave (nebulosas)
	galaxy = 125791123364516, -- galaxia espiral
	nebula = 14135223682, -- nebulosa rosa/azul
}

-- Skybox de nebulosa azul-violeta para el espacio profundo
Assets.Skybox = {
	Bk = 95984003307249,
	Dn = 135816775316034,
	Ft = 134724161702610,
	Lf = 96690603990248,
	Rt = 129021469699942,
	Up = 90271986476549,
}

-- Sonidos (efectos de la cuenta oficial Roblox; musica de la biblioteca con licencia del Creator Store)
Assets.Sounds = {
	click = 15675059323,
	hover = 10066931761,
	success = 10066947742,
	error = 17208353912,
	charge = 16480578036,
	reveal = 17208327798,
	fanfare = 17208372272,
	portal = 15674975792,
	collect = 17208319162,
	notify = 17208361335,
	music_hub = 103700934283247,
	music_universe = 140533822783920,
}

function Assets.url(id)
	if type(id) == "number" and id > 0 then
		return "rbxassetid://" .. tostring(id)
	end
	return ""
end

function Assets.texture(key)
	return Assets.url(Assets.Textures[key])
end

function Assets.image(key)
	return Assets.url(Assets.Images[key])
end

function Assets.sound(key)
	return Assets.url(Assets.Sounds[key])
end

-- Marca como no disponible cualquier asset cuya URL este en `failed` (conjunto de URLs).
-- Devuelve cuantos se desactivaron.
function Assets.disable(failed)
	local n = 0
	for _, group in ipairs({ Assets.Textures, Assets.Images, Assets.Sounds }) do
		for key, id in pairs(group) do
			if failed[Assets.url(id)] then
				group[key] = 0
				n = n + 1
			end
		end
	end
	if failed[Assets.url(Assets.SphereMesh)] then
		Assets.SphereMesh = 0
		n = n + 1
	end
	return n
end

return Assets
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[-- Config: tablas de balance y constantes centrales de PLANET COLLECTOR.
-- Todos los valores economicos son orientativos y se pueden ajustar aqui sin tocar la logica.
local Config = {}

Config.Version = "1.0.0"

-- Persistencia
Config.Data = {
	StoreName = "PlanetCollector_Profiles_v1",
	Version = 1,
	AutosaveInterval = 120, -- segundos
	LockTimeout = 600, -- un candado de sesion mas viejo que esto se considera abandonado
	LoadRetries = 4,
	SaveRetries = 4,
}

-- Economia base
Config.Economy = {
	StartingEnergy = 250,
	MaxCurrency = 1e18, -- limite seguro (los double pierden precision de enteros a partir de ~9e15)
	TickSeconds = 1,
	SlotsPerSystem = 8,
	InventoryBaseCapacity = 150,
	SellReturn = 0.15, -- retorno esperado al vender lo obtenido de una capsula (fraccion de su precio)
	OfflineBaseCapHours = 2,
	OfflineBaseRate = 0.5, -- fraccion de la produccion que se gana desconectado
	OfflineMinSeconds = 60,
}

-- Capsulas
Config.Capsules = {
	CooldownSeconds = 0.5,
	BatchSizes = { 1, 3, 10 }, -- desbloqueables con la mejora de nucleo "multi"
}

-- Evolucion (Terra -> Terra Prime)
Config.Evolution = {
	CopiesRequired = 2, -- copias normales adicionales que se consumen
	ProductionMultiplier = 3,
	EnergyCostPerBase = 1500, -- coste = produccion base x este valor
	StardustPerRarityOrder = 10,
	ScaleMultiplier = 1.18,
}

-- Trading
Config.Trade = {
	MaxItemsPerSide = 8,
	RequestTimeout = 30,
	ReviewSeconds = 5,
	MinPlaytimeSeconds = 0,
}

-- Leaderboard
Config.Leaderboard = {
	RefreshSeconds = 120,
	Size = 10,
	StorePrefix = "PlanetCollector_LB_v1_",
}

-- Mundo
Config.World = {
	HubSpawn = Vector3.new(0, 6, 78),
	PlotCount = 12,
	PlotOrigin = Vector3.new(0, 900, 6000),
	PlotSpacing = 2600,
	OrbitBaseRadius = 46,
	OrbitSpacing = 19,
	StarRadius = 15,
	PlanetBaseRadius = 5,
}

-- Monetizacion responsable: solo cosmetica/comodidad. 0 = desactivado.
Config.GamePasses = {
	VIP = 0, -- id de GamePass para titulo/insignia VIP (cosmetico)
}

-- Tutorial
Config.TutorialSteps = { "welcome", "open_capsule", "go_universe", "place_planet", "watch_production", "buy_upgrade", "done" }

-- Ajustes por defecto del jugador
Config.DefaultSettings = {
	Music = true,
	Sfx = true,
	ReducedEffects = false,
	SkipCapsuleAnimation = false,
	ShowOtherNames = true,
	LowQuality = false,
	LargeText = false,
}

return Config
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBX8">
        <Properties>
          <string name="Name">Definitions</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX9">
          <Properties>
            <string name="Name">AscensionDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- AscensionDefinitions: Galactic Ascension (prestigio). Hitos 1-5 segun el manual; despues, formula.
local Ascension = {}

-- Cada hito combina el requisito del manual con una cantidad de Energy generada en la ascension
-- actual (RunEnergy), para que entre ascensiones siempre haya una partida real.
Ascension.Milestones = {
	{ Requirements = { { Type = "PlanetsOwned", Count = 10 }, { Type = "RunEnergy", Amount = 500000 } }, Multiplier = 2, Cores = 3 },
	{ Requirements = { { Type = "RarityOwned", Rarity = "legendary", Count = 1 }, { Type = "RunEnergy", Amount = 150000000 } }, Multiplier = 3, Cores = 5 },
	{ Requirements = { { Type = "CollectionComplete", System = "solar" }, { Type = "RunEnergy", Amount = 10000000000 } }, Multiplier = 5, Cores = 8 },
	{ Requirements = { { Type = "RarityOwned", Rarity = "legendary", Count = 3 }, { Type = "RunEnergy", Amount = 400000000000 } }, Multiplier = 8, Cores = 12 },
	{ Requirements = { { Type = "CollectionComplete", System = "nebula" }, { Type = "RunEnergy", Amount = 20000000000000 } }, Multiplier = 12, Cores = 20 },
}

-- Datos del hito para pasar de `current` ascensiones a current + 1
function Ascension.next(current)
	local n = current + 1
	local m = Ascension.Milestones[n]
	if m then
		return { Index = n, Requirements = m.Requirements, Multiplier = m.Multiplier, Cores = m.Cores }
	end
	local extra = n - #Ascension.Milestones
	return {
		Index = n,
		Requirements = { { Type = "RunEnergy", Amount = 4e14 * 20 ^ (extra - 1) } },
		Multiplier = 12 + 5 * extra,
		Cores = 20 + 5 * extra,
	}
end

-- Multiplicador permanente de produccion con `count` ascensiones
function Ascension.multiplier(count)
	if count <= 0 then return 1 end
	local m = Ascension.Milestones[count]
	if m then return m.Multiplier end
	return 12 + 5 * (count - #Ascension.Milestones)
end

Ascension.Resets = {
	"Energy actual",
	"Mejoras compradas con Energy",
	"Sistemas desbloqueados (vuelves a Solar)",
	"Slots orbitales comprados",
	"Planetas colocados (vuelven al inventario)",
}

Ascension.Keeps = {
	"Todos tus planetas e inventario",
	"Collection Index y descubrimientos",
	"Stardust y Cosmic Cores",
	"Mejoras de núcleo permanentes",
	"Cosméticos, misiones y estadísticas",
}

return Ascension
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX10">
          <Properties>
            <string name="Name">CapsuleDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- CapsuleDefinitions: capsulas, precios, requisitos y tablas de probabilidad REALES.
-- Odds: probabilidad por rareza (suma exacta 100). Pools: planetas posibles por rareza (reparto uniforme).
-- Las capsulas solo se compran con Energy ganada jugando.
local Capsules = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local LIST = {
	{
		Id = "starter", Name = "Starter Capsule", Price = 100, RequiresSystem = "solar",
		Description = "Cápsula inicial: colección común y poco común.",
		Color = rgb(60, 220, 255), CoreColor = rgb(80, 160, 255),
		Odds = { common = 70, uncommon = 30 },
		Pools = { common = { "terra", "rocanox" }, uncommon = { "dunaris", "glaciera" } },
	},
	{
		Id = "solar", Name = "Solar Capsule", Price = 1000, RequiresSystem = "solar",
		Description = "Sistema Solar: comunes, poco comunes y raros.",
		Color = rgb(70, 130, 255), CoreColor = rgb(120, 180, 255),
		Odds = { common = 40, uncommon = 38, rare = 22 },
		Pools = { common = { "terra", "rocanox" }, uncommon = { "dunaris", "glaciera" }, rare = { "jovian", "inferno" } },
	},
	{
		Id = "nebula", Name = "Nebula Capsule", Price = 10000, RequiresSystem = "nebula",
		Description = "Nebula: lunas, raros y épicos.",
		Color = rgb(170, 90, 255), CoreColor = rgb(210, 140, 255),
		Odds = { uncommon = 25, rare = 50, epic = 25 },
		Pools = { uncommon = { "lunaris" }, rare = { "amethyst", "selene" }, epic = { "aureon", "nebulon" } },
	},
	{
		Id = "galaxy", Name = "Galaxy Capsule", Price = 100000, RequiresSystem = "void",
		Description = "Sistemas avanzados: épicos y legendarios del Void.",
		Color = rgb(110, 100, 255), CoreColor = rgb(160, 120, 255),
		Odds = { rare = 33, epic = 45, legendary = 20, mythic = 2 },
		Pools = { rare = { "noctis" }, epic = { "umbra" }, legendary = { "shadowra", "eclipsa" }, mythic = { "singularity" } },
	},
	{
		Id = "cosmic", Name = "Cosmic Capsule", Price = 1000000, RequiresSystem = "celestial",
		Description = "Contenido avanzado: legendarios y míticos celestiales.",
		Color = rgb(255, 80, 200), CoreColor = rgb(255, 200, 90),
		Odds = { epic = 45, legendary = 45, mythic = 10 },
		Pools = { epic = { "solara" }, legendary = { "quantum", "seraphim" }, mythic = { "aurelia", "singularity" } },
	},
	{
		Id = "infinity", Name = "Infinity Capsule", Price = 100000000, RequiresSystem = "infinity",
		Description = "Endgame: míticos y descubrimientos secretos.",
		Color = rgb(230, 220, 255), CoreColor = rgb(190, 150, 255),
		Odds = { legendary = 50, mythic = 47, secret = 3 },
		Pools = { legendary = { "quantum", "seraphim", "shadowra", "eclipsa" },
			mythic = { "paradox", "infinitum", "aurelia", "singularity" },
			secret = { "cryostar", "volcanis", "zenith" } },
	},
}

Capsules.List = LIST
Capsules.ById = {}
for index, def in ipairs(LIST) do
	def.Order = index
	Capsules.ById[def.Id] = def
end

function Capsules.get(id)
	return Capsules.ById[id]
end

-- Lista ordenada de { Rarity, Chance (0-1), Planets } para mostrar en la UI y para tirar en servidor.
function Capsules.oddsList(def, rarityOrder)
	local out = {}
	for _, rarityId in ipairs(rarityOrder) do
		local pct = def.Odds[rarityId]
		if pct then
			table.insert(out, { Rarity = rarityId, Chance = pct / 100, Planets = def.Pools[rarityId] })
		end
	end
	return out
end

-- Elige rareza y planeta con dos numeros aleatorios uniformes en [0,1) generados por el SERVIDOR.
function Capsules.roll(def, rarityOrder, randomRarity, randomPlanet)
	local list = Capsules.oddsList(def, rarityOrder)
	local acc = 0
	local chosen = list[#list]
	for _, entry in ipairs(list) do
		acc = acc + entry.Chance
		if randomRarity < acc then
			chosen = entry
			break
		end
	end
	local pool = chosen.Planets
	local index = math.min(#pool, math.floor(randomPlanet * #pool) + 1)
	return pool[index], chosen.Rarity
end

return Capsules
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX11">
          <Properties>
            <string name="Name">CosmeticDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- CosmeticDefinitions: personalizacion del universo comprada con Stardust. Nunca afecta a la economia.
local Cosmetics = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Cosmetics.Categories = {
	{ Id = "OrbitColor", Name = "Color de órbitas" },
	{ Id = "StarAura", Name = "Aura de la estrella" },
}

Cosmetics.List = {
	{ Id = "orbit_system", Category = "OrbitColor", Name = "Del sistema", Price = 0, Description = "Usa el color propio de cada sistema." },
	{ Id = "orbit_cyan", Category = "OrbitColor", Name = "Cian", Price = 40, Color = rgb(80, 220, 255) },
	{ Id = "orbit_violet", Category = "OrbitColor", Name = "Violeta", Price = 60, Color = rgb(180, 110, 255) },
	{ Id = "orbit_emerald", Category = "OrbitColor", Name = "Esmeralda", Price = 80, Color = rgb(90, 255, 160) },
	{ Id = "orbit_crimson", Category = "OrbitColor", Name = "Carmesí", Price = 80, Color = rgb(255, 80, 100) },
	{ Id = "orbit_gold", Category = "OrbitColor", Name = "Oro", Price = 150, Color = rgb(255, 205, 90) },
	{ Id = "orbit_white", Category = "OrbitColor", Name = "Blanco puro", Price = 200, Color = rgb(245, 245, 255) },
	{ Id = "aura_default", Category = "StarAura", Name = "Corona estándar", Price = 0, Description = "El halo natural de la estrella." },
	{ Id = "aura_pulse", Category = "StarAura", Name = "Pulso", Price = 120, Description = "Ondas de luz que laten lentamente.", Style = "pulse" },
	{ Id = "aura_flare", Category = "StarAura", Name = "Llamaradas", Price = 200, Description = "Lenguas de plasma alrededor de la estrella.", Style = "flare" },
	{ Id = "aura_halo", Category = "StarAura", Name = "Halo doble", Price = 300, Description = "Dos anillos de luz cruzados.", Style = "halo" },
}

Cosmetics.ById = {}
Cosmetics.ByCategory = {}
Cosmetics.Defaults = { OrbitColor = "orbit_system", StarAura = "aura_default" }
for _, c in ipairs(Cosmetics.List) do
	Cosmetics.ById[c.Id] = c
	if not Cosmetics.ByCategory[c.Category] then Cosmetics.ByCategory[c.Category] = {} end
	table.insert(Cosmetics.ByCategory[c.Category], c)
end

return Cosmetics
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX12">
          <Properties>
            <string name="Name">EventDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- EventDefinitions: eventos cosmicos globales. El calendario se calcula con el tiempo del servidor:
-- cada ciclo de CycleSeconds empieza con un evento activo durante ActiveSeconds; el resto es descanso.
local Events = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Events.CycleSeconds = 1800
Events.ActiveSeconds = 600

Events.List = {
	{ Id = "meteor_shower", Name = "Meteor Shower", Icon = "☄️", Color = rgb(255, 170, 80),
		Description = "Caen meteoritos por todo el Hub y tu universo: tócalos para recoger Stardust.",
		Effects = { Meteors = true },
		Objective = { Type = "CollectMeteors", Goal = 15, Text = "Recoge %s meteoritos" }, RewardStardust = 40 },
	{ Id = "solar_eclipse", Name = "Solar Eclipse", Icon = "🌑", Color = rgb(170, 120, 255),
		Description = "La oscuridad favorece lo extraño: probabilidad de variantes x2.",
		Effects = { VariantLuck = 2 },
		Objective = { Type = "OpenCapsules", Goal = 15, Text = "Abre %s cápsulas durante el eclipse" }, RewardStardust = 40 },
	{ Id = "supernova", Name = "Supernova", Icon = "💥", Color = rgb(255, 230, 140),
		Description = "Una onda de energía recorre la galaxia: producción de Energy x2.",
		Effects = { Production = 2 },
		Objective = { Type = "PlacePlanets", Goal = 3, Text = "Coloca %s planetas durante la supernova" }, RewardStardust = 40 },
	{ Id = "cosmic_storm", Name = "Cosmic Storm", Icon = "🌩️", Color = rgb(90, 220, 255),
		Description = "La tormenta abarata la tecnología: todas las cápsulas cuestan un 25% menos.",
		Effects = { CapsuleDiscount = 0.75 },
		Objective = { Type = "OpenCapsules", Goal = 20, Text = "Abre %s cápsulas durante la tormenta" }, RewardStardust = 40 },
}

Events.ById = {}
for _, e in ipairs(Events.List) do
	Events.ById[e.Id] = e
end

-- Estado del calendario para un instante (segundos unix del servidor).
-- Devuelve { Active = def|nil, EndsAt, Next = def, NextStartsAt, CycleIndex }
function Events.schedule(now)
	local cycle = math.floor(now / Events.CycleSeconds)
	local start = cycle * Events.CycleSeconds
	local count = #Events.List
	local current = Events.List[(cycle % count) + 1]
	local nextDef = Events.List[((cycle + 1) % count) + 1]
	local out = { CycleIndex = cycle, Next = nextDef, NextStartsAt = start + Events.CycleSeconds }
	if now < start + Events.ActiveSeconds then
		out.Active = current
		out.EndsAt = start + Events.ActiveSeconds
	end
	return out
end

return Events
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX13">
          <Properties>
            <string name="Name">GalaxyDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- GalaxyDefinitions: los cinco sistemas, su tematica, multiplicador, slots y requisitos de desbloqueo.
-- Fuente de verdad para desbloqueos. Unlock es una lista de requisitos evaluados por Shared/Progression.
local Galaxy = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Coste de cada slot orbital (los 3 primeros son gratis al desbloquear el sistema)
local BASE_SLOT_COSTS = { 0, 0, 0, 2500, 12000, 60000, 250000, 1000000 }

local function slotCosts(factor)
	local out = {}
	for i, c in ipairs(BASE_SLOT_COSTS) do
		out[i] = c * factor
	end
	return out
end

local LIST = {
	{
		Id = "solar", Name = "Solar System", Subtitle = "Sistema inicial", Multiplier = 1,
		Description = "Estrella cálida, planetas rocosos y gigantes gaseosos. Aquí aprendes el bucle principal.",
		Introduces = "Tutorial, cápsulas Starter y Solar, planetas iniciales.",
		SlotCosts = slotCosts(1), FreeSlots = 3, Unlock = {},
		Theme = { Star = rgb(255, 214, 120), StarGlow = rgb(255, 190, 90), Orbit = rgb(90, 200, 255),
			Nebula = { rgb(40, 90, 200), rgb(30, 60, 160) }, Ambient = rgb(120, 130, 160), Accent = rgb(90, 200, 255) },
		Reward = { Stardust = 50, ProductionBonus = 0.05 },
	},
	{
		Id = "nebula", Name = "Nebula System", Subtitle = "Primer sistema avanzado", Multiplier = 4,
		Description = "Nebulosas azules y violetas, polvo estelar, cristales y lunas.",
		Introduces = "Cápsula Nebula, cristales, lunas y sinergias de elementos.",
		SlotCosts = slotCosts(15), FreeSlots = 3,
		Unlock = {
			{ Type = "Energy", Amount = 150000 },
			{ Type = "Collection", System = "solar", Count = 4 },
		},
		Theme = { Star = rgb(190, 150, 255), StarGlow = rgb(150, 110, 255), Orbit = rgb(170, 120, 255),
			Nebula = { rgb(120, 60, 220), rgb(60, 80, 230) }, Ambient = rgb(130, 115, 170), Accent = rgb(180, 120, 255) },
		Reward = { Stardust = 120, ProductionBonus = 0.05 },
	},
	{
		Id = "void", Name = "Void System", Subtitle = "Sistema oscuro", Multiplier = 20,
		Description = "Negros azulados, púrpuras profundos y un núcleo de gravedad en lugar de estrella.",
		Introduces = "Cápsula Galaxy, mundos oscuros, singularidades y combinaciones avanzadas.",
		SlotCosts = slotCosts(300), FreeSlots = 3,
		Unlock = {
			{ Type = "Energy", Amount = 30000000 },
			{ Type = "Collection", System = "nebula", Count = 4 },
			{ Type = "Placed", System = "nebula", Count = 5 },
		},
		Theme = { Star = rgb(25, 10, 45), StarGlow = rgb(150, 70, 255), Orbit = rgb(140, 80, 255),
			Nebula = { rgb(50, 20, 110), rgb(20, 20, 70) }, Ambient = rgb(95, 85, 135), Accent = rgb(150, 80, 255),
			BlackHole = true },
		Reward = { Stardust = 250, ProductionBonus = 0.05 },
	},
	{
		Id = "celestial", Name = "Celestial System", Subtitle = "Sistema de alta rareza", Multiplier = 100,
		Description = "Arquitectura dorada, estrella blanca-dorada, anillos elegantes y atmósferas luminosas.",
		Introduces = "Cápsula Cosmic, coleccionables dorados y efectos visuales premium.",
		SlotCosts = slotCosts(8000), FreeSlots = 3,
		Unlock = {
			{ Type = "Energy", Amount = 3000000000 },
			{ Type = "Collection", System = "void", Count = 4 },
			{ Type = "Production", Amount = 50000 },
		},
		Theme = { Star = rgb(255, 245, 215), StarGlow = rgb(255, 215, 120), Orbit = rgb(255, 215, 120),
			Nebula = { rgb(200, 150, 60), rgb(120, 90, 170) }, Ambient = rgb(165, 150, 125), Accent = rgb(255, 210, 110),
			Ornaments = true },
		Reward = { Stardust = 500, ProductionBonus = 0.05 },
	},
	{
		Id = "infinity", Name = "Infinity System", Subtitle = "Endgame", Multiplier = 500,
		Description = "Dimensiones superpuestas, portales múltiples y geometrías cósmicas imposibles pero legibles.",
		Introduces = "Cápsula Infinity, secretos y objetivos finales.",
		SlotCosts = slotCosts(300000), FreeSlots = 3,
		Unlock = {
			{ Type = "Energy", Amount = 250000000000 },
			{ Type = "Ascensions", Count = 3 },
			{ Type = "Discoveries", Count = 18 },
		},
		Theme = { Star = rgb(235, 225, 255), StarGlow = rgb(120, 255, 255), Orbit = rgb(120, 255, 255),
			Nebula = { rgb(40, 160, 200), rgb(140, 60, 220) }, Ambient = rgb(125, 145, 175), Accent = rgb(120, 255, 255),
			Portals = true },
		Reward = { Stardust = 1000, ProductionBonus = 0.1 },
	},
}

Galaxy.List = LIST
Galaxy.ById = {}
Galaxy.Order = {}
for index, def in ipairs(LIST) do
	def.Order = index
	Galaxy.ById[def.Id] = def
	Galaxy.Order[index] = def.Id
end

function Galaxy.get(id)
	return Galaxy.ById[id]
end

function Galaxy.slotKey(index)
	return "s" .. tostring(index)
end

return Galaxy
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX14">
          <Properties>
            <string name="Name">MissionDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- MissionDefinitions: plantillas de misiones diarias y semanales. Las metas escalan con el progreso (tier).
-- Goal(tier, production) y Reward(tier, production) devuelven numeros; el servidor los fija al generar la mision.
local Missions = {}

Missions.DailyCount = 3
Missions.WeeklyCount = 3

Missions.Templates = {
	{ Id = "open_capsules", Type = "OpenCapsules", Scope = "daily", Text = "Abre %s cápsulas",
		Goal = function(tier) return 10 + 5 * tier end, Stardust = function(tier) return 10 + 3 * tier end },
	{ Id = "obtain_rare", Type = "ObtainRare", Scope = "daily", Text = "Consigue %s planetas Raros o superiores",
		Goal = function(tier) return 3 + tier end, Stardust = function(tier) return 12 + 3 * tier end },
	{ Id = "earn_energy", Type = "EarnEnergy", Scope = "daily", Text = "Genera %s de Energy",
		Goal = function(tier, production) return math.max(2000, math.floor(production * 600)) end,
		Stardust = function(tier) return 10 + 3 * tier end },
	{ Id = "place_planets", Type = "PlacePlanets", Scope = "daily", Text = "Coloca %s planetas en órbita",
		Goal = function(tier) return 3 + tier end, Stardust = function(tier) return 8 + 2 * tier end },
	{ Id = "buy_upgrades", Type = "BuyUpgrades", Scope = "daily", Text = "Compra %s mejoras",
		Goal = function(tier) return 3 + tier end, Stardust = function(tier) return 8 + 2 * tier end },
	{ Id = "visit_universe", Type = "VisitUniverse", Scope = "daily", Text = "Visita %s universo de otro jugador",
		Goal = function() return 1 end, Stardust = function(tier) return 10 + 2 * tier end },
	{ Id = "sell_planets", Type = "SellPlanets", Scope = "daily", Text = "Vende %s planetas duplicados",
		Goal = function(tier) return 5 + 2 * tier end, Stardust = function(tier) return 8 + 2 * tier end },
	{ Id = "w_open_capsules", Type = "OpenCapsules", Scope = "weekly", Text = "Abre %s cápsulas esta semana",
		Goal = function(tier) return 100 + 50 * tier end, Stardust = function(tier) return 60 + 15 * tier end },
	{ Id = "w_earn_energy", Type = "EarnEnergy", Scope = "weekly", Text = "Genera %s de Energy esta semana",
		Goal = function(tier, production) return math.max(50000, math.floor(production * 7200)) end,
		Stardust = function(tier) return 60 + 15 * tier end },
	{ Id = "w_evolve", Type = "EvolvePlanet", Scope = "weekly", Text = "Evoluciona %s planeta a su forma Prime",
		Goal = function() return 1 end, Stardust = function(tier) return 80 + 15 * tier end },
	{ Id = "w_trade", Type = "CompleteTrade", Scope = "weekly", Text = "Completa %s intercambio en el Galactic Market",
		Goal = function() return 1 end, Stardust = function(tier) return 50 + 10 * tier end },
	{ Id = "w_event", Type = "EventParticipation", Scope = "weekly", Text = "Completa %s objetivo de evento cósmico",
		Goal = function() return 1 end, Stardust = function(tier) return 70 + 15 * tier end },
	{ Id = "w_obtain_epic", Type = "ObtainEpic", Scope = "weekly", Text = "Consigue %s planetas Épicos o superiores",
		Goal = function(tier) return 3 + 2 * tier end, Stardust = function(tier) return 70 + 15 * tier end },
}

Missions.ById = {}
Missions.ByScope = { daily = {}, weekly = {} }
for _, t in ipairs(Missions.Templates) do
	Missions.ById[t.Id] = t
	table.insert(Missions.ByScope[t.Scope], t)
end

-- Recompensa de Energy de una mision (segundos de produccion), para que escale con el progreso
Missions.EnergyRewardSeconds = { daily = 120, weekly = 900 }

return Missions
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX15">
          <Properties>
            <string name="Name">PlanetDefinitions</string>
            <ProtectedString name="Source"><![CDATA[-- PlanetDefinitions: catalogo de planetas (datos, no scripts).
-- Los 15 planetas del manual conservan nombre, rareza, tipo y produccion de referencia.
-- Se añaden 10 mundos complementarios (lunas y planetas de sistemas avanzados) para dar contenido
-- a las colecciones de Nebula, Void, Celestial e Infinity.
--
-- Campos: Id, Name, Description, Rarity, Elements (lista), TypeLabel, System (coleccion a la que pertenece),
-- Base (BaseEnergyPerSecond), CollectionValue, ModelKey, Scale, RotationSpeed (grados/s), OrbitSpeed (factor),
-- Visual (parametros para Shared/PlanetVisual), VariantRules (variantes permitidas), Secret (pista).
local Planets = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local ALL_VARIANTS = { "shiny", "golden", "rainbow", "cosmic" }

