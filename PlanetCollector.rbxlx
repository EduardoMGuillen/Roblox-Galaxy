      <Item class="Folder" referent="RBX58">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX59">
          <Properties>
            <string name="Name">AssetCheck</string>
            <ProtectedString name="Source"><![CDATA[-- AssetCheck: comprueba al arrancar que las texturas/mallas del Creator Store cargan en este cliente.
-- Las que fallen se desactivan (Assets.disable) y el juego usa su alternativa con materiales integrados.
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Assets = require(ReplicatedStorage:WaitForChild("Shared").Assets)

local AssetCheck = {}

AssetCheck.Failed = {} -- conjunto de URLs que no cargaron

function AssetCheck.run(timeout)
	local urls = { Assets.url(Assets.SphereMesh) }
	for _, group in ipairs({ Assets.Textures, Assets.Images }) do
		for _, id in pairs(group) do
			local url = Assets.url(id)
			if url ~= "" then table.insert(urls, url) end
		end
	end
	local done = false
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(urls, function(contentId, status)
				if status == Enum.AssetFetchStatus.Failure then
					AssetCheck.Failed[contentId] = true
				end
			end)
		end)
		done = true
	end)
	local waited = 0
	while not done and waited < (timeout or 8) do
		waited = waited + task.wait(0.1)
	end
	local disabled = Assets.disable(AssetCheck.Failed)
	if disabled > 0 then
		warn("[PlanetCollector] " .. disabled .. " assets no cargaron; se usan materiales integrados en su lugar.")
	end
	return disabled
end

-- Oculta las superficies texturizadas (construidas por el servidor) cuyo asset fallo, para que se vea
-- la esfera de material que hay debajo.
function AssetCheck.fixModels(root)
	if next(AssetCheck.Failed) == nil then return end
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("SpecialMesh") and (AssetCheck.Failed[inst.TextureId] or AssetCheck.Failed[inst.MeshId]) then
			local part = inst.Parent
			if part and part:IsA("BasePart") then part.Transparency = 1 end
		elseif inst:IsA("Decal") and AssetCheck.Failed[inst.Texture] then
			inst.Transparency = 1
		end
	end
end

return AssetCheck
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX60">
          <Properties>
            <string name="Name">ClientState</string>
            <ProtectedString name="Source"><![CDATA[-- ClientState: copia local (solo lectura) del estado autorizado por el servidor.
-- Recibe el perfil completo al entrar y parches incrementales despues. La interfaz se suscribe a
-- claves de primer nivel ("Energy", "Planets", "_Production"...). El cliente nunca decide resultados.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local State = {}

State.Data = {}
State.Universes = {} -- [userId] = vista publica del universo
State.Leaderboards = {}
State.Ready = false

local remotes = nil
local listeners = {} -- [clave] = { fn, ... }
local anyListeners = {}
local universeListeners = {}
local leaderboardListeners = {}
local energyClock = 0

function State.remotes()
	return remotes
end

-- Llama a una peticion del servidor. Siempre devuelve una tabla { Ok, Data, Error }.
function State.call(name, ...)
	local remote = remotes and remotes:FindFirstChild(name)
	if not remote then
		return { Ok = false, Error = "Acción no disponible." }
	end
	local ok, result = pcall(remote.InvokeServer, remote, ...)
	if not ok or type(result) ~= "table" then
		return { Ok = false, Error = "Sin respuesta del servidor." }
	end
	return result
end

function State.on(key, fn)
	if not listeners[key] then listeners[key] = {} end
	table.insert(listeners[key], fn)
end

function State.onAny(fn)
	table.insert(anyListeners, fn)
end

function State.onUniverse(fn)
	table.insert(universeListeners, fn)
end

function State.onLeaderboard(fn)
	table.insert(leaderboardListeners, fn)
end

local function fire(list, ...)
	for _, fn in ipairs(list) do
		task.spawn(fn, ...)
	end
end

local function applyPatches(patches)
	local changed = {}
	for _, patch in ipairs(patches) do
		local path = patch.p
		local node = State.Data
		for i = 1, #path - 1 do
			local key = path[i]
			if type(node[key]) ~= "table" then node[key] = {} end
			node = node[key]
		end
		node[path[#path]] = patch.v
		changed[path[1]] = true
		if path[1] == "Energy" then energyClock = os.clock() end
	end
	for key in pairs(changed) do
		if listeners[key] then fire(listeners[key], State.Data[key]) end
	end
	fire(anyListeners, changed)
end

-- Energy mostrada: interpola entre ticks del servidor usando la produccion actual
function State.displayEnergy()
	local data = State.Data
	local energy = data.Energy or 0
	local production = data._Production
	if production and production.Total > 0 then
		energy = energy + production.Total * math.min(1.2, os.clock() - energyClock)
	end
	return energy
end

function State.rate()
	local production = State.Data._Production
	return production and production.Total or 0
end

function State.serverTime()
	return Workspace:GetServerTimeNow()
end

-- Ubicacion actual: "hub" o "u:<userId>"
function State.location()
	local session = State.Data._Session
	return session and session.Location or "hub"
end

-- userId del propietario del universo en el que esta el jugador, o nil si esta en el Hub
function State.locationOwner()
	local id = string.match(State.location(), "^u:(%d+)$")
	return id and tonumber(id) or nil
end

function State.inOwnUniverse()
	return State.locationOwner() == Players.LocalPlayer.UserId
end

function State.init()
	ReplicatedStorage:WaitForChild("ServerReady")
	remotes = ReplicatedStorage:WaitForChild("Remotes")

	remotes:WaitForChild("StateUpdate").OnClientEvent:Connect(function(patches)
		if State.Ready then applyPatches(patches) end
	end)
	remotes:WaitForChild("UniverseUpdate").OnClientEvent:Connect(function(view)
		State.Universes[view.Owner] = view
		fire(universeListeners, view.Owner, view)
	end)
	remotes:WaitForChild("UniverseRemoved").OnClientEvent:Connect(function(userId)
		State.Universes[userId] = nil
		fire(universeListeners, userId, nil)
	end)
	remotes:WaitForChild("LeaderboardUpdate").OnClientEvent:Connect(function(boards)
		State.Leaderboards = boards
		fire(leaderboardListeners, boards)
	end)

	-- esperar a que el servidor cargue el perfil
	local result = nil
	while true do
		result = State.call("GetState")
		if result.Ok then break end
		task.wait(0.5)
	end
	for key, value in pairs(result.Data.Profile) do
		State.Data[key] = value
	end
	for key, value in pairs(result.Data.Derived) do
		State.Data[key] = value
	end
	energyClock = os.clock()
	State.Ready = true

	local universes = State.call("GetUniverses")
	if universes.Ok then
		for _, view in ipairs(universes.Data) do
			State.Universes[view.Owner] = view
		end
	end
	local boards = State.call("GetLeaderboard")
	if boards.Ok then State.Leaderboards = boards.Data end
end

return State
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX61">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX62">
            <Properties>
              <string name="Name">AudioController</string>
              <ProtectedString name="Source"><![CDATA[-- AudioController: musica ambiental y efectos de sonido (respetando los ajustes del jugador).
-- Si un sonido no tiene asset configurado (id 0) simplemente no suena.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Assets = require(ReplicatedStorage:WaitForChild("Shared").Assets)

local Audio = {}
local ctx = nil
local sounds = {}
local music = nil
local currentTrack = nil

local VOLUMES = { click = 0.35, hover = 0.2, success = 0.5, error = 0.4, charge = 0.5, reveal = 0.55, fanfare = 0.6, portal = 0.5,
	notify = 0.45, collect = 0.45 }

local function settings()
	return ctx.State.Data.Settings or {}
end

function Audio.play(name)
	if not settings().Sfx then return end
	local sound = sounds[name]
	if not sound then
		local url = Assets.sound(name)
		if url == "" then return end
		sound = Instance.new("Sound")
		sound.Name = "Sfx_" .. name
		sound.SoundId = url
		sound.Volume = VOLUMES[name] or 0.5
		sound.Parent = SoundService
		sounds[name] = sound
	end
	SoundService:PlayLocalSound(sound)
end

local function updateMusic()
	local track = ctx.State.locationOwner() and "music_universe" or "music_hub"
	local url = Assets.sound(track)
	if url == "" then url = Assets.sound("music_hub") end
	if not settings().Music or url == "" then
		if music then music:Stop() end
		currentTrack = nil
		return
	end
	if not music then
		music = Instance.new("Sound")
		music.Name = "Music"
		music.Looped = true
		music.Volume = 0.22
		music.Parent = SoundService
	end
	if currentTrack ~= url then
		currentTrack = url
		music:Stop()
		music.SoundId = url
		music:Play()
	elseif not music.IsPlaying then
		music:Play()
	end
end

function Audio.init(context)
	ctx = context
	ctx.Audio = Audio
	ctx.Kit.onClick = function()
		Audio.play("click")
	end
	ctx.State.on("Settings", updateMusic)
	ctx.State.on("_Session", updateMusic)
	updateMusic()
end

return Audio
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX63">
            <Properties>
              <string name="Name">CameraController</string>
              <ProtectedString name="Source"><![CDATA[-- CameraController: "vista orbital" opcional para contemplar el sistema completo desde arriba.
-- La camara normal del personaje se restaura al salir o al cambiar de lugar.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Camera = {}
local ctx = nil
local active = false
local angle = 0
local zoom = 1

local ZOOMS = { { 340, 190 }, { 230, 110 }, { 430, 330 } }

local function stop()
	if not active then return end
	active = false
	RunService:UnbindFromRenderStep("PlanetCollectorOverview")
	local camera = Workspace.CurrentCamera
	if camera then camera.CameraType = Enum.CameraType.Custom end
end

local function step(dt)
	local center = ctx.Universe and ctx.Universe.currentCenter()
	local camera = Workspace.CurrentCamera
	if not center or not camera then
		stop()
		return
	end
	angle = angle + dt * 0.06
	local z = ZOOMS[zoom]
	local pos = center + Vector3.new(math.sin(angle) * z[1], z[2], math.cos(angle) * z[1])
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(pos, center)
end

function Camera.isOverview()
	return active
end

-- Alterna: normal -> vista orbital -> zoom cercano -> zoom lejano -> normal
function Camera.toggleOverview()
	if not active then
		if not (ctx.Universe and ctx.Universe.currentCenter()) then return end
		active = true
		zoom = 1
		RunService:BindToRenderStep("PlanetCollectorOverview", Enum.RenderPriority.Camera.Value + 1, step)
		ctx.UI.toast("Vista orbital: pulsa otra vez para cambiar el zoom y salir.", "info")
	elseif zoom < #ZOOMS then
		zoom = zoom + 1
	else
		stop()
	end
end

function Camera.init(context)
	ctx = context
	ctx.Camera = Camera
	ctx.State.on("_Session", function()
		if not ctx.State.locationOwner() then stop() end
	end)
end

return Camera
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX64">
            <Properties>
              <string name="Name">CapsuleController</string>
              <ProtectedString name="Source"><![CDATA[-- CapsuleController: animacion de apertura de capsulas. Solo reproduce el resultado que ya decidio el
-- servidor: capsula y nombre -> vibracion y luz -> apertura -> el planeta emerge girando -> datos.
-- Es corta y se puede saltar tocando la pantalla (o desactivar en Ajustes).
local RunService = game:GetService("RunService")

local Capsule = {}
local ctx = nil
local playing = false
local queue = {}

local function reveal(root, data, skipIntro)
	local Kit, Defs, Format, Progression, Theme = ctx.Kit, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local capsuleDef = Defs.Capsules.ById[data.Capsule]
	local results = data.Results
	-- se muestra el mejor resultado (mayor rareza; variante como desempate)
	local best = results[1]
	local function score(r)
		local s = Defs.Rarities.ById[r.Rarity].Order * 10
		if r.V ~= "none" then s = s + 5 end
		if r.New then s = s + 1 end
		return s
	end
	for _, r in ipairs(results) do
		if score(r) > score(best) then best = r end
	end
	local def = Defs.Planets.ById[best.Id]
	local rarity = Defs.Rarities.ById[def.Rarity]
	local variant = Defs.Variants.get(best.V)
	local skipped = skipIntro
	local finished = false

	local stage = Kit.frame(root, { Name = "Stage", Size = UDim2.fromOffset(700, 560), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5) })
	local title = Kit.label(stage, string.upper(capsuleDef.Name), { Size = UDim2.new(1, 0, 0, 40), TextSize = 26, Font = F.Title,
		AlignX = Enum.TextXAlignment.Center, Color = capsuleDef.Color, Stroke = true })

	-- capsula (dos mitades)
	local pill = Kit.frame(stage, { Name = "Pill", Size = UDim2.fromOffset(130, 250), Position = UDim2.new(0.5, 0, 0, 190),
		AnchorPoint = Vector2.new(0.5, 0.5) })
	local glow = Kit.box(pill, capsuleDef.Color, 0.7, { Size = UDim2.fromOffset(260, 260), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5) }, 130)
	local top = Kit.box(pill, Color3.fromRGB(240, 244, 255), 0, { Size = UDim2.new(1, 0, 0.5, 0) }, 60)
	local bottom = Kit.box(pill, capsuleDef.Color, 0, { Size = UDim2.new(1, 0, 0.5, 0), Position = UDim2.fromScale(0, 0.5) }, 60)
	Kit.gradient(bottom, capsuleDef.CoreColor, capsuleDef.Color, 90)
	local core = Kit.box(pill, capsuleDef.CoreColor, 0, { Size = UDim2.new(1, 8, 0, 26), Position = UDim2.new(0, -4, 0.5, -13) }, 8)
	Kit.stroke(core, Color3.new(1, 1, 1), 2, 0.2)

	local flash = Kit.frame(root, { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1, ZIndex = 5 })

	local skipConn = nil
	local catcher = Instance.new("TextButton")
	catcher.Name = "Skip"
	catcher.Text = ""
	catcher.BackgroundTransparency = 1
	catcher.Size = UDim2.fromScale(1, 1)
	catcher.ZIndex = 4
	catcher.Parent = root
	skipConn = catcher.Activated:Connect(function()
		skipped = true
	end)
	local hint = Kit.label(root, "Toca para saltar", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -40), TextSize = 13,
		AlignX = Enum.TextXAlignment.Center, Color = C.TextDim })

	local function waitOrSkip(seconds)
		local t = 0
		while t < seconds and not skipped do
			t = t + task.wait(0.03)
		end
	end

	if not skipped then
		if ctx.Audio then ctx.Audio.play("charge") end
		-- vibracion breve y aumento de luz
		for i = 1, 9 do
			if skipped then break end
			pill.Rotation = (i % 2 == 0) and 5 or -5
			glow.BackgroundTransparency = math.max(0.2, 0.7 - i * 0.055)
			glow.Size = UDim2.fromOffset(260 + i * 14, 260 + i * 14)
			waitOrSkip(0.085)
		end
		pill.Rotation = 0
		-- apertura mecanica + destello
		Kit.tween(top, 0.25, { Position = UDim2.new(0, 0, 0, -70), BackgroundTransparency = 1 })
		Kit.tween(bottom, 0.25, { Position = UDim2.new(0, 0, 0.5, 70), BackgroundTransparency = 1 })
		Kit.tween(core, 0.2, { BackgroundTransparency = 1 })
		flash.BackgroundTransparency = 0.15
		Kit.tween(flash, 0.45, { BackgroundTransparency = 1 })
		waitOrSkip(0.25)
	end
	pill:Destroy()
	flash.BackgroundTransparency = 1
	hint:Destroy()
	skipConn:Disconnect()
	catcher:Destroy()
	if ctx.Audio then
		ctx.Audio.play(rarity.Order >= 4 and "fanfare" or "reveal")
	end

	-- el planeta emerge y rota
	title.Text = (best.New and "¡NUEVO DESCUBRIMIENTO!") or (best.NewVariant and "¡NUEVA VARIANTE!") or string.upper(capsuleDef.Name)
	title.TextColor3 = (best.New or best.NewVariant) and C.Gold or capsuleDef.Color
	local halo = Kit.box(stage, rarity.Color, 0.78, { Size = UDim2.fromOffset(330, 330), Position = UDim2.new(0.5, 0, 0, 205),
		AnchorPoint = Vector2.new(0.5, 0.5) }, 165)
	Kit.stroke(halo, rarity.Color, 3, 0.1)
	local view = Kit.viewport(stage, best.Id, best.V, false, { Size = UDim2.fromOffset(300, 300), Position = UDim2.new(0.5, 0, 0, 205),
		AnchorPoint = Vector2.new(0.5, 0.5) })
	local viewScale = Instance.new("UIScale")
	viewScale.Scale = 0.2
	viewScale.Parent = view
	Kit.tween(viewScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	local model = view:FindFirstChildOfClass("Model")
	local spin = 0
	local conn = RunService.Heartbeat:Connect(function(dt)
		spin = spin + dt * 0.9
		if model and model.Parent then
			model:PivotTo(CFrame.Angles(math.rad(18), spin, math.rad(-14)))
		end
	end)

	local info = Kit.frame(stage, { Name = "Info", Size = UDim2.new(1, 0, 0, 120), Position = UDim2.fromOffset(0, 372) })
	Kit.label(info, def.Name, { Size = UDim2.new(1, 0, 0, 40), TextSize = 34, Font = F.Black, AlignX = Enum.TextXAlignment.Center,
		Color = rarity.Color, Stroke = true })
	local sub = Kit.rarityText(def.Rarity) .. "   ·   " .. def.TypeLabel
	if variant.Id ~= "none" then sub = sub .. "   ·   " .. variant.Icon .. " " .. variant.Name end
	Kit.label(info, sub, { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 42), TextSize = 16, AlignX = Enum.TextXAlignment.Center })
	Kit.label(info, "⚡ " .. Format.rate(Progression.planetRate({ Id = best.Id, V = best.V, E = false })) .. " base",
		{ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 68), TextSize = 17, AlignX = Enum.TextXAlignment.Center, Color = C.Energy })
	if #results > 1 then
		local names = {}
		for _, r in ipairs(results) do
			local d = Defs.Planets.ById[r.Id]
			local v = Defs.Variants.get(r.V)
			table.insert(names, Defs.Rarities.ById[d.Rarity].Icon .. " " .. d.Name .. (v.Id ~= "none" and (" " .. v.Icon) or ""))
		end
		Kit.label(info, "x" .. #results .. ":  " .. table.concat(names, "  ·  "), { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 94),
			TextSize = 12, AlignX = Enum.TextXAlignment.Center, Color = C.TextDim, Font = F.Body })
	end

	local buttons = Kit.frame(stage, { Name = "Buttons", Size = UDim2.new(1, 0, 0, 48), Position = UDim2.new(0, 0, 1, -52) })
	local layout = Kit.listLayout(buttons, 12, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	local function finish()
		if finished then return end
		finished = true
		conn:Disconnect()
	end
	Kit.button(buttons, "Guardar", "ghost", { Size = UDim2.fromOffset(170, 46), Props = { LayoutOrder = 1, Name = "Keep" } }, finish)
	Kit.button(buttons, "Colocar en órbita", "primary", { Size = UDim2.fromOffset(200, 46), Props = { LayoutOrder = 2, Name = "Place" } }, function()
		finish()
		ctx.UI.open("Inventory", { Select = best.Uid, Place = true })
	end)
	Kit.button(buttons, "Inspeccionar", "cyan", { Size = UDim2.fromOffset(170, 46), Props = { LayoutOrder = 3, Name = "Inspect" } }, function()
		finish()
		ctx.UI.open("Inventory", { Select = best.Uid })
	end)
	while not finished do
		task.wait(0.05)
	end
end

local function run(data)
	local Kit, Theme = ctx.Kit, ctx.Theme
	local settings = ctx.State.Data.Settings or {}
	local root = Kit.frame(ctx.UI.overlay(), { Name = "CapsuleOpening", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Colors.Dark,
		BackgroundTransparency = 0.25, Active = true, ZIndex = 30 })
	local ok, err = pcall(reveal, root, data, settings.SkipCapsuleAnimation == true)
	if not ok then warn("[Capsule] " .. tostring(err)) end
	root:Destroy()
end

-- Reproduce la apertura del resultado recibido del servidor (en cola si ya hay una en curso)
function Capsule.play(data)
	table.insert(queue, data)
	if playing then return end
	playing = true
	task.spawn(function()
		while #queue > 0 do
			run(table.remove(queue, 1))
		end
		playing = false
	end)
end

function Capsule.isPlaying()
	return playing
end

function Capsule.init(context)
	ctx = context
	ctx.Capsule = Capsule
end

return Capsule
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX65">
            <Properties>
              <string name="Name">EffectsController</string>
              <ProtectedString name="Source"><![CDATA[-- EffectsController: presentaciones breves y saltables (ascension, resumen de ganancias sin conexion).
-- Siempre se muestran DESPUES de que el servidor confirme el resultado.
local Effects = {}
local ctx = nil

-- Animacion de ascension: la pantalla pasa a blanco/azul, onda de energia y renacer con nuevo halo.
function Effects.ascension(data)
	local Kit, Theme, Format = ctx.Kit, ctx.Theme, ctx.Format
	local C, F = Theme.Colors, Theme.Fonts
	if ctx.Audio then ctx.Audio.play("fanfare") end
	local root = Kit.frame(ctx.UI.overlay(), { Name = "Ascension", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(215, 235, 255),
		BackgroundTransparency = 1, Active = true, ZIndex = 40 })
	local closed = false
	local function close()
		if closed then return end
		closed = true
		root:Destroy()
	end
	local skip = Instance.new("TextButton")
	skip.Text = ""
	skip.BackgroundTransparency = 1
	skip.Size = UDim2.fromScale(1, 1)
	skip.ZIndex = 45
	skip.Activated:Connect(close)
	skip.Parent = root
	if not (ctx.State.Data.Settings or {}).ReducedEffects then
		Kit.tween(root, 0.35, { BackgroundTransparency = 0.05 })
		task.wait(0.4)
		if closed then return end
		Kit.tween(root, 0.8, { BackgroundTransparency = 0.55, BackgroundColor3 = Color3.fromRGB(20, 30, 80) })
	else
		root.BackgroundColor3 = Color3.fromRGB(20, 30, 80)
		root.BackgroundTransparency = 0.4
	end
	local wave = Kit.box(root, C.Cyan, 1, { Size = UDim2.fromOffset(60, 60), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 41 }, 400)
	local waveStroke = Kit.stroke(wave, C.Gold, 6, 0)
	Kit.tween(wave, 1.1, { Size = UDim2.fromOffset(900, 900) })
	Kit.tween(waveStroke, 1.1, { Transparency = 1 })
	local title = Kit.label(root, "ASCENSIÓN " .. tostring(data.Ascensions), { Size = UDim2.new(1, 0, 0, 70), Position = UDim2.new(0, 0, 0.5, -70),
		TextSize = 56, Font = F.Title, AlignX = Enum.TextXAlignment.Center, Color = C.Gold, Stroke = true, Props = { ZIndex = 42 } })
	local sub = Kit.label(root, "Producción permanente " .. Format.mult(data.Multiplier) .. "   ·   +" .. data.Cores .. " 💠 Cosmic Cores",
		{ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0.5, 10), TextSize = 22, AlignX = Enum.TextXAlignment.Center, Stroke = true,
			Props = { ZIndex = 42 } })
	Kit.label(root, "Toca para continuar", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0.5, 60), TextSize = 14,
		AlignX = Enum.TextXAlignment.Center, Color = C.TextDim, Props = { ZIndex = 42 } })
	title.TextTransparency = 1
	sub.TextTransparency = 1
	Kit.tween(title, 0.4, { TextTransparency = 0 })
	Kit.tween(sub, 0.6, { TextTransparency = 0 })
	task.delay(4.5, close)
end

-- Resumen de ganancias sin conexion al volver
function Effects.offline(summary)
	local Format = ctx.Format
	ctx.UI.confirm({ Title = "¡Bienvenido de nuevo!", Icon = "🌙", Confirm = "¡Genial!", Cancel = "Cerrar", Style = "gold",
		Text = "Mientras no estabas (" .. Format.duration(summary.Away) .. "), tus planetas siguieron trabajando durante "
			.. Format.duration(summary.Seconds) .. " y generaron " .. Format.number(summary.Energy) .. " de Energy.\n\n"
			.. "Mejora Baterías Offline y Colector Nocturno para ganar más." })
end

function Effects.init(context)
	ctx = context
	ctx.Effects = Effects
end

return Effects
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX66">
            <Properties>
              <string name="Name">HubController</string>
              <ProtectedString name="Source"><![CDATA[-- HubController: vida del Cosmic Hub en el cliente. Interpreta los ProximityPrompts de las
-- instalaciones, anima el holograma central y las capsulas, rellena los tableros (probabilidades,
-- leaderboard, evento) y muestra los meteoritos de Meteor Shower.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Build = require(Shared.Util.Build)
local Format = require(Shared.Util.Format)

local Hub = {}
local ctx = nil
local player = Players.LocalPlayer
local hub = nil
local animated = {} -- { Model, Base, Kind, Phase }
local boardLabels = {}
local leaderboardIndex = 1
local meteorFolder = nil

local LEADERBOARD = {
	{ "Rate", "PRODUCCIÓN (ENERGY/S)", function(v) return Format.rate(v) end },
	{ "Value", "VALOR DEL UNIVERSO", function(v) return Format.number(v) end },
	{ "Ascensions", "ASCENSIONES", function(v) return Format.number(v) end },
	{ "Discoveries", "PLANETAS DESCUBIERTOS", function(v) return Format.number(v) end },
	{ "Rares", "PLANETAS RAROS", function(v) return Format.number(v) end },
}

---------------------------------------------------------------- prompts
local function onPrompt(prompt, who)
	if who ~= player then return end
	local action = prompt:GetAttribute("Action")
	if type(action) ~= "string" then return end
	local capsule = string.match(action, "^Capsule:(.+)$")
	if capsule then
		ctx.UI.open("Capsules", { Capsule = capsule })
	elseif action == "Portal" then
		ctx.UI.open("Teleport")
	elseif action == "Market" then
		ctx.UI.open("Trading")
	elseif action == "Event" then
		ctx.UI.open("Event")
	elseif action == "Leaderboard" then
		ctx.UI.open("Leaderboard")
	elseif action == "Upgrades" then
		ctx.UI.open("Upgrades")
	elseif action == "Capsules" then
		ctx.UI.open("Capsules")
	elseif action == "Galaxy" then
		ctx.UI.open("Galaxy")
	elseif action == "Collection" then
		ctx.UI.open("Collection")
	elseif action == "Hub" then
		local result = ctx.UI.request("Teleport", "hub")
		if result.Ok and ctx.Audio then ctx.Audio.play("portal") end
	end
end

---------------------------------------------------------------- tableros
local function boardLabel(name, textSize)
	local boards = hub:FindFirstChild("Boards")
	local board = (boards and boards:FindFirstChild(name)) or hub:FindFirstChild(name, true)
	local panel = board and board:FindFirstChild("Panel")
	if not panel then return nil end
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Adornee = panel
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local label = Build.label(gui, "", { Size = UDim2.fromScale(0.94, 0.92), Position = UDim2.fromScale(0.03, 0.04), TextScaled = false,
		TextSize = textSize, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true })
	boardLabels[name] = label
	return label
end

local function hex(color)
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function updateOdds()
	local label = boardLabels.Board_Odds
	if not label then return end
	local lines = { "<font size=\"44\"><b>CAPSULE PROBABILITIES</b></font>  <font color=\"#A0AFD2\">probabilidades reales</font>" }
	for _, def in ipairs(Defs.Capsules.List) do
		local parts = {}
		for _, entry in ipairs(Defs.Capsules.oddsList(def, Defs.Rarities.Order)) do
			local rarity = Defs.Rarities.ById[entry.Rarity]
			table.insert(parts, "<font color=\"" .. hex(rarity.Color) .. "\">" .. rarity.Icon .. " " .. rarity.Name .. " " .. Format.percent(entry.Chance)
				.. "</font>")
		end
		table.insert(lines, "<font color=\"" .. hex(def.Color) .. "\"><b>" .. def.Name .. "</b></font>  ⚡" .. Format.number(def.Price))
		table.insert(lines, "   " .. table.concat(parts, "   "))
	end
	label.Text = table.concat(lines, "\n")
end

local function updateLeaderboard()
	local label = boardLabels.Board_Leaderboard
	if not label then return end
	local category = LEADERBOARD[leaderboardIndex]
	local board = ctx.State.Leaderboards[category[1]] or {}
	local lines = { "<font size=\"50\"><b>LEADERBOARD</b></font>", "<font color=\"#C8AAFF\">" .. category[2] .. "</font>" }
	for rank = 1, 8 do
		local entry = board[rank]
		if entry then
			local color = (rank == 1 and "#FFC850") or (rank == 2 and "#D2DCF0") or (rank == 3 and "#E6A064") or "#F0F5FF"
			table.insert(lines, "<font color=\"" .. color .. "\">" .. rank .. ".  " .. entry.Name .. "</font>   <font color=\"#46D7FF\">"
				.. category[3](entry.Value) .. "</font>")
		end
	end
	if #board == 0 then table.insert(lines, "Aún sin datos. ¡Sé el primero!") end
	label.Text = table.concat(lines, "\n")
end

local function updateEventBoard()
	local label = boardLabels.Board_Event
	if not label then return end
	local event = ctx.State.Data._Event
	if not event then return end
	local now = ctx.State.serverTime()
	if event.Id and now < (event.EndsAt or 0) then
		local def = Defs.Events.ById[event.Id]
		label.Text = "<font size=\"46\" color=\"" .. hex(def.Color) .. "\"><b>" .. def.Icon .. " " .. string.upper(def.Name) .. "</b></font>\n"
			.. "<font size=\"40\">Termina en " .. Format.clock(event.EndsAt - now) .. "</font>\n" .. def.Description
	else
		local def = Defs.Events.ById[event.NextId]
		label.Text = "<font size=\"40\"><b>COSMIC EVENTS</b></font>\nPróximo: <font color=\"" .. hex(def.Color) .. "\">" .. def.Icon .. " " .. def.Name
			.. "</font>\n<font size=\"46\">" .. Format.clock(math.max(0, event.NextStartsAt - now)) .. "</font>"
	end
end

---------------------------------------------------------------- animacion ambiental
local function collectAnimated()
	animated = {}
	local core = hub:FindFirstChild("Core")
	if core then
		local globe = core:FindFirstChild("HubGlobe")
		if globe then table.insert(animated, { Model = globe, Base = globe:GetPivot(), Kind = "spin", Speed = 0.25 }) end
		for i = 1, 3 do
			local ring = core:FindFirstChild("HoloRing" .. i)
			if ring then
				table.insert(animated, { Model = ring, Base = ring:GetPivot(), Kind = "spin", Speed = 0.35 * (i % 2 == 0 and -1 or 1) })
			end
		end
	end
	local station = hub:FindFirstChild("CapsuleStation")
	if station then
		for index, machine in ipairs(station:GetChildren()) do
			local capsule = machine:IsA("Model") and machine:FindFirstChild("Capsule")
			if capsule then
				table.insert(animated, { Model = capsule, Base = capsule:GetPivot(), Kind = "bob", Phase = index * 1.3 })
			end
		end
	end
end

local function animate()
	if ctx.State.locationOwner() ~= nil then return end
	local t = os.clock()
	for _, item in ipairs(animated) do
		if item.Kind == "spin" then
			item.Model:PivotTo(item.Base * CFrame.Angles(0, t * item.Speed % (math.pi * 2), 0))
		else
			item.Model:PivotTo(item.Base * CFrame.new(0, math.sin(t * 1.6 + item.Phase) * 0.35, 0) * CFrame.Angles(0, t * 0.8 % (math.pi * 2), 0))
		end
	end
end

---------------------------------------------------------------- meteoritos
local function spawnMeteor(info)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local rng = Random.new(info.Seed)
	local angle = rng:NextNumber(0, math.pi * 2)
	local dist = rng:NextNumber(10, 26)
	local ground = root.Position.Y - 2.2
	local target = Vector3.new(root.Position.X + math.cos(angle) * dist, ground, root.Position.Z + math.sin(angle) * dist)
	local meteor = Build.ball({ Position = target + Vector3.new(rng:NextNumber(-30, 30), 90, rng:NextNumber(-30, 30)), Radius = 1.4 },
		{ Name = "Meteor", Color = Color3.fromRGB(255, 170, 80), Material = Enum.Material.Neon, CanCollide = false })
	Build.light(meteor, Color3.fromRGB(255, 170, 80), 18, 2)
	Build.particles(meteor, { Texture = Build.ParticleTextures.Fire, Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 90, 30)),
		Rate = 30, Lifetime = NumberRange.new(0.5, 1), Speed = NumberRange.new(1, 3), Size = Build.sizeSeq(2.2) })
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 60
	click.Parent = meteor
	meteor.Parent = meteorFolder
	local collected = false
	local function collect()
		if collected then return end
		collected = true
		local result = ctx.State.call("CollectMeteor", info.Id)
		if result.Ok then
			ctx.UI.toast("☄️ +" .. result.Data.Stardust .. " Stardust", "reward")
			if ctx.Audio then ctx.Audio.play("collect") end
		end
		meteor:Destroy()
	end
	click.MouseClick:Connect(collect)
	meteor.Touched:Connect(function(hit)
		if hit:IsDescendantOf(player.Character or meteorFolder) then collect() end
	end)
	-- caida
	task.spawn(function()
		local start = meteor.Position
		local t = 0
		while t < 1 and meteor.Parent do
			t = math.min(1, t + RunService.Heartbeat:Wait() / 1.2)
			meteor.CFrame = CFrame.new(start:Lerp(target + Vector3.new(0, 1.4, 0), t * t))
		end
	end)
	task.delay(info.Lifetime or 14, function()
		if meteor.Parent then meteor:Destroy() end
	end)
end

function Hub.init(context)
	ctx = context
	ctx.Hub = Hub
	hub = Workspace:WaitForChild("CosmicHub")
	meteorFolder = Workspace:FindFirstChild("EventEnvironment") or Workspace

	ProximityPromptService.PromptTriggered:Connect(onPrompt)

	boardLabel("Board_Odds", 30)
	boardLabel("Board_Leaderboard", 38)
	boardLabel("Board_Event", 30)
	updateOdds()
	updateLeaderboard()
	updateEventBoard()
	ctx.State.onLeaderboard(updateLeaderboard)

	collectAnimated()
	RunService.Heartbeat:Connect(animate)
	local accumulator, cycle = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		cycle = cycle + dt
		if accumulator >= 1 then
			accumulator = 0
			updateEventBoard()
		end
		if cycle >= 8 then
			cycle = 0
			leaderboardIndex = leaderboardIndex % #LEADERBOARD + 1
			updateLeaderboard()
		end
	end)

	ctx.State.remotes():WaitForChild("Meteor").OnClientEvent:Connect(function(info)
		local ok, err = pcall(spawnMeteor, info)
		if not ok then warn("[Hub] meteor: " .. tostring(err)) end
	end)
end

return Hub
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX67">
            <Properties>
              <string name="Name">TradeController</string>
              <ProtectedString name="Source"><![CDATA[-- TradeController: recibe del servidor el estado del intercambio (invitaciones, ofertas, cierre) y
-- abre/actualiza la TradingUI. El cliente nunca transfiere nada: solo muestra y solicita.
local TradeController = {}

local Trade = { Current = nil, Requests = {} }

function Trade.removeRequest(fromUserId)
	for i = #Trade.Requests, 1, -1 do
		if Trade.Requests[i].From == fromUserId then table.remove(Trade.Requests, i) end
	end
end

function TradeController.init(ctx)
	ctx.Trade = Trade
	ctx.State.remotes():WaitForChild("TradeUpdate").OnClientEvent:Connect(function(update)
		if update.Stage == "request" then
			Trade.removeRequest(update.From)
			table.insert(Trade.Requests, { From = update.From, Name = update.Name, Expires = os.clock() + (update.Timeout or 30) })
			ctx.UI.toast("🤝 " .. update.Name .. " quiere intercambiar contigo", "info")
			if ctx.Audio then ctx.Audio.play("notify") end
			if not ctx.UI.isOpen() or ctx.UI.isOpen("Trading") then
				ctx.UI.open("Trading")
			end
		elseif update.Stage == "closed" then
			Trade.Current = nil
			ctx.UI.toast(update.Reason or "Intercambio cerrado.", update.Completed and "reward" or "info")
			if update.Completed and ctx.Audio then ctx.Audio.play("success") end
			ctx.UI.refresh("Trading")
		else
			local isNew = Trade.Current == nil
			Trade.Current = update
			if isNew then
				ctx.UI.open("Trading")
			else
				ctx.UI.refresh("Trading")
			end
		end
	end)
end

return TradeController
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX68">
            <Properties>
              <string name="Name">TutorialController</string>
              <ProtectedString name="Source"><![CDATA[-- TutorialController: guia inicial (abrir, colocar, producir y mejorar). El avance lo decide el servidor
-- segun las acciones reales del jugador; aqui solo se muestra el paso actual y se resalta el boton.
local RunService = game:GetService("RunService")

local Tutorial = {}
local ctx = nil
local banner, textLabel, actionButton, highlight = nil, nil, nil, nil
local highlighted = nil

local STEPS = {
	welcome = { Text = "¡Bienvenido a PLANET COLLECTOR! Colecciona planetas, colócalos en órbita alrededor de tu estrella y genera Energy.",
		Button = "Empezar", Ack = "welcome" },
	open_capsule = { Text = "Paso 1 · Abre tu primera cápsula: pulsa OPEN CAPSULE (o acércate a la Capsule Station) y abre una Starter Capsule.",
		Target = "Capsule" },
	go_universe = { Text = "Paso 2 · ¡Ya tienes planetas! Viaja a tu universo personal con la tarjeta «Tu Universo» o por el Portal Room.",
		Target = "UniverseCard" },
	place_planet = { Text = "Paso 3 · Coloca un planeta: usa el panel ÓRBITAS de la derecha (+ Colocar planeta) o toca un marcador verde.",
		Target = nil },
	watch_production = { Text = "Paso 4 · Tu planeta ya produce Energy cada segundo. Mira el contador ⚡ arriba a la izquierda.",
		Button = "Entendido", Ack = "watch_production" },
	buy_upgrade = { Text = "Paso 5 · Invierte tu Energy: abre Mejoras y compra «Reactor Estelar» para producir más.", Target = "Upgrades" },
}

local function clearHighlight()
	if highlight then
		highlight:Destroy()
		highlight = nil
	end
	highlighted = nil
end

local function setHighlight(target)
	if highlighted == target then return end
	clearHighlight()
	if not target then return end
	highlighted = target
	highlight = Instance.new("UIStroke")
	highlight.Name = "TutorialGlow"
	highlight.Color = ctx.Theme.Colors.Gold
	highlight.Thickness = 4
	highlight.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	highlight.Parent = target
end

local function refresh()
	local steps = ctx.Defs.Config.TutorialSteps
	local name = steps[ctx.State.Data.Tutorial or #steps]
	local step = name and STEPS[name]
	if not step then
		banner.Visible = false
		clearHighlight()
		return
	end
	banner.Visible = true
	textLabel.Text = step.Text
	actionButton.Visible = step.Button ~= nil
	actionButton.Text = step.Button or ""
	actionButton:SetAttribute("Ack", step.Ack)
	local hud = ctx.UI.Hud
	local target = nil
	if step.Target == "Upgrades" then
		target = hud.Root:FindFirstChild("Right") and hud.Root.Right:FindFirstChild("Upgrades")
	elseif step.Target then
		target = hud[step.Target]
	end
	setHighlight(target)
end

function Tutorial.init(context)
	ctx = context
	local Kit, Theme = ctx.Kit, ctx.Theme
	local C = Theme.Colors
	banner = Kit.box(ctx.UI.Hud.Root, C.Panel, 0.08, { Name = "Tutorial", Size = UDim2.fromOffset(640, 84), Position = UDim2.new(0.5, 0, 1, -130),
		AnchorPoint = Vector2.new(0.5, 1), Visible = false }, 12)
	Kit.stroke(banner, C.Gold, 2, 0)
	textLabel = Kit.label(banner, "", { Size = UDim2.new(1, -190, 1, -12), Position = UDim2.fromOffset(14, 6), TextSize = 14, Wrap = true,
		Font = Theme.Fonts.Body })
	actionButton = Kit.button(banner, "", "gold", { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -164, 0.5, -20), TextSize = 14,
		Props = { Name = "Continue" } }, function(button)
		local ack = button:GetAttribute("Ack")
		if ack then ctx.UI.request("TutorialAck", ack) end
	end)
	Kit.button(banner, "Saltar", "ghost", { Size = UDim2.fromOffset(64, 22), Position = UDim2.new(1, -70, 0, -26), TextSize = 11,
		Props = { Name = "Skip" } }, function()
		ctx.UI.request("SkipTutorial")
	end)
	ctx.State.on("Tutorial", refresh)
	ctx.UI.onLayout(function(compact)
		banner.Position = compact and UDim2.new(0.5, 0, 1, -96) or UDim2.new(0.5, 0, 1, -130)
	end)
	refresh()
	-- latido del resaltado
	local t = 0
	RunService.Heartbeat:Connect(function(dt)
		if highlight then
			t = t + dt
			highlight.Transparency = 0.25 + 0.25 * math.sin(t * 5)
		end
	end)
end

return Tutorial
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX69">
            <Properties>
              <string name="Name">UIController</string>
              <ProtectedString name="Source"><![CDATA[-- UIController: HUD principal, gestor de paneles, avisos (toasts) y dialogos de confirmacion.
-- El mundo 3D es el foco: los paneles se abren bajo demanda y solo uno a la vez.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Format = require(Shared.Util.Format)
local Progression = require(Shared.Progression)
local Client = script.Parent.Parent
local State = require(Client.ClientState)
local Kit = require(Client.UI.Kit)
local Theme = require(Client.UI.Theme)
local C, F = Theme.Colors, Theme.Fonts

local UI = {}

local player = Players.LocalPlayer
local playerGui = nil
local hudGui, panelGui, overlayGui = nil, nil, nil
local panels = {} -- [nombre] = { Frame, OnOpen, OnClose }
local current = nil
local ctx = nil
local toastHolder = nil
local hud = {}
local openListeners = {}

UI.Hud = hud

local screens = {} -- [contenedor] = ScreenGui

-- Crea una ScreenGui con un marco raiz escalable. El UIScale vive en el marco (un GuiObject) y el
-- marco mide 1/escala de la pantalla, asi que tras escalar ocupa exactamente toda la pantalla.
-- Devuelve el marco raiz, que es donde se colocan los elementos.
local function makeScreen(name, order, ignoreInset)
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = ignoreInset
	gui.DisplayOrder = order
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Name = "ScreenScale"
	scale.Parent = root
	gui.Parent = playerGui
	screens[root] = gui
	return root
end

local compact = false
local layoutListeners = {}

-- Posiciones y tamaños del HUD: modo normal (escritorio/tablet) y compacto (moviles apaisados)
local LAYOUTS = {
	normal = {
		Energy = { UDim2.fromOffset(16, 16), UDim2.fromOffset(270, 54) },
		Rate = { UDim2.fromOffset(24, 76), UDim2.fromOffset(190, 34) },
		Stardust = { UDim2.fromOffset(24, 116), UDim2.fromOffset(124, 30) },
		Cores = { UDim2.fromOffset(154, 116), UDim2.fromOffset(110, 30) },
		Rebirth = { UDim2.new(1, -16, 0, 16), UDim2.fromOffset(236, 54) },
		Ascension = { UDim2.new(1, -16, 0, 78), UDim2.fromOffset(236, 36) },
		TopButtons = { UDim2.new(1, -16, 0, 122), UDim2.fromOffset(236, 44), UDim2.fromOffset(114, 40) },
		Left = { UDim2.new(0, 16, 0.5, 30), UDim2.fromOffset(104, 470), UDim2.fromOffset(104, 86), Vector2.new(0, 0.5), 34 },
		UniverseCard = { UDim2.new(0, 16, 1, -16), UDim2.fromOffset(370, 96) },
		Capsule = { UDim2.new(0.5, 0, 1, -16), UDim2.fromOffset(310, 100) },
		Right = { UDim2.new(1, -16, 1, -16), UDim2.fromOffset(400, 104), UDim2.fromOffset(124, 104), Vector2.new(1, 1), 40 },
		Event = { UDim2.new(0.5, 0, 0, 14), UDim2.fromOffset(400, 44) },
		Visit = { UDim2.new(0.5, 0, 0, 64), UDim2.fromOffset(460, 34) },
		Toasts = { UDim2.new(0.5, 0, 0, 108), UDim2.fromOffset(640, 400) },
		CapsuleText = 27, RebirthText = 22,
	},
	compact = {
		Energy = { UDim2.fromOffset(12, 6), UDim2.fromOffset(240, 46) },
		Rate = { UDim2.fromOffset(12, 56), UDim2.fromOffset(130, 28) },
		Stardust = { UDim2.fromOffset(146, 56), UDim2.fromOffset(106, 28) },
		Cores = { UDim2.fromOffset(12, 88), UDim2.fromOffset(100, 26) },
		Rebirth = { UDim2.new(1, -12, 0, 6), UDim2.fromOffset(190, 44) },
		Ascension = { UDim2.new(1, -12, 0, 54), UDim2.fromOffset(190, 30) },
		TopButtons = { UDim2.new(1, -12, 0, 88), UDim2.fromOffset(190, 36), UDim2.fromOffset(91, 34) },
		Left = { UDim2.fromOffset(12, 122), UDim2.fromOffset(190, 200), UDim2.fromOffset(90, 60), Vector2.new(0, 0), 24 },
		UniverseCard = { UDim2.new(0, 12, 1, -10), UDim2.fromOffset(290, 70) },
		Capsule = { UDim2.new(0.5, 0, 1, -10), UDim2.fromOffset(250, 76) },
		Right = { UDim2.new(1, -12, 1, -10), UDim2.fromOffset(310, 78), UDim2.fromOffset(96, 78), Vector2.new(1, 1), 30 },
		Event = { UDim2.new(0.5, 0, 0, 6), UDim2.fromOffset(330, 36) },
		Visit = { UDim2.new(0.5, 0, 0, 46), UDim2.fromOffset(400, 28) },
		Toasts = { UDim2.new(0.5, 0, 0, 80), UDim2.fromOffset(640, 300) },
		CapsuleText = 21, RebirthText = 18,
	},
}

local function applyLayout()
	local spec = compact and LAYOUTS.compact or LAYOUTS.normal
	for _, name in ipairs({ "Energy", "Rate", "Stardust", "Cores", "Rebirth", "Ascension", "UniverseCard", "Capsule", "Event", "Visit", "Toasts" }) do
		local item = hud.Items[name]
		item.Position = spec[name][1]
		item.Size = spec[name][2]
	end
	for _, name in ipairs({ "TopButtons", "Left", "Right" }) do
		local item = hud.Items[name]
		local grid = item:FindFirstChildOfClass("UIGridLayout")
		item.Position = spec[name][1]
		item.Size = spec[name][2]
		grid.CellSize = spec[name][3]
		if spec[name][4] then item.AnchorPoint = spec[name][4] end
		if spec[name][5] then
			for _, child in ipairs(item:GetChildren()) do
				local icon = child:FindFirstChild("Icon")
				if icon then icon.TextSize = spec[name][5] end
			end
		end
	end
	hud.CapsuleText.TextSize = spec.CapsuleText
	hud.Rebirth.TextSize = spec.RebirthText
	for _, fn in ipairs(layoutListeners) do
		task.spawn(fn, compact)
	end
end

function UI.isCompact()
	return compact
end

-- fn(compact) se llama cada vez que cambia el modo de layout (y una vez al registrarse)
function UI.onLayout(fn)
	table.insert(layoutListeners, fn)
	task.spawn(fn, compact)
end

local function setScale(root, value)
	local scale = root:FindFirstChild("ScreenScale")
	if scale then scale.Scale = value end
	root.Size = UDim2.fromScale(1 / value, 1 / value)
end

local function updateScale()
	local camera = Workspace.CurrentCamera
	local size = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local large = State.Data.Settings and State.Data.Settings.LargeText
	local boost = large and 1.12 or 1
	local wasCompact = compact
	compact = size.Y < 600
	local hudScale
	if compact then
		hudScale = math.clamp(math.min(size.Y / 540, size.X / 1150), 0.5, 0.9)
	else
		hudScale = math.clamp(math.min(size.Y / 900, size.X / 1500), 0.6, 1.35)
	end
	-- los paneles (hasta 980x580) siempre deben caber en pantalla
	local panelScale = math.clamp(math.min(size.X / 1010, size.Y / 610), 0.4, 1.35)
	setScale(hudGui, hudScale * boost)
	setScale(panelGui, panelScale)
	setScale(overlayGui, panelScale)
	if compact ~= wasCompact or not hud.LayoutApplied then
		hud.LayoutApplied = true
		applyLayout()
	end
end

function UI.overlay()
	return overlayGui
end

function UI.context()
	return ctx
end

---------------------------------------------------------------- avisos
local toastCount = 0
local TOAST_COLORS = { info = C.Cyan, error = C.Red, reward = C.Gold, secret = C.Magenta, event = C.Gold,
	collection = C.Green, system = C.Violet }

function UI.toast(text, kind)
	kind = kind or "info"
	local color = TOAST_COLORS[kind] or C.Cyan
	local big = kind == "secret" or kind == "collection" or kind == "system"
	toastCount = toastCount + 1
	local box = Kit.box(toastHolder, C.Panel, 0.05, { Size = UDim2.fromOffset(big and 620 or 520, big and 58 or 44), LayoutOrder = toastCount }, 10)
	Kit.stroke(box, color, 2, 0)
	local label = Kit.label(box, text, { Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0), TextSize = big and 16 or 14,
		AlignX = Enum.TextXAlignment.Center, Wrap = true, Color = big and color or C.Text })
	local scale = Instance.new("UIScale")
	scale.Scale = 0.7
	scale.Parent = box
	Kit.tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(big and 6 or 3.5, function()
		if box.Parent then
			Kit.tween(box, 0.3, { BackgroundTransparency = 1 })
			Kit.tween(label, 0.3, { TextTransparency = 1 })
			task.wait(0.32)
			box:Destroy()
		end
	end)
	return box
end

-- Llama al servidor y muestra el error si lo hay. Devuelve el resultado.
function UI.request(name, ...)
	local result = State.call(name, ...)
	if not result.Ok and result.Code ~= "rate" then
		UI.toast(result.Error or "No se pudo completar la acción.", "error")
	end
	return result
end

-- Dialogo de confirmacion. opts: Title, Text, Confirm, Cancel, Style, OnConfirm
function UI.confirm(opts)
	local shade = Kit.frame(overlayGui, { Name = "Confirm", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Dark,
		BackgroundTransparency = 0.45, Active = true, ZIndex = 50 })
	local frame, body = Kit.panel(shade, { Size = UDim2.fromOffset(460, 250), Title = opts.Title or "Confirmar", Icon = opts.Icon })
	Kit.label(body, opts.Text or "", { Size = UDim2.new(1, 0, 1, -56), TextSize = 15, Wrap = true, AlignY = Enum.TextYAlignment.Top,
		Color = C.TextDim, Font = F.Body })
	local function close()
		shade:Destroy()
	end
	Kit.button(body, opts.Cancel or "Cancelar", "ghost", { Size = UDim2.fromOffset(190, 42), Position = UDim2.new(0, 0, 1, -44) }, close)
	Kit.button(body, opts.Confirm or "Confirmar", opts.Style or "primary", { Size = UDim2.fromOffset(190, 42), Position = UDim2.new(1, -190, 1, -44) },
		function()
			close()
			if opts.OnConfirm then opts.OnConfirm() end
		end).Name = "ConfirmButton"
	return frame
end

---------------------------------------------------------------- paneles
function UI.onOpen(fn)
	table.insert(openListeners, fn)
end

function UI.isOpen(name)
	if name then return current == name end
	return current ~= nil
end

function UI.close()
	if not current then return end
	local panel = panels[current]
	current = nil
	if panel then
		panel.Frame.Visible = false
		if panel.OnClose then panel.OnClose() end
	end
	for _, fn in ipairs(openListeners) do
		task.spawn(fn, nil)
	end
end

function UI.open(name, args)
	if current and current ~= name then UI.close() end
	local panel = panels[name]
	if not panel then
		local module = Client.UI.Panels:FindFirstChild(name)
		if not module then
			warn("[UI] panel desconocido: " .. tostring(name))
			return
		end
		panel = require(module)(ctx, panelGui)
		panel.Frame.Visible = false
		panels[name] = panel
	end
	current = name
	panel.Frame.Visible = true
	local scale = panel.Frame:FindFirstChild("Pop")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "Pop"
		scale.Parent = panel.Frame
	end
	scale.Scale = 0.88
	Kit.tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	if panel.OnOpen then panel.OnOpen(args or {}) end
	for _, fn in ipairs(openListeners) do
		task.spawn(fn, name)
	end
end

function UI.toggle(name, args)
	if current == name then UI.close() else UI.open(name, args) end
end

-- Refresca el panel abierto (si expone Refresh)
function UI.refresh(name)
	local panel = panels[name]
	if panel and current == name and panel.Refresh then panel.Refresh() end
end

---------------------------------------------------------------- HUD
local function pill(parent, size, position, anchor, strokeColor)
	local box = Kit.box(parent, C.Panel, 0.12, { Size = size, Position = position, AnchorPoint = anchor or Vector2.new(0, 0) }, 12)
	Kit.stroke(box, strokeColor or C.Cyan, 1.5, 0.15)
	return box
end

local function squareButton(parent, icon, text, order, onClick)
	local b = Kit.button(parent, "", "ghost", { Props = { LayoutOrder = order } }, onClick)
	Kit.label(b, icon, { Size = UDim2.new(1, 0, 0.58, 0), Position = UDim2.fromScale(0, 0.06), TextSize = 34,
		AlignX = Enum.TextXAlignment.Center }).Name = "Icon"
	Kit.label(b, text, { Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.fromScale(0, 0.64), TextSize = 13,
		AlignX = Enum.TextXAlignment.Center, Stroke = true }).Name = "Caption"
	return b
end

local function gridFrame(parent, name, padding, alignRight)
	local frame = Kit.frame(parent, { Name = name })
	local grid = Instance.new("UIGridLayout")
	grid.CellPadding = UDim2.fromOffset(padding, padding)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = alignRight and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left
	grid.Parent = frame
	return frame
end

local function buildHud()
	local root = hudGui
	hud.Root = root
	local items = {}
	hud.Items = items

	-- superior izquierda: Energy, Energy/s y monedas secundarias
	local energy = pill(root, UDim2.fromOffset(270, 54), UDim2.fromOffset(16, 16), nil, C.Energy)
	energy.Name = "Energy"
	items.Energy = energy
	Kit.label(energy, "⚡", { Size = UDim2.new(0, 44, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 28, AlignX = Enum.TextXAlignment.Center })
	hud.Energy = Kit.label(energy, "0", { Size = UDim2.new(1, -106, 1, 0), Position = UDim2.fromOffset(54, 0), TextSize = 26, Font = F.Black,
		Stroke = true })
	Kit.button(energy, "+", "cyan", { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -44, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
		TextSize = 24 }, function()
		UI.toggle("Stats")
	end).Name = "Plus"
	local rate = pill(root, UDim2.fromOffset(190, 34), UDim2.fromOffset(24, 76), nil, C.Cyan)
	rate.Name = "Rate"
	items.Rate = rate
	hud.Rate = Kit.label(rate, "0/s", { Size = UDim2.fromScale(1, 1), TextSize = 17, AlignX = Enum.TextXAlignment.Center, Color = C.Cyan })
	local stardust = pill(root, UDim2.fromOffset(124, 30), UDim2.fromOffset(24, 116), nil, C.Stardust)
	stardust.Name = "Stardust"
	items.Stardust = stardust
	hud.Stardust = Kit.label(stardust, "✨ 0", { Size = UDim2.fromScale(1, 1), TextSize = 14, AlignX = Enum.TextXAlignment.Center, Color = C.Stardust })
	local cores = pill(root, UDim2.fromOffset(110, 30), UDim2.fromOffset(154, 116), nil, C.Cores)
	cores.Name = "Cores"
	items.Cores = cores
	hud.Cores = Kit.label(cores, "💠 0", { Size = UDim2.fromScale(1, 1), TextSize = 14, AlignX = Enum.TextXAlignment.Center, Color = C.Cores })

	-- superior derecha: ascension, estadisticas y clasificacion
	hud.Rebirth = Kit.button(root, "🔄  REBIRTH", "primary", { Size = UDim2.fromOffset(236, 54), Position = UDim2.new(1, -16, 0, 16),
		AnchorPoint = Vector2.new(1, 0), TextSize = 22, Font = F.Black }, function()
		UI.toggle("Rebirth")
	end)
	hud.Rebirth.Name = "Rebirth"
	items.Rebirth = hud.Rebirth
	local asc = pill(root, UDim2.fromOffset(236, 36), UDim2.new(1, -16, 0, 78), Vector2.new(1, 0), C.Gold)
	asc.Name = "Ascension"
	items.Ascension = asc
	hud.Ascension = Kit.label(asc, "👑 Ascensión: 0", { Size = UDim2.fromScale(1, 1), TextSize = 16, AlignX = Enum.TextXAlignment.Center, Color = C.Gold })
	local topButtons = gridFrame(root, "TopButtons", 8, true)
	topButtons.AnchorPoint = Vector2.new(1, 0)
	items.TopButtons = topButtons
	Kit.button(topButtons, "📊 Estadísticas", "ghost", { TextSize = 12, Props = { LayoutOrder = 1 } }, function()
		UI.toggle("Stats")
	end).Name = "Stats"
	Kit.button(topButtons, "🏅 Ranking", "ghost", { TextSize = 12, Props = { LayoutOrder = 2 } }, function()
		UI.toggle("Leaderboard")
	end).Name = "Leaderboard"

	-- lateral izquierdo
	local left = gridFrame(root, "Left", 8, false)
	items.Left = left
	squareButton(left, "🎒", "Inventario", 1, function() UI.toggle("Inventory") end).Name = "Inventory"
	squareButton(left, "📖", "Colección", 2, function() UI.toggle("Collection") end).Name = "Collection"
	hud.Missions = squareButton(left, "🏆", "Misiones", 3, function() UI.toggle("Missions") end)
	hud.Missions.Name = "Missions"
	squareButton(left, "🔁", "Trading", 4, function() UI.toggle("Trading") end).Name = "Trading"
	squareButton(left, "⚙️", "Ajustes", 5, function() UI.toggle("Settings") end).Name = "Settings"
	hud.MissionBadge = Kit.box(hud.Missions, C.Red, 0, { Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -18, 0, -4), Visible = false }, 11)
	hud.MissionBadgeText = Kit.label(hud.MissionBadge, "!", { Size = UDim2.fromScale(1, 1), TextSize = 13, AlignX = Enum.TextXAlignment.Center })

	-- inferior izquierda: tarjeta del universo
	hud.UniverseCard = Kit.button(root, "", "ghost", { Size = UDim2.fromOffset(370, 96), Position = UDim2.new(0, 16, 1, -16),
		AnchorPoint = Vector2.new(0, 1) }, function()
		local owner = State.locationOwner()
		if owner == nil then
			UI.request("Teleport", "universe")
		elseif owner == player.UserId then
			UI.toggle("Galaxy")
		else
			UI.request("Teleport", "hub")
		end
	end)
	hud.UniverseCard.Name = "UniverseCard"
	items.UniverseCard = hud.UniverseCard
	Kit.label(hud.UniverseCard, "🌌", { Size = UDim2.new(0, 76, 1, 0), Position = UDim2.fromOffset(6, 0), TextSize = 42, AlignX = Enum.TextXAlignment.Center })
	hud.UniverseTitle = Kit.label(hud.UniverseCard, "Tu Universo", { Size = UDim2.new(1, -130, 0.34, 0), Position = UDim2.new(0, 88, 0.14, 0),
		TextSize = 14, Color = C.TextDim })
	hud.UniverseName = Kit.label(hud.UniverseCard, "Solar System", { Size = UDim2.new(1, -130, 0.4, 0), Position = UDim2.new(0, 88, 0.46, 0),
		TextSize = 22, Stroke = true })
	Kit.label(hud.UniverseCard, ">", { Size = UDim2.new(0, 36, 1, 0), Position = UDim2.new(1, -42, 0, 0), TextSize = 32, Color = C.Cyan,
		AlignX = Enum.TextXAlignment.Center, Font = F.Black })

	-- inferior centro: capsulas
	hud.Capsule = Kit.button(root, "", "primary", { Size = UDim2.fromOffset(310, 100), Position = UDim2.new(0.5, 0, 1, -16),
		AnchorPoint = Vector2.new(0.5, 1), Radius = 22 }, function()
		UI.toggle("Capsules")
	end)
	hud.Capsule.Name = "OpenCapsule"
	items.Capsule = hud.Capsule
	Kit.label(hud.Capsule, "💊", { Size = UDim2.new(0.3, 0, 1, 0), Position = UDim2.fromScale(0.03, 0), TextSize = 44, AlignX = Enum.TextXAlignment.Center })
	hud.CapsuleText = Kit.label(hud.Capsule, "OPEN\nCAPSULE", { Size = UDim2.new(0.64, 0, 1, 0), Position = UDim2.fromScale(0.34, 0), TextSize = 27,
		Font = F.Black, Stroke = true, Wrap = true, Props = { LineHeight = 1.05 } })

	-- inferior derecha: mejoras, teletransporte y tienda
	local right = gridFrame(root, "Right", 8, true)
	right.AnchorPoint = Vector2.new(1, 1)
	items.Right = right
	squareButton(right, "📈", "Mejoras", 1, function() UI.toggle("Upgrades") end).Name = "Upgrades"
	squareButton(right, "🌀", "Teleport", 2, function() UI.toggle("Teleport") end).Name = "Teleport"
	squareButton(right, "🛒", "Tienda", 3, function() UI.toggle("Shop") end).Name = "Shop"

	-- superior centro: evento y aviso de visita
	hud.Event = Kit.button(root, "", "ghost", { Size = UDim2.fromOffset(400, 44), Position = UDim2.new(0.5, 0, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0), TextSize = 14 }, function()
		UI.toggle("Event")
	end)
	hud.Event.Name = "EventChip"
	items.Event = hud.Event
	hud.Visit = pill(root, UDim2.fromOffset(460, 34), UDim2.new(0.5, 0, 0, 64), Vector2.new(0.5, 0), C.Violet)
	hud.Visit.Name = "VisitBanner"
	hud.Visit.Visible = false
	items.Visit = hud.Visit
	hud.VisitText = Kit.label(hud.Visit, "", { Size = UDim2.fromScale(1, 1), TextSize = 13, AlignX = Enum.TextXAlignment.Center, Color = C.Stardust })

	toastHolder = Kit.frame(overlayGui, { Name = "Toasts", Size = UDim2.fromOffset(640, 400), Position = UDim2.new(0.5, 0, 0, 108),
		AnchorPoint = Vector2.new(0.5, 0) })
	items.Toasts = toastHolder
	local layout = Kit.listLayout(toastHolder, 6, false)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
end

local function refreshStatic()
	local data = State.Data
	hud.Stardust.Text = "✨ " .. Format.number(data.Stardust or 0)
	hud.Cores.Text = "💠 " .. Format.number(data.Cores or 0)
	hud.Ascension.Text = "👑 Ascensión: " .. tostring(data.Ascensions or 0)
	hud.Rate.Text = Format.rate(State.rate())
	local system = Defs.Galaxy.ById[data.ActiveSystem or "solar"]
	local owner = State.locationOwner()
	if owner == nil then
		hud.UniverseTitle.Text = "Tu Universo"
		hud.UniverseName.Text = system.Name
		hud.Visit.Visible = false
	elseif owner == player.UserId then
		hud.UniverseTitle.Text = "Tu universo · sistemas"
		hud.UniverseName.Text = system.Name
		hud.Visit.Visible = false
	else
		local view = State.Universes[owner]
		hud.UniverseTitle.Text = "Visitando a " .. (view and view.Name or "otro jugador")
		hud.UniverseName.Text = "Volver al Hub"
		hud.Visit.Visible = true
		hud.VisitText.Text = "👀 Universo de " .. (view and view.Name or "?") .. " · modo solo lectura"
	end
	-- misiones reclamables
	local claimable = 0
	local missions = data.Missions
	if missions then
		for _, list in ipairs({ missions.Daily, missions.Weekly }) do
			for _, m in ipairs(list) do
				if m.Progress >= m.Goal and not m.Claimed then claimable = claimable + 1 end
			end
		end
	end
	hud.MissionBadge.Visible = claimable > 0
	hud.MissionBadgeText.Text = tostring(claimable)
	-- la ascension resalta cuando esta lista
	local milestone = Defs.Ascension.next(data.Ascensions or 0)
	local ready = true
	for _, req in ipairs(milestone.Requirements) do
		if not Progression.checkRequirement(data, req, State.rate()).Ok then ready = false end
	end
	Kit.setStyle(hud.Rebirth, ready and "gold" or "primary")
end

local function refreshEvent()
	local event = State.Data._Event
	if not event then
		hud.Event.Text = ""
		return
	end
	local now = State.serverTime()
	if event.Id and event.EndsAt and now < event.EndsAt then
		local def = Defs.Events.ById[event.Id]
		hud.Event.Text = def.Icon .. "  " .. def.Name .. "  ·  " .. Format.clock(event.EndsAt - now)
		Kit.setStyle(hud.Event, "gold")
	else
		local def = Defs.Events.ById[event.NextId]
		hud.Event.Text = "Próximo evento: " .. def.Icon .. " " .. def.Name .. " en " .. Format.clock(math.max(0, event.NextStartsAt - now))
		Kit.setStyle(hud.Event, "ghost")
	end
end

function UI.setHudVisible(visible)
	screens[hudGui].Enabled = visible
end

function UI.init(context)
	ctx = context
	ctx.UI = UI
	playerGui = player:WaitForChild("PlayerGui")
	-- el HUD respeta la barra superior de Roblox; paneles y overlays ocupan toda la pantalla
	hudGui = makeScreen("MainHUD", 5, false)
	panelGui = makeScreen("Panels", 10, true)
	overlayGui = makeScreen("Overlay", 20, true)
	buildHud()
	updateScale()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	State.on("Settings", updateScale)

	refreshStatic()
	refreshEvent()
	State.onAny(function(changed)
		if changed.Energy and not (changed.Stardust or changed.Cores or changed.Ascensions or changed._Production
			or changed.ActiveSystem or changed._Session or changed.Missions or changed.Planets or changed.Discovered) then
			return
		end
		refreshStatic()
	end)
	State.onUniverse(refreshStatic)

	local accumulator, eventAccumulator = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		eventAccumulator = eventAccumulator + dt
		if accumulator >= 0.1 then
			accumulator = 0
			hud.Energy.Text = Format.number(State.displayEnergy())
		end
		if eventAccumulator >= 0.5 then
			eventAccumulator = 0
			refreshEvent()
		end
	end)

	State.remotes():WaitForChild("Notify").OnClientEvent:Connect(function(message)
		UI.toast(message.Text, message.Kind)
		if ctx.Audio then
			if message.Kind == "secret" or message.Kind == "collection" or message.Kind == "system" then
				ctx.Audio.play("fanfare")
			elseif message.Kind == "reward" then
				ctx.Audio.play("success")
			end
		end
	end)
end

return UI
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX70">
            <Properties>
              <string name="Name">UniverseController</string>
              <ProtectedString name="Source"><![CDATA[-- UniverseController: dibuja el universo personal en el que esta el jugador (el suyo o el que visita):
-- estrella central, orbitas luminosas, planetas colocados (orbita + rotacion propia con matematica
-- simple y sincronizada con el reloj del servidor), marcadores de slots y decoracion del sistema.
-- Solo representa el estado autorizado por el servidor; al visitar es de solo lectura.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Assets = require(Shared.Assets)
local Build = require(Shared.Util.Build)
local Format = require(Shared.Util.Format)
local Layout = require(Shared.UniverseLayout)
local Progression = require(Shared.Progression)
local PlanetVisual = require(Shared.PlanetVisual)
local Config = Defs.Config

local Universe = {}
local ctx = nil
local player = Players.LocalPlayer

local container = nil
local current = nil -- { Owner, View, StarKey, Center }
local planets = {} -- [slot] = { Model, Body, Def, Key, Tilt, Rainbow }
local markers = {} -- [slot] = { Part, Kind }
local spinners = {} -- { Model, Speed, CFrame } decoracion giratoria
local staticFolder, planetFolder = nil, nil
local boards = {}
local slotsPanel = nil

local function settings()
	return ctx.State.Data.Settings or {}
end

local function clearAll()
	if container then container:ClearAllChildren() end
	planets = {}
	markers = {}
	spinners = {}
	for _, gui in pairs(boards) do
		gui:Destroy()
	end
	boards = {}
	staticFolder, planetFolder = nil, nil
	current = nil
end

---------------------------------------------------------------- estrella y decoracion
local function orbitColor(view, theme)
	local id = view.Cosmetics and view.Cosmetics.OrbitColor
	local def = id and Defs.Cosmetics.ById[id]
	if def and def.Color then return def.Color end
	return theme.Orbit
end

local function buildStar(view, theme, folder, low)
	local center = view.Center
	local radius = Config.World.StarRadius
	local star = Instance.new("Model")
	star.Name = "Star"
	local aura = view.Cosmetics and Defs.Cosmetics.ById[view.Cosmetics.StarAura or ""]
	local style = aura and aura.Style or nil

	if theme.BlackHole then
		-- nucleo de gravedad: esfera negra con disco de acrecion y borde luminoso
		local core = Build.ball({ Position = center, Radius = radius * 0.8 }, { Name = "Core", Color = Color3.new(0, 0, 0),
			Material = Enum.Material.SmoothPlastic, CanCollide = false, Parent = star })
		Build.ball({ Position = center, Radius = radius * 0.9 }, { Name = "Lens", Color = theme.StarGlow, Material = Enum.Material.ForceField,
			Transparency = 0.1, CanCollide = false, CanQuery = false, Parent = star })
		local tilt = CFrame.new(center) * CFrame.Angles(math.rad(14), 0, math.rad(6))
		Build.cylinder({ CFrame = tilt, Radius = radius * 2.4, Height = 0.3 }, { Name = "Disc1", Color = theme.StarGlow, Material = Enum.Material.Neon,
			Transparency = 0.45, CanCollide = false, CanQuery = false, Parent = star })
		Build.cylinder({ CFrame = tilt, Radius = radius * 3.3, Height = 0.2 }, { Name = "Disc2", Color = Color3.fromRGB(110, 50, 220),
			Material = Enum.Material.Neon, Transparency = 0.75, CanCollide = false, CanQuery = false, Parent = star })
		Build.ring({ CFrame = tilt, Radius = radius * 1.15, Width = 0.6, Height = 0.6, Segments = 36 },
			{ Name = "Photon", Color = Color3.fromRGB(255, 220, 255), Material = Enum.Material.Neon, Parent = star })
		Build.light(core, theme.StarGlow, 60, 3)
		if not low then
			local emitter = Build.particles(core, { Color = ColorSequence.new(theme.StarGlow, Color3.fromRGB(90, 30, 200)), Rate = 30,
				Speed = NumberRange.new(4, 9), Lifetime = NumberRange.new(1.5, 3), Size = Build.sizeSeq(2.2), RotSpeed = NumberRange.new(-160, 160) })
			emitter.Shape = Enum.ParticleEmitterShape.Sphere
			emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
		end
		star.PrimaryPart = core
	else
		local core = Build.ball({ Position = center, Radius = radius * 0.96 }, { Name = "Core", Color = theme.Star, Material = Enum.Material.Neon,
			CanCollide = false, Parent = star })
		if Assets.SphereMesh ~= 0 and Assets.texture("sun") ~= "" then
			-- superficie texturizada semitransparente sobre el nucleo de neon (aspecto emisivo con detalle)
			local surface = Build.decor({ Name = "Surface", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(center), Color = theme.Star,
				Transparency = 0.35, Parent = star })
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = Assets.url(Assets.SphereMesh)
			mesh.TextureId = Assets.texture("sun")
			local s = radius / Assets.SphereMeshRadius
			mesh.Scale = Vector3.new(s, s, s)
			mesh.VertexColor = Vector3.new(theme.Star.R, theme.Star.G, theme.Star.B)
			mesh.Parent = surface
		end
		Build.ball({ Position = center, Radius = radius * 1.18 }, { Name = "Corona", Color = theme.StarGlow, Material = Enum.Material.Neon,
			Transparency = 0.78, CanCollide = false, CanQuery = false, Parent = star })
		Build.ball({ Position = center, Radius = radius * 1.5 }, { Name = "Halo", Color = theme.StarGlow, Material = Enum.Material.Neon,
			Transparency = 0.92, CanCollide = false, CanQuery = false, Parent = star })
		Build.light(core, theme.StarGlow, 60, 4)
		if Assets.image("glow") ~= "" then
			local glow = Instance.new("BillboardGui")
			glow.Name = "Glow"
			glow.Size = UDim2.fromScale(radius * 7, radius * 7)
			glow.LightInfluence = 0
			glow.MaxDistance = 2000
			glow.Parent = core
			local image = Instance.new("ImageLabel")
			image.BackgroundTransparency = 1
			image.Size = UDim2.fromScale(1, 1)
			image.Image = Assets.image("glow")
			image.ImageColor3 = theme.StarGlow
			image.ImageTransparency = 0.55
			image.Parent = glow
		end
		if not low then
			local emitter = Build.particles(core, { Color = ColorSequence.new(theme.Star, theme.StarGlow), Rate = style == "flare" and 46 or 22,
				Speed = NumberRange.new(style == "flare" and 6 or 2, style == "flare" and 14 or 6), Lifetime = NumberRange.new(1.5, 3.2),
				Size = Build.sizeSeq(style == "flare" and 4.5 or 3), RotSpeed = NumberRange.new(-60, 60) })
			emitter.Shape = Enum.ParticleEmitterShape.Sphere
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
		end
		star.PrimaryPart = core
	end

	-- auras cosmeticas
	if style == "halo" then
		for i, tilt in ipairs({ 60, -60 }) do
			local ringModel = Instance.new("Model")
			ringModel.Name = "AuraRing" .. i
			local cf = CFrame.new(center) * CFrame.Angles(math.rad(tilt), 0, 0)
			Build.ring({ CFrame = cf, Radius = radius * 1.9, Width = 0.5, Height = 0.5, Segments = 36 },
				{ Color = theme.StarGlow, Material = Enum.Material.Neon, Parent = ringModel })
			ringModel.WorldPivot = cf
			ringModel.Parent = star
			table.insert(spinners, { Model = ringModel, Speed = 0.25 * (i == 1 and 1 or -1), Base = cf })
		end
	elseif style == "pulse" then
		local pulse = Build.ball({ Position = center, Radius = radius * 1.3 }, { Name = "Pulse", Color = theme.StarGlow, Material = Enum.Material.ForceField,
			Transparency = 0.2, CanCollide = false, CanQuery = false, Parent = star })
		table.insert(spinners, { Pulse = pulse, Radius = radius })
	end

	-- adornos por sistema
	if theme.Ornaments then
		local tilts = { { 0, 0 }, { 58, 20 }, { -58, -20 } }
		for i, t in ipairs(tilts) do
			local ringModel = Instance.new("Model")
			ringModel.Name = "Ornament" .. i
			local cf = CFrame.new(center) * CFrame.Angles(math.rad(t[1]), 0, math.rad(t[2]))
			Build.ring({ CFrame = cf, Radius = radius * 1.7 + i * 3.2, Width = 0.7, Height = 0.7, Segments = 40 },
				{ Color = Color3.fromRGB(255, 215, 120), Material = Enum.Material.Neon, Parent = ringModel })
			ringModel.WorldPivot = cf
			ringModel.Parent = star
			table.insert(spinners, { Model = ringModel, Speed = 0.12 * (i % 2 == 0 and -1 or 1), Base = cf })
		end
	end
	star.Parent = folder
	return star
end

local function buildBackdrop(view, theme, folder, low)
	local center = view.Center
	local outer = Layout.outerRadius()
	if theme.Portals then
		-- portales y anillos multidimensionales
		local portalColors = { Color3.fromRGB(120, 255, 255), Color3.fromRGB(255, 110, 255), Color3.fromRGB(190, 150, 255), Color3.fromRGB(255, 255, 255) }
		for i = 1, 4 do
			local angle = i / 4 * math.pi * 2 + 0.6
			local pos = center + Vector3.new(math.cos(angle) * (outer + 70), 40 + i * 14, math.sin(angle) * (outer + 70))
			local cf = CFrame.lookAt(pos, center) * CFrame.Angles(math.rad(90), 0, 0)
			local portal = Instance.new("Model")
			portal.Name = "DimensionPortal" .. i
			Build.ring({ CFrame = cf, Radius = 16, Width = 1.2, Height = 1.2, Segments = 24 },
				{ Color = portalColors[i], Material = Enum.Material.Neon, Parent = portal })
			Build.cylinder({ CFrame = cf, Radius = 15, Height = 0.3 }, { Name = "Core", Color = portalColors[i], Material = Enum.Material.Neon,
				Transparency = 0.7, CanCollide = false, CanQuery = false, Parent = portal })
			portal.Parent = folder
		end
		for i, tilt in ipairs({ 26, -26 }) do
			local ringModel = Instance.new("Model")
			ringModel.Name = "DimensionRing" .. i
			local cf = CFrame.new(center) * CFrame.Angles(math.rad(tilt), 0, math.rad(tilt * 0.5))
			Build.ring({ CFrame = cf, Radius = outer + 26 + i * 12, Width = 0.8, Height = 0.8, Segments = 64 },
				{ Color = i == 1 and Color3.fromRGB(120, 255, 255) or Color3.fromRGB(200, 120, 255), Material = Enum.Material.Neon,
					Transparency = 0.3, Parent = ringModel })
			ringModel.WorldPivot = cf
			ringModel.Parent = folder
			table.insert(spinners, { Model = ringModel, Speed = 0.05 * (i == 1 and 1 or -1), Base = cf })
		end
	end
	if low or settings().ReducedEffects then return end
	-- nubes de nebulosa (particulas grandes y lentas, muy transparentes)
	local rng = Random.new(view.Plot * 131 + Defs.Galaxy.ById[view.System].Order)
	for i = 1, 10 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(outer + 120, outer + 420)
		local pos = center + Vector3.new(math.cos(angle) * dist, rng:NextNumber(-160, 120), math.sin(angle) * dist)
		local anchor = Build.decor({ Name = "Nebula", Size = Vector3.new(60, 60, 60), Transparency = 1, CFrame = CFrame.new(pos), Parent = folder })
		local c = theme.Nebula[(i % 2) + 1]
		local smoke = Assets.image("smoke")
		Build.particles(anchor, { Texture = smoke ~= "" and smoke or Build.ParticleTextures.Smoke, Color = ColorSequence.new(c, theme.Nebula[1]), Rate = 1.2,
			Lifetime = NumberRange.new(14, 22), Speed = NumberRange.new(0.5, 2), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-4, 4),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 70), NumberSequenceKeypoint.new(1, 130) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.86),
				NumberSequenceKeypoint.new(0.7, 0.88), NumberSequenceKeypoint.new(1, 1) }),
			LightEmission = 0.7, SpreadAngle = Vector2.new(180, 180) })
	end
	-- galaxias y nebulosas lejanas (imagenes con transparencia; si no cargan, simplemente no se ven)
	local sprites = { { "galaxy", 520, 360 }, { "nebula", 640, 640 }, { "galaxy", 300, 210 } }
	for i, sprite in ipairs(sprites) do
		local url = Assets.image(sprite[1])
		if url ~= "" then
			local angle = rng:NextNumber(0, math.pi * 2)
			local pos = center + Vector3.new(math.cos(angle) * 1500, rng:NextNumber(-250, 500), math.sin(angle) * 1500)
			local anchor = Build.decor({ Name = "FarSprite" .. i, Size = Vector3.new(1, 1, 1), Transparency = 1, CFrame = CFrame.new(pos), Parent = folder })
			local billboard = Instance.new("BillboardGui")
			billboard.Size = UDim2.fromScale(sprite[2], sprite[3])
			billboard.LightInfluence = 0
			billboard.MaxDistance = 5000
			billboard.Parent = anchor
			local image = Instance.new("ImageLabel")
			image.BackgroundTransparency = 1
			image.Size = UDim2.fromScale(1, 1)
			image.Image = url
			image.ImageTransparency = 0.25
			image.Parent = billboard
		end
	end
	-- polvo estelar cercano
	local dust = Build.decor({ Name = "Stardust", Size = Vector3.new(outer * 2.4, 90, outer * 2.4), Transparency = 1, CFrame = CFrame.new(center), Parent = folder })
	Build.particles(dust, { Color = ColorSequence.new(theme.Accent, Color3.new(1, 1, 1)), Rate = 26, Lifetime = NumberRange.new(5, 9),
		Speed = NumberRange.new(0.2, 1), Size = Build.sizeSeq(1.1) })
end

local function buildOrbits(view, theme, folder, low)
	local color = orbitColor(view, theme)
	local orbits = Instance.new("Folder")
	orbits.Name = "Orbits"
	for slot = 1, Config.Economy.SlotsPerSystem do
		local unlocked = slot <= view.Slots
		local radius = Layout.orbitRadius(slot)
		local segments = math.floor((low and 26 or 44) + slot * (low and 2 or 4))
		Build.ring({ CFrame = CFrame.new(view.Center), Radius = radius, Width = unlocked and 0.4 or 0.3, Height = 0.14, Segments = segments,
			Gap = unlocked and nil or 0.55 }, { Name = "Orbit" .. slot, Color = color, Material = Enum.Material.Neon,
			Transparency = unlocked and 0.45 or 0.86, Parent = orbits })
	end
	orbits.Parent = folder
end

---------------------------------------------------------------- planetas y marcadores
local function nameTag(part, title, subtitle, color, offsetY)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Tag"
	billboard.Size = UDim2.fromOffset(170, 44)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	billboard.MaxDistance = 700
	billboard.LightInfluence = 0
	billboard.AlwaysOnTop = false
	billboard.Parent = part
	local top = Build.label(billboard, title, { Size = UDim2.fromScale(1, 0.55), TextScaled = false, TextSize = 15, TextColor3 = color,
		Font = Enum.Font.GothamBold })
	Build.stroke(top, Color3.fromRGB(4, 6, 18), 2, 0.1)
	if subtitle then
		local bottom = Build.label(billboard, subtitle, { Size = UDim2.fromScale(1, 0.45), Position = UDim2.fromScale(0, 0.55), TextScaled = false,
			TextSize = 13, TextColor3 = Color3.fromRGB(255, 215, 90), Font = Enum.Font.GothamBold })
		Build.stroke(bottom, Color3.fromRGB(4, 6, 18), 2, 0.1)
	end
	return billboard
end

local function planetKey(p)
	return p.Id .. "|" .. tostring(p.V) .. "|" .. tostring(p.E)
end

local function removePlanet(slot)
	local entry = planets[slot]
	if entry then
		entry.Model:Destroy()
		planets[slot] = nil
	end
end

local function removeMarker(slot)
	local entry = markers[slot]
	if entry then
		entry.Part:Destroy()
		markers[slot] = nil
	end
end

local function addPlanet(slot, data, isOwner)
	local def = Defs.Planets.ById[data.Id]
	local low = settings().LowQuality
	local model = PlanetVisual.build(data.Id, data.V, data.E, { Welded = true, Static = low or settings().ReducedEffects })
	model:SetAttribute("Slot", slot)
	model:SetAttribute("Uid", data.Uid)
	local radius = model:GetAttribute("Radius")
	local rarity = Defs.Rarities.ById[def.Rarity]
	local inst = { Id = data.Id, V = data.V or "none", E = data.E == true }
	nameTag(model.PrimaryPart, Defs.Planets.displayName(def, data.E), "⚡ " .. Format.rate(Progression.planetRate(inst)), rarity.Color,
		radius * PlanetVisual.extent(def, data.E) * 0.75 + 3)
	model.Parent = planetFolder
	planets[slot] = { Model = model, Body = model.PrimaryPart, Def = def, Key = planetKey(data),
		Tilt = CFrame.Angles(math.rad(12 + slot * 3), 0, math.rad(-8 + slot * 2)), Rainbow = model:GetAttribute("Rainbow") == true,
		Surface = model:FindFirstChild("Surface"), Atmosphere = model:FindFirstChild("Atmosphere") }
end

local function addMarker(slot, kind, view)
	local part = Build.ball({ Position = view.Center, Radius = kind == "empty" and 2.2 or 1.8 }, { Name = "SlotMarker", CanCollide = false,
		Material = Enum.Material.Neon, Transparency = 0.45, Color = kind == "empty" and Color3.fromRGB(90, 255, 170) or Color3.fromRGB(255, 200, 90) })
	part:SetAttribute("Slot", slot)
	part:SetAttribute("Kind", kind)
	if kind == "empty" then
		nameTag(part, "+ Órbita " .. slot, "Colocar planeta", Color3.fromRGB(150, 255, 200), 5)
	else
		local cost = Progression.nextSlotCost(ctx.State.Data, view.System) or 0
		nameTag(part, "🔒 Órbita " .. slot, "⚡ " .. Format.number(cost), Color3.fromRGB(255, 215, 120), 5)
	end
	part.Parent = planetFolder
	markers[slot] = { Part = part, Kind = kind }
end

local function syncPlanets(view)
	local isOwner = view.Owner == player.UserId
	for slot = 1, Config.Economy.SlotsPerSystem do
		local data = view.Planets[Defs.Galaxy.slotKey(slot)]
		local entry = planets[slot]
		if data then
			removeMarker(slot)
			if not entry or entry.Key ~= planetKey(data) then
				removePlanet(slot)
				addPlanet(slot, data, isOwner)
			else
				entry.Model:SetAttribute("Uid", data.Uid)
			end
		else
			removePlanet(slot)
			local kind = nil
			if isOwner then
				if slot <= view.Slots then kind = "empty" elseif slot == view.Slots + 1 then kind = "locked" end
			end
			local marker = markers[slot]
			if (marker and marker.Kind) ~= kind then
				removeMarker(slot)
				if kind then addMarker(slot, kind, view) end
			end
		end
	end
end

---------------------------------------------------------------- tableros de la plataforma
local function boardGui(view, boardName)
	local zones = Workspace:FindFirstChild("PlayerUniverseZones")
	local plot = zones and zones:FindFirstChild("Universe_" .. tostring(view.Plot))
	local board = plot and plot:FindFirstChild(boardName)
	local panel = board and board:FindFirstChild("Panel")
	if not panel then return nil end
	local gui = Instance.new("SurfaceGui")
	gui.Name = boardName
	gui.Adornee = panel
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 28
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	local label = Build.label(gui, "", { Size = UDim2.fromScale(0.92, 0.9), Position = UDim2.fromScale(0.04, 0.05), TextScaled = false, TextSize = 30,
		Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, RichText = true })
	boards[boardName] = gui
	return label
end

local function updateBoards()
	if not current then return end
	local view = current.View
	local production = boards.Board_Production and boards.Board_Production:FindFirstChildOfClass("TextLabel")
	if production then
		local lines = { "<font size=\"40\"><b>PRODUCCIÓN</b></font>" }
		if view.Owner == player.UserId then
			local p = ctx.State.Data._Production
			if p then
				table.insert(lines, "<font color=\"#FFD246\" size=\"46\">⚡ " .. Format.rate(p.Total) .. "</font>")
				for _, sysId in ipairs(Defs.Galaxy.Order) do
					local sys = p.Systems[sysId]
					if sys then
						table.insert(lines, Defs.Galaxy.ById[sysId].Name .. ": " .. Format.rate(sys.Total) .. "  (" .. sys.Count .. " planetas)")
					end
				end
				local m = p.Mults
				table.insert(lines, "<font color=\"#46D7FF\">Mejoras " .. Format.mult(m.Reactor * m.Cores) .. " · Ascensión " .. Format.mult(m.Ascension)
					.. " · Evento " .. Format.mult(m.Event) .. "</font>")
			end
		else
			table.insert(lines, "<font color=\"#FFD246\" size=\"46\">⚡ " .. Format.rate(view.Stats.Rate) .. "</font>")
			table.insert(lines, "Universo de " .. view.Name)
		end
		production.Text = table.concat(lines, "\n")
	end
	local info = boards.Board_Universe and boards.Board_Universe:FindFirstChildOfClass("TextLabel")
	if info then
		local system = Defs.Galaxy.ById[view.System]
		local names = {}
		for _, sysId in ipairs(view.Stats.Systems) do
			table.insert(names, (string.gsub(Defs.Galaxy.ById[sysId].Name, " System", "")))
		end
		local placed = 0
		for _ in pairs(view.Planets) do
			placed = placed + 1
		end
		info.Text = table.concat({
			"<font size=\"40\"><b>" .. string.upper(system.Name) .. "</b></font>",
			"<font color=\"#C8AAFF\">Propietario: " .. view.Name .. "</font>",
			"Órbitas: " .. placed .. " / " .. view.Slots .. " (máx. 8)",
			"Colección: " .. view.Stats.Discovered .. " / " .. view.Stats.DiscoveredTotal,
			"Ascensiones: 👑 " .. view.Stats.Ascensions,
			"Sistemas: " .. table.concat(names, ", "),
		}, "\n")
	end
end

---------------------------------------------------------------- panel de orbitas (HUD)
local function buildSlotsPanel()
	local Kit, Theme = ctx.Kit, ctx.Theme
	local C = Theme.Colors
	local root = ctx.UI.Hud.Root
	local panel = Kit.box(root, C.Panel, 0.12, { Name = "OrbitsPanel", Size = UDim2.fromOffset(260, 392), Position = UDim2.new(1, -16, 0.5, 6),
		AnchorPoint = Vector2.new(1, 0.5), Visible = false }, 12)
	Kit.stroke(panel, C.Cyan, 1.5, 0.2)
	local title = Kit.label(panel, "ÓRBITAS", { Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(12, 6), TextSize = 13, Font = Theme.Fonts.Title,
		Color = C.Cyan })
	local list = Kit.frame(panel, { Name = "List", Size = UDim2.new(1, -16, 0, 300), Position = UDim2.fromOffset(8, 36) })
	Kit.listLayout(list, 4, false)
	local cameraButton = Kit.button(panel, "📷 Vista orbital", "ghost", { Size = UDim2.new(1, -16, 0, 38), Position = UDim2.new(0, 8, 1, -46), TextSize = 13,
		Props = { Name = "CameraToggle" } }, function()
		if ctx.Camera then ctx.Camera.toggleOverview() end
	end)
	-- en moviles el panel se pliega tras un boton para no tapar el universo
	local toggle = Kit.button(root, "🪐 Órbitas", "cyan", { Size = UDim2.fromOffset(130, 40), Position = UDim2.new(1, -12, 0, 132),
		AnchorPoint = Vector2.new(1, 0), TextSize = 14, Props = { Name = "OrbitsToggle", Visible = false } }, function()
		slotsPanel.Expanded = not slotsPanel.Expanded
		Universe.refreshSlotsPanel()
	end)
	slotsPanel = { Frame = panel, Title = title, List = list, CameraButton = cameraButton, Toggle = toggle, Expanded = false, Compact = false }
	ctx.UI.onLayout(function(compact)
		slotsPanel.Compact = compact
		if compact then
			panel.AnchorPoint = Vector2.new(1, 0.5)
			panel.Position = UDim2.new(1, -330, 0.5, 0)
		else
			panel.AnchorPoint = Vector2.new(1, 0.5)
			panel.Position = UDim2.new(1, -16, 0.5, 6)
		end
		Universe.refreshSlotsPanel()
	end)
end

local refreshSlotsPanel
refreshSlotsPanel = function()
	if not slotsPanel then return end
	local Kit, Theme = ctx.Kit, ctx.Theme
	local C = Theme.Colors
	if not current then
		slotsPanel.Frame.Visible = false
		slotsPanel.Toggle.Visible = false
		return
	end
	local view = current.View
	local isOwner = view.Owner == player.UserId
	slotsPanel.Toggle.Visible = slotsPanel.Compact
	slotsPanel.Frame.Visible = (not slotsPanel.Compact) or slotsPanel.Expanded
	if not slotsPanel.Frame.Visible then return end
	slotsPanel.Title.Text = "ÓRBITAS · " .. string.upper((string.gsub(Defs.Galaxy.ById[view.System].Name, " System", "")))
	Kit.clear(slotsPanel.List)
	for slot = 1, Config.Economy.SlotsPerSystem do
		local data = view.Planets[Defs.Galaxy.slotKey(slot)]
		local text, style, enabled, action
		if data then
			local def = Defs.Planets.ById[data.Id]
			local variant = Defs.Variants.get(data.V)
			text = slot .. " · " .. Defs.Planets.displayName(def, data.E) .. (variant.Id ~= "none" and (" " .. variant.Icon) or "")
				.. "  ⚡" .. Format.rate(Progression.planetRate({ Id = data.Id, V = data.V or "none", E = data.E == true }))
			style, enabled = "ghost", true
			action = function()
				if isOwner then
					ctx.UI.open("Inventory", { Select = data.Uid })
				else
					ctx.UI.open("Inspect", { Planet = data, Owner = view.Name })
				end
			end
		elseif slot <= view.Slots then
			text = slot .. " · " .. (isOwner and "+ Colocar planeta" or "Vacía")
			style, enabled = isOwner and "green" or "ghost", isOwner
			action = function()
				ctx.UI.open("Inventory", { PlaceSlot = slot })
			end
		elseif slot == view.Slots + 1 and isOwner then
			local cost = Progression.nextSlotCost(ctx.State.Data, view.System) or 0
			text = slot .. " · 🔒 Desbloquear ⚡" .. Format.number(cost)
			style, enabled = "gold", (ctx.State.Data.Energy or 0) >= cost
			action = function()
				local result = ctx.UI.request("UnlockSlot", view.System)
				if result.Ok and ctx.Audio then ctx.Audio.play("success") end
			end
		else
			text = slot .. " · 🔒 Bloqueada"
			style, enabled = "ghost", false
		end
		local button = Kit.button(slotsPanel.List, text, style, { Size = UDim2.new(1, 0, 0, 33), TextSize = 12, Props = { LayoutOrder = slot,
			Name = "Slot" .. slot } }, action)
		Kit.setEnabled(button, enabled)
	end
end
Universe.refreshSlotsPanel = refreshSlotsPanel

---------------------------------------------------------------- ciclo
local function starKey(view)
	local c = view.Cosmetics or {}
	local s = settings()
	return view.System .. "|" .. tostring(view.Slots) .. "|" .. tostring(c.OrbitColor) .. "|" .. tostring(c.StarAura) .. "|" .. tostring(view.Plot)
		.. "|" .. tostring(s.LowQuality) .. "|" .. tostring(s.ReducedEffects)
end

local function render()
	local owner = ctx.State.locationOwner()
	local view = owner and ctx.State.Universes[owner] or nil
	if not view then
		if current then clearAll() end
		refreshSlotsPanel()
		return
	end
	local key = starKey(view)
	if not current or current.Owner ~= owner or current.StarKey ~= key then
		clearAll()
		local theme = Defs.Galaxy.ById[view.System].Theme
		local low = settings().LowQuality == true
		staticFolder = Instance.new("Folder")
		staticFolder.Name = "Static"
		planetFolder = Instance.new("Folder")
		planetFolder.Name = "Planets"
		buildStar(view, theme, staticFolder, low)
		buildOrbits(view, theme, staticFolder, low)
		buildBackdrop(view, theme, staticFolder, low)
		staticFolder.Parent = container
		planetFolder.Parent = container
		current = { Owner = owner, View = view, StarKey = key, Center = view.Center }
		boardGui(view, "Board_Production")
		boardGui(view, "Board_Universe")
	end
	current.View = view
	syncPlanets(view)
	updateBoards()
	refreshSlotsPanel()
end
Universe.render = render

local function onFrame()
	if not current then return end
	local now = ctx.State.serverTime()
	local center = current.Center
	for slot, entry in pairs(planets) do
		local angle = Layout.orbitAngle(slot, entry.Def.OrbitSpeed, now)
		local pos = Layout.orbitPosition(center, slot, angle)
		entry.Body.CFrame = CFrame.new(pos) * entry.Tilt * CFrame.Angles(0, math.rad(entry.Def.RotationSpeed) * now % (math.pi * 2), 0)
		if entry.Rainbow then
			local hue = (now * 0.08 + slot * 0.13) % 1
			local color = Color3.fromHSV(hue, 0.5, 1)
			if entry.Atmosphere then entry.Atmosphere.Color = color end
			local mesh = entry.Surface and entry.Surface:FindFirstChildOfClass("SpecialMesh")
			if mesh then mesh.VertexColor = Vector3.new(color.R, color.G, color.B) end
		end
	end
	for slot, entry in pairs(markers) do
		local angle = Layout.orbitAngle(slot, 1, now)
		entry.Part.CFrame = CFrame.new(Layout.orbitPosition(center, slot, angle))
	end
	for _, spinner in ipairs(spinners) do
		if spinner.Model then
			spinner.Model:PivotTo(spinner.Base * CFrame.Angles(0, now * spinner.Speed % (math.pi * 2), 0))
		elseif spinner.Pulse then
			local s = spinner.Radius * (1.3 + 0.25 * math.sin(now * 1.4)) * 2
			spinner.Pulse.Size = Vector3.new(s, s, s)
		end
	end
end

-- Clic/toque sobre un planeta o un marcador de slot
local function onPointer(screenPosition)
	if not current then return end
	local camera = Workspace.CurrentCamera
	if not camera then return end
	local ray = camera:ViewportPointToRay(screenPosition.X, screenPosition.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { planetFolder }
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
	if not hit then return end
	local part = hit.Instance
	local view = current.View
	local isOwner = view.Owner == player.UserId
	if part.Name == "SlotMarker" then
		if not isOwner then return end
		local slot = part:GetAttribute("Slot")
		if part:GetAttribute("Kind") == "empty" then
			ctx.UI.open("Inventory", { PlaceSlot = slot })
		else
			local cost = Progression.nextSlotCost(ctx.State.Data, view.System) or 0
			ctx.UI.confirm({ Title = "Desbloquear órbita", Icon = "🔓", Confirm = "Desbloquear", Style = "gold",
				Text = "¿Desbloquear la órbita " .. slot .. " de " .. Defs.Galaxy.ById[view.System].Name .. " por " .. Format.number(cost) .. " de Energy?",
				OnConfirm = function()
					ctx.UI.request("UnlockSlot", view.System)
				end })
		end
		return
	end
	local model = part:FindFirstAncestorOfClass("Model")
	if model and model:GetAttribute("PlanetId") then
		local slot = model:GetAttribute("Slot")
		local data = view.Planets[Defs.Galaxy.slotKey(slot)]
		if not data then return end
		if isOwner then
			ctx.UI.open("Inventory", { Select = data.Uid })
		else
			ctx.UI.open("Inspect", { Planet = data, Owner = view.Name })
		end
	end
end

function Universe.currentCenter()
	return current and current.Center or nil
end

function Universe.init(context)
	ctx = context
	ctx.Universe = Universe
	container = Instance.new("Folder")
	container.Name = "ClientUniverse"
	container.Parent = Workspace
	buildSlotsPanel()

	ctx.State.on("_Session", render)
	ctx.State.onUniverse(function(userId)
		if ctx.State.locationOwner() == userId then render() end
	end)
	ctx.State.on("Settings", render)
	ctx.State.on("_Production", updateBoards)
	local lastEnergyRefresh = 0
	ctx.State.on("Energy", function()
		if current and os.clock() - lastEnergyRefresh > 1.5 then
			lastEnergyRefresh = os.clock()
			refreshSlotsPanel()
		end
	end)
	RunService:BindToRenderStep("PlanetCollectorOrbits", Enum.RenderPriority.Camera.Value - 5, onFrame)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			onPointer(UserInputService:GetMouseLocation())
		end
	end)
	UserInputService.TouchTapInWorld:Connect(function(position, processed)
		if not processed then onPointer(position) end
	end)
	render()
end

return Universe
]]></ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="RBX71">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source"><![CDATA[-- Main (cliente): arranca el estado replicado y los controladores de PLANET COLLECTOR.
-- El cliente gestiona interfaz, camara, entrada, efectos y animaciones no autoritativas.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Client = script.Parent

local State = require(Client.ClientState)
local AssetCheck = require(Client.AssetCheck)
State.init()
AssetCheck.run(8)

local ctx = {
	State = State,
	Player = Players.LocalPlayer,
	Defs = require(Shared.Defs),
	Format = require(Shared.Util.Format),
	Progression = require(Shared.Progression),
	PlanetVisual = require(Shared.PlanetVisual),
	Layout = require(Shared.UniverseLayout),
	Kit = require(Client.UI.Kit),
	Theme = require(Client.UI.Theme),
}

-- El orden importa: la interfaz primero; el resto se apoya en ella.
local ORDER = { "UIController", "AudioController", "EffectsController", "CapsuleController", "TradeController", "CameraController",
	"UniverseController", "HubController", "TutorialController" }
for _, name in ipairs(ORDER) do
	local controller = require(Client.Controllers[name])
	local ok, err = pcall(controller.init, ctx)
	if not ok then
		warn("[PlanetCollector] error al iniciar " .. name .. ": " .. tostring(err))
	end
end

AssetCheck.fixModels(game:GetService("Workspace"))

-- la mochila clasica de Roblox no se usa en este juego
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- avisos de sesion
local session = State.Data._Session or {}
if session.Offline then
	ctx.Effects.offline(session.Offline)
end
if session.SessionOnly then
	ctx.UI.toast("Modo de prueba: el progreso no se guardará (activa «Enable Studio Access to API Services»).", "error")
end
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="Folder" referent="RBX72">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="RBX73">
            <Properties>
              <string name="Name">Kit</string>
              <ProtectedString name="Source"><![CDATA[-- Kit: componentes de interfaz reutilizables (paneles holograficos, botones, listas, tarjetas de planeta).
-- Toda la interfaz se genera por codigo para que el proyecto se pueda construir sin Studio.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Defs = require(Shared.Defs)
local Format = require(Shared.Util.Format)
local Progression = require(Shared.Progression)
local PlanetVisual = require(Shared.PlanetVisual)
local Theme = require(script.Parent.Theme)
local C, F = Theme.Colors, Theme.Fonts

local Kit = {}

Kit.onClick = nil -- funcion opcional (sonido de clic), la asigna AudioController

---------------------------------------------------------------- basicos
function Kit.corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or Theme.Corner)
	c.Parent = parent
	return c
end

function Kit.stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or C.Cyan
	s.Thickness = thickness or Theme.Stroke
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function Kit.gradient(parent, c0, c1, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c0, c1)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function Kit.padding(parent, left, top, right, bottom)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, left or 0)
	p.PaddingTop = UDim.new(0, top or left or 0)
	p.PaddingRight = UDim.new(0, right or left or 0)
	p.PaddingBottom = UDim.new(0, bottom or top or left or 0)
	p.Parent = parent
	return p
end

local function applyProps(inst, props)
	if props then
		for k, v in pairs(props) do
			inst[k] = v
		end
	end
end

-- Marco. opts: propiedades de Frame; Color/Alpha atajos de fondo
function Kit.frame(parent, props)
	local f = Instance.new("Frame")
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	applyProps(f, props)
	f.Parent = parent
	return f
end

-- Caja de color con esquinas redondeadas
function Kit.box(parent, color, transparency, props, radius)
	local f = Kit.frame(parent, props)
	f.BackgroundColor3 = color or C.Row
	f.BackgroundTransparency = transparency or 0
	Kit.corner(f, radius or 10)
	return f
end

-- Texto. opts: Size, Position, AnchorPoint, TextSize, Color, Font, AlignX, AlignY, Wrap, Stroke, y cualquier
-- otra propiedad de TextLabel en Props
function Kit.label(parent, text, opts)
	opts = opts or {}
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Font = opts.Font or F.Bold
	l.Text = text or ""
	l.TextSize = opts.TextSize or 16
	l.TextColor3 = opts.Color or C.Text
	l.TextXAlignment = opts.AlignX or Enum.TextXAlignment.Left
	l.TextYAlignment = opts.AlignY or Enum.TextYAlignment.Center
	l.TextWrapped = opts.Wrap == true
	l.TextTruncate = opts.Wrap and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd
	l.Size = opts.Size or UDim2.new(1, 0, 0, (opts.TextSize or 16) + 8)
	if opts.Position then l.Position = opts.Position end
	if opts.AnchorPoint then l.AnchorPoint = opts.AnchorPoint end
	if opts.Stroke then
		local s = Instance.new("UIStroke")
		s.Color = C.Dark
		s.Thickness = 1.5
		s.Transparency = 0.2
		s.Parent = l
	end
	applyProps(l, opts.Props)
	l.Parent = parent
	return l
end

function Kit.tween(inst, time, props, style, direction)
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

---------------------------------------------------------------- botones
function Kit.setStyle(button, style)
	local colors = Theme.Buttons[style] or Theme.Buttons.primary
	local gradient = button:FindFirstChild("Fill")
	local stroke = button:FindFirstChild("Edge")
	if gradient then gradient.Color = ColorSequence.new(colors[1], colors[2]) end
	if stroke then stroke.Color = colors[3] end
	button:SetAttribute("Style", style)
end

function Kit.setEnabled(button, enabled)
	button:SetAttribute("Disabled", not enabled)
	local style = button:GetAttribute("BaseStyle") or "primary"
	local colors = enabled and Theme.Buttons[style] or Theme.Buttons.disabled
	local gradient = button:FindFirstChild("Fill")
	local stroke = button:FindFirstChild("Edge")
	if gradient then gradient.Color = ColorSequence.new(colors[1], colors[2]) end
	if stroke then stroke.Color = colors[3] end
	button.TextTransparency = enabled and 0 or 0.45
end

-- Boton. opts: Size, Position, AnchorPoint, TextSize, Font, Radius, Props
function Kit.button(parent, text, style, opts, onClick)
	opts = opts or {}
	style = style or "primary"
	local colors = Theme.Buttons[style] or Theme.Buttons.primary
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	b.BorderSizePixel = 0
	b.Font = opts.Font or F.Bold
	b.Text = text or ""
	b.TextSize = opts.TextSize or 16
	b.TextColor3 = C.Text
	b.TextWrapped = true
	b.Size = opts.Size or UDim2.fromOffset(140, 40)
	if opts.Position then b.Position = opts.Position end
	if opts.AnchorPoint then b.AnchorPoint = opts.AnchorPoint end
	b:SetAttribute("BaseStyle", style)
	Kit.corner(b, opts.Radius or 10)
	local gradient = Kit.gradient(b, colors[1], colors[2], 90)
	gradient.Name = "Fill"
	local stroke = Kit.stroke(b, colors[3], 1.5, 0)
	stroke.Name = "Edge"
	local textStroke = Instance.new("UIStroke")
	textStroke.Name = "TextEdge"
	textStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	textStroke.Color = C.Dark
	textStroke.Thickness = 1.2
	textStroke.Transparency = 0.35
	textStroke.Parent = b
	local scale = Instance.new("UIScale")
	scale.Parent = b
	applyProps(b, opts.Props)
	b.MouseEnter:Connect(function()
		if not b:GetAttribute("Disabled") then stroke.Thickness = 2.5 end
	end)
	b.MouseLeave:Connect(function()
		stroke.Thickness = 1.5
		scale.Scale = 1
	end)
	b.MouseButton1Down:Connect(function()
		if not b:GetAttribute("Disabled") then scale.Scale = 0.95 end
	end)
	b.MouseButton1Up:Connect(function()
		scale.Scale = 1
	end)
	b.Activated:Connect(function()
		if b:GetAttribute("Disabled") then return end
		if Kit.onClick then Kit.onClick() end
		if onClick then onClick(b) end
	end)
	b.Parent = parent
	return b
end

---------------------------------------------------------------- panel
-- Panel centrado con cabecera. opts: Size (UDim2 en offset), Title, Icon, OnClose, Name
-- Devuelve frame, body
function Kit.panel(parent, opts)
	local frame = Instance.new("Frame")
	frame.Name = opts.Name or "Panel"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = opts.Position or UDim2.fromScale(0.5, 0.5)
	frame.Size = opts.Size or UDim2.fromOffset(760, 500)
	frame.BackgroundColor3 = C.Panel
	frame.BackgroundTransparency = 0.06
	frame.BorderSizePixel = 0
	frame.Active = true
	Kit.corner(frame, 16)
	local stroke = Kit.stroke(frame, Color3.new(1, 1, 1), 2, 0)
	Kit.gradient(stroke, C.Cyan, C.Violet, 35)
	local glow = Kit.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 180, 235), 90)
	glow.Name = "Shade"

	local header = Kit.frame(frame, { Name = "Header", Size = UDim2.new(1, 0, 0, 54) })
	Kit.label(header, ((opts.Icon and (opts.Icon .. "  ")) or "") .. string.upper(opts.Title or ""), {
		Font = F.Title, TextSize = 19, Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -90, 1, 0), Color = C.Text,
	}).Name = "Title"
	local line = Kit.frame(frame, { Name = "Divider", Size = UDim2.new(1, -32, 0, 2), Position = UDim2.fromOffset(16, 54),
		BackgroundTransparency = 0.2, BackgroundColor3 = Color3.new(1, 1, 1) })
	Kit.gradient(line, C.Cyan, C.Violet, 0)
	if opts.OnClose then
		Kit.button(header, "X", "danger", { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -46, 0, 9), TextSize = 18 }, opts.OnClose).Name = "Close"
	end
	local body = Kit.frame(frame, { Name = "Body", Position = UDim2.fromOffset(16, 64), Size = UDim2.new(1, -32, 1, -78) })
	frame.Parent = parent
	return frame, body
end

---------------------------------------------------------------- listas
-- opts: Size, Position, Grid (UDim2 celda), Padding, Horizontal, Props
function Kit.scroll(parent, opts)
	opts = opts or {}
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = opts.Size or UDim2.fromScale(1, 1)
	if opts.Position then s.Position = opts.Position end
	s.CanvasSize = UDim2.new(0, 0, 0, 0)
	s.AutomaticCanvasSize = opts.Horizontal and Enum.AutomaticSize.X or Enum.AutomaticSize.Y
	s.ScrollBarThickness = 6
	s.ScrollBarImageColor3 = C.Cyan
	s.ScrollingDirection = opts.Horizontal and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y
	applyProps(s, opts.Props)
	local layout
	if opts.Grid then
		layout = Instance.new("UIGridLayout")
		layout.CellSize = opts.Grid
		layout.CellPadding = UDim2.fromOffset(opts.Padding or 8, opts.Padding or 8)
	else
		layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, opts.Padding or 8)
		layout.FillDirection = opts.Horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	end
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = s
	Kit.padding(s, 2, 2, 10, 2)
	s.Parent = parent
	return s, layout
end

function Kit.listLayout(parent, padding, horizontal, alignCenter)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, padding or 8)
	layout.FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	if alignCenter then
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	end
	layout.Parent = parent
	return layout
end

-- Elimina los hijos que no sean layouts/paddings
function Kit.clear(container)
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
end

---------------------------------------------------------------- barra de progreso
-- Devuelve frame, set(fraccion, texto)
function Kit.progress(parent, opts)
	opts = opts or {}
	local back = Kit.box(parent, C.Dark, 0.3, { Size = opts.Size or UDim2.new(1, 0, 0, 18), Position = opts.Position }, 8)
	Kit.stroke(back, opts.Color or C.Cyan, 1, 0.5)
	local fill = Kit.box(back, opts.Color or C.Cyan, 0, { Size = UDim2.fromScale(0, 1), Name = "Fill" }, 8)
	local text = Kit.label(back, "", { Size = UDim2.fromScale(1, 1), TextSize = 12, AlignX = Enum.TextXAlignment.Center, Stroke = true })
	local function set(fraction, caption)
		fraction = math.clamp(fraction, 0, 1)
		fill.Size = UDim2.fromScale(fraction, 1)
		fill.Visible = fraction > 0.001
		text.Text = caption or ""
	end
	return back, set
end

---------------------------------------------------------------- interruptor
function Kit.toggle(parent, value, onChange, opts)
	opts = opts or {}
	local state = value == true
	local b
	local function paint()
		b.Text = state and "ACTIVADO" or "DESACTIVADO"
		Kit.setStyle(b, state and "green" or "ghost")
	end
	b = Kit.button(parent, "", "ghost", { Size = opts.Size or UDim2.fromOffset(130, 34), Position = opts.Position,
		AnchorPoint = opts.AnchorPoint, TextSize = 13 }, function()
		state = not state
		paint()
		onChange(state)
	end)
	paint()
	return b, function(v)
		state = v == true
		paint()
	end
end

---------------------------------------------------------------- pestañas
-- items = { "Texto", ... }. Devuelve frame, select(indice)
function Kit.tabs(parent, items, onSelect, opts)
	opts = opts or {}
	local bar = Kit.frame(parent, { Size = opts.Size or UDim2.new(1, 0, 0, 36), Position = opts.Position })
	Kit.listLayout(bar, 6, true)
	local buttons = {}
	local function select(index, silent)
		for i, btn in ipairs(buttons) do
			Kit.setStyle(btn, i == index and "cyan" or "ghost")
		end
		if not silent then onSelect(index) end
	end
	for i, text in ipairs(items) do
		buttons[i] = Kit.button(bar, text, "ghost", { Size = UDim2.fromOffset(opts.Width or 120, 34), TextSize = 13,
			Props = { LayoutOrder = i } }, function()
			select(i)
		end)
	end
	select(1, true)
	return bar, select, buttons
end

---------------------------------------------------------------- planetas
function Kit.rarityText(rarityId)
	local r = Defs.Rarities.ById[rarityId]
	return r.Icon .. " " .. r.Name
end

-- ViewportFrame con el modelo del planeta
function Kit.viewport(parent, planetId, variant, evolved, props)
	local v = Instance.new("ViewportFrame")
	v.BackgroundTransparency = 1
	v.BorderSizePixel = 0
	v.Size = UDim2.fromScale(1, 1)
	applyProps(v, props)
	PlanetVisual.mount(v, planetId, variant, evolved)
	v.Parent = parent
	return v
end

-- Tarjeta de planeta. data = { Id, V, E, L, Placed, Silhouette }. opts: Size, OnClick, ShowRate
function Kit.planetCard(parent, data, opts)
	opts = opts or {}
	local def = Defs.Planets.ById[data.Id]
	local rarity = Defs.Rarities.ById[def.Rarity]
	local variant = Defs.Variants.get(data.V)
	local card = Instance.new("TextButton")
	card.Name = "PlanetCard"
	card.AutoButtonColor = false
	card.Text = ""
	card.BackgroundColor3 = C.Row
	card.BorderSizePixel = 0
	card.Size = opts.Size or UDim2.fromOffset(118, 150)
	Kit.corner(card, 10)
	local stroke = Kit.stroke(card, rarity.Color, 1.5, 0.1)
	stroke.Name = "Edge"
	Kit.gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 160, 210), 90)

	local view = Kit.viewport(card, data.Id, data.V, data.E, { Size = UDim2.new(1, -8, 0.56, 0), Position = UDim2.fromOffset(4, 4) })
	if data.Silhouette then
		view.ImageColor3 = Color3.new(0, 0, 0)
		view.ImageTransparency = 0.25
	end
	local name = data.Silhouette and "???" or Defs.Planets.displayName(def, data.E)
	Kit.label(card, name, { Size = UDim2.new(1, -8, 0, 18), Position = UDim2.new(0, 4, 0.58, 0), TextSize = 13,
		AlignX = Enum.TextXAlignment.Center })
	Kit.label(card, Kit.rarityText(def.Rarity), { Size = UDim2.new(1, -8, 0, 16), Position = UDim2.new(0, 4, 0.58, 18), TextSize = 11,
		AlignX = Enum.TextXAlignment.Center, Color = rarity.Color })
	if opts.ShowRate ~= false and not data.Silhouette then
		Kit.label(card, "⚡ " .. Format.rate(Progression.planetRate({ Id = data.Id, V = data.V or "none", E = data.E == true })),
			{ Size = UDim2.new(1, -8, 0, 16), Position = UDim2.new(0, 4, 0.58, 34), TextSize = 12, AlignX = Enum.TextXAlignment.Center,
				Color = C.Energy })
	end
	if variant.Id ~= "none" then
		local tag = Kit.box(card, C.Dark, 0.25, { Size = UDim2.fromOffset(64, 16), Position = UDim2.fromOffset(4, 4) }, 6)
		Kit.label(tag, variant.Icon .. " " .. string.upper(variant.Name), { Size = UDim2.fromScale(1, 1), TextSize = 10,
			AlignX = Enum.TextXAlignment.Center, Color = variant.Color })
	end
	if data.L then
		Kit.label(card, "🔒", { Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -22, 0, 3), TextSize = 13 })
	end
	if data.Placed then
		local ribbon = Kit.box(card, C.Cyan, 0.1, { Size = UDim2.new(1, -8, 0, 14), Position = UDim2.new(0, 4, 0.56, -12) }, 5)
		Kit.label(ribbon, "EN ÓRBITA", { Size = UDim2.fromScale(1, 1), TextSize = 10, AlignX = Enum.TextXAlignment.Center, Color = C.Dark })
	end
	if opts.OnClick then
		card.Activated:Connect(function()
			if Kit.onClick then Kit.onClick() end
			opts.OnClick(card)
		end)
	end
	card.MouseEnter:Connect(function()
		card.BackgroundColor3 = C.RowHover
	end)
	card.MouseLeave:Connect(function()
		card.BackgroundColor3 = C.Row
	end)
	card.Parent = parent
	return card
end

-- Fila de "icono + valor" usada en resumenes
function Kit.stat(parent, title, value, color, order)
	local row = Kit.box(parent, C.Row, 0.15, { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = order or 0 }, 8)
	Kit.label(row, title, { Size = UDim2.new(0.6, -10, 1, 0), Position = UDim2.fromOffset(10, 0), TextSize = 13, Color = C.TextDim })
	local v = Kit.label(row, value, { Size = UDim2.new(0.4, -10, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), TextSize = 14,
		AlignX = Enum.TextXAlignment.Right, Color = color or C.Text })
	return row, v
end

return Kit
]]></ProtectedString>
            </Properties>
          </Item>
          <Item class="Folder" referent="RBX74">
            <Properties>
              <string name="Name">Panels</string>
            </Properties>
            <Item class="ModuleScript" referent="RBX75">
              <Properties>
                <string name="Name">Capsules</string>
                <ProtectedString name="Source"><![CDATA[-- CapsuleUI: tipo de capsula, precio, requisitos, PROBABILIDADES REALES y botones de apertura.
-- El resultado lo genera el servidor; aqui solo se muestra la informacion y se lanza la animacion.
return function(ctx, parent)
	local Kit, State, Defs, Format, Progression, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C = Theme.Colors
	local frame, body = Kit.panel(parent, { Name = "CapsuleUI", Size = UDim2.fromOffset(900, 560), Title = "Capsule Station", Icon = "💊",
		OnClose = function() ctx.UI.close() end })

	local list = Kit.scroll(body, { Size = UDim2.new(0, 250, 1, 0), Padding = 6 })
	local detail = Kit.frame(body, { Name = "Detail", Size = UDim2.new(1, -262, 1, 0), Position = UDim2.fromOffset(262, 0) })

	local selected = "starter"
	local rows = {}
	local busy = false
	local openButtons = {}
	local priceLabel, reqLabel, titleLabel, descLabel, oddsHolder, variantLabel, previewHolder

	titleLabel = Kit.label(detail, "", { Size = UDim2.new(1, 0, 0, 30), TextSize = 22, Font = Theme.Fonts.Black })
	descLabel = Kit.label(detail, "", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 30), TextSize = 13, Color = C.TextDim,
		Font = Theme.Fonts.Body })
	priceLabel = Kit.label(detail, "", { Size = UDim2.new(0.5, 0, 0, 26), Position = UDim2.fromOffset(0, 54), TextSize = 19, Color = C.Energy })
	reqLabel = Kit.label(detail, "", { Size = UDim2.new(0.5, 0, 0, 26), Position = UDim2.new(0.5, 0, 0, 54), TextSize = 13,
		AlignX = Enum.TextXAlignment.Right, Color = C.TextDim })
	Kit.label(detail, "PROBABILIDADES REALES", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 86), TextSize = 12,
		Color = C.Cyan, Font = Theme.Fonts.Title })
	oddsHolder = Kit.frame(detail, { Name = "Odds", Size = UDim2.new(1, 0, 0, 150), Position = UDim2.fromOffset(0, 108) })
	Kit.listLayout(oddsHolder, 4, false)
	variantLabel = Kit.label(detail, "", { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 262), TextSize = 12, Color = C.TextDim,
		Wrap = true, Font = Theme.Fonts.Body })
	previewHolder = Kit.scroll(detail, { Size = UDim2.new(1, 0, 0, 112), Position = UDim2.fromOffset(0, 300), Horizontal = true, Padding = 6 })

	local buttonRow = Kit.frame(detail, { Name = "Buttons", Size = UDim2.new(1, 0, 0, 52), Position = UDim2.new(0, 0, 1, -52) })
	Kit.listLayout(buttonRow, 10, true)

	local function price(def)
		local event = State.Data._Event
		local discount = 1
		if event and event.Id and State.serverTime() < (event.EndsAt or 0) then
			discount = Defs.Events.ById[event.Id].Effects.CapsuleDiscount or 1
		end
		return Progression.capsulePrice(State.Data, def, discount)
	end

	local function luck()
		local event = State.Data._Event
		local eventLuck = 1
		if event and event.Id and State.serverTime() < (event.EndsAt or 0) then
			eventLuck = Defs.Events.ById[event.Id].Effects.VariantLuck or 1
		end
		return Progression.variantLuck(State.Data, eventLuck)
	end

	local function updateButtons()
		local def = Defs.Capsules.ById[selected]
		local unlocked = State.Data.Systems[def.RequiresSystem] == true
		local unit = price(def)
		local maxBatch = Progression.maxBatch(State.Data)
		for _, item in ipairs(openButtons) do
			local count = item.Count
			local allowed = unlocked and count <= maxBatch
			item.Button.Text = "Abrir x" .. count .. "\n⚡ " .. Format.number(unit * count)
			if count > maxBatch then item.Button.Text = "x" .. count .. " 🔒\nApertura Múltiple" end
			Kit.setEnabled(item.Button, allowed and (State.Data.Energy or 0) >= unit * count and not busy)
		end
		priceLabel.Text = "⚡ " .. Format.number(unit) .. (unit < def.Price and ("  (antes " .. Format.number(def.Price) .. ")") or "")
	end

	local function showDetail()
		local def = Defs.Capsules.ById[selected]
		local unlocked = State.Data.Systems[def.RequiresSystem] == true
		titleLabel.Text = def.Name
		titleLabel.TextColor3 = def.Color
		descLabel.Text = def.Description
		reqLabel.Text = unlocked and "✔ Disponible" or ("🔒 Requiere " .. Defs.Galaxy.ById[def.RequiresSystem].Name)
		reqLabel.TextColor3 = unlocked and C.Green or C.Red
		Kit.clear(oddsHolder)
		for index, entry in ipairs(Defs.Capsules.oddsList(def, Defs.Rarities.Order)) do
			local rarity = Defs.Rarities.ById[entry.Rarity]
			local row = Kit.box(oddsHolder, C.Row, 0.2, { Size = UDim2.new(1, 0, 0, 26), LayoutOrder = index }, 6)
			Kit.label(row, Kit.rarityText(entry.Rarity), { Size = UDim2.new(0, 130, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 13, Color = rarity.Color })
			local names = {}
			for _, id in ipairs(entry.Planets) do
				table.insert(names, Defs.Planets.ById[id].Name)
			end
			Kit.label(row, table.concat(names, ", "), { Size = UDim2.new(1, -220, 1, 0), Position = UDim2.fromOffset(140, 0), TextSize = 12,
				Color = C.TextDim, Font = Theme.Fonts.Body })
			Kit.label(row, Format.percent(entry.Chance), { Size = UDim2.new(0, 70, 1, 0), Position = UDim2.new(1, -78, 0, 0), TextSize = 14,
				AlignX = Enum.TextXAlignment.Right })
		end
		local chances = Defs.Variants.chances(luck())
		local parts = {}
		for _, id in ipairs(Defs.Variants.Order) do
			if id ~= "none" then
				local v = Defs.Variants.ById[id]
				table.insert(parts, v.Icon .. " " .. v.Name .. " " .. Format.percent(chances[id]) .. " (" .. Format.mult(v.Multiplier) .. ")")
			end
		end
		variantLabel.Text = "Variantes (probabilidad por planeta): " .. table.concat(parts, "  ·  ")
		Kit.clear(previewHolder)
		local order = 0
		for _, entry in ipairs(Defs.Capsules.oddsList(def, Defs.Rarities.Order)) do
			for _, id in ipairs(entry.Planets) do
				order = order + 1
				local card = Kit.planetCard(previewHolder, { Id = id, V = "none", E = false, Silhouette = not State.Data.Discovered[id] },
					{ Size = UDim2.fromOffset(84, 104), ShowRate = false })
				card.LayoutOrder = order
			end
		end
		for id, row in pairs(rows) do
			Kit.setStyle(row, id == selected and "cyan" or "ghost")
		end
		updateButtons()
	end

	for index, def in ipairs(Defs.Capsules.List) do
		local row = Kit.button(list, "", "ghost", { Size = UDim2.new(1, -4, 0, 62), Props = { LayoutOrder = index, Name = "Capsule_" .. def.Id } }, function()
			selected = def.Id
			showDetail()
		end)
		local dot = Kit.box(row, def.Color, 0, { Size = UDim2.fromOffset(26, 40), Position = UDim2.fromOffset(10, 11) }, 13)
		Kit.gradient(dot, Color3.new(1, 1, 1), def.CoreColor, 90)
		Kit.label(row, def.Name, { Size = UDim2.new(1, -52, 0, 24), Position = UDim2.fromOffset(46, 8), TextSize = 15 })
		Kit.label(row, "⚡ " .. Format.number(def.Price), { Size = UDim2.new(1, -52, 0, 20), Position = UDim2.fromOffset(46, 32), TextSize = 13,
			Color = C.Energy }).Name = "Price"
		rows[def.Id] = row
	end

	for index, count in ipairs(Defs.Config.Capsules.BatchSizes) do
		local button
		button = Kit.button(buttonRow, "", index == 1 and "primary" or "cyan", { Size = UDim2.fromOffset(index == 1 and 230 or 180, 52), TextSize = 14,
			Props = { LayoutOrder = index, Name = "Open" .. count } }, function()
			if busy then return end
			busy = true
			updateButtons()
			local result = ctx.UI.request("OpenCapsule", selected, count)
			if result.Ok then
				ctx.Capsule.play(result.Data)
			end
			busy = false
			updateButtons()
		end)
		table.insert(openButtons, { Button = button, Count = count })
	end

	local lastUpdate = 0
	State.on("Energy", function()
		if frame.Visible and os.clock() - lastUpdate > 0.4 then
			lastUpdate = os.clock()
			updateButtons()
		end
	end)
	State.onAny(function(changed)
		if frame.Visible and (changed.Systems or changed.Upgrades or changed._Event or changed.Discovered) then showDetail() end
	end)

	return {
		Frame = frame,
		OnOpen = function(args)
			if args.Capsule and Defs.Capsules.ById[args.Capsule] then selected = args.Capsule end
			showDetail()
		end,
		Refresh = showDetail,
	}
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX76">
              <Properties>
                <string name="Name">Collection</string>
                <ProtectedString name="Source"><![CDATA[-- Collection Index: descubiertos y no descubiertos, rareza, sistema, variantes, produccion de
-- referencia y porcentaje de coleccion. Filtros por sistema, rareza y estado. Las pistas de secretos
-- solo aparecen cuando corresponde.
return function(ctx, parent)
	local Kit, State, Defs, Format, Progression, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "CollectionUI", Size = UDim2.fromOffset(980, 580), Title = "Collection Index", Icon = "📖",
		OnClose = function() ctx.UI.close() end })

	local systemFilter = 0 -- 0 = todos
	local stateFilter = 1 -- 1 todos, 2 descubiertos, 3 por descubrir
	local rarityFilter = 0
	local selected = nil
	local STATE_NAMES = { "Estado: todos", "Solo descubiertos", "Por descubrir" }

	local summary = Kit.label(body, "", { Size = UDim2.new(1, -300, 0, 26), TextSize = 15, Color = C.Gold })
	local _, setTotal = Kit.progress(body, { Size = UDim2.new(1, -300, 0, 14), Position = UDim2.fromOffset(0, 28), Color = C.Gold })
	local grid = Kit.scroll(body, { Size = UDim2.new(1, -300, 1, -96), Position = UDim2.fromOffset(0, 94), Grid = UDim2.fromOffset(112, 138), Padding = 8 })
	local side = Kit.box(body, C.PanelLight, 0.2, { Name = "Detail", Size = UDim2.new(0, 288, 1, 0), Position = UDim2.new(1, -288, 0, 0) }, 12)
	Kit.stroke(side, C.Violet, 1, 0.5)
	local sideBody = Kit.frame(side, { Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10) })
	local refresh

	local function hintsUnlocked()
		local found = Progression.discoveryTotals(State.Data)
		return State.Data.Ascensions >= 1 or found >= 12
	end

	local function showDetail()
		Kit.clear(sideBody)
		local def = selected and Defs.Planets.ById[selected]
		if not def then
			Kit.label(sideBody, "Selecciona una entrada del índice.", { Size = UDim2.new(1, 0, 0, 60), TextSize = 14, Wrap = true, Color = C.TextDim,
				Font = F.Body, AlignX = Enum.TextXAlignment.Center })
			return
		end
		local data = State.Data
		local discovered = data.Discovered[def.Id] == true
		local rarity = Defs.Rarities.ById[def.Rarity]
		local view = Kit.viewport(sideBody, def.Id, "none", false, { Size = UDim2.new(1, 0, 0, 150) })
		if not discovered then
			view.ImageColor3 = Color3.new(0, 0, 0)
			view.ImageTransparency = 0.2
		end
		Kit.label(sideBody, discovered and def.Name or "???", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 152), TextSize = 21,
			Font = F.Black, AlignX = Enum.TextXAlignment.Center, Color = rarity.Color })
		Kit.label(sideBody, Kit.rarityText(def.Rarity) .. " · " .. Defs.Galaxy.ById[def.System].Name, { Size = UDim2.new(1, 0, 0, 18),
			Position = UDim2.fromOffset(0, 180), TextSize = 12, AlignX = Enum.TextXAlignment.Center })
		local text
		if discovered then
			text = def.TypeLabel .. "  ·  ⚡ " .. Format.rate(def.Base) .. " base\n\n" .. def.Description
		elseif def.Secret then
			text = hintsUnlocked() and ("Pista: " .. def.Secret.Hint) or "Descubrimiento secreto. Sigue ampliando tu colección para recibir una pista."
		else
			local sources = {}
			for _, cap in ipairs(Defs.Capsules.List) do
				local pool = cap.Pools[def.Rarity]
				if pool and table.find(pool, def.Id) then table.insert(sources, cap.Name) end
			end
			text = "Aún no descubierto.\nSe obtiene en: " .. table.concat(sources, ", ") .. "."
		end
		Kit.label(sideBody, text, { Size = UDim2.new(1, 0, 0, 120), Position = UDim2.fromOffset(0, 204), TextSize = 12, Wrap = true, Color = C.TextDim,
			Font = F.Body, AlignY = Enum.TextYAlignment.Top, AlignX = Enum.TextXAlignment.Center })
		-- variantes y forma Prime descubiertas
		Kit.label(sideBody, "VARIANTES DESCUBIERTAS", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -118), TextSize = 11,
			Font = F.Title, Color = C.Cyan, AlignX = Enum.TextXAlignment.Center })
		local variants = Kit.frame(sideBody, { Size = UDim2.new(1, 0, 0, 92), Position = UDim2.new(0, 0, 1, -96) })
		local layout = Instance.new("UIGridLayout")
		layout.CellSize = UDim2.new(0.5, -4, 0, 26)
		layout.CellPadding = UDim2.fromOffset(6, 6)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = variants
		local order = 0
		for _, id in ipairs(Defs.Variants.Order) do
			if id ~= "none" then
				order = order + 1
				local v = Defs.Variants.ById[id]
				local has = data.Discovered[def.Id .. "#" .. id] == true
				local chip = Kit.box(variants, C.Row, has and 0 or 0.5, { LayoutOrder = order }, 6)
				Kit.label(chip, (has and "✔ " or "· ") .. v.Icon .. " " .. v.Name, { Size = UDim2.fromScale(1, 1), TextSize = 12,
					AlignX = Enum.TextXAlignment.Center, Color = has and v.Color or C.TextDim })
			end
		end
		local hasPrime = data.Discovered[def.Id .. "#evo"] == true
		local prime = Kit.box(variants, C.Row, hasPrime and 0 or 0.5, { LayoutOrder = 10 }, 6)
		Kit.label(prime, (hasPrime and "✔ " or "· ") .. "🌟 Prime", { Size = UDim2.fromScale(1, 1), TextSize = 12, AlignX = Enum.TextXAlignment.Center,
			Color = hasPrime and C.Gold or C.TextDim })
	end

	refresh = function()
		local data = State.Data
		local found, total = Progression.discoveryTotals(data)
		summary.Text = "Colección: " .. found .. " / " .. total .. " planetas  (" .. Format.percent(found / total, 0) .. ")"
		setTotal(found / total, "")
		Kit.clear(grid)
		local order = 0
		for _, def in ipairs(Defs.Planets.List) do
			local discovered = data.Discovered[def.Id] == true
			local sysOk = systemFilter == 0 or Defs.Galaxy.Order[systemFilter] == def.System
			local stateOk = stateFilter == 1 or (stateFilter == 2 and discovered) or (stateFilter == 3 and not discovered)
			local rarityOk = rarityFilter == 0 or Defs.Rarities.Order[rarityFilter] == def.Rarity
			if sysOk and stateOk and rarityOk then
				order = order + 1
				local card = Kit.planetCard(grid, { Id = def.Id, V = "none", E = false, Silhouette = not discovered }, {
					Size = UDim2.fromOffset(112, 138), ShowRate = discovered,
					OnClick = function()
						selected = def.Id
						showDetail()
					end,
				})
				card.Name = "Entry_" .. def.Id
				card.LayoutOrder = order
			end
		end
		showDetail()
	end

	local systemNames = { "Todos" }
	for _, sysId in ipairs(Defs.Galaxy.Order) do
		table.insert(systemNames, (string.gsub(Defs.Galaxy.ById[sysId].Name, " System", "")))
	end
	Kit.tabs(body, systemNames, function(index)
		systemFilter = index - 1
		refresh()
	end, { Size = UDim2.new(1, -300, 0, 34), Position = UDim2.fromOffset(0, 50), Width = 82 })
	local stateButton, rarityButton
	stateButton = Kit.button(body, STATE_NAMES[1], "ghost", { Size = UDim2.fromOffset(150, 28), Position = UDim2.new(1, -620, 0, 0), TextSize = 12 }, function()
		stateFilter = stateFilter % 3 + 1
		stateButton.Text = STATE_NAMES[stateFilter]
		refresh()
	end)
	stateButton.Name = "StateFilter"
	rarityButton = Kit.button(body, "Rareza: todas", "ghost", { Size = UDim2.fromOffset(160, 28), Position = UDim2.new(1, -464, 0, 0), TextSize = 12 }, function()
		rarityFilter = (rarityFilter + 1) % (#Defs.Rarities.Order + 1)
		rarityButton.Text = rarityFilter == 0 and "Rareza: todas" or ("Rareza: " .. Defs.Rarities.ById[Defs.Rarities.Order[rarityFilter]].Name)
		refresh()
	end)
	rarityButton.Name = "RarityFilter"

	State.onAny(function(changed)
		if frame.Visible and (changed.Discovered or changed.SecretsFound) then refresh() end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX77">
              <Properties>
                <string name="Name">Event</string>
                <ProtectedString name="Source"><![CDATA[-- Event Terminal: evento activo, temporizador (tiempo de servidor), descripcion, objetivo, recompensa
-- y proximo evento programado.
return function(ctx, parent)
	local RunService = game:GetService("RunService")
	local Kit, State, Defs, Format, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "EventUI", Size = UDim2.fromOffset(680, 520), Title = "Event Terminal", Icon = "☄️",
		OnClose = function() ctx.UI.close() end })
	local timerLabel = nil
	local currentKey = nil

	local function activeEvent()
		local event = State.Data._Event
		if event and event.Id and State.serverTime() < (event.EndsAt or 0) then
			return Defs.Events.ById[event.Id], event
		end
		return nil, event
	end

	local function refresh()
		Kit.clear(body)
		timerLabel = nil
		local def, event = activeEvent()
		currentKey = def and def.Id or "none"
		local y = 0
		if def then
			local box = Kit.box(body, C.Row, 0.1, { Size = UDim2.new(1, 0, 0, 190) }, 12)
			Kit.stroke(box, def.Color, 2, 0)
			Kit.label(box, def.Icon, { Size = UDim2.fromOffset(90, 90), Position = UDim2.fromOffset(10, 8), TextSize = 56, AlignX = Enum.TextXAlignment.Center })
			Kit.label(box, string.upper(def.Name), { Size = UDim2.new(1, -260, 0, 32), Position = UDim2.fromOffset(104, 12), TextSize = 22, Font = F.Title,
				Color = def.Color })
			Kit.label(box, def.Description, { Size = UDim2.new(1, -120, 0, 44), Position = UDim2.fromOffset(104, 46), TextSize = 13, Wrap = true,
				Color = C.TextDim, Font = F.Body, AlignY = Enum.TextYAlignment.Top })
			timerLabel = Kit.label(box, "", { Size = UDim2.fromOffset(140, 32), Position = UDim2.new(1, -152, 0, 12), TextSize = 22, Font = F.Black,
				AlignX = Enum.TextXAlignment.Right, Color = C.Gold })
			local m = State.Data.Missions
			local progress = m.EventProgress or 0
			local goal = def.Objective.Goal
			Kit.label(box, "Objetivo: " .. string.format(def.Objective.Text, goal) .. "   ·   Recompensa: ✨ " .. def.RewardStardust,
				{ Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 104), TextSize = 13 })
			local _, set = Kit.progress(box, { Size = UDim2.new(1, -200, 0, 20), Position = UDim2.fromOffset(12, 134), Color = progress >= goal and C.Green or def.Color })
			set(progress / goal, progress .. " / " .. goal)
			local claim = Kit.button(box, m.EventClaimed and "✔ Reclamado" or "Reclamar", "green", { Size = UDim2.fromOffset(160, 40),
				Position = UDim2.new(1, -172, 0, 124), TextSize = 14, Props = { Name = "Claim" } }, function()
				local result = ctx.UI.request("ClaimMission", "event", 1)
				if result.Ok then
					ctx.UI.toast("Objetivo de evento completado: +" .. result.Data.Stardust .. " ✨", "reward")
				end
			end)
			Kit.setEnabled(claim, progress >= goal and not m.EventClaimed)
			y = 202
		else
			local box = Kit.box(body, C.Row, 0.1, { Size = UDim2.new(1, 0, 0, 96) }, 12)
			Kit.label(box, "No hay ningún evento activo.", { Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 12), TextSize = 17 })
			local nextDef = event and Defs.Events.ById[event.NextId]
			if nextDef then
				Kit.label(box, "Próximo: " .. nextDef.Icon .. " " .. nextDef.Name, { Size = UDim2.new(1, -200, 0, 26), Position = UDim2.fromOffset(12, 50),
					TextSize = 15, Color = nextDef.Color })
				timerLabel = Kit.label(box, "", { Size = UDim2.fromOffset(160, 32), Position = UDim2.new(1, -172, 0, 46), TextSize = 22, Font = F.Black,
					AlignX = Enum.TextXAlignment.Right, Color = C.Cyan })
			end
			y = 108
		end
		Kit.label(body, "CALENDARIO DE EVENTOS CÓSMICOS", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, y), TextSize = 12, Font = F.Title,
			Color = C.Cyan })
		for i, e in ipairs(Defs.Events.List) do
			local row = Kit.box(body, C.Row, 0.25, { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, y + 26 + (i - 1) * 52) }, 8)
			Kit.label(row, e.Icon .. "  " .. e.Name, { Size = UDim2.fromOffset(200, 46), Position = UDim2.fromOffset(12, 0), TextSize = 14, Color = e.Color })
			Kit.label(row, e.Description, { Size = UDim2.new(1, -230, 1, 0), Position = UDim2.fromOffset(216, 0), TextSize = 11, Wrap = true,
				Color = C.TextDim, Font = F.Body })
		end
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		if not frame.Visible then return end
		accumulator = accumulator + dt
		if accumulator < 0.25 then return end
		accumulator = 0
		local def, event = activeEvent()
		local key = def and def.Id or "none"
		if key ~= currentKey then
			refresh()
			return
		end
		if timerLabel and event then
			local now = State.serverTime()
			timerLabel.Text = Format.clock(def and (event.EndsAt - now) or math.max(0, event.NextStartsAt - now))
		end
	end)

	State.onAny(function(changed)
		if frame.Visible and (changed.Missions or changed._Event) then refresh() end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX78">
              <Properties>
                <string name="Name">Galaxy</string>
                <ProtectedString name="Source"><![CDATA[-- GalaxyUI: los cinco sistemas con su estado (bloqueado / listo para desbloquear / desbloqueado),
-- requisitos, progreso y contenido que introducen. Permite desbloquear y viajar entre sistemas.
return function(ctx, parent)
	local Kit, State, Defs, Format, Progression, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "GalaxyUI", Size = UDim2.fromOffset(980, 560), Title = "Sistemas de tu universo", Icon = "🌌",
		OnClose = function() ctx.UI.close() end })
	local row = Kit.frame(body, { Size = UDim2.fromScale(1, 1) })
	Kit.listLayout(row, 10, true)

	local function refresh()
		Kit.clear(row)
		local data = State.Data
		local rate = State.rate()
		for index, def in ipairs(Defs.Galaxy.List) do
			local state, checks = Progression.systemState(data, def.Id, rate)
			local active = data.ActiveSystem == def.Id
			local card = Kit.box(row, C.Row, 0.1, { Size = UDim2.new(0.2, -8, 1, 0), LayoutOrder = index, Name = "System_" .. def.Id }, 12)
			Kit.stroke(card, active and C.Text or def.Theme.Accent, active and 3 or 1.5, state == "locked" and 0.6 or 0)
			local header = Kit.box(card, def.Theme.Accent, 0.15, { Size = UDim2.new(1, -12, 0, 74), Position = UDim2.fromOffset(6, 6) }, 10)
			Kit.gradient(header, def.Theme.Star, def.Theme.Accent, 90)
			Kit.label(header, string.format("%02d", index), { Size = UDim2.fromOffset(40, 24), Position = UDim2.fromOffset(8, 4), TextSize = 14,
				Font = F.Title, Color = C.Dark })
			Kit.label(header, string.upper(def.Name), { Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(8, 26), TextSize = 13,
				Font = F.Title, Color = C.Dark })
			Kit.label(header, def.Subtitle, { Size = UDim2.new(1, -12, 0, 18), Position = UDim2.fromOffset(8, 50), TextSize = 11, Color = C.Dark,
				Font = F.Body })
			local badgeText = (state == "unlocked" and (active and "● ACTIVO" or "✔ DESBLOQUEADO")) or (state == "ready" and "★ LISTO") or "🔒 BLOQUEADO"
			local badgeColor = (state == "unlocked" and C.Green) or (state == "ready" and C.Gold) or C.Red
			Kit.label(card, badgeText, { Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(8, 84), TextSize = 12, Color = badgeColor })
			Kit.label(card, "Producción " .. Format.mult(def.Multiplier), { Size = UDim2.new(1, -12, 0, 20), Position = UDim2.fromOffset(8, 104),
				TextSize = 14, Color = C.Energy })
			Kit.label(card, def.Introduces, { Size = UDim2.new(1, -16, 0, 62), Position = UDim2.fromOffset(8, 126), TextSize = 11, Wrap = true,
				Color = C.TextDim, Font = F.Body, AlignY = Enum.TextYAlignment.Top })

			local info = Kit.frame(card, { Size = UDim2.new(1, -16, 0, 190), Position = UDim2.fromOffset(8, 192) })
			Kit.listLayout(info, 5, false)
			if state == "unlocked" then
				local found, total = Progression.discoveredInSystem(data, def.Id)
				local barCollection, setCollection = Kit.progress(info, { Size = UDim2.new(1, 0, 0, 20), Color = C.Violet })
				barCollection.LayoutOrder = 1
				setCollection(found / total, "Colección " .. found .. "/" .. total)
				local placed = Progression.placedCount(data, def.Id)
				local slots = data.Slots[def.Id] or 0
				local barSlots, setSlots = Kit.progress(info, { Size = UDim2.new(1, 0, 0, 20), Color = C.Cyan })
				barSlots.LayoutOrder = 2
				setSlots(placed / Defs.Config.Economy.SlotsPerSystem, "Órbitas " .. placed .. "/" .. slots .. " (máx. 8)")
				local breakdown = data._Production and data._Production.Systems[def.Id]
				Kit.label(info, "⚡ " .. Format.rate(breakdown and breakdown.Total or 0) .. " antes de mejoras", { Size = UDim2.new(1, 0, 0, 18),
					TextSize = 11, Color = C.TextDim, Font = F.Body, Props = { LayoutOrder = 3 } })
				local reward = def.Reward
				Kit.label(info, (data.CollectionsClaimed[def.Id] and "✔ " or "🎁 ") .. "Colección completa: +" .. reward.Stardust .. " ✨ y +"
					.. math.floor(reward.ProductionBonus * 100) .. "% producción", { Size = UDim2.new(1, 0, 0, 34), TextSize = 11, Wrap = true,
					Color = data.CollectionsClaimed[def.Id] and C.Green or C.TextDim, Font = F.Body, Props = { LayoutOrder = 4 } })
			else
				for i, check in ipairs(checks) do
					local bar, set = Kit.progress(info, { Size = UDim2.new(1, 0, 0, 16), Color = check.Ok and C.Green or C.Gold })
					bar.LayoutOrder = i * 2 - 1
					set(check.Goal > 0 and check.Current / check.Goal or 0, (check.Ok and "✔ " or "") .. Format.number(check.Current) .. " / "
						.. Format.number(check.Goal))
					Kit.label(info, check.Text, { Size = UDim2.new(1, 0, 0, 28), TextSize = 10, Wrap = true, Color = check.Ok and C.Green or C.TextDim,
						Font = F.Body, AlignY = Enum.TextYAlignment.Top, Props = { LayoutOrder = i * 2 } })
				end
			end

			local buttonSize = UDim2.new(1, -16, 0, 40)
			local buttonPos = UDim2.new(0, 8, 1, -48)
			if state == "unlocked" then
				local b = Kit.button(card, active and "Estás aquí" or "Viajar", active and "ghost" or "cyan", { Size = buttonSize, Position = buttonPos,
					TextSize = 14, Props = { Name = "Travel" } }, function()
					local result = ctx.UI.request("SetActiveSystem", def.Id)
					if result.Ok then
						if ctx.Audio then ctx.Audio.play("portal") end
						if not State.inOwnUniverse() then ctx.UI.request("Teleport", "universe") end
						ctx.UI.close()
					end
				end)
				Kit.setEnabled(b, not active)
			else
				local cost = Progression.systemEnergyCost(def.Id)
				local b = Kit.button(card, state == "ready" and ("Desbloquear\n⚡ " .. Format.number(cost)) or "Bloqueado", "gold",
					{ Size = buttonSize, Position = buttonPos, TextSize = 13, Props = { Name = "Unlock" } }, function()
						local result = ctx.UI.request("UnlockSystem", def.Id)
						if result.Ok and ctx.Audio then ctx.Audio.play("fanfare") end
					end)
				Kit.setEnabled(b, state == "ready")
			end
		end
	end

	local last = 0
	State.onAny(function(changed)
		if not frame.Visible then return end
		if changed.Systems or changed.ActiveSystem or changed.Slots or changed.Placed or changed.Discovered or changed.Ascensions
			or changed.CollectionsClaimed or (changed.Energy and os.clock() - last > 2) then
			last = os.clock()
			refresh()
		end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX79">
              <Properties>
                <string name="Name">Inspect</string>
                <ProtectedString name="Source"><![CDATA[-- PlanetInspectUI (solo lectura): ficha de un planeta de otro universo o del indice.
return function(ctx, parent)
	local Kit, Defs, Format, Progression, Theme = ctx.Kit, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "PlanetInspectUI", Size = UDim2.fromOffset(420, 500), Title = "Planeta", Icon = "🪐",
		OnClose = function() ctx.UI.close() end })

	local function show(args)
		Kit.clear(body)
		local planet = args.Planet
		if not planet then return end
		local def = Defs.Planets.ById[planet.Id]
		local rarity = Defs.Rarities.ById[def.Rarity]
		local variant = Defs.Variants.get(planet.V)
		Kit.viewport(body, planet.Id, planet.V, planet.E, { Size = UDim2.new(1, 0, 0, 200) })
		Kit.label(body, Defs.Planets.displayName(def, planet.E), { Size = UDim2.new(1, 0, 0, 32), Position = UDim2.fromOffset(0, 204), TextSize = 24,
			Font = F.Black, AlignX = Enum.TextXAlignment.Center, Color = rarity.Color })
		Kit.label(body, Kit.rarityText(def.Rarity) .. "  ·  " .. def.TypeLabel, { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 238),
			TextSize = 13, AlignX = Enum.TextXAlignment.Center })
		local line = "⚡ " .. Format.rate(Progression.planetRate({ Id = planet.Id, V = planet.V or "none", E = planet.E == true }))
		if variant.Id ~= "none" then line = line .. "  ·  " .. variant.Icon .. " " .. variant.Name end
		Kit.label(body, line, { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 260), TextSize = 14, AlignX = Enum.TextXAlignment.Center,
			Color = C.Energy })
		Kit.label(body, def.Description, { Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 288), TextSize = 13, Wrap = true,
			Color = C.TextDim, Font = F.Body, AlignY = Enum.TextYAlignment.Top, AlignX = Enum.TextXAlignment.Center })
		if args.Owner then
			Kit.label(body, "Pertenece al universo de " .. args.Owner .. " (solo lectura)", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -22),
				TextSize = 12, AlignX = Enum.TextXAlignment.Center, Color = C.Stardust })
		end
	end

	return { Frame = frame, OnOpen = show }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX80">
              <Properties>
                <string name="Name">Inventory</string>
                <ProtectedString name="Source"><![CDATA[-- InventoryUI + PlanetInspectUI: lista de instancias con filtros, estado colocado/no colocado, y ficha
-- del planeta seleccionado con sus acciones (colocar, retirar, bloquear, evolucionar, vender).
return function(ctx, parent)
	local Kit, State, Defs, Format, Progression, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "InventoryUI", Size = UDim2.fromOffset(960, 580), Title = "Inventario", Icon = "🎒",
		OnClose = function() ctx.UI.close() end })

	local filter = 1 -- 1 todos, 2 libres, 3 en orbita
	local selected = nil
	local sellMode = false
	local sellSet = {}
	local placeSlot = nil -- slot elegido desde el panel de orbitas
	local cards = {} -- [uid] = { Card, Signature }

	local refresh, showInspect

	local toolbar = Kit.frame(body, { Name = "Toolbar", Size = UDim2.new(1, -290, 0, 36) })
	local _, selectTab = Kit.tabs(toolbar, { "Todos", "Libres", "En órbita" }, function(index)
		filter = index
		refresh()
	end, { Size = UDim2.fromOffset(330, 36), Width = 104 })
	local countLabel = Kit.label(toolbar, "", { Size = UDim2.fromOffset(110, 36), Position = UDim2.new(1, -250, 0, 0), TextSize = 14,
		AlignX = Enum.TextXAlignment.Right, Color = C.TextDim })
	local sellToggle
	local grid = Kit.scroll(body, { Size = UDim2.new(1, -290, 1, -86), Position = UDim2.fromOffset(0, 44), Grid = UDim2.fromOffset(118, 150), Padding = 8 })
	local hintLabel = Kit.label(body, "", { Size = UDim2.new(1, -290, 0, 34), Position = UDim2.new(0, 0, 1, -36), TextSize = 13, Color = C.TextDim,
		Wrap = true, Font = F.Body })
	local sellButton = Kit.button(body, "", "danger", { Size = UDim2.fromOffset(250, 36), Position = UDim2.new(1, -540, 1, -36), TextSize = 13 })
	sellButton.Visible = false

	local side = Kit.box(body, C.PanelLight, 0.2, { Name = "Inspect", Size = UDim2.new(0, 278, 1, 0), Position = UDim2.new(1, -278, 0, 0) }, 12)
	Kit.stroke(side, C.Cyan, 1, 0.5)
	local sideBody = Kit.frame(side, { Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10) })

	local function isPlaced(uid)
		return Progression.findPlaced(State.Data, uid) ~= nil
	end

	local function sellTotal()
		local total, n = 0, 0
		for uid in pairs(sellSet) do
			local inst = State.Data.Planets[uid]
			if inst then
				total = total + Progression.sellValue(inst)
				n = n + 1
			end
		end
		return total, n
	end

	local function updateSellButton()
		local total, n = sellTotal()
		sellButton.Visible = sellMode
		sellButton.Text = "Vender " .. n .. " por ⚡ " .. Format.number(total)
		Kit.setEnabled(sellButton, n > 0)
		sellToggle.Text = sellMode and "Cancelar venta" or "Vender varios"
		Kit.setStyle(sellToggle, sellMode and "danger" or "ghost")
	end

	local function place(uid, slot)
		local result = ctx.UI.request("EquipPlanet", uid, State.Data.ActiveSystem, slot)
		if result.Ok then
			if ctx.Audio then ctx.Audio.play("success") end
			ctx.UI.toast("Planeta colocado en la órbita " .. slot, "info")
			placeSlot = nil
			if ctx.State.inOwnUniverse() then ctx.UI.close() end
		end
	end

	-- selector de slot del sistema activo
	local function pickSlot(uid)
		local data = State.Data
		local system = Defs.Galaxy.ById[data.ActiveSystem]
		local shade = Kit.frame(frame, { Name = "SlotPicker", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Dark, BackgroundTransparency = 0.35,
			Active = true, ZIndex = 20 })
		Kit.corner(shade, 16)
		local box = Kit.box(shade, C.Panel, 0, { Size = UDim2.fromOffset(520, 300), Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 21 }, 14)
		Kit.stroke(box, C.Cyan, 2, 0)
		Kit.label(box, "Elige una órbita de " .. system.Name, { Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(14, 8), TextSize = 17,
			Props = { ZIndex = 22 } })
		local holder = Kit.frame(box, { Size = UDim2.new(1, -28, 0, 190), Position = UDim2.fromOffset(14, 50), ZIndex = 22 })
		local layout = Instance.new("UIGridLayout")
		layout.CellSize = UDim2.fromOffset(116, 88)
		layout.CellPadding = UDim2.fromOffset(8, 8)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = holder
		local owned = data.Slots[data.ActiveSystem] or 0
		for i = 1, Defs.Config.Economy.SlotsPerSystem do
			local occupant = data.Placed[data.ActiveSystem] and data.Placed[data.ActiveSystem][Defs.Galaxy.slotKey(i)]
			local text
			if i > owned then
				text = "Órbita " .. i .. "\n🔒 Bloqueada"
			elseif occupant and data.Planets[occupant] then
				text = "Órbita " .. i .. "\n" .. Defs.Planets.ById[data.Planets[occupant].Id].Name .. "\n(reemplazar)"
			else
				text = "Órbita " .. i .. "\n+ Libre"
			end
			local b = Kit.button(holder, text, (i <= owned and not occupant) and "green" or "ghost", { TextSize = 12,
				Props = { LayoutOrder = i, ZIndex = 23, Name = "Slot" .. i } }, function()
				shade:Destroy()
				place(uid, i)
			end)
			Kit.setEnabled(b, i <= owned and occupant ~= uid)
		end
		Kit.button(box, "Cancelar", "ghost", { Size = UDim2.fromOffset(140, 36), Position = UDim2.new(0.5, -70, 1, -46), Props = { ZIndex = 23 } },
			function() shade:Destroy() end)
	end

	showInspect = function()
		Kit.clear(sideBody)
		local data = State.Data
		local inst = selected and data.Planets[selected]
		if not inst then
			selected = nil
			Kit.label(sideBody, "Selecciona un planeta para ver su ficha y sus acciones.", { Size = UDim2.new(1, 0, 0, 80), TextSize = 14,
				Wrap = true, Color = C.TextDim, Font = F.Body, AlignX = Enum.TextXAlignment.Center })
			return
		end
		local uid = selected
		local def = Defs.Planets.ById[inst.Id]
		local rarity = Defs.Rarities.ById[def.Rarity]
		local variant = Defs.Variants.get(inst.V)
		local placedSystem, placedSlot = Progression.findPlaced(data, uid)
		Kit.viewport(sideBody, inst.Id, inst.V, inst.E, { Size = UDim2.new(1, 0, 0, 150) })
		Kit.label(sideBody, Defs.Planets.displayName(def, inst.E), { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 150), TextSize = 21,
			Font = F.Black, AlignX = Enum.TextXAlignment.Center, Color = rarity.Color })
		local sub = Kit.rarityText(def.Rarity) .. " · " .. def.TypeLabel
		Kit.label(sideBody, sub, { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 178), TextSize = 12, AlignX = Enum.TextXAlignment.Center })
		local rateText = "⚡ " .. Format.rate(Progression.planetRate(inst))
		if variant.Id ~= "none" then rateText = rateText .. "  ·  " .. variant.Icon .. " " .. variant.Name .. " " .. Format.mult(variant.Multiplier) end
		if inst.E then rateText = rateText .. "  ·  Prime " .. Format.mult(Defs.Config.Evolution.ProductionMultiplier) end
		Kit.label(sideBody, rateText, { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 197), TextSize = 12, AlignX = Enum.TextXAlignment.Center,
			Color = C.Energy })
		Kit.label(sideBody, def.Description, { Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 217), TextSize = 12, Wrap = true,
			Color = C.TextDim, Font = F.Body, AlignY = Enum.TextYAlignment.Top, AlignX = Enum.TextXAlignment.Center })
		local status = placedSystem and ("En órbita: " .. Defs.Galaxy.ById[placedSystem].Name .. ", " .. string.gsub(placedSlot, "s", "órbita "))
			or "En el inventario"
		Kit.label(sideBody, status, { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 268), TextSize = 11, AlignX = Enum.TextXAlignment.Center,
			Color = placedSystem and C.Cyan or C.TextDim })

		local actions = Kit.frame(sideBody, { Name = "Actions", Size = UDim2.new(1, 0, 0, 196), Position = UDim2.new(0, 0, 1, -196) })
		Kit.listLayout(actions, 6, false)
		local full = UDim2.new(1, 0, 0, 34)
		if placedSystem then
			Kit.button(actions, "Retirar de la órbita", "ghost", { Size = full, TextSize = 13, Props = { LayoutOrder = 1, Name = "Unequip" } }, function()
				local index = tonumber(string.match(placedSlot, "%d+"))
				ctx.UI.request("UnequipPlanet", placedSystem, index)
			end)
		else
			Kit.button(actions, placeSlot and ("Colocar en la órbita " .. placeSlot) or "Colocar en órbita", "primary",
				{ Size = full, TextSize = 13, Props = { LayoutOrder = 1, Name = "Equip" } }, function()
					if placeSlot then place(uid, placeSlot) else pickSlot(uid) end
				end)
		end
		Kit.button(actions, inst.L and "🔓 Desbloquear" or "🔒 Bloquear (proteger)", "ghost", { Size = full, TextSize = 13,
			Props = { LayoutOrder = 2, Name = "Lock" } }, function()
			ctx.UI.request("LockPlanet", uid, not inst.L)
		end)
		if not inst.E then
			local cost = Progression.evolutionCost(def)
			local fodder = Progression.evolutionFodder(data, uid)
			local can = #fodder >= cost.Copies and data.Energy >= cost.Energy and data.Stardust >= cost.Stardust
			local evolve = Kit.button(actions, "Evolucionar a Prime\n" .. #fodder .. "/" .. cost.Copies .. " copias · ⚡" .. Format.number(cost.Energy)
				.. " · ✨" .. cost.Stardust, "gold", { Size = UDim2.new(1, 0, 0, 44), TextSize = 12, Props = { LayoutOrder = 3, Name = "Evolve" } }, function()
				ctx.UI.confirm({ Title = "Evolucionar", Icon = "🌟", Confirm = "Evolucionar", Style = "gold",
					Text = "Se consumirán " .. cost.Copies .. " copias normales de " .. def.Name .. ", " .. Format.number(cost.Energy)
						.. " de Energy y " .. cost.Stardust .. " de Stardust. " .. def.Name .. " pasará a ser " .. def.Name
						.. " Prime (producción " .. Format.mult(Defs.Config.Evolution.ProductionMultiplier) .. ").",
					OnConfirm = function()
						local result = ctx.UI.request("EvolvePlanet", uid)
						if result.Ok then
							ctx.UI.toast("¡" .. def.Name .. " evolucionó a " .. def.Name .. " Prime!", "reward")
							if ctx.Audio then ctx.Audio.play("fanfare") end
						end
					end })
			end)
			Kit.setEnabled(evolve, can)
		end
		local sell = Kit.button(actions, "Vender por ⚡ " .. Format.number(Progression.sellValue(inst)), "danger", { Size = full, TextSize = 13,
			Props = { LayoutOrder = 4, Name = "Sell" } }, function()
			ctx.UI.confirm({ Title = "Vender planeta", Icon = "💱", Confirm = "Vender", Style = "danger",
				Text = "¿Vender " .. Defs.Planets.displayName(def, inst.E) .. " por " .. Format.number(Progression.sellValue(inst))
					.. " de Energy? Esta acción no se puede deshacer.",
				OnConfirm = function()
					ctx.UI.request("SellPlanets", { uid })
				end })
		end)
		Kit.setEnabled(sell, not inst.L and not placedSystem)
	end

	refresh = function()
		local data = State.Data
		local list = {}
		for uid, inst in pairs(data.Planets) do
			local placed = isPlaced(uid)
			if filter == 1 or (filter == 2 and not placed) or (filter == 3 and placed) then
				table.insert(list, { Uid = uid, Inst = inst, Placed = placed, Def = Defs.Planets.ById[inst.Id] })
			end
		end
		table.sort(list, function(a, b)
			local ra, rb = Defs.Rarities.ById[a.Def.Rarity].Order, Defs.Rarities.ById[b.Def.Rarity].Order
			if ra ~= rb then return ra > rb end
			local pa, pb = Progression.planetRate(a.Inst), Progression.planetRate(b.Inst)
			if pa ~= pb then return pa > pb end
			return a.Uid < b.Uid
		end)
		local keep = {}
		for order, item in ipairs(list) do
			local uid = item.Uid
			local signature = item.Inst.Id .. "|" .. item.Inst.V .. "|" .. tostring(item.Inst.E) .. "|" .. tostring(item.Inst.L) .. "|"
				.. tostring(item.Placed)
			local entry = cards[uid]
			if not entry or entry.Signature ~= signature then
				if entry then entry.Card:Destroy() end
				local card = Kit.planetCard(grid, { Id = item.Inst.Id, V = item.Inst.V, E = item.Inst.E, L = item.Inst.L, Placed = item.Placed }, {
					OnClick = function()
						if sellMode then
							local inst = State.Data.Planets[uid]
							if inst and not inst.L and not isPlaced(uid) then
								sellSet[uid] = not sellSet[uid] or nil
								refresh()
							else
								ctx.UI.toast("Ese planeta está bloqueado o en órbita.", "error")
							end
						else
							selected = uid
							refresh()
						end
					end,
				})
				card.Name = "Card_" .. uid
				entry = { Card = card, Signature = signature }
				cards[uid] = entry
			end
			entry.Card.LayoutOrder = order
			local edge = entry.Card:FindFirstChild("Edge")
			if edge then
				local highlighted = (sellMode and sellSet[uid]) or (not sellMode and selected == uid)
				edge.Thickness = highlighted and 3.5 or 1.5
				edge.Color = (sellMode and sellSet[uid]) and C.Red or (highlighted and C.Text or Defs.Rarities.ById[item.Def.Rarity].Color)
			end
			keep[uid] = true
		end
		for uid, entry in pairs(cards) do
			if not keep[uid] then
				entry.Card:Destroy()
				cards[uid] = nil
			end
		end
		for uid in pairs(sellSet) do
			if not data.Planets[uid] then sellSet[uid] = nil end
		end
		countLabel.Text = Progression.inventoryCount(data) .. " / " .. Progression.inventoryCapacity(data)
		if placeSlot then
			hintLabel.Text = "Elige un planeta para la órbita " .. placeSlot .. " de " .. Defs.Galaxy.ById[data.ActiveSystem].Name .. "."
		elseif sellMode then
			hintLabel.Text = "Toca los planetas que quieras vender."
		else
			hintLabel.Text = "Los duplicados sirven para evolucionar (Prime), intercambiar o vender."
		end
		updateSellButton()
		showInspect()
	end

	sellToggle = Kit.button(toolbar, "Vender varios", "ghost", { Size = UDim2.fromOffset(130, 34), Position = UDim2.new(1, -130, 0, 1), TextSize = 13 },
		function()
			sellMode = not sellMode
			sellSet = {}
			refresh()
		end)
	sellToggle.Name = "SellMode"
	sellButton.Activated:Connect(function()
		if sellButton:GetAttribute("Disabled") then return end
		local total, n = sellTotal()
		local uids = {}
		for uid in pairs(sellSet) do
			table.insert(uids, uid)
		end
		ctx.UI.confirm({ Title = "Vender planetas", Icon = "💱", Confirm = "Vender " .. n, Style = "danger",
			Text = "¿Vender " .. n .. " planetas por " .. Format.number(total) .. " de Energy? Esta acción no se puede deshacer.",
			OnConfirm = function()
				local result = ctx.UI.request("SellPlanets", uids)
				if result.Ok then
					sellSet = {}
					sellMode = false
					refresh()
				end
			end })
	end)

	State.onAny(function(changed)
		if frame.Visible and (changed.Planets or changed.Placed or changed.Slots or changed.ActiveSystem or changed.Upgrades) then
			refresh()
		end
	end)

	return {
		Frame = frame,
		OnOpen = function(args)
			sellMode = false
			sellSet = {}
			placeSlot = args.PlaceSlot
			if args.Select and State.Data.Planets[args.Select] then
				selected = args.Select
			end
			if placeSlot then
				filter = 2
				selectTab(2, true)
			end
			refresh()
			if args.Place and selected and not isPlaced(selected) then
				pickSlot(selected)
			end
		end,
		OnClose = function()
			placeSlot = nil
		end,
		Refresh = refresh,
	}
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX81">
              <Properties>
                <string name="Name">Leaderboard</string>
                <ProtectedString name="Source"><![CDATA[-- Leaderboard: cinco clasificaciones persistentes (se refrescan periodicamente en el servidor).
return function(ctx, parent)
	local Kit, State, Format, Theme = ctx.Kit, ctx.State, ctx.Format, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "LeaderboardUI", Size = UDim2.fromOffset(700, 540), Title = "Leaderboard", Icon = "🏅",
		OnClose = function() ctx.UI.close() end })
	local CATEGORIES = {
		{ "Rate", "Producción", function(v) return "⚡ " .. Format.rate(v) end },
		{ "Value", "Valor", function(v) return Format.number(v) end },
		{ "Ascensions", "Ascensiones", function(v) return "👑 " .. Format.number(v) end },
		{ "Discoveries", "Descubiertos", function(v) return "📖 " .. Format.number(v) end },
		{ "Rares", "Raros", function(v) return "🟣 " .. Format.number(v) end },
	}
	local tab = 1
	local list = Kit.scroll(body, { Size = UDim2.new(1, 0, 1, -46), Position = UDim2.fromOffset(0, 46), Padding = 5 })

	local function refresh()
		Kit.clear(list)
		local category = CATEGORIES[tab]
		local board = State.Leaderboards[category[1]] or {}
		for rank, entry in ipairs(board) do
			local row = Kit.box(list, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 40), LayoutOrder = rank }, 8)
			local color = (rank == 1 and C.Gold) or (rank == 2 and Color3.fromRGB(200, 210, 230)) or (rank == 3 and Color3.fromRGB(220, 150, 90)) or C.TextDim
			Kit.label(row, "#" .. rank, { Size = UDim2.fromOffset(50, 40), Position = UDim2.fromOffset(10, 0), TextSize = 17, Font = F.Black, Color = color })
			Kit.label(row, entry.Name, { Size = UDim2.new(1, -260, 1, 0), Position = UDim2.fromOffset(64, 0), TextSize = 15 })
			Kit.label(row, category[3](entry.Value), { Size = UDim2.fromOffset(180, 40), Position = UDim2.new(1, -190, 0, 0), TextSize = 15,
				AlignX = Enum.TextXAlignment.Right, Color = C.Cyan })
		end
		if #board == 0 then
			Kit.label(list, "Aún no hay datos en esta clasificación.", { Size = UDim2.new(1, 0, 0, 40), TextSize = 13, Color = C.TextDim,
				AlignX = Enum.TextXAlignment.Center, Font = F.Body })
		end
	end

	local names = {}
	for _, category in ipairs(CATEGORIES) do
		table.insert(names, category[2])
	end
	Kit.tabs(body, names, function(index)
		tab = index
		refresh()
	end, { Size = UDim2.new(1, 0, 0, 36), Width = 126 })

	State.onLeaderboard(function()
		if frame.Visible then refresh() end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX82">
              <Properties>
                <string name="Name">Missions</string>
                <ProtectedString name="Source"><![CDATA[-- MissionUI: objetivos diarios, semanales y de evento con progreso, recompensa y reclamacion.
return function(ctx, parent)
	local Kit, State, Defs, Format, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "MissionUI", Size = UDim2.fromOffset(760, 520), Title = "Misiones", Icon = "🏆",
		OnClose = function() ctx.UI.close() end })
	local tab = 1
	local list = Kit.scroll(body, { Size = UDim2.new(1, 0, 1, -76), Position = UDim2.fromOffset(0, 46), Padding = 8 })
	local footer = Kit.label(body, "", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 1, -24), TextSize = 12, Color = C.TextDim,
		Font = F.Body })

	local function row(order, text, progress, goal, reward, claimed, onClaim)
		local box = Kit.box(list, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 78), LayoutOrder = order, Name = "Mission" .. order }, 10)
		Kit.label(box, text, { Size = UDim2.new(1, -200, 0, 24), Position = UDim2.fromOffset(12, 8), TextSize = 15 })
		Kit.label(box, "Recompensa: " .. reward, { Size = UDim2.new(1, -200, 0, 18), Position = UDim2.fromOffset(12, 32), TextSize = 12,
			Color = C.Stardust })
		local _, set = Kit.progress(box, { Size = UDim2.new(1, -200, 0, 16), Position = UDim2.fromOffset(12, 54), Color = progress >= goal and C.Green or C.Cyan })
		set(goal > 0 and progress / goal or 0, Format.number(math.floor(progress)) .. " / " .. Format.number(goal))
		local done = progress >= goal
		local button = Kit.button(box, claimed and "✔ Reclamada" or (done and "Reclamar" or "En curso"), done and not claimed and "green" or "ghost",
			{ Size = UDim2.fromOffset(160, 44), Position = UDim2.new(1, -172, 0, 17), TextSize = 14, Props = { Name = "Claim" } }, onClaim)
		Kit.setEnabled(button, done and not claimed)
	end

	local function refresh()
		Kit.clear(list)
		local m = State.Data.Missions
		local now = State.serverTime()
		if tab <= 2 then
			local scope = tab == 1 and "daily" or "weekly"
			local missions = tab == 1 and m.Daily or m.Weekly
			for i, mission in ipairs(missions) do
				local template = Defs.Missions.ById[mission.Id]
				local text = template and string.format(template.Text, Format.number(mission.Goal)) or mission.Id
				row(i, text, mission.Progress, mission.Goal, "✨ " .. mission.Stardust .. "  +  ⚡ " .. Format.number(mission.Energy), mission.Claimed,
					function()
						local result = ctx.UI.request("ClaimMission", scope, i)
						if result.Ok then
							ctx.UI.toast("Misión completada: +" .. result.Data.Stardust .. " ✨ y +" .. Format.number(result.Data.Energy) .. " ⚡", "reward")
							if ctx.Audio then ctx.Audio.play("success") end
						end
					end)
			end
			local period = tab == 1 and 86400 or 604800
			local elapsed = tab == 1 and (now % 86400) or ((now + 3 * 86400) % 604800)
			footer.Text = "Se renuevan en " .. Format.duration(period - elapsed) .. ". No pierdes nada si un día no juegas."
		else
			local event = State.Data._Event
			if event and event.Id and now < (event.EndsAt or 0) then
				local def = Defs.Events.ById[event.Id]
				row(1, def.Icon .. " " .. string.format(def.Objective.Text, def.Objective.Goal), m.EventProgress or 0, def.Objective.Goal,
					"✨ " .. def.RewardStardust, m.EventClaimed == true, function()
						local result = ctx.UI.request("ClaimMission", "event", 1)
						if result.Ok then
							ctx.UI.toast("Objetivo de evento completado: +" .. result.Data.Stardust .. " ✨", "reward")
						end
					end)
				footer.Text = def.Name .. " termina en " .. Format.clock(event.EndsAt - now) .. "."
			else
				Kit.label(list, "No hay ningún evento activo ahora mismo.", { Size = UDim2.new(1, 0, 0, 40), TextSize = 14, Color = C.TextDim,
					AlignX = Enum.TextXAlignment.Center })
				local nextDef = event and Defs.Events.ById[event.NextId]
				footer.Text = nextDef and ("Próximo evento: " .. nextDef.Name .. " en " .. Format.clock(math.max(0, event.NextStartsAt - now))) or ""
			end
		end
	end

	Kit.tabs(body, { "Diarias", "Semanales", "Evento" }, function(index)
		tab = index
		refresh()
	end, { Size = UDim2.fromOffset(400, 36), Width = 124 })

	State.onAny(function(changed)
		if frame.Visible and (changed.Missions or changed._Event) then refresh() end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX83">
              <Properties>
                <string name="Name">Rebirth</string>
                <ProtectedString name="Source"><![CDATA[-- RebirthUI: Galactic Ascension. Muestra requisitos, que se reinicia y que se conserva (con cantidades
-- actuales), recompensas exactas y pide doble confirmacion. La ascension solo ocurre si el servidor la valida.
return function(ctx, parent)
	local Kit, State, Defs, Format, Progression, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "RebirthUI", Size = UDim2.fromOffset(820, 570), Title = "Galactic Ascension", Icon = "🔄",
		OnClose = function() ctx.UI.close() end })

	local function count(t)
		local n = 0
		for _ in pairs(t) do
			n = n + 1
		end
		return n
	end

	local function refresh()
		Kit.clear(body)
		local data = State.Data
		local milestone = Defs.Ascension.next(data.Ascensions)
		local currentMult = Defs.Ascension.multiplier(data.Ascensions)
		Kit.label(body, "Ascensión " .. data.Ascensions .. "  →  " .. milestone.Index, { Size = UDim2.new(0.5, 0, 0, 30), TextSize = 22,
			Font = F.Black, Color = C.Gold })
		Kit.label(body, "Reinicia parte de tu progreso a cambio de un multiplicador permanente y Cosmic Cores.", { Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.fromOffset(0, 30), TextSize = 12, Color = C.TextDim, Font = F.Body })

		-- recompensas
		local rewards = Kit.box(body, C.Row, 0.1, { Size = UDim2.new(1, 0, 0, 58), Position = UDim2.fromOffset(0, 56) }, 10)
		Kit.stroke(rewards, C.Gold, 1.5, 0.2)
		Kit.label(rewards, "RECOMPENSAS", { Size = UDim2.fromOffset(150, 58), Position = UDim2.fromOffset(12, 0), TextSize = 12, Font = F.Title,
			Color = C.Gold })
		Kit.label(rewards, "Producción permanente  " .. Format.mult(currentMult) .. "  →  " .. Format.mult(milestone.Multiplier),
			{ Size = UDim2.new(0.5, -90, 1, 0), Position = UDim2.fromOffset(160, 0), TextSize = 15, Color = C.Energy })
		Kit.label(rewards, "+" .. milestone.Cores .. " 💠 Cosmic Cores", { Size = UDim2.new(0.3, 0, 1, 0), Position = UDim2.new(0.7, -10, 0, 0),
			TextSize = 15, AlignX = Enum.TextXAlignment.Right, Color = C.Cores })

		-- requisitos
		Kit.label(body, "REQUISITOS", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 122), TextSize = 12, Font = F.Title, Color = C.Cyan })
		local allOk = true
		for i, req in ipairs(milestone.Requirements) do
			local check = Progression.checkRequirement(data, req, State.rate())
			if not check.Ok then allOk = false end
			local y = 144 + (i - 1) * 30
			Kit.label(body, (check.Ok and "✔ " or "❌ ") .. check.Text, { Size = UDim2.new(0.56, 0, 0, 24), Position = UDim2.fromOffset(0, y),
				TextSize = 13, Color = check.Ok and C.Green or C.Text })
			local _, set = Kit.progress(body, { Size = UDim2.new(0.42, 0, 0, 20), Position = UDim2.new(0.58, 0, 0, y + 2),
				Color = check.Ok and C.Green or C.Gold })
			set(check.Current / check.Goal, Format.number(check.Current) .. " / " .. Format.number(check.Goal))
		end

		-- columnas: se reinicia / se conserva
		local energyLevels = 0
		for id, level in pairs(data.Upgrades) do
			if Defs.Upgrades.ById[id] and Defs.Upgrades.ById[id].Currency == "Energy" then energyLevels = energyLevels + level end
		end
		local placed = 0
		for sysId in pairs(data.Placed) do
			placed = placed + Progression.placedCount(data, sysId)
		end
		local found, total = Progression.discoveryTotals(data)
		local resets = {
			"Energy actual: " .. Format.number(data.Energy) .. " → " .. Format.number(Progression.startingEnergy(data)),
			"Mejoras con Energy: " .. energyLevels .. " niveles → 0",
			"Sistemas: " .. count(data.Systems) .. " → 1 (Solar)",
			"Slots orbitales comprados → 3 por sistema",
			"Planetas en órbita: " .. placed .. " vuelven al inventario",
		}
		local keeps = {
			"Tus " .. Progression.inventoryCount(data) .. " planetas",
			"Collection Index: " .. found .. "/" .. total .. " descubiertos",
			"✨ " .. Format.number(data.Stardust) .. " Stardust y 💠 " .. Format.number(data.Cores) .. " Cores",
			"Mejoras de núcleo y bonos de colección",
			"Cosméticos, misiones y estadísticas",
		}
		local columns = { { "SE REINICIA", C.Red, resets, 0 }, { "SE CONSERVA", C.Green, keeps, 0.5 } }
		for _, col in ipairs(columns) do
			local box = Kit.box(body, C.Row, 0.15, { Size = UDim2.new(0.5, -6, 0, 178), Position = UDim2.new(col[4], col[4] > 0 and 6 or 0, 0, 214) }, 10)
			Kit.stroke(box, col[2], 1.5, 0.3)
			Kit.label(box, col[1], { Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(12, 6), TextSize = 13, Font = F.Title, Color = col[2] })
			for i, text in ipairs(col[3]) do
				Kit.label(box, "•  " .. text, { Size = UDim2.new(1, -24, 0, 24), Position = UDim2.fromOffset(12, 30 + (i - 1) * 27), TextSize = 12,
					Font = F.Body, Color = C.Text })
			end
		end

		Kit.label(body, "⚠ La ascensión no se puede deshacer.", { Size = UDim2.new(0.5, 0, 0, 44), Position = UDim2.new(0, 0, 1, -46), TextSize = 13,
			Color = C.Gold })
		local button = Kit.button(body, "ASCENDER", "gold", { Size = UDim2.fromOffset(280, 46), Position = UDim2.new(1, -280, 1, -48), TextSize = 19,
			Font = F.Black, Props = { Name = "Ascend" } }, function()
			ctx.UI.confirm({ Title = "Confirmar ascensión", Icon = "🔄", Confirm = "Sí, ascender", Style = "gold",
				Text = "Vas a reiniciar tu Energy, tus mejoras con Energy, tus sistemas y tus slots. Conservas todos tus planetas, tu colección, "
					.. "Stardust y Cosmic Cores. Recibirás producción permanente " .. Format.mult(milestone.Multiplier) .. " y +" .. milestone.Cores
					.. " Cosmic Cores.",
				OnConfirm = function()
					local result = ctx.UI.request("Rebirth", true)
					if result.Ok then
						ctx.UI.close()
						if ctx.Effects then ctx.Effects.ascension(result.Data) end
					end
				end })
		end)
		Kit.setEnabled(button, allOk)
	end

	local last = 0
	State.onAny(function(changed)
		if not frame.Visible then return end
		if changed.Ascensions or changed.Planets or changed.Discovered or changed.RunEnergy or (changed.Energy and os.clock() - last > 2) then
			last = os.clock()
			refresh()
		end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX84">
              <Properties>
                <string name="Name">Settings</string>
                <ProtectedString name="Source"><![CDATA[-- SettingsUI: audio, efectos, calidad visual, accesibilidad y tutorial.
return function(ctx, parent)
	local Kit, State, Defs, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "SettingsUI", Size = UDim2.fromOffset(600, 540), Title = "Ajustes", Icon = "⚙️",
		OnClose = function() ctx.UI.close() end })
	local list = Kit.scroll(body, { Size = UDim2.new(1, 0, 1, -34), Padding = 6 })
	local setters = {}

	local ITEMS = {
		{ "Music", "Música", "Música ambiental del espacio." },
		{ "Sfx", "Efectos de sonido", "Clics, recompensas y portales." },
		{ "ReducedEffects", "Efectos reducidos", "Menos partículas y destellos (accesibilidad)." },
		{ "SkipCapsuleAnimation", "Saltar animación de cápsulas", "Muestra el resultado al instante." },
		{ "LowQuality", "Calidad visual baja", "Mejora el rendimiento en móviles." },
		{ "LargeText", "Interfaz grande", "Aumenta el tamaño de la interfaz." },
		{ "ShowOtherNames", "Mostrar nombres en universos", "Carteles con el nombre del propietario." },
	}
	for index, item in ipairs(ITEMS) do
		local key = item[1]
		local row = Kit.box(list, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 54), LayoutOrder = index, Name = "Setting_" .. key }, 10)
		Kit.label(row, item[2], { Size = UDim2.new(1, -170, 0, 24), Position = UDim2.fromOffset(12, 6), TextSize = 15 })
		Kit.label(row, item[3], { Size = UDim2.new(1, -170, 0, 18), Position = UDim2.fromOffset(12, 30), TextSize = 12, Color = C.TextDim,
			Font = F.Body })
		local _, set = Kit.toggle(row, State.Data.Settings[key], function(value)
			State.Data.Settings[key] = value
			ctx.UI.request("UpdateSetting", key, value)
			if ctx.onSettingChanged then ctx.onSettingChanged(key, value) end
		end, { Position = UDim2.new(1, -142, 0, 10) })
		setters[key] = set
	end
	local tutorialRow = Kit.box(list, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 54), LayoutOrder = 50, Name = "Tutorial" }, 10)
	Kit.label(tutorialRow, "Tutorial", { Size = UDim2.new(1, -170, 0, 24), Position = UDim2.fromOffset(12, 6), TextSize = 15 })
	Kit.label(tutorialRow, "Oculta la guía inicial si ya sabes jugar.", { Size = UDim2.new(1, -170, 0, 18), Position = UDim2.fromOffset(12, 30),
		TextSize = 12, Color = C.TextDim, Font = F.Body })
	Kit.button(tutorialRow, "Saltar tutorial", "ghost", { Size = UDim2.fromOffset(130, 34), Position = UDim2.new(1, -142, 0, 10), TextSize = 13 }, function()
		ctx.UI.request("SkipTutorial")
	end)

	local footer = Kit.label(body, "", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, -26), TextSize = 12, Color = C.TextDim,
		Font = F.Body })

	local function refresh()
		for key, set in pairs(setters) do
			set(State.Data.Settings[key])
		end
		local session = State.Data._Session
		if session and session.SessionOnly then
			footer.Text = "⚠ Modo de prueba: el progreso NO se guardará (activa el acceso a API en Studio)."
			footer.TextColor3 = C.Gold
		else
			footer.Text = "PLANET COLLECTOR v" .. Defs.Config.Version .. " · tu progreso se guarda automáticamente."
			footer.TextColor3 = C.TextDim
		end
	end

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX85">
              <Properties>
                <string name="Name">Shop</string>
                <ProtectedString name="Source"><![CDATA[-- Tienda cosmetica: personalizacion del universo con Stardust (ganado jugando). No afecta al balance.
return function(ctx, parent)
	local Kit, State, Defs, Format, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "ShopUI", Size = UDim2.fromOffset(760, 520), Title = "Tienda cosmética", Icon = "🛒",
		OnClose = function() ctx.UI.close() end })
	local tab = 1
	local balance = Kit.label(body, "", { Size = UDim2.fromOffset(260, 36), Position = UDim2.new(1, -260, 0, 0), TextSize = 16,
		AlignX = Enum.TextXAlignment.Right, Color = C.Stardust })
	local list = Kit.scroll(body, { Size = UDim2.new(1, 0, 1, -74), Position = UDim2.fromOffset(0, 46), Padding = 6 })
	Kit.label(body, "Los cosméticos solo cambian el aspecto de tu universo. El Stardust se gana con misiones, eventos y colecciones.",
		{ Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -22), TextSize = 11, Color = C.TextDim, Font = F.Body })

	local function refresh()
		Kit.clear(list)
		local data = State.Data
		balance.Text = "✨ " .. Format.number(data.Stardust) .. " Stardust"
		local category = Defs.Cosmetics.Categories[tab]
		for index, def in ipairs(Defs.Cosmetics.ByCategory[category.Id]) do
			local owned = data.Cosmetics.Owned[def.Id] == true
			local equipped = data.Cosmetics.Equipped[category.Id] == def.Id
			local row = Kit.box(list, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 58), LayoutOrder = index, Name = "Cosmetic_" .. def.Id }, 10)
			local swatch = Kit.box(row, def.Color or C.Cyan, 0, { Size = UDim2.fromOffset(38, 38), Position = UDim2.fromOffset(10, 10) }, 19)
			Kit.stroke(swatch, C.Text, 1.5, 0.3)
			Kit.label(row, def.Name, { Size = UDim2.new(1, -260, 0, 24), Position = UDim2.fromOffset(60, 6), TextSize = 15 })
			Kit.label(row, def.Description or ("Color " .. string.lower(def.Name) .. " para tus órbitas."), { Size = UDim2.new(1, -260, 0, 18),
				Position = UDim2.fromOffset(60, 30), TextSize = 12, Color = C.TextDim, Font = F.Body })
			local text = equipped and "✔ Equipado" or (owned and "Equipar" or ("✨ " .. def.Price))
			local button = Kit.button(row, text, equipped and "ghost" or (owned and "cyan" or "primary"), { Size = UDim2.fromOffset(160, 40),
				Position = UDim2.new(1, -172, 0, 9), TextSize = 14, Props = { Name = "Action" } }, function()
				if owned then
					ctx.UI.request("EquipCosmetic", def.Id)
				else
					local result = ctx.UI.request("BuyCosmetic", def.Id)
					if result.Ok then
						if ctx.Audio then ctx.Audio.play("success") end
						ctx.UI.request("EquipCosmetic", def.Id)
					end
				end
			end)
			Kit.setEnabled(button, not equipped and (owned or data.Stardust >= def.Price))
		end
	end

	local names = {}
	for _, category in ipairs(Defs.Cosmetics.Categories) do
		table.insert(names, category.Name)
	end
	Kit.tabs(body, names, function(index)
		tab = index
		refresh()
	end, { Size = UDim2.fromOffset(420, 36), Width = 190 })

	State.onAny(function(changed)
		if frame.Visible and (changed.Cosmetics or changed.Stardust) then refresh() end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX86">
              <Properties>
                <string name="Name">Stats</string>
                <ProtectedString name="Source"><![CDATA[-- Estadisticas: desglose de produccion (de donde viene tu Energy) y estadisticas del jugador.
return function(ctx, parent)
	local Kit, State, Defs, Format, Progression, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "StatsUI", Size = UDim2.fromOffset(860, 560), Title = "Producción y estadísticas", Icon = "📊",
		OnClose = function() ctx.UI.close() end })
	local left = Kit.scroll(body, { Size = UDim2.new(0.58, -6, 1, 0), Padding = 5 })
	local right = Kit.scroll(body, { Size = UDim2.new(0.42, -6, 1, 0), Position = UDim2.new(0.58, 6, 0, 0), Padding = 5 })

	local function header(holder, text, order, color)
		Kit.label(holder, text, { Size = UDim2.new(1, -6, 0, 24), TextSize = 12, Font = F.Title, Color = color or C.Cyan,
			Props = { LayoutOrder = order } })
	end

	local function refresh()
		Kit.clear(left)
		Kit.clear(right)
		local data = State.Data
		local production = data._Production or Progression.production(data, 1)
		local order = 0
		local function nextOrder()
			order = order + 1
			return order
		end
		header(left, "PRODUCCIÓN POR SISTEMA", nextOrder())
		for _, sysId in ipairs(Defs.Galaxy.Order) do
			local sys = production.Systems[sysId]
			if sys then
				local def = Defs.Galaxy.ById[sysId]
				local box = Kit.box(left, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 62), LayoutOrder = nextOrder() }, 8)
				Kit.label(box, def.Name, { Size = UDim2.new(0.6, 0, 0, 22), Position = UDim2.fromOffset(10, 4), TextSize = 14, Color = def.Theme.Accent })
				Kit.label(box, "⚡ " .. Format.rate(sys.Total), { Size = UDim2.new(0.4, -20, 0, 22), Position = UDim2.new(0.6, 0, 0, 4), TextSize = 14,
					AlignX = Enum.TextXAlignment.Right, Color = C.Energy })
				local names = {}
				for _, id in ipairs(sys.Synergies) do
					table.insert(names, Defs.Synergies.ById[id].Name)
				end
				Kit.label(box, sys.Count .. " planetas · base " .. Format.number(sys.Base) .. " · sistema " .. Format.mult(def.Multiplier)
					.. " · sinergias " .. Format.mult(math.floor(sys.SynergyMult * 100 + 0.5) / 100), { Size = UDim2.new(1, -20, 0, 16),
					Position = UDim2.fromOffset(10, 26), TextSize = 11, Color = C.TextDim, Font = F.Body })
				Kit.label(box, #names > 0 and ("🔗 " .. table.concat(names, ", ")) or "Sin sinergias activas", { Size = UDim2.new(1, -20, 0, 16),
					Position = UDim2.fromOffset(10, 42), TextSize = 11, Color = #names > 0 and C.Green or C.TextDim, Font = F.Body })
			end
		end
		header(left, "MULTIPLICADORES GLOBALES", nextOrder())
		local mults = production.Mults
		Kit.stat(left, "Reactor Estelar", Format.mult(mults.Reactor), C.Cyan, nextOrder())
		Kit.stat(left, "Núcleo de Poder", Format.mult(mults.Cores), C.Cores, nextOrder())
		Kit.stat(left, "Galactic Ascension", Format.mult(mults.Ascension), C.Gold, nextOrder())
		Kit.stat(left, "Colecciones completas", Format.mult(mults.Collections), C.Violet, nextOrder())
		Kit.stat(left, "Evento activo", Format.mult(mults.Event), C.Gold, nextOrder())
		Kit.stat(left, "PRODUCCIÓN TOTAL", "⚡ " .. Format.rate(production.Total), C.Energy, nextOrder())
		header(left, "SINERGIAS DISPONIBLES (por sistema)", nextOrder())
		for _, synergy in ipairs(Defs.Synergies.List) do
			Kit.label(left, "• " .. synergy.Name .. " +" .. math.floor(synergy.Bonus * 100) .. "%: " .. synergy.Description,
				{ Size = UDim2.new(1, -6, 0, 18), TextSize = 11, Color = C.TextDim, Font = F.Body, Props = { LayoutOrder = nextOrder() } })
		end

		local stats = data.Stats
		local found, total = Progression.discoveryTotals(data)
		order = 0
		header(right, "TU PROGRESO", nextOrder())
		Kit.stat(right, "Energy total generada", Format.number(data.TotalEnergy), C.Energy, nextOrder())
		Kit.stat(right, "Mejor producción", Format.rate(stats.BestRate), C.Energy, nextOrder())
		Kit.stat(right, "Ascensiones", tostring(data.Ascensions), C.Gold, nextOrder())
		Kit.stat(right, "Planetas descubiertos", found .. " / " .. total, C.Violet, nextOrder())
		Kit.stat(right, "Planetas en inventario", Progression.inventoryCount(data) .. " / " .. Progression.inventoryCapacity(data), C.Text, nextOrder())
		Kit.stat(right, "Cápsulas abiertas", Format.commas(stats.CapsulesOpened), C.Text, nextOrder())
		Kit.stat(right, "Planetas obtenidos", Format.commas(stats.PlanetsObtained), C.Text, nextOrder())
		Kit.stat(right, "Raros o superiores", Format.commas(stats.RaresObtained), C.Text, nextOrder())
		Kit.stat(right, "Evoluciones", tostring(stats.Evolutions), C.Text, nextOrder())
		Kit.stat(right, "Intercambios", tostring(stats.Trades), C.Text, nextOrder())
		Kit.stat(right, "Universos visitados", tostring(stats.Visits), C.Text, nextOrder())
		Kit.stat(right, "Meteoritos recogidos", tostring(stats.MeteorsCollected), C.Text, nextOrder())
		header(right, "CÓMO PRODUCIR MÁS", nextOrder(), C.Gold)
		local tips = {
			"Llena los 8 slots de cada sistema.", "Combina elementos para activar sinergias.",
			"Desbloquea sistemas: multiplican la producción.", "Evoluciona duplicados a su forma Prime.",
			"Las variantes producen más (hasta x6).", "Asciende para multiplicar todo.",
		}
		for _, tip in ipairs(tips) do
			Kit.label(right, "• " .. tip, { Size = UDim2.new(1, -6, 0, 18), TextSize = 11, Color = C.TextDim, Font = F.Body,
				Props = { LayoutOrder = nextOrder() } })
		end
	end

	State.onAny(function(changed)
		if frame.Visible and (changed._Production or changed.Stats or changed.Discovered) then refresh() end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX87">
              <Properties>
                <string name="Name">Teleport</string>
                <ProtectedString name="Source"><![CDATA[-- Teletransporte y Universe Showcase: volver al Hub, ir a tu universo o visitar (solo lectura) el de otro jugador.
return function(ctx, parent)
	local Players = game:GetService("Players")
	local Kit, State, Defs, Format, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "TeleportUI", Size = UDim2.fromOffset(640, 520), Title = "Portal Room", Icon = "🌀",
		OnClose = function() ctx.UI.close() end })

	local function go(destination)
		local result = ctx.UI.request("Teleport", destination)
		if result.Ok then
			if ctx.Audio then ctx.Audio.play("portal") end
			ctx.UI.close()
		end
	end
	Kit.button(body, "🏠  Cosmic Hub", "cyan", { Size = UDim2.new(0.5, -6, 0, 56), TextSize = 17, Props = { Name = "Hub" } }, function() go("hub") end)
	Kit.button(body, "🌌  Mi universo", "primary", { Size = UDim2.new(0.5, -6, 0, 56), Position = UDim2.new(0.5, 6, 0, 0), TextSize = 17,
		Props = { Name = "Universe" } }, function() go("universe") end)
	Kit.label(body, "UNIVERSOS DE OTROS JUGADORES (solo lectura)", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 68), TextSize = 12,
		Font = F.Title, Color = C.Cyan })
	local list = Kit.scroll(body, { Size = UDim2.new(1, 0, 1, -96), Position = UDim2.fromOffset(0, 94), Padding = 6 })

	local function refresh()
		Kit.clear(list)
		local me = Players.LocalPlayer.UserId
		local order = 0
		for userId, view in pairs(State.Universes) do
			if userId ~= me then
				order = order + 1
				local row = Kit.box(list, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 62), LayoutOrder = order, Name = "Universe_" .. userId }, 10)
				Kit.label(row, "🪐 " .. view.Name, { Size = UDim2.new(1, -190, 0, 24), Position = UDim2.fromOffset(12, 6), TextSize = 16 })
				Kit.label(row, "⚡ " .. Format.rate(view.Stats.Rate) .. "  ·  👑 " .. view.Stats.Ascensions .. "  ·  📖 " .. view.Stats.Discovered .. "/"
					.. view.Stats.DiscoveredTotal .. "  ·  " .. Defs.Galaxy.ById[view.System].Name, { Size = UDim2.new(1, -190, 0, 20),
					Position = UDim2.fromOffset(12, 32), TextSize = 12, Color = C.TextDim, Font = F.Body })
				Kit.button(row, "Visitar", "cyan", { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -162, 0, 11), TextSize = 14,
					Props = { Name = "Visit" } }, function()
					local result = ctx.UI.request("VisitUniverse", userId)
					if result.Ok then
						if ctx.Audio then ctx.Audio.play("portal") end
						ctx.UI.close()
					end
				end)
			end
		end
		if order == 0 then
			Kit.label(list, "No hay otros jugadores en este servidor ahora mismo.", { Size = UDim2.new(1, 0, 0, 40), TextSize = 13, Color = C.TextDim,
				AlignX = Enum.TextXAlignment.Center, Font = F.Body })
		end
	end

	State.onUniverse(function()
		if frame.Visible then refresh() end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX88">
              <Properties>
                <string name="Name">Trading</string>
                <ProtectedString name="Source"><![CDATA[-- TradingUI: Galactic Trading. Invitar/aceptar, oferta de ambos jugadores con atributos, rareza y
-- variantes, estado de "Listo", periodo de revision y confirmacion final de los dos.
return function(ctx, parent)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Kit, State, Defs, Format, Progression, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Progression, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "TradingUI", Size = UDim2.fromOffset(960, 580), Title = "Galactic Market", Icon = "🔁",
		OnClose = function() ctx.UI.close() end })
	local Trade = ctx.Trade
	local confirmButton = nil
	local reviewLabel = nil

	local function lobby()
		Kit.label(body, "INVITACIONES RECIBIDAS", { Size = UDim2.new(0.5, -8, 0, 22), TextSize = 12, Font = F.Title, Color = C.Gold })
		local incoming = Kit.scroll(body, { Size = UDim2.new(0.5, -8, 1, -30), Position = UDim2.fromOffset(0, 28), Padding = 6 })
		local count = 0
		for index, request in ipairs(Trade.Requests) do
			if request.Expires > os.clock() then
				count = count + 1
				local row = Kit.box(incoming, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 56), LayoutOrder = index, Name = "Request_" .. request.From }, 10)
				Kit.label(row, "🤝 " .. request.Name, { Size = UDim2.new(1, -220, 1, 0), Position = UDim2.fromOffset(12, 0), TextSize = 15 })
				Kit.button(row, "Aceptar", "green", { Size = UDim2.fromOffset(96, 36), Position = UDim2.new(1, -206, 0, 10), TextSize = 13,
					Props = { Name = "Accept" } }, function()
					Trade.removeRequest(request.From)
					ctx.UI.request("RespondTrade", request.From, true)
				end)
				Kit.button(row, "Rechazar", "ghost", { Size = UDim2.fromOffset(96, 36), Position = UDim2.new(1, -104, 0, 10), TextSize = 13,
					Props = { Name = "Decline" } }, function()
					Trade.removeRequest(request.From)
					ctx.UI.request("RespondTrade", request.From, false)
					ctx.UI.refresh("Trading")
				end)
			end
		end
		if count == 0 then
			Kit.label(incoming, "No tienes invitaciones pendientes.", { Size = UDim2.new(1, 0, 0, 36), TextSize = 13, Color = C.TextDim, Font = F.Body })
		end

		Kit.label(body, "JUGADORES EN EL SERVIDOR", { Size = UDim2.new(0.5, -8, 0, 22), Position = UDim2.new(0.5, 8, 0, 0), TextSize = 12,
			Font = F.Title, Color = C.Cyan })
		local players = Kit.scroll(body, { Size = UDim2.new(0.5, -8, 1, -30), Position = UDim2.new(0.5, 8, 0, 28), Padding = 6 })
		local others = 0
		for index, other in ipairs(Players:GetPlayers()) do
			if other ~= Players.LocalPlayer then
				others = others + 1
				local row = Kit.box(players, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 56), LayoutOrder = index, Name = "Player_" .. other.UserId }, 10)
				Kit.label(row, "🚀 " .. other.DisplayName, { Size = UDim2.new(1, -150, 1, 0), Position = UDim2.fromOffset(12, 0), TextSize = 15 })
				Kit.button(row, "Invitar", "primary", { Size = UDim2.fromOffset(120, 36), Position = UDim2.new(1, -130, 0, 10), TextSize = 13,
					Props = { Name = "Invite" } }, function(button)
					local result = ctx.UI.request("RequestTrade", other.UserId)
					if result.Ok then
						ctx.UI.toast("Invitación enviada a " .. other.DisplayName, "info")
						button.Text = "Enviada ✔"
						Kit.setEnabled(button, false)
					end
				end)
			end
		end
		if others == 0 then
			Kit.label(players, "No hay otros jugadores con quien intercambiar ahora mismo.", { Size = UDim2.new(1, 0, 0, 36), TextSize = 13,
				Color = C.TextDim, Font = F.Body })
		end
	end

	local function offerColumn(title, side, x, removable)
		local box = Kit.box(body, C.Row, 0.15, { Size = UDim2.new(0.5, -6, 0, 250), Position = UDim2.new(x, x > 0 and 6 or 0, 0, 0) }, 12)
		Kit.stroke(box, side.Confirmed and C.Green or (side.Ready and C.Gold or C.Cyan), 2, 0.2)
		Kit.label(box, title, { Size = UDim2.new(1, -150, 0, 26), Position = UDim2.fromOffset(12, 6), TextSize = 14, Font = F.Title })
		local status = side.Confirmed and "✔ CONFIRMADO" or (side.Ready and "● LISTO" or "Eligiendo...")
		Kit.label(box, status, { Size = UDim2.fromOffset(140, 26), Position = UDim2.new(1, -150, 0, 6), TextSize = 12,
			AlignX = Enum.TextXAlignment.Right, Color = side.Confirmed and C.Green or (side.Ready and C.Gold or C.TextDim) })
		local grid = Kit.scroll(box, { Size = UDim2.new(1, -16, 1, -42), Position = UDim2.fromOffset(8, 36), Grid = UDim2.fromOffset(96, 126), Padding = 6 })
		for index, item in ipairs(side.Offer) do
			local card = Kit.planetCard(grid, { Id = item.Id, V = item.V, E = item.E }, { Size = UDim2.fromOffset(96, 126),
				OnClick = removable and function()
					ctx.UI.request("TradeAction", "remove", item.Uid)
				end or nil })
			card.LayoutOrder = index
			card.Name = "Offer_" .. item.Uid
		end
		if #side.Offer == 0 then
			Kit.label(grid, removable and "Añade planetas desde tu inventario (abajo)." or "Aún no ofrece nada.", { Size = UDim2.new(1, 0, 0, 30),
				TextSize = 12, Color = C.TextDim, Font = F.Body })
		end
	end

	local function tradeView(trade)
		offerColumn("TU OFERTA", trade.You, 0, true)
		offerColumn("OFERTA DE " .. string.upper(trade.Them.Name), trade.Them, 0.5, false)
		Kit.label(body, "TU INVENTARIO (toca para ofrecer; máx. " .. Defs.Config.Trade.MaxItemsPerSide .. ")", { Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.fromOffset(0, 256), TextSize = 11, Font = F.Title, Color = C.Cyan })
		local strip = Kit.scroll(body, { Size = UDim2.new(1, 0, 0, 136), Position = UDim2.fromOffset(0, 278), Horizontal = true, Padding = 6 })
		local offered = {}
		for _, item in ipairs(trade.You.Offer) do
			offered[item.Uid] = true
		end
		local list = {}
		for uid, inst in pairs(State.Data.Planets) do
			if not offered[uid] and not inst.L and not Progression.findPlaced(State.Data, uid) then
				table.insert(list, { Uid = uid, Inst = inst })
			end
		end
		table.sort(list, function(a, b)
			local ra = Defs.Rarities.ById[Defs.Planets.ById[a.Inst.Id].Rarity].Order
			local rb = Defs.Rarities.ById[Defs.Planets.ById[b.Inst.Id].Rarity].Order
			if ra ~= rb then return ra > rb end
			return a.Uid < b.Uid
		end)
		for index, item in ipairs(list) do
			if index > 60 then break end
			local card = Kit.planetCard(strip, { Id = item.Inst.Id, V = item.Inst.V, E = item.Inst.E }, { Size = UDim2.fromOffset(96, 126),
				OnClick = function()
					ctx.UI.request("TradeAction", "add", item.Uid)
				end })
			card.LayoutOrder = index
			card.Name = "Mine_" .. item.Uid
		end

		reviewLabel = Kit.label(body, "", { Size = UDim2.new(1, -520, 0, 44), Position = UDim2.new(0, 0, 1, -46), TextSize = 13, Wrap = true,
			Color = C.TextDim, Font = F.Body })
		Kit.button(body, "Cancelar", "danger", { Size = UDim2.fromOffset(140, 44), Position = UDim2.new(1, -500, 1, -46), TextSize = 14,
			Props = { Name = "Cancel" } }, function()
			ctx.UI.request("TradeAction", "cancel")
		end)
		Kit.button(body, trade.You.Ready and "Cambiar oferta" or "Listo", trade.You.Ready and "ghost" or "cyan", { Size = UDim2.fromOffset(160, 44),
			Position = UDim2.new(1, -350, 1, -46), TextSize = 14, Props = { Name = "Ready" } }, function()
			ctx.UI.request("TradeAction", trade.You.Ready and "unready" or "ready")
		end)
		confirmButton = Kit.button(body, "CONFIRMAR", "green", { Size = UDim2.fromOffset(180, 44), Position = UDim2.new(1, -180, 1, -46), TextSize = 15,
			Font = F.Black, Props = { Name = "Confirm" } }, function()
			ctx.UI.request("ConfirmTrade")
		end)
		Kit.setEnabled(confirmButton, false)
	end

	local function refresh()
		Kit.clear(body)
		confirmButton = nil
		reviewLabel = nil
		if Trade.Current then tradeView(Trade.Current) else lobby() end
	end

	RunService.Heartbeat:Connect(function()
		local trade = Trade.Current
		if not frame.Visible or not trade or not confirmButton or not reviewLabel then return end
		if trade.Stage == "review" then
			local remaining = (trade.ReviewEndsAt or 0) - State.serverTime()
			if trade.You.Confirmed then
				reviewLabel.Text = "Has confirmado. Esperando a " .. trade.Them.Name .. "..."
				Kit.setEnabled(confirmButton, false)
			elseif remaining > 0 then
				reviewLabel.Text = "Revisa bien ambas ofertas. Podrás confirmar en " .. math.ceil(remaining) .. " s."
				Kit.setEnabled(confirmButton, false)
			else
				reviewLabel.Text = "Confirmación final: el intercambio se completa cuando ambos confirméis."
				Kit.setEnabled(confirmButton, true)
			end
		else
			reviewLabel.Text = "Cuando los dos marquéis Listo empezará la revisión. Cambiar una oferta reinicia las confirmaciones."
			Kit.setEnabled(confirmButton, false)
		end
	end)

	State.on("Planets", function()
		if frame.Visible and Trade.Current then refresh() end
	end)

	return { Frame = frame, OnOpen = refresh, Refresh = refresh }
end
]]></ProtectedString>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX89">
              <Properties>
                <string name="Name">Upgrades</string>
                <ProtectedString name="Source"><![CDATA[-- UpgradeUI: coste, nivel actual, siguiente mejora y efecto real. Dos pestañas: Energy y Cosmic Cores.
return function(ctx, parent)
	local Kit, State, Defs, Format, Theme = ctx.Kit, ctx.State, ctx.Defs, ctx.Format, ctx.Theme
	local C, F = Theme.Colors, Theme.Fonts
	local frame, body = Kit.panel(parent, { Name = "UpgradeUI", Size = UDim2.fromOffset(760, 540), Title = "Mejoras", Icon = "📈",
		OnClose = function() ctx.UI.close() end })
	local tab = 1
	local list = Kit.scroll(body, { Size = UDim2.new(1, 0, 1, -46), Position = UDim2.fromOffset(0, 46), Padding = 8 })
	local balance = Kit.label(body, "", { Size = UDim2.fromOffset(300, 36), Position = UDim2.new(1, -300, 0, 0), TextSize = 15,
		AlignX = Enum.TextXAlignment.Right })
	local rows = {}

	local function effectText(def, level)
		local value = def.Effect(level)
		local kind = def.EffectKind
		if kind == "mult" then return Format.mult(value)
		elseif kind == "discount" then return "-" .. math.floor((1 - value) * 100 + 0.5) .. "%"
		elseif kind == "flat" then return "+" .. value
		elseif kind == "hours" then return "+" .. value .. " h"
		elseif kind == "add" then return "+" .. math.floor(value * 100 + 0.5) .. "%"
		end
		return "Nv " .. value
	end

	local function update()
		local data = State.Data
		balance.Text = tab == 1 and ("⚡ " .. Format.number(data.Energy)) or ("💠 " .. Format.number(data.Cores) .. " Cosmic Cores")
		balance.TextColor3 = tab == 1 and C.Energy or C.Cores
		for _, item in ipairs(rows) do
			local def = item.Def
			local level = Defs.Upgrades.level(data, def.Id)
			local maxed = level >= def.MaxLevel
			item.Level.Text = "Nv " .. level .. " / " .. def.MaxLevel
			item.Effect.Text = maxed and ("Efecto: " .. effectText(def, level) .. " (MÁX)")
				or ("Efecto: " .. effectText(def, level) .. "  →  " .. effectText(def, level + 1))
			if maxed then
				item.Button.Text = "MÁXIMO"
				Kit.setEnabled(item.Button, false)
			else
				local cost = def.Cost(level)
				item.Button.Text = (def.Currency == "Cores" and "💠 " or "⚡ ") .. Format.number(cost)
				Kit.setEnabled(item.Button, (def.Currency == "Cores" and data.Cores or data.Energy) >= cost)
			end
		end
	end

	local function build()
		Kit.clear(list)
		rows = {}
		local currency = tab == 1 and "Energy" or "Cores"
		for index, def in ipairs(Defs.Upgrades.List) do
			if def.Currency == currency then
				local row = Kit.box(list, C.Row, 0.1, { Size = UDim2.new(1, -6, 0, 76), LayoutOrder = index, Name = "Upgrade_" .. def.Id }, 10)
				Kit.label(row, def.Icon, { Size = UDim2.fromOffset(56, 76), Position = UDim2.fromOffset(6, 0), TextSize = 32, AlignX = Enum.TextXAlignment.Center })
				Kit.label(row, def.Name, { Size = UDim2.new(1, -330, 0, 24), Position = UDim2.fromOffset(66, 6), TextSize = 16 })
				Kit.label(row, def.Description, { Size = UDim2.new(1, -250, 0, 20), Position = UDim2.fromOffset(66, 30), TextSize = 12, Color = C.TextDim,
					Font = F.Body })
				local effect = Kit.label(row, "", { Size = UDim2.new(1, -250, 0, 20), Position = UDim2.fromOffset(66, 50), TextSize = 12, Color = C.Cyan })
				local level = Kit.label(row, "", { Size = UDim2.fromOffset(110, 22), Position = UDim2.new(1, -290, 0, 8), TextSize = 13,
					AlignX = Enum.TextXAlignment.Right, Color = C.Gold })
				local button
				button = Kit.button(row, "", def.Currency == "Cores" and "cyan" or "primary", { Size = UDim2.fromOffset(160, 48), Position = UDim2.new(1, -170, 0, 14),
					TextSize = 15, Props = { Name = "Buy" } }, function()
					local result = ctx.UI.request("PurchaseUpgrade", def.Id)
					if result.Ok and ctx.Audio then ctx.Audio.play("success") end
				end)
				table.insert(rows, { Def = def, Level = level, Effect = effect, Button = button })
			end
		end
		update()
	end

	Kit.tabs(body, { "⚡ Con Energy", "💠 Núcleos (permanentes)" }, function(index)
		tab = index
		build()
	end, { Size = UDim2.fromOffset(420, 36), Width = 200 })

	local last = 0
	State.onAny(function(changed)
		if not frame.Visible then return end
		if changed.Upgrades or changed.Cores or (changed.Energy and os.clock() - last > 0.3) then
			last = os.clock()
			update()
		end
	end)

	return { Frame = frame, OnOpen = build, Refresh = update }
end
]]></ProtectedString>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="RBX90">
            <Properties>
              <string name="Name">Theme</string>
              <ProtectedString name="Source"><![CDATA[-- Theme: paleta, tipografias y medidas de la interfaz holografica (paneles oscuros, bordes luminosos).
local Theme = {}

Theme.Colors = {
	Panel = Color3.fromRGB(10, 14, 34),
	PanelLight = Color3.fromRGB(20, 27, 58),
	Row = Color3.fromRGB(24, 32, 66),
	RowHover = Color3.fromRGB(34, 46, 92),
	Cyan = Color3.fromRGB(70, 215, 255),
	Blue = Color3.fromRGB(60, 120, 255),
	Violet = Color3.fromRGB(150, 90, 255),
	Magenta = Color3.fromRGB(255, 80, 210),
	Gold = Color3.fromRGB(255, 200, 80),
	Green = Color3.fromRGB(90, 230, 140),
	Red = Color3.fromRGB(255, 85, 95),
	Text = Color3.fromRGB(240, 245, 255),
	TextDim = Color3.fromRGB(160, 175, 210),
	Dark = Color3.fromRGB(4, 6, 18),
	Energy = Color3.fromRGB(255, 210, 70),
	Stardust = Color3.fromRGB(200, 170, 255),
	Cores = Color3.fromRGB(110, 235, 255),
}

Theme.Fonts = {
	Title = Enum.Font.Michroma,
	Bold = Enum.Font.GothamBold,
	Body = Enum.Font.GothamMedium,
	Black = Enum.Font.GothamBlack,
}

Theme.Corner = 12
Theme.Stroke = 2

-- estilos de boton: { color superior, color inferior, borde }
Theme.Buttons = {
	primary = { Color3.fromRGB(150, 90, 255), Color3.fromRGB(88, 42, 190), Color3.fromRGB(205, 165, 255) },
	cyan = { Color3.fromRGB(60, 190, 255), Color3.fromRGB(26, 96, 200), Color3.fromRGB(160, 230, 255) },
	gold = { Color3.fromRGB(255, 200, 70), Color3.fromRGB(205, 120, 20), Color3.fromRGB(255, 232, 150) },
	green = { Color3.fromRGB(80, 220, 130), Color3.fromRGB(26, 140, 80), Color3.fromRGB(170, 255, 200) },
	danger = { Color3.fromRGB(255, 95, 105), Color3.fromRGB(175, 34, 54), Color3.fromRGB(255, 170, 175) },
	ghost = { Color3.fromRGB(34, 44, 88), Color3.fromRGB(20, 27, 58), Color3.fromRGB(90, 120, 200) },
	disabled = { Color3.fromRGB(62, 66, 84), Color3.fromRGB(40, 43, 58), Color3.fromRGB(90, 95, 115) },
}

return Theme
]]></ProtectedString>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="RBX91">
    <Properties>
      <string name="Name">SoundService</string>
    </Properties>
  </Item>
</roblox>
